# kaze.gbnf -- a GBNF grammar for the Kaze 1.0 human syntax.
#
# This grammar is the constrained-decoding and editor-tooling view of the
# language.  The parser and checker remain the authority for indentation,
# scopes and types.  The grammar is line-oriented: a top-level declaration
# starts in column zero, and a block body is one or more indented lines.  It
# deliberately does not try to match indentation widths -- only "indented" and
# "not indented" -- because the parser accepts any consistent step.
#
# GBNF terminals: "text", [char-class], rule refs, ?, *, + and |.
# Every rule is written on one line because llama.cpp's grammar reader treats
# a leading "|" on the next line as the start of a new rule.

root ::= (line)*
line ::= blank | comment-line | use-decl | needs-decl | tasks-decl | record-decl | routine-decl | test-decl | when-decl | every-decl | stmt-line

# ------------------------------------------------------------------ layout
sp ::= [ \t]*
indent ::= [ \t]+
ib ::= [ \t\r\n]*
eol ::= sp comment? "\r"? "\n"
blank ::= sp "\r"? "\n"
comment-line ::= sp comment eol
comment ::= "#" [^\n]*

# ----------------------------------------------------------------- headers
use-decl ::= "use" sp use-target eol
use-target ::= selective-use | string (sp "as" sp lower-ident)?
selective-use ::= "{" sp (lower-ident (sp "," sp lower-ident)*)? sp "}" sp "from" sp string
needs-decl ::= "needs" sp (":" sp)? (cap (sp "," sp cap)*)? eol
cap ::= ident (sp "." sp ident)? (sp "(" ib args? ib ")")?
tasks-decl ::= "tasks" sp "bounded" sp number eol

# ------------------------------------------------------------ declarations
record-decl ::= (pub-kw)? "record" sp type-ident sp ":" eol record-body
pub-kw ::= "pub" sp
record-body ::= (blank | indent record-line)*
record-line ::= field sp comment? eol | comment eol
field ::= lower-ident (sp ":" sp type)?
routine-decl ::= (pub-kw)? routine-kw sp lower-ident sp "(" ib params? ib ")" (sp "->" sp type)? sp (":" sp)? eol body
routine-kw ::= "action" | "routine" | "func" | "task" | "check" | "filter" | "fiber"
params ::= param (sp "," sp param)* (sp ",")?
param ::= lower-ident (sp ":" sp type)? (sp "=" sp expression)?
test-decl ::= (pub-kw)? "test" sp string sp (":" sp)? eol body
when-decl ::= (pub-kw)? "when" sp expression sp (":" sp)? eol body
every-decl ::= (pub-kw)? "every" sp expression sp (":" sp)? eol body
body ::= (blank | indent body-line)*
body-line ::= stmt-line | recursion-decl | fuel-decl | routine-needs | comment eol
recursion-decl ::= "recursion" sp "bounded" sp (number | "?") eol
fuel-decl ::= "fuel" sp number eol
routine-needs ::= "needs" sp (":" sp)? (cap (sp "," sp cap)*)? eol

# -------------------------------------------------------------- statements
stmt-line ::= let-stmt | set-stmt | assign-stmt | return-stmt | guard-stmt | contract-stmt | break-stmt | continue-stmt | if-stmt | while-stmt | for-stmt | parallel-stmt | repeat-stmt | try-stmt | spawn-stmt | yield-stmt | join-stmt | cancel-stmt | send-stmt | log-stmt | alert-stmt | spawn-verb-stmt | expression eol
let-stmt ::= "let" sp lower-ident (sp "=" sp expression | sp "to" sp expression)? eol
set-stmt ::= "set" sp lower-ident sp ("to" sp expression | "=" sp expression) eol
assign-stmt ::= lower-ident sp ("=" | "+=" | "-=" | "*=" | "/=" | "%=") sp expression eol
return-stmt ::= "return" (sp "to" sp lower-ident | sp expression)? eol
guard-stmt ::= "guard" sp expression (sp "otherwise" sp exit-stmt)? eol
exit-stmt ::= "return" (sp expression)? | "break" | "continue"
contract-stmt ::= ("require" | "requires" | "ensure" | "ensures") sp expression eol
break-stmt ::= "break" eol
continue-stmt ::= "continue" eol
if-stmt ::= "if" sp expression sp ":" eol body elif-arm* else-arm?
elif-arm ::= indent "elif" sp expression sp ":" eol body
else-arm ::= indent ("else" | "otherwise") sp ":"? eol body
while-stmt ::= "while" sp expression (sp "bounded" sp (number | "?"))? sp ":" eol body
for-stmt ::= "for" (sp "each")? sp lower-ident sp "in" sp expression sp ":" eol body
parallel-stmt ::= "parallel" sp "for" (sp "each")? sp lower-ident sp "in" sp expression sp ":" eol body
repeat-stmt ::= "repeat" sp expression (sp "times")? sp ":" eol body
try-stmt ::= "try" sp ":" eol body (indent "otherwise" (sp "with" sp lower-ident)? sp ":" eol body)?
spawn-stmt ::= "spawn" sp lower-ident (sp "(" ib args? ib ")")? (sp "as" sp lower-ident)? eol
yield-stmt ::= "yield" eol
join-stmt ::= "join" sp expression eol
cancel-stmt ::= "cancel" sp expression eol
send-stmt ::= "send" sp expression (sp "to" sp expression)? eol
log-stmt ::= "log" (sp ("info" | "warn" | "warning" | "error" | "debug"))? sp expression eol
alert-stmt ::= "alert" sp expression eol
spawn-verb-stmt ::= ("arm" | "takeoff" | "fly" | "stop" | "hold" | "land" | "drive" | "turn" | "pulse" | "reject" | "allow" | "remember" | "recall") (sp expression)* eol

# ------------------------------------------------------------- expressions
expression ::= or-expr (sp "otherwise" sp fallback-expr)?
fallback-expr ::= "return" (sp or-expr)? | "break" | "continue" | or-expr
or-expr ::= and-expr (sp "or" sp and-expr)*
and-expr ::= not-expr (sp "and" sp not-expr)*
not-expr ::= ("not" sp)* bitor-expr
bitor-expr ::= bitxor-expr (sp "|" sp bitxor-expr)*
bitxor-expr ::= bitand-expr (sp "^" sp bitand-expr)*
bitand-expr ::= relational (sp "&" sp relational)*
relational ::= shift (sp ("==" | "!=" | "<=" | ">=" | "<" | ">") sp shift | sp "between" sp shift sp "and" sp shift)*
shift ::= additive (sp ("<<" | ">>") sp additive)*
additive ::= multiplicative (sp ("+" | "-") sp multiplicative)*
multiplicative ::= unary (sp ("*" | "/" | "%") sp unary)*
unary ::= ("-" | "~") sp unary | postfix
postfix ::= primary (postfix-op)*
postfix-op ::= sp "." sp ident | sp "[" ib expression ib "]" | sp "(" ib args? ib ")" | sp "in" sp ("radians" | "degrees")
primary ::= number unit? | string | "true" | "false" | "nothing" | "nil" | "?" | "length" sp "of" sp unary | "link" sp "lost" (sp "for" sp unary)? | "distance" sp "between" sp unary sp "and" sp unary | "slant" sp "distance" sp "between" sp unary sp "and" sp unary | "bearing" sp "from" sp unary sp "to" sp unary | "bearing" sp "of" sp unary | "policy" sp ("detects" | "detect") sp ident (sp "in" sp unary)? | "receive" sp "from" sp unary | "(" ib expression ib ")" | list-literal | ident
list-literal ::= "[" ib (expression (ib "," ib expression)* (ib ",")?)? ib "]"
args ::= arg (ib "," ib arg)* (ib ",")?
arg ::= (lower-ident sp ":" sp)? expression

# ------------------------------------------------------------------- types
type ::= ident (ib "<" ib type-arg (ib "," ib type-arg)* ib ">")?
type-arg ::= type | "[" ib (type-arg (ib "," ib type-arg)*)? ib "]" | number

# --------------------------------------------------------------- terminals
type-ident ::= [A-Z][A-Za-z0-9_]*
lower-ident ::= [a-z_][A-Za-z0-9_]*
ident ::= [A-Za-z_][A-Za-z0-9_]*
number ::= [0-9]+ ("." [0-9]+)?
unit ::= sp ("%" | unit-name (sp "/" sp [A-Za-z0-9_]+)? )
unit-name ::= "milliseconds" | "millimeters" | "centimeters" | "kilometers" | "kilograms" | "hectopascals" | "Celsius" | "Kelvin" | "Pascal" | "seconds" | "meters" | "minutes" | "hours" | "grams" | "ampere" | "degrees" | "radians" | "mbar" | "hPa" | "km" | "cm" | "mm" | "ms" | "kg" | "min" | "Pa" | "C" | "K" | "A" | "m" | "s" | "h" | "g"
string ::= "\"" ([^"\\\n] | "\\" [^\n])* "\""
