{
  "Kaze action": {
    "prefix": "action",
    "body": [
      "action ${1:main}(${2:params}):",
      "    ${3:log \"$4\"}",
      "$0"
    ],
    "description": "An action routine."
  },
  "Kaze check": {
    "prefix": "check",
    "body": [
      "check ${1:inspect}(${2:params}):",
      "    ${3:log \"$4\"}",
      "$0"
    ],
    "description": "A check routine."
  },
  "Kaze filter": {
    "prefix": "filter",
    "body": [
      "filter ${1:guard}(prompt):",
      "    if ${2:length of prompt > 2000}:",
      "        reject with \"${3:too long}\"",
      "    allow prompt",
      "$0"
    ],
    "description": "A filter that must allow or reject."
  },
  "Kaze record": {
    "prefix": "record",
    "body": [
      "record ${1:Telemetry}:",
      "    ${2:alt}: num",
      "    ${3:ok}: bool",
      "$0"
    ],
    "description": "A typed immutable record."
  },
  "Kaze fiber": {
    "prefix": "fiber",
    "body": [
      "fiber ${1:worker}(${2:ch}) fuel ${3:1000}:",
      "    yield",
      "$0"
    ],
    "description": "A bounded cooperative fiber."
  },
  "Kaze parallel for": {
    "prefix": "parallel",
    "body": [
      "parallel for each ${1:item} in ${2:collection}:",
      "    ${3:transform(item)}",
      "$0"
    ],
    "description": "Pure multicore parallel loop."
  },
  "Kaze contract": {
    "prefix": "requires",
    "body": [
      "requires ${1:x > 0}",
      "ensures ${2:result >= 0}",
      "$0"
    ],
    "description": "Routine precondition and postcondition contracts."
  },
  "Kaze supervisor hook": {
    "prefix": "when",
    "body": [
      "when ${1:battery < 20%}:",
      "    ${2:log warning \"low battery\"}",
      "$0"
    ],
    "description": "A when hook, evaluated on every tick."
  },
  "Kaze periodic hook": {
    "prefix": "every",
    "body": [
      "every ${1:100ms}:",
      "    ${2:log \"tick\"}",
      "$0"
    ],
    "description": "An every hook."
  },
  "Kaze fault tolerance": {
    "prefix": "try",
    "body": [
      "try:",
      "    ${1:takeoff to 15 meters}",
      "otherwise with err:",
      "    log warning err.code",
      "$0"
    ],
    "description": "Recover from an operational host failure."
  },
  "Kaze module header": {
    "prefix": "use",
    "body": [
      "use \"${1:./lib/helpers.kaze}\"",
      "$0"
    ],
    "description": "Import another Kaze module."
  },
  "Kaze capabilities": {
    "prefix": "needs",
    "body": [
      "needs: ${1:drone, log}",
      "$0"
    ],
    "description": "Declare capability families."
  }
}
