{
  "name": "kaze",
  "displayName": "Kaze",
  "description": "Kaze 1.0 language support: syntax highlighting, diagnostics, completion, hover, symbols and formatting via the pure-C99 Kaze toolchain.",
  "version": "1.0.0",
  "publisher": "sofuu-runtime",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sofuu-runtime/kaze"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kaze",
    "robotics",
    "drone",
    "ai",
    "language-server"
  ],
  "activationEvents": [
    "onLanguage:kaze",
    "workspaceContains:**/*.kaze"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kaze",
        "aliases": [
          "Kaze",
          "kaze"
        ],
        "extensions": [
          ".kaze"
        ],
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "iconThemes": [
      {
        "id": "kaze-icons",
        "label": "Kaze File Icons",
        "path": "./kaze-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "kaze",
        "scopeName": "source.kaze",
        "path": "./syntaxes/kaze.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kaze",
        "path": "./snippets/kaze.json"
      }
    ],
    "commands": [
      {
        "command": "kaze.restartServer",
        "title": "Kaze: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Kaze",
      "properties": {
        "kaze.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Kaze host/compiler binary (for example 'kaze-host' or 'kaze'). Leave empty to auto-detect 'bin/kaze-host' in the workspace or 'kaze-host' on PATH."
        },
        "kaze.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional extra arguments for the language server command. Leave empty to pass 'lsp' automatically to 'kaze-host' or 'kaze'."
        },
        "kaze.lsp.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log JSON-RPC messages to the Kaze output channel."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/lsp.test.js"
  }
}
