# main.kaze — Pure Kaze Self-Hosted Compiler.
#
# One binary, several modes, selected by the first positional argument:
#
#   <bin> <file.kaze>              source in, C out (the bootstrap default)
#   <bin> emit-c <file.kaze>       the same, said explicitly
#   <bin> check <file.kaze>        parse and check, print diagnostics
#   <bin> fmt <file.kaze>          parse and print the canonical human form
#   <bin> compile <file.kaze>      parse, check, print the bytecode module (hex)
#   <bin> to-machine <file.kaze>   emit the canonical machine S-expression form
#   <bin> to-human <file.kaze>     read machine S-expressions, print human syntax
#   <bin> lsp [session]            serve a framed LSP session (see lsp.kaze)
#
# The first parameter is the mode so that the single-argument form keeps
# working: when the first positional argument is not a mode name, it is the
# source itself and the compiler emits C. That is what lets the bootstrap run
# the same binary it built.
use "./token.kaze"
use "./ast.kaze"
use "./lexer.kaze"
use "./parser.kaze"
use "./checker.kaze"
use "./isa.kaze"
use "./machine.kaze"
use "./codegen.kaze"
use "./lsp.kaze"

action mode_of(word):
    if word == "check" or word == "emit-c" or word == "to-machine" or word == "to-human":
        return word
    if word == "fmt" or word == "compile" or word == "lsp" or word == "surface":
        return word
    return ""

# Human syntax and machine syntax are detected the same way the reference
# engine does it: a root form that opens with "(".
action parse_source(src):
    if is_machine_source(src) == 1:
        return parse_machine(src)
    let tokens = tokenize(src)
    return parse_program(tokens)

action render_diags(diags):
    let count = length of diags
    if count == 0:
        return "check: ok\n"
    let out = "check: " + count + " diagnostic(s)\n"
    for each d in diags:
        set out to out + render_diag(d) + "\n"
    return out

action compile(src):
    let program = parse_source(src)
    return emit_c_program(program)

# Print the language surface as one family.verb per line, sorted, so the drift check can
# diff it against the embedded product engine (scripts/kaze-drift-check.sh).
action surface_text() -> text:
    # cap_verbs() is kept in sorted order, so printing it is already canonical
    let verbs = cap_verbs()
    let out = ""
    let first = 1
    for each v in verbs:
        if first == 1:
            set out to v
            set first to 0
        otherwise:
            set out to out + "\n" + v
    for each o in bc_opcodes():
        set out to out + "\nopcode " + o
    return out

action main(mode, src):
    let selected = mode_of(mode)
    if selected == "lsp":
        # The second parameter is the session: a path the runtime reads, or the
        # session text itself when the argument is not a file. With no second
        # parameter there is no second input channel in this binary, so the
        # command says nothing on stdout rather than printing an empty line.
        if lsp_has_text(src) == 0:
            return
        if lsp_looks_like_session(src) == 0:
            return
        return lsp_serve_session(src)
    if selected == "":
        # A whole framed session arriving as the first parameter is what a
        # stdin slurp produces (the binary with no mode word, or --entry lsp
        # with stdin piped); serve it instead of trying to compile JSON.
        if lsp_looks_like_session(mode) == 1:
            return lsp_serve_session(mode)
        # Legacy one-argument form: the first parameter holds the source.
        if lsp_has_text(mode) == 0:
            return "/* Kaze Compiler — No input provided */\n"
        if length of mode == 0:
            return "/* Kaze Compiler — No input provided */\n"
        return compile(mode)
    if selected == "check":
        let program = parse_source(src)
        return render_diags(check_program(program))
    if selected == "to-machine":
        let program = parse_source(src)
        return emit_machine(program)
    if selected == "surface":
        return surface_text()

    if selected == "to-human":
        let program = parse_machine(src)
        return emit_human(program)
    if selected == "fmt":
        let program = parse_source(src)
        return emit_human(program)
    if selected == "compile":
        return compile_module(src)
    return compile(src)

# ── compile: the bytecode module writer ─────────────────────────────────
#
# The reference for the on-disk layout is sfs/isa.rs: the magic KAZEBC1 and a
# NUL, a u16 format number, the root origin, the needs list, the constant pool
# (number as f64 little-endian / text as length+bytes / boolean as one byte),
# the capability table, then one record per item: tag, period, line, slots,
# recursion ceiling, name, origin, parameter names and the code words.
#
# The lowering below mirrors sfs/compiler.rs instruction for instruction, so a
# module written here runs on the same VM as one the reference compiler wrote.
# Three limits of running inside the self-hosted binary are reported rather
# than papered over:
#
#   * it cannot write a file — the language has no write primitive, and the
#     generated C prints a returned string with printf("%s"), which stops at
#     the NUL byte every module header holds — so the module leaves as
#     lowercase hex on stdout:
#         kaze compile x.kaze | xxd -r -p > x.kazebc
#   * the root and item origins are empty: the generated C reads a positional
#     argument as the file it names, so this program never learns the path.
#     The VM reads neither field; only diagnostics lose the file name.
#   * text is ASCII: the writer has no UTF-8 encoder (it would need code
#     points), so a module carrying a non-ASCII constant is refused by name.

# One entry in the constant pool.
record BcConst:
    kind: str
    text: str
    val: num

# One capability call site: the family the gate re-checks, the operation and
# the number of arguments the call passes.
record BcCap:
    family: str
    op: str
    argc: num

# One item exactly as the module stores it.
record BcItem:
    name: str
    tag: num
    params: list
    code: list
    line: num
    period: num
    slots: num
    bound: num

# ── numbers and bytes ───────────────────────────────────────────────────

# The integer part of x. There is no floor builtin, and every use here is on
# a non-negative quantity, so one subtraction of the fractional part is exact.
action bc_floor(x):
    if x >= 0:
        let r = x % 1 otherwise 0
        return x - r
    let r = (0 - x) % 1 otherwise 0
    return 0 - ((0 - x) - r)

# A decimal literal's text as a number. The fraction is scaled with one
# division of two exact integers, which rounds once — the same rounding the
# reference parser's str::parse gives every literal this lexer can produce.
action bc_num_of(text):
    let n = length of text
    let i = 0
    let seen = 0
    let whole = 0
    let frac = 0
    let scale = 1
    while i < n bounded 64:
        let c = text[i] otherwise "x"
        if c == ".":
            set seen to 1
        otherwise:
            if c >= "0" and c <= "9":
                let d = digit_value(c)
                if seen == 1:
                    set scale to scale * 10
                    set frac to frac * 10 + d
                otherwise:
                    set whole to whole * 10 + d
        set i to i + 1
    if scale == 1:
        return whole
    return (whole * scale + frac) / scale otherwise whole

# The 8 bytes of a number's IEEE-754 representation, little-endian. A
# constant is stored as f64 and the language has no bit-cast, so the writer
# normalises to 1 <= m < 2, reads the 52 fraction bits with arithmetic, then
# splits the exponent and the mantissa into two 32-bit halves.
action bc_bytes_of_num(x):
    let sign = 0
    let v = x
    if v < 0:
        set sign to 1
        set v to 0 - v
    if v == 0:
        return [0, 0, 0, 0, 0, 0, 0, 0]
    let e = 0
    let m = v
    while m >= 2 and e < 1100 bounded 2000:
        set m to m / 2
        set e to e + 1
    while m < 1 and e > -1100 bounded 2000:
        set m to m * 2
        set e to e - 1
    let frac = 0
    let i = 0
    set m to m - 1
    while i < 52 bounded 64:
        set m to m * 2
        let bit = bc_floor(m)
        set m to m - bit
        set frac to frac * 2 + bit
        set i to i + 1
    let ef = e + 1023
    let fhi = bc_floor(frac / 4294967296)
    let flo = frac - fhi * 4294967296
    let hi = sign * 2147483648 + ef * 1048576 + fhi
    let lo = flo
    let y3 = bc_floor(lo / 16777216)
    let r3 = lo - y3 * 16777216
    let y2 = bc_floor(r3 / 65536)
    let r2 = r3 - y2 * 65536
    let y1 = bc_floor(r2 / 256)
    let y0 = r2 - y1 * 256
    let z3 = bc_floor(hi / 16777216)
    let s3 = hi - z3 * 16777216
    let z2 = bc_floor(s3 / 65536)
    let s2 = s3 - z2 * 65536
    let z1 = bc_floor(s2 / 256)
    let z0 = s2 - z1 * 256
    return [y0, y1, y2, y3, z0, z1, z2, z3]

# An immediate word is written as the u32 the reference writer's cast
# produces: a negative displacement wraps around.
action bc_u32(n):
    if n < 0:
        return n + 4294967296
    return n

action bc_u16_bytes(n):
    let v = bc_u32(n)
    let b0 = v % 256
    let b1 = (v - b0) / 256
    return [b0, b1]

action bc_u32_bytes(n):
    let v = bc_u32(n)
    let b0 = v % 256
    let r0 = (v - b0) / 256
    let b1 = r0 % 256
    let r1 = (r0 - b1) / 256
    let b2 = r1 % 256
    let b3 = (r1 - b2) / 256
    return [b0, b1, b2, b3]

# The code of one ASCII character, or -1 when it is not ASCII. The table is
# 32..126 in order, so the byte is its position plus 32.
action bc_byte_of(c):
    if c == "\n":
        return 10
    if c == "\t":
        return 9
    let table = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    let n = length of table
    let i = 0
    while i < n bounded 128:
        if (table[i] otherwise "") == c:
            return 32 + i
        set i to i + 1
    return -1

action bc_text_ok(s):
    let n = length of s
    let i = 0
    let ok = 1
    while i < n bounded 100000:
        if bc_byte_of(s[i] otherwise "x") < 0:
            set ok to 0
        set i to i + 1
    return ok

action bc_text_bytes(s):
    let out = []
    let n = length of s
    let i = 0
    while i < n bounded 100000:
        let b = bc_byte_of(s[i] otherwise "x")
        if b >= 0:
            set out to out + [b]
        set i to i + 1
    return out

action bc_text_field(s):
    return bc_u32_bytes(length of s) + bc_text_bytes(s)

# A whole number as text. Both engines agree on "" + n only when the left
# side is a string, and the interpreter refuses text + number outright, so
# every message that names a line spells the number out here.
action bc_num_text(n):
    recursion bounded 32
    let v = bc_floor(n)
    if v < 0:
        return "-" + bc_num_text(0 - v)
    if v == 0:
        return "0"
    let digits = "0123456789"
    let out = ""
    let rest = v
    while rest > 0 bounded 32:
        let d = rest % 10
        set out to (digits[d] otherwise "0") + out
        set rest to (rest - d) / 10
    return out

action bc_hex_of(bytes):
    let digits = "0123456789abcdef"
    let out = ""
    for each b in bytes:
        let lo = b % 16
        let hi = (b - lo) / 16
        set out to out + (digits[hi] otherwise "0") + (digits[lo] otherwise "0")
    return out

# ── the lowering state ──────────────────────────────────────────────────
#
# A Kaze record cannot be mutated, so the compiler threads one list through
# the walk instead:
#   0 next free local slot      5 the first error ("" while the walk is clean)
#   1 lexical scopes            6 the item being lowered
#   2 the code words            7 every item in the module (call targets)
#   3 the constant pool         8 the item's ensures clauses
#   4 the capability table

action bc_set_at(lst, i, v):
    let out = []
    let k = 0
    for each x in lst:
        if k == i:
            set out to out + [v]
        otherwise:
            set out to out + [x]
        set k to k + 1
    return out

action bc_state(item_name, items_nodes, ensures, consts, caps):
    return [0, [[]], [], consts, caps, "", item_name, items_nodes, ensures]

action bc_fail(st, msg):
    if (length of (st[5] otherwise "")) > 0:
        return st
    return bc_set_at(st, 5, msg)

action bc_emit(st, op, a):
    let code = st[2] otherwise []
    return bc_set_at(st, 2, code + [op + a * 256])

action bc_wide(st, op, a, imm):
    let code = st[2] otherwise []
    let at = length of code
    return [bc_set_at(st, 2, code + [op + a * 256, bc_u32(imm)]), at]

action bc_wide1(st, op, a, imm):
    let r = bc_wide(st, op, a, imm)
    return r[0] otherwise []

action bc_mark(st):
    return length of (st[2] otherwise [])

action bc_patch(st, at):
    let code = st[2] otherwise []
    let rel = (length of code) - (at + 2)
    return bc_set_at(st, 2, bc_set_at(code, at + 1, bc_u32(rel)))

action bc_jump_back(st, head):
    let code = st[2] otherwise []
    let at = length of code
    let rel = head - (at + 2)
    return bc_set_at(st, 2, code + [20, bc_u32(rel)])

action bc_temp(st):
    let n = st[0] otherwise 0
    if n >= 255:
        return [bc_fail(st, "this block uses more than 255 values; split it into actions"), 0]
    return [bc_set_at(st, 0, n + 1), n]

action bc_push_scope(st):
    return bc_set_at(st, 1, (st[1] otherwise []) + [[]])

action bc_pop_scope(st):
    let scopes = st[1] otherwise []
    let n = length of scopes
    if n == 0:
        return st
    let out = []
    let i = 0
    while i < (n - 1) bounded 400:
        set out to out + [scopes[i] otherwise []]
        set i to i + 1
    return bc_set_at(st, 1, out)

action bc_resolve(scopes, name):
    let found = -1
    let i = (length of scopes) - 1
    while i >= 0 bounded 400:
        let scope = scopes[i] otherwise []
        let j = (length of scope) - 1
        while j >= 0 bounded 400:
            let pair = scope[j] otherwise []
            if found < 0 and (pair[0] otherwise "") == name:
                set found to pair[1] otherwise -1
            set j to j - 1
        set i to i - 1
    return found

action bc_bind(st, name):
    let t = bc_temp(st)
    let st1 = t[0] otherwise []
    let slot = t[1] otherwise 0
    let scopes = st1[1] otherwise []
    let n = length of scopes
    if n == 0:
        return [bc_set_at(st1, 1, [[[name, slot]]]), slot]
    let last = scopes[n - 1] otherwise []
    return [bc_set_at(st1, 1, bc_set_at(scopes, n - 1, last + [[name, slot]])), slot]

# Bind a name to a slot the caller already reserved (a try handler's error).
action bc_bind_named(st, name, slot):
    let scopes = st[1] otherwise []
    let n = length of scopes
    if n == 0:
        return bc_set_at(st, 1, [[[name, slot]]])
    let last = scopes[n - 1] otherwise []
    return bc_set_at(st, 1, bc_set_at(scopes, n - 1, last + [[name, slot]]))

action bc_same_bytes(a, b):
    if (length of a) != (length of b):
        return 0
    let n = length of a
    let i = 0
    let same = 1
    while i < n bounded 16:
        if (a[i] otherwise -1) != (b[i] otherwise -2):
            set same to 0
        set i to i + 1
    return same

action bc_push_num(st, val):
    let consts = st[3] otherwise []
    let n = length of consts
    let want = bc_bytes_of_num(val)
    let i = 0
    let found = -1
    while i < n bounded 20000:
        let c = consts[i] otherwise BcConst(kind: "", text: "", val: 0)
        if found < 0 and c.kind == "num":
            if bc_same_bytes(bc_bytes_of_num(c.val), want) == 1:
                set found to i
        set i to i + 1
    if found >= 0:
        return [st, found]
    return [bc_set_at(st, 3, consts + [BcConst(kind: "num", text: "", val: val)]), n]

action bc_push_text(st, text):
    if bc_text_ok(text) == 0:
        return [bc_fail(st, "a text constant holds a non-ASCII character; the minimal module writer has no UTF-8 encoder"), 0]
    let consts = st[3] otherwise []
    let n = length of consts
    let i = 0
    let found = -1
    while i < n bounded 20000:
        let c = consts[i] otherwise BcConst(kind: "", text: "", val: 0)
        if found < 0 and c.kind == "str" and c.text == text:
            set found to i
        set i to i + 1
    if found >= 0:
        return [st, found]
    return [bc_set_at(st, 3, consts + [BcConst(kind: "str", text: text, val: 0)]), n]

action bc_push_bool(st, which):
    let spelling = "false"
    if which == 1:
        set spelling to "true"
    let consts = st[3] otherwise []
    let n = length of consts
    let i = 0
    let found = -1
    while i < n bounded 20000:
        let c = consts[i] otherwise BcConst(kind: "", text: "", val: 0)
        if found < 0 and c.kind == "bool" and c.text == spelling:
            set found to i
        set i to i + 1
    if found >= 0:
        return [st, found]
    return [bc_set_at(st, 3, consts + [BcConst(kind: "bool", text: spelling, val: 0)]), n]

action bc_push_cap(st, family, op, argc):
    let caps = st[4] otherwise []
    let n = length of caps
    let i = 0
    let found = -1
    while i < n bounded 20000:
        let c = caps[i] otherwise BcCap(family: "", op: "", argc: 0)
        if found < 0 and c.family == family and c.op == op and c.argc == argc:
            set found to i
        set i to i + 1
    if found >= 0:
        return [st, found]
    return [bc_set_at(st, 4, caps + [BcCap(family: family, op: op, argc: argc)]), n]

# ── names ───────────────────────────────────────────────────────────────

action bc_take_chars(s, k):
    let out = ""
    let i = 0
    while i < k bounded 256:
        set out to out + (s[i] otherwise "")
        set i to i + 1
    return out

action bc_from_char(s, k):
    let out = ""
    let n = length of s
    let i = k
    while i < n bounded 256:
        set out to out + (s[i] otherwise "")
        set i to i + 1
    return out

action bc_head(s):
    let n = length of s
    let i = 0
    while i < n bounded 256:
        if (s[i] otherwise "") == ".":
            return bc_take_chars(s, i)
        set i to i + 1
    return s

action bc_tail(s):
    let n = length of s
    let i = 0
    while i < n bounded 256:
        if (s[i] otherwise "") == ".":
            return bc_from_char(s, i + 1)
        set i to i + 1
    return ""

action bc_item_index(items, name):
    let n = length of items
    let i = 0
    let found = -1
    while i < n bounded 5000:
        let it = items[i] otherwise none_node()
        if found < 0 and it.name == name:
            set found to i
        set i to i + 1
    return found

# ── units ───────────────────────────────────────────────────────────────

# The multiplier into the dimension's base unit, as ast.rs's Unit::scale:
# the reference engine normalises at parse time, and a constant only matches
# its bytes if this walk does the same.
action bc_unit_scale(u):
    if u == "km":
        return 1000
    if u == "cm":
        return 0.01
    if u == "mm":
        return 0.001
    if u == "km/h":
        return 1000 / 3600
    if u == "radians":
        return 180 / 3.141592653589793
    if u == "hours":
        return 3600
    if u == "minutes":
        return 60
    if u == "ms":
        return 0.001
    if u == "gram":
        return 0.001
    if u == "mbar":
        return 100
    if u == "hPa":
        return 100
    return 1

# Only Celsius has a zero that is not the dimension's zero.
action bc_unit_offset(u):
    if u == "Celsius":
        return 273.15
    return 0

# ── expressions ─────────────────────────────────────────────────────────

action bc_bin_op(op):
    if op == "+":
        return 7
    if op == "-":
        return 8
    if op == "*":
        return 9
    if op == "/":
        return 10
    if op == "%":
        return 11
    if op == "<":
        return 13
    if op == "<=":
        return 14
    if op == ">":
        return 15
    if op == ">=":
        return 16
    if op == "==":
        return 17
    if op == "!=":
        return 18
    return 6

action bc_math_op(name):
    if name == "sin":
        return 37
    if name == "cos":
        return 38
    if name == "atan2":
        return 39
    return 40

action bc_has_named(args):
    let found = 0
    for each a in args:
        if a.kind == "NAMED_ARG":
            set found to 1
    return found

action bc_named_arg(args, name):
    let out = none_node()
    let found = 0
    for each a in args:
        if found == 0 and a.kind == "NAMED_ARG" and a.name == name:
            set out to bc_kid(a, 0)
            set found to 1
    return out

action bc_kid(n: AstNode, i):
    return child_at(n, i)

action bc_expr_args(st, args):
    recursion bounded 200
    let st1 = st
    for each a in args:
        if a.kind == "NAMED_ARG":
            set st1 to bc_expr(st1, bc_kid(a, 0), 0)
        otherwise:
            set st1 to bc_expr(st1, a, 0)
    return st1

action bc_trig_args(st, args, target):
    recursion bounded 200
    let st1 = st
    let i = 0
    let n = length of args
    while i < n bounded 256:
        let a = args[i] otherwise none_node()
        set st1 to bc_expr(st1, a, 0)
        if i == 0 and (target == "sin" or target == "cos"):
            if a.kind == "NUM" and (a.name == "degrees" or a.name == "radians"):
                set st1 to bc_emit(st1, 41, 0)
        set i to i + 1
    return st1

action bc_link_lost(st, e: AstNode):
    let args = e.children
    if (length of args) == 0:
        return bc_fail(st, "line " + bc_num_text(e.line) + ": link lost needs a time, e.g. 'link lost for 3 seconds'")
    let a = args[0] otherwise none_node()
    if a.kind != "NUM":
        return bc_fail(st, "line " + bc_num_text(e.line) + ": link lost needs a time literal, e.g. 'link lost for 3 seconds'")
    let ms = (bc_num_of(a.val_str) * bc_unit_scale(a.name)) * 1000
    if ms < 1 or ms > 4294967295:
        return bc_fail(st, "line " + bc_num_text(e.line) + ": link lost needs at least 1 millisecond (and less than about 49 days)")
    return bc_wide1(st, 46, 0, bc_floor(ms))

action bc_record_init(st, e: AstNode):
    recursion bounded 200
    let items = st[7] otherwise []
    let target = bc_item_index(items, e.name)
    if target < 0:
        return bc_fail(st, "line " + bc_num_text(e.line) + ": record '" + e.name + "' is not defined in this module")
    let item = items[target] otherwise none_node()
    if item.kind != "RECORD":
        return bc_fail(st, "line " + bc_num_text(e.line) + ": '" + e.name + "' is not a record")
    let fields = item.children
    let st1 = st
    for each f in fields:
        let arg = bc_named_arg(e.children, f.name)
        if arg.kind == "NONE":
            set st1 to bc_fail(st1, "line " + bc_num_text(e.line) + ": missing field '" + f.name + "' in instantiation of record '" + e.name + "'")
        otherwise:
            let r = bc_push_text(st1, f.name)
            let st2 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
            set st1 to bc_expr(st2, arg, 0)
    return bc_emit(st1, 48, length of fields)

action bc_call(st, e: AstNode, root):
    recursion bounded 200
    let target = e.name
    let args = e.children
    if (length of args) > 255:
        return bc_fail(st, "line " + bc_num_text(e.line) + ": '" + target + "' takes too many values")
    if target == "link_lost":
        return bc_link_lost(st, e)
    if target == "vector":
        let st1 = bc_expr_args(st, args)
        return bc_emit(st1, 33, length of args)
    if target == "sin" or target == "cos" or target == "sqrt" or target == "atan2":
        let st1 = bc_trig_args(st, args, target)
        return bc_emit(st1, bc_math_op(target), 0)
    if target == "geo.distance":
        let st1 = bc_expr_args(st, args)
        return bc_emit(st1, 34, 0)
    if target == "geo.slant_distance":
        let st1 = bc_expr_args(st, args)
        return bc_emit(st1, 43, 0)
    if target == "geo.bearing_of":
        let st1 = bc_expr_args(st, args)
        return bc_emit(st1, 35, 0)
    if target == "geo.bearing_from":
        let st1 = bc_expr_args(st, args)
        return bc_emit(st1, 36, 0)
    if (length of bc_tail(target)) > 0:
        let family = family_of_word(bc_head(target))
        let op = bc_tail(target)
        let st1 = bc_expr_args(st, args)
        let c = bc_push_cap(st1, family, op, length of args)
        return bc_wide1(c[0] otherwise [], 22, length of args, c[1] otherwise 0)
    if bc_has_named(args) == 1:
        return bc_record_init(st, e)
    let idx = bc_item_index(st[7] otherwise [], target)
    if idx < 0:
        return bc_fail(st, "line " + bc_num_text(e.line) + ": '" + target + "' is not defined in this module")
    let st1 = bc_expr_args(st, args)
    return bc_wide1(st1, 47, length of args, idx)

action bc_expr(st, e: AstNode, root):
    recursion bounded 200
    let k = e.kind
    if k == "NUM":
        let val = bc_num_of(e.val_str) * bc_unit_scale(e.name) + bc_unit_offset(e.name)
        let r = bc_push_num(st, val)
        return bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
    if k == "STR":
        let r = bc_push_text(st, e.val_str)
        return bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
    if k == "BOOL":
        let which = 0
        if e.val_str == "true":
            set which to 1
        let r = bc_push_bool(st, which)
        return bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
    if k == "LIST":
        let items = e.children
        let n = length of items
        if n > 255:
            return bc_fail(st, "line " + bc_num_text(e.line) + ": this list has more than 255 items")
        let st1 = st
        for each it in items:
            set st1 to bc_expr(st1, it, 0)
        return bc_emit(st1, 3, n)
    if k == "IDENT":
        let slot = bc_resolve(st[1] otherwise [], e.name)
        if slot < 0:
            return bc_fail(st, "line " + bc_num_text(e.line) + ": '" + e.name + "' is not defined in '" + (st[6] otherwise "") + "'")
        return bc_emit(st, 1, slot)
    if k == "LEN":
        let st1 = bc_expr(st, bc_kid(e, 0), 0)
        return bc_emit(st1, 5, 0)
    if k == "LEN_LIT":
        let r = bc_push_num(st, e.val_num)
        return bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
    if k == "INDEX":
        let st1 = bc_expr(st, bc_kid(e, 0), 0)
        let st2 = bc_expr(st1, bc_kid(e, 1), 0)
        return bc_emit(st2, 4, 0)
    if k == "FIELD":
        let base = bc_kid(e, 0)
        if base.kind != "IDENT":
            return bc_fail(st, "line " + bc_num_text(e.line) + ": a field is read from a name, not from another expression")
        let slot = bc_resolve(st[1] otherwise [], base.name)
        if slot < 0:
            return bc_fail(st, "line " + bc_num_text(e.line) + ": '" + base.name + "' is not a value here")
        let st1 = bc_emit(st, 1, slot)
        let r = bc_push_text(st1, e.name)
        let st2 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        return bc_emit(st2, 30, 0)
    if k == "BIN":
        return bc_bin(st, e, root)
    if k == "FALLBACK":
        return bc_fallback(st, bc_kid(e, 0), bc_kid(e, 1), e.line, root)
    if k == "IN_UNIT":
        let st1 = bc_expr(st, bc_kid(e, 0), 0)
        if e.name == "radians":
            return bc_emit(st1, 41, 0)
        return bc_emit(st1, 42, 0)
    if k == "CALL":
        return bc_call(st, e, root)
    return bc_fail(st, "line " + bc_num_text(e.line) + ": the parser could not read this expression")

action bc_bin(st, e: AstNode, root):
    recursion bounded 200
    let op = e.name
    if op == "not":
        let st1 = bc_expr(st, bc_kid(e, 0), 0)
        return bc_emit(st1, 19, 0)
    if op == "and":
        let st1 = bc_expr(st, bc_kid(e, 0), 0)
        let to_false = bc_wide(st1, 21, 0, 0)
        let st2 = bc_expr(to_false[0] otherwise [], bc_kid(e, 1), 0)
        let to_end = bc_wide(st2, 20, 0, 0)
        let st3 = bc_patch(to_end[0] otherwise [], to_false[1] otherwise 0)
        let r = bc_push_bool(st3, 0)
        let st4 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        return bc_patch(st4, to_end[1] otherwise 0)
    if op == "or":
        let st1 = bc_expr(st, bc_kid(e, 0), 0)
        let to_rhs = bc_wide(st1, 21, 0, 0)
        let r = bc_push_bool(to_rhs[0] otherwise [], 1)
        let st2 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        let to_end = bc_wide(st2, 20, 0, 0)
        let st3 = bc_patch(to_end[0] otherwise [], to_rhs[1] otherwise 0)
        let st4 = bc_expr(st3, bc_kid(e, 1), 0)
        return bc_patch(st4, to_end[1] otherwise 0)
    let st1 = bc_expr(st, bc_kid(e, 0), 0)
    let st2 = bc_expr(st1, bc_kid(e, 1), 0)
    return bc_emit(st2, bc_bin_op(op), 0)

# <inner> otherwise <fallback>, lowered with the opcodes that exist: a
# divisor test, a bounds test, or a try frame around a capability call.
# Anything the checker proved safe gets no test at all.
action bc_fallback(st, inner: AstNode, fb: AstNode, line, root):
    recursion bounded 200
    let k = inner.kind
    if k == "BIN" and (inner.name == "/" or inner.name == "%"):
        let right = bc_kid(inner, 1)
        if right.kind == "NUM" and bc_num_of(right.val_str) != 0:
            return bc_expr(st, inner, root)
        let t = bc_temp(st)
        let st1 = bc_expr(t[0] otherwise [], right, 0)
        let divisor = t[1] otherwise 0
        let st2 = bc_emit(st1, 2, divisor)
        let st3 = bc_emit(st2, 1, divisor)
        let r = bc_push_num(st3, 0)
        let st4 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        let to_fb = bc_wide(st4, 31, 0, 0)
        let st5 = bc_expr(to_fb[0] otherwise [], bc_kid(inner, 0), 0)
        let st6 = bc_emit(st5, 1, divisor)
        let op = 10
        if inner.name == "%":
            set op to 11
        let st7 = bc_emit(st6, op, 0)
        let to_end = bc_wide(st7, 20, 0, 0)
        let st8 = bc_patch(to_end[0] otherwise [], to_fb[1] otherwise 0)
        let st9 = bc_expr(st8, fb, 0)
        return bc_patch(st9, to_end[1] otherwise 0)
    if k == "INDEX":
        let c = bc_temp(st)
        let i = bc_temp(c[0] otherwise [])
        let coll_slot = c[1] otherwise 0
        let idx_slot = i[1] otherwise 0
        let st1 = bc_expr(i[0] otherwise [], bc_kid(inner, 0), 0)
        let st2 = bc_emit(st1, 2, coll_slot)
        let st3 = bc_expr(st2, bc_kid(inner, 1), 0)
        let st4 = bc_emit(st3, 2, idx_slot)
        let st5 = bc_emit(st4, 1, idx_slot)
        let r = bc_push_num(st5, 0)
        let st6 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        let st7 = bc_emit(st6, 13, 0)
        let too_low = bc_wide(st7, 29, 0, 0)
        let st8 = bc_emit(too_low[0] otherwise [], 1, idx_slot)
        let st9 = bc_emit(st8, 1, coll_slot)
        let st10 = bc_emit(st9, 5, 0)
        let st11 = bc_emit(st10, 16, 0)
        let too_high = bc_wide(st11, 29, 0, 0)
        let st12 = bc_emit(too_high[0] otherwise [], 1, coll_slot)
        let st13 = bc_emit(st12, 1, idx_slot)
        let st14 = bc_emit(st13, 4, 0)
        let to_end = bc_wide(st14, 20, 0, 0)
        let st15 = bc_patch(to_end[0] otherwise [], too_low[1] otherwise 0)
        let st16 = bc_patch(st15, too_high[1] otherwise 0)
        let st17 = bc_expr(st16, fb, 0)
        return bc_patch(st17, to_end[1] otherwise 0)
    if k == "CALL":
        if root == 0:
            return bc_fail(st, "line " + line + ": a capability fallback must be the whole value of its statement; give it a 'let' of its own (or wrap the statement in 'try:')")
        let h = bc_wide(st, 44, 255, 0)
        let st1 = bc_expr(h[0] otherwise [], inner, 0)
        let st2 = bc_emit(st1, 45, 0)
        let to_end = bc_wide(st2, 20, 0, 0)
        let st3 = bc_patch(to_end[0] otherwise [], h[1] otherwise 0)
        let st4 = bc_expr(st3, fb, 0)
        return bc_patch(st4, to_end[1] otherwise 0)
    return bc_expr(st, inner, root)

# Branch when cond is false. a == b and a != b fuse into one
# compare-and-branch instruction, the same lowering the reference emits.
action bc_jump_if_false(st, cond: AstNode):
    if cond.kind == "BIN" and cond.name == "==":
        let st1 = bc_expr(st, bc_kid(cond, 0), 0)
        let st2 = bc_expr(st1, bc_kid(cond, 1), 0)
        return bc_wide(st2, 32, 0, 0)
    if cond.kind == "BIN" and cond.name == "!=":
        let st1 = bc_expr(st, bc_kid(cond, 0), 0)
        let st2 = bc_expr(st1, bc_kid(cond, 1), 0)
        return bc_wide(st2, 31, 0, 0)
    let st3 = bc_expr(st, cond, 1)
    return bc_wide(st3, 21, 0, 0)

# ── statements ──────────────────────────────────────────────────────────

action bc_stmts(st, block: AstNode):
    recursion bounded 200
    let st1 = bc_push_scope(st)
    let st2 = st1
    for each s in block.children:
        set st2 to bc_stmt(st2, s)
    return bc_pop_scope(st2)

action bc_stmt(st, s: AstNode):
    recursion bounded 200
    let k = s.kind
    if k == "LET":
        let st1 = bc_expr(st, bc_kid(s, 0), 1)
        let b = bc_bind(st1, s.name)
        return bc_emit(b[0] otherwise [], 2, b[1] otherwise 0)
    if k == "SET":
        let st1 = bc_expr(st, bc_kid(s, 0), 1)
        let slot = bc_resolve(st1[1] otherwise [], s.name)
        if slot < 0:
            return bc_fail(st1, "line " + bc_num_text(s.line) + ": '" + s.name + "' is not defined")
        return bc_emit(st1, 2, slot)
    if k == "EXPR":
        let e = bc_kid(s, 0)
        let st1 = bc_expr(st, e, 1)
        if e.kind == "CALL" and (e.name == "policy.allow" or e.name == "policy.reject"):
            return bc_emit(st1, 23, 0)
        return bc_emit(st1, 6, 0)
    if k == "IF":
        let j = bc_jump_if_false(st, bc_kid(s, 0))
        let st1 = bc_stmts(j[0] otherwise [], bc_kid(s, 1))
        let other = bc_kid(s, 2)
        if (length of other.children) == 0:
            return bc_patch(st1, j[1] otherwise 0)
        let to_end = bc_wide(st1, 20, 0, 0)
        let st2 = bc_patch(to_end[0] otherwise [], j[1] otherwise 0)
        let st3 = bc_stmts(st2, other)
        return bc_patch(st3, to_end[1] otherwise 0)
    if k == "WHILE":
        return bc_while(st, s)
    if k == "FOR_EACH":
        return bc_for_each(st, s)
    if k == "TRY":
        return bc_try(st, s)
    if k == "GUARD":
        let st1 = bc_expr(st, bc_kid(s, 0), 1)
        let held = bc_wide(st1, 29, 0, 0)
        let r = bc_push_text(held[0] otherwise [], "E_KAZE_GUARD: the invariant at line " + bc_num_text(s.line) + " is false")
        let st2 = bc_wide1(r[0] otherwise [], 27, 0, r[1] otherwise 0)
        return bc_patch(st2, held[1] otherwise 0)
    if k == "RETURN":
        return bc_return(st, s)
    return bc_fail(st, "line " + bc_num_text(s.line) + ": " + k + " is not lowered by the minimal bytecode writer")

action bc_while(st, s: AstNode):
    recursion bounded 200
    let cond = bc_kid(s, 0)
    let body = bc_kid(s, 1)
    let bound_node = bc_kid(s, 2)
    let bound_text = bound_node.val_str
    let limited = 1
    if bound_text == "" or bound_text == "?":
        set limited to 0
    let st1 = st
    let counter = -1
    if limited == 1:
        let t = bc_temp(st1)
        set st1 to t[0] otherwise []
        set counter to t[1] otherwise 0
        let r = bc_push_num(st1, 0)
        let st2 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        set st1 to bc_emit(st2, 2, counter)
    let head = bc_mark(st1)
    set st1 to bc_wide1(st1, 26, 0, s.line)
    let to_trap = -1
    if limited == 1:
        let st2 = bc_emit(st1, 1, counter)
        let r = bc_push_num(st2, bc_num_of(bound_text))
        let st3 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        let st4 = bc_emit(st3, 16, 0)
        let j = bc_wide(st4, 29, 0, 0)
        set st1 to j[0] otherwise []
        set to_trap to j[1] otherwise 0
    let jf = bc_jump_if_false(st1, cond)
    let to_end = jf[1] otherwise 0
    let st5 = jf[0] otherwise []
    for each b in body.children:
        set st5 to bc_stmt(st5, b)
    let st6 = st5
    if limited == 1:
        let st7 = bc_emit(st6, 1, counter)
        let r = bc_push_num(st7, 1)
        let st8 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
        let st9 = bc_emit(st8, 7, 0)
        set st6 to bc_emit(st9, 2, counter)
    let st10 = bc_jump_back(st6, head)
    if limited == 0:
        return bc_patch(st10, to_end)
    let over = bc_wide(st10, 20, 0, 0)
    let st11 = bc_patch(over[0] otherwise [], to_trap)
    let r = bc_push_text(st11, "E_KAZE_LOOP_BOUND: the loop at line " + bc_num_text(s.line) + " ran past its declared bound of " + bound_text + " iterations")
    let st12 = bc_wide1(r[0] otherwise [], 27, 0, r[1] otherwise 0)
    let st13 = bc_emit(st12, 25, 0)
    let st14 = bc_patch(st13, over[1] otherwise 0)
    return bc_patch(st14, to_end)

action bc_for_each(st, s: AstNode):
    recursion bounded 200
    let st1 = bc_expr(st, bc_kid(s, 0), 0)
    let t1 = bc_temp(st1)
    let list_slot = t1[1] otherwise 0
    let st2 = bc_emit(t1[0] otherwise [], 2, list_slot)
    let r0 = bc_push_num(st2, 0)
    let st3 = bc_wide1(r0[0] otherwise [], 0, 0, r0[1] otherwise 0)
    let t2 = bc_temp(st3)
    let idx_slot = t2[1] otherwise 0
    let st4 = bc_emit(t2[0] otherwise [], 2, idx_slot)
    let head = bc_mark(st4)
    let st5 = bc_wide1(st4, 26, 0, s.line)
    let st6 = bc_emit(st5, 1, list_slot)
    let st7 = bc_emit(st6, 5, 0)
    let st8 = bc_emit(st7, 1, idx_slot)
    let st9 = bc_emit(st8, 14, 0)
    let j = bc_wide(st9, 29, 0, 0)
    let st10 = bc_push_scope(j[0] otherwise [])
    let b = bc_bind(st10, s.name)
    let st11 = bc_emit(b[0] otherwise [], 1, list_slot)
    let st12 = bc_emit(st11, 1, idx_slot)
    let st13 = bc_emit(st12, 4, 0)
    let st14 = bc_emit(st13, 2, b[1] otherwise 0)
    let st15 = st14
    let body_block = bc_kid(s, 1)
    for each x in body_block.children:
        set st15 to bc_stmt(st15, x)
    let st16 = bc_pop_scope(st15)
    let st17 = bc_emit(st16, 1, idx_slot)
    let r1 = bc_push_num(st17, 1)
    let st18 = bc_wide1(r1[0] otherwise [], 0, 0, r1[1] otherwise 0)
    let st19 = bc_emit(st18, 7, 0)
    let st20 = bc_emit(st19, 2, idx_slot)
    let st21 = bc_jump_back(st20, head)
    return bc_patch(st21, j[1] otherwise 0)

action bc_try(st, s: AstNode):
    recursion bounded 200
    let err = s.name
    let st1 = st
    let slot = 255
    if (length of err) > 0:
        let t = bc_temp(st1)
        set st1 to t[0] otherwise []
        set slot to t[1] otherwise 0
    let h = bc_wide(st1, 44, slot, 0)
    let st2 = bc_stmts(h[0] otherwise [], bc_kid(s, 0))
    let st3 = bc_emit(st2, 45, 0)
    let to_end = bc_wide(st3, 20, 0, 0)
    let st4 = bc_patch(to_end[0] otherwise [], h[1] otherwise 0)
    let st5 = bc_push_scope(st4)
    let st6 = st5
    if (length of err) > 0:
        set st6 to bc_bind_named(st5, err, slot)
    let st7 = bc_stmts(st6, bc_kid(s, 1))
    let st8 = bc_pop_scope(st7)
    return bc_patch(st8, to_end[1] otherwise 0)

action bc_return(st, s: AstNode):
    if (length of s.children) == 0:
        return bc_emit(st, 25, 0)
    let t = bc_temp(st)
    let st1 = bc_expr(t[0] otherwise [], bc_kid(s, 0), 1)
    let slot = t[1] otherwise 0
    let st2 = bc_emit(st1, 2, slot)
    let st3 = bc_exit_assertions(st2, slot)
    let st4 = bc_emit(st3, 1, slot)
    return bc_emit(st4, 24, 0)

action bc_entry_assertions(st, contracts):
    let st1 = st
    for each c in contracts:
        if c.kind == "CONTRACT" and c.name == "requires":
            let st2 = bc_expr(st1, bc_kid(c, 0), 1)
            let held = bc_wide(st2, 29, 0, 0)
            let r = bc_push_text(held[0] otherwise [], "E_KAZE_CONTRACT: the requires clause at line " + bc_num_text(c.line) + " is false for these arguments")
            let st3 = bc_wide1(r[0] otherwise [], 27, 0, r[1] otherwise 0)
            set st1 to bc_patch(st3, held[1] otherwise 0)
    return st1

action bc_exit_assertions(st, slot):
    let st1 = st
    for each c in (st[8] otherwise []):
        if c.kind == "CONTRACT" and c.name == "ensures":
            let st2 = bc_push_scope(st1)
            let st3 = bc_bind_named(st2, "result", slot)
            let st4 = bc_expr(st3, bc_kid(c, 0), 1)
            let st5 = bc_pop_scope(st4)
            let held = bc_wide(st5, 29, 0, 0)
            let r = bc_push_text(held[0] otherwise [], "E_KAZE_CONTRACT: the ensures clause at line " + bc_num_text(c.line) + " is false for this result")
            let st6 = bc_wide1(r[0] otherwise [], 27, 0, r[1] otherwise 0)
            set st1 to bc_patch(st6, held[1] otherwise 0)
    return st1

# ── items ───────────────────────────────────────────────────────────────

# The loader numbers hooks across the whole module so two files cannot both
# define when#1; the parser's per-file spelling never reaches a module.
action bc_hook_name(kind, serial):
    if kind == "WHEN":
        return "when-" + bc_num_text(serial)
    return "every-" + bc_num_text(serial)

action bc_tag_of(kind):
    if kind == "CHECK":
        return 1
    if kind == "FILTER":
        return 2
    if kind == "WHEN":
        return 3
    if kind == "EVERY":
        return 4
    return 0

action bc_period_of(item: AstNode):
    if item.kind != "EVERY":
        return 0
    let d = bc_kid(item, 0)
    if d.kind != "NUM":
        return 0
    return (bc_num_of(d.val_str) * bc_unit_scale(d.name)) * 1000

action bc_is_routine_kind(kind):
    if kind == "ACTION" or kind == "CHECK" or kind == "FILTER":
        return 1
    return 0

# ── contract elision ────────────────────────────────────────────────────
#
# A requires clause is only worth a runtime check when some call site cannot be
# proved. This is the reference rule: every call passes numeric literals and
# every clause folds true, so the entry assertions are dead code and vanish.

# [known, value]: known 0 means "the walk could not decide".
action bc_eval_num(e: AstNode, env):
    recursion bounded 200
    let k = e.kind
    if k == "NUM":
        return [1, bc_num_of(e.val_str) * bc_unit_scale(e.name) + bc_unit_offset(e.name)]
    if k == "IDENT":
        let i = 0
        let n = length of env
        while i < n bounded 64:
            let pair = env[i] otherwise ["", 0]
            if (pair[0] otherwise "") == e.name:
                return [1, pair[1] otherwise 0]
            set i to i + 1
        return [0, 0]
    if k == "BIN":
        let op = e.name
        if op == "+" or op == "-" or op == "*" or op == "/" or op == "%":
            let l = bc_eval_num(bc_kid(e, 0), env)
            let r = bc_eval_num(bc_kid(e, 1), env)
            if (l[0] otherwise 0) == 0 or (r[0] otherwise 0) == 0:
                return [0, 0]
            let a = l[1] otherwise 0
            let b = r[1] otherwise 0
            if op == "+":
                return [1, a + b]
            if op == "-":
                return [1, a - b]
            if op == "*":
                return [1, a * b]
            if b == 0:
                return [0, 0]
            if op == "/":
                return [1, a / b otherwise 0]
            return [1, a % b otherwise 0]
    return [0, 0]

action bc_eval_clause(e: AstNode, env):
    recursion bounded 200
    let k = e.kind
    if k == "BOOL":
        let v = 0
        if e.val_str == "true":
            set v to 1
        return [1, v]
    if k == "BIN" and e.name == "not":
        let r = bc_eval_clause(bc_kid(e, 0), env)
        if (r[0] otherwise 0) == 0:
            return [0, 0]
        return [1, 1 - (r[1] otherwise 0)]
    if k == "BIN" and (e.name == "and" or e.name == "or"):
        let l = bc_eval_clause(bc_kid(e, 0), env)
        let r = bc_eval_clause(bc_kid(e, 1), env)
        if (l[0] otherwise 0) == 0 or (r[0] otherwise 0) == 0:
            return [0, 0]
        let a = l[1] otherwise 0
        let b = r[1] otherwise 0
        if e.name == "and":
            if a == 1 and b == 1:
                return [1, 1]
            return [1, 0]
        if a == 1 or b == 1:
            return [1, 1]
        return [1, 0]
    if k == "BIN" and (e.name == "<" or e.name == "<=" or e.name == ">" or e.name == ">=" or e.name == "==" or e.name == "!="):
        let l = bc_eval_num(bc_kid(e, 0), env)
        let r = bc_eval_num(bc_kid(e, 1), env)
        if (l[0] otherwise 0) == 0 or (r[0] otherwise 0) == 0:
            return [0, 0]
        let a = l[1] otherwise 0
        let b = r[1] otherwise 0
        if e.name == "<":
            if a < b:
                return [1, 1]
            return [1, 0]
        if e.name == "<=":
            if a <= b:
                return [1, 1]
            return [1, 0]
        if e.name == ">":
            if a > b:
                return [1, 1]
            return [1, 0]
        if e.name == ">=":
            if a >= b:
                return [1, 1]
            return [1, 0]
        if e.name == "==":
            if a == b:
                return [1, 1]
            return [1, 0]
        if a != b:
            return [1, 1]
        return [1, 0]
    return [0, 0]

# Does one call site pass values that provably satisfy every clause?
action bc_proves_call(callee: AstNode, args):
    let params_node = bc_kid(callee, 0)
    let params = params_node.children
    if (length of params) != (length of args):
        return 0
    let env = []
    let i = 0
    while i < (length of params) bounded 64:
        let p = params[i] otherwise none_node()
        let a = args[i] otherwise none_node()
        if a.kind != "NUM":
            return 0
        set env to env + [[p.name, bc_num_of(a.val_str) * bc_unit_scale(a.name) + bc_unit_offset(a.name)]]
        set i to i + 1
    let cnode = bc_kid(callee, 1)
    for each c in cnode.children:
        if c.kind == "CONTRACT" and c.name == "requires":
            let r = bc_eval_clause(bc_kid(c, 0), env)
            if (r[0] otherwise 0) == 0 or (r[1] otherwise 0) != 1:
                return 0
    return 1

action bc_walk_calls_expr(e: AstNode, callee: AstNode, sites, proved):
    recursion bounded 200
    let s = sites
    let p = proved
    if e.kind == "CALL" and bc_has_named(e.children) == 0:
        if (length of bc_tail(e.name)) == 0 and e.name == callee.name:
            set s to s + 1
            if bc_proves_call(callee, e.children) == 0:
                set p to 0
    for each c in e.children:
        let r = bc_walk_calls_expr(c, callee, s, p)
        set s to r[0] otherwise 0
        set p to r[1] otherwise 1
    return [s, p]

action bc_walk_calls(stmts, callee: AstNode, sites, proved):
    recursion bounded 200
    let s = sites
    let p = proved
    for each st in stmts:
        for each c in st.children:
            if c.kind == "BLOCK":
                let r = bc_walk_calls(c.children, callee, s, p)
                set s to r[0] otherwise 0
                set p to r[1] otherwise 1
            otherwise:
                let r2 = bc_walk_calls_expr(c, callee, s, p)
                set s to r2[0] otherwise 0
                set p to r2[1] otherwise 1
    return [s, p]

action bc_body_of(item: AstNode):
    if bc_is_routine_kind(item.kind) == 1:
        let body = bc_kid(item, 2)
        return body.children
    if item.kind == "WHEN" or item.kind == "EVERY":
        let hook_body = bc_kid(item, 1)
        return hook_body.children
    return []

action bc_requires_proved(items, item: AstNode):
    let cnode = bc_kid(item, 1)
    let asked = 0
    for each c in cnode.children:
        if c.kind == "CONTRACT" and c.name == "requires":
            set asked to 1
    if asked == 0:
        return 1
    let s = 0
    let p = 1
    for each caller in items:
        let body = bc_body_of(caller)
        let r = bc_walk_calls(body, item, s, p)
        set s to r[0] otherwise 0
        set p to r[1] otherwise 1
    if s > 0 and p == 1:
        return 1
    return 0

action bc_item(st, item: AstNode, items_nodes):
    let kind = item.kind
    if kind == "RECORD":
        let fields = item.children
        let st1 = st
        let i = 0
        while i < (length of fields) bounded 256:
            let f = fields[i] otherwise none_node()
            let r = bc_push_text(st1, f.name)
            let st2 = bc_wide1(r[0] otherwise [], 0, 0, r[1] otherwise 0)
            set st1 to bc_emit(st2, 1, i)
            set i to i + 1
        let st3 = bc_emit(st1, 48, length of fields)
        return bc_emit(st3, 24, 0)
    if kind == "WHEN":
        let st1 = bc_expr(st, bc_kid(item, 0), 0)
        let skip = bc_wide(st1, 21, 0, 0)
        let st2 = bc_stmts(skip[0] otherwise [], bc_kid(item, 1))
        let st3 = bc_emit(st2, 25, 0)
        let st4 = bc_patch(st3, skip[1] otherwise 0)
        return bc_emit(st4, 25, 0)
    if kind == "EVERY":
        let st1 = bc_stmts(st, bc_kid(item, 1))
        return bc_emit(st1, 25, 0)
    let st1 = st
    let params_node = bc_kid(item, 0)
    for each p in params_node.children:
        let b = bc_bind(st1, p.name)
        set st1 to b[0] otherwise []
    let cnode = bc_kid(item, 1)
    let st2 = st1
    if bc_requires_proved(st1[7] otherwise [], item) == 0:
        set st2 to bc_entry_assertions(st1, cnode.children)
    let st3 = bc_stmts(st2, bc_kid(item, 2))
    return bc_emit(st3, 25, 0)

# ── the module ──────────────────────────────────────────────────────────

action bc_module(prog: AstNode):
    let uses = program_uses(prog)
    if (length of uses.children) > 0:
        return ["this file imports another module with 'use'; the pure-Kaze writer compiles one file — inline the import or leave the module to the reference engine", []]
    let needs = []
    let needs_node = program_needs(prog)
    for each nd in needs_node.children:
        set needs to needs + [nd.name]
    let items_nodes = program_items(prog)
    let consts = []
    let caps = []
    let out = []
    let hooks = 0
    for each item in items_nodes:
        let kind = item.kind
        let contracts = []
        let params = []
        if kind == "RECORD":
            for each f in item.children:
                set params to params + [f.name]
        if bc_is_routine_kind(kind) == 1:
            let cnode = bc_kid(item, 1)
            set contracts to cnode.children
            let params_node = bc_kid(item, 0)
            for each p in params_node.children:
                set params to params + [p.name]
        let st = bc_state(item.name, items_nodes, contracts, consts, caps)
        let st1 = bc_item(st, item, items_nodes)
        if (length of (st1[5] otherwise "")) > 0:
            return [st1[5] otherwise "", []]
        set consts to st1[3] otherwise []
        set caps to st1[4] otherwise []
        let slots = st1[0] otherwise 0
        if (length of params) > slots:
            set slots to length of params
        let bound = 0
        let i = 0
        while i < (length of contracts) bounded 64:
            let c = contracts[i] otherwise none_node()
            if c.kind == "RECURSION_BOUND":
                set bound to bc_num_of(c.val_str)
            set i to i + 1
        let code = st1[2] otherwise []
        let label = item.name
        if kind == "WHEN" or kind == "EVERY":
            set hooks to hooks + 1
            set label to bc_hook_name(kind, hooks)
        set out to out + [BcItem(name: label, tag: bc_tag_of(kind), params: params, code: code, line: item.line, period: bc_period_of(item), slots: slots, bound: bound)]
    return ["", bc_serialize(needs, consts, caps, out)]

action bc_serialize(needs, consts, caps, items):
    let out = [75, 65, 90, 69, 66, 67, 49, 0]
    set out to out + bc_u16_bytes(5)
    set out to out + bc_text_field("")
    set out to out + bc_u32_bytes(length of needs)
    for each nm in needs:
        set out to out + bc_text_field(nm)
    set out to out + bc_u32_bytes(length of consts)
    for each c in consts:
        if c.kind == "num":
            set out to out + [0] + bc_bytes_of_num(c.val)
        otherwise:
            if c.kind == "str":
                set out to out + [1] + bc_text_field(c.text)
            otherwise:
                let bv = 0
                if c.text == "true":
                    set bv to 1
                set out to out + [2, bv]
    set out to out + bc_u32_bytes(length of caps)
    for each c in caps:
        set out to out + bc_text_field(c.family) + bc_text_field(c.op) + [c.argc]
    set out to out + bc_u32_bytes(length of items)
    for each it in items:
        set out to out + [it.tag] + bc_bytes_of_num(it.period) + bc_u32_bytes(it.line) + [it.slots] + bc_u16_bytes(it.bound)
        set out to out + bc_text_field(it.name) + bc_text_field("")
        set out to out + bc_u32_bytes(length of it.params)
        for each p in it.params:
            set out to out + bc_text_field(p)
        set out to out + bc_u32_bytes(length of it.code)
        for each w in it.code:
            set out to out + bc_u32_bytes(w)
    return out

# The self-hosted parser recovers from a syntax error into an UNKNOWN node
# instead of failing, so a module must not be written for a tree that holds
# one: the reference engine refuses the file outright.
action bc_first_unknown(n: AstNode):
    recursion bounded 200
    if n.kind == "UNKNOWN":
        return bc_num_text(n.line)
    for each c in n.children:
        let r = bc_first_unknown(c)
        if (length of r) > 0:
            return r
    return ""

# The compile command: parse, check, and print the module as hex.
action compile_module(src):
    let program = parse_source(src)
    let unread = bc_first_unknown(program)
    if (length of unread) > 0:
        return "compile: the parser could not read this source (line " + unread + "); no module written\n"
    let diags = check_program(program)
    if (length of diags) > 0:
        let out = "compile: " + bc_num_text(length of diags) + " diagnostic(s); no module written\n"
        for each d in diags:
            set out to out + render_diag(d) + "\n"
        return out
    let r = bc_module(program)
    if (length of (r[0] otherwise "")) > 0:
        return "compile: " + (r[0] otherwise "") + "\n"
    return bc_hex_of(r[1] otherwise [])
