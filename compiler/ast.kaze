# ast.kaze — Kaze AST node representations.
#
# Every shape the front end produces is an AstNode:
#
#   kind       the shape ("NUM", "BIN", "LET", "ACTION", ...)
#   name       an identifier, operator, unit or sub-tag
#   val_str    a literal payload (number text, string text, type name, ...)
#   val_num    a numeric payload (a declared bound, or a default value)
#   children   sub-nodes
#   line       1-based source line; 0 for a synthesised node
#
# Items carry three children, always in this order:
#
#   children[0]  PARAMS    one PARAM per parameter
#   children[1]  CONTRACTS REQUIRES / ENSURES / RECURSION_BOUND / ROUTINE_NEED
#   children[2]  BODY      the statement block
#
# Contracts and a routine's own needs: line are declarations. They live on the
# item, never in the body, so no backend has to filter them out of a run.

record AstNode:
    kind: str
    name: str
    val_str: str
    val_num: num
    children: list
    line: num

action make_node(k, n, vs, vn, ch, l):
    return AstNode(kind: k, name: n, val_str: vs, val_num: vn, children: ch, line: l)

# The empty node. Lookups return it instead of trapping, which is what keeps
# this front end free of run-time panics on a malformed tree.
action none_node():
    return AstNode(kind: "NONE", name: "", val_str: "", val_num: 0, children: [], line: 0)

action kids_of(n: AstNode):
    return n.children

# A guarded read: the index is proved in range before the read, so the call
# allocates nothing on the hit path. The old form --
#   node_at(kids, i)
# -- evaluated the fallback eagerly in native code, which meant a fresh record
# and list for every child access: hundreds of thousands of allocations on a
# 4,000-line file.
action node_at(nodes, i):
    # The proof has to be the *positive* condition of the guard: the checker
    # learns facts from an if body, not from an early return.
    if i >= 0 and i < (length of nodes):
        return nodes[i]
    return none_node()

action child_at(n: AstNode, i):
    return node_at(n.children, i)

# ── expressions ─────────────────────────────────────────────────────────

action make_ident(name, l):
    return make_node("IDENT", name, "", 0, [], l)

# A numeric literal keeps its source text in val_str, so "1.5" and "500" print
# back exactly as written and the C emitter needs no float formatting.
action make_num(text, l):
    return make_node("NUM", "", text, 0, [], l)

action make_str(s, l):
    return make_node("STR", "", s, 0, [], l)

action make_bool(b, l):
    let vs = "false"
    if b:
        set vs to "true"
    return make_node("BOOL", "", vs, 0, [], l)

action make_bin(op, left, right, l):
    return make_node("BIN", op, "", 0, [left, right], l)

action make_call(target, args, l):
    return make_node("CALL", target, "", 0, args, l)

action make_field(base, field, l):
    return make_node("FIELD", field, "", 0, [base], l)

action make_index(coll, idx, l):
    return make_node("INDEX", "", "", 0, [coll, idx], l)

action make_len(inner, l):
    return make_node("LEN", "", "", 0, [inner], l)

# Only a literal's length is known to the front end; the checker uses this to
# prove a constant index without running anything.
action make_len_lit(n, l):
    return make_node("LEN_LIT", "", "", n, [], l)

action make_list_expr(items, l):
    return make_node("LIST", "", "", 0, items, l)

# The phase 2 inline fallback: <expr> otherwise <fallback>.
action make_fallback(inner, fb, l):
    return make_node("FALLBACK", "", "", 0, [inner, fb], l)

# <expr> in radians / <expr> in degrees.
action make_in_unit(unit, inner, l):
    return make_node("IN_UNIT", unit, "", 0, [inner], l)

# x between low and high. Kept as its own node so the canonical formatter can
# print the contract as written instead of a desugared pair of comparisons.
action make_between(value, low, high, l):
    return make_node("BETWEEN", "", "", 0, [value, low, high], l)

# f(name: value) keeps the field name on the argument.
action make_named_arg(field, value, l):
    return make_node("NAMED_ARG", field, "", 0, [value], l)

# An expression the parser could not read. The checker reports it; it is never
# silently dropped.
action make_unknown(l):
    return make_node("UNKNOWN", "", "", 0, [], l)

# A typed synthesis hole: the type/unit the expression must have (empty means
# the author did not say) and the goal text an AI is asked to satisfy. The
# human syntax spells this `?` or `todo(<type>, "<goal>")`; the machine syntax
# spells it `(hole <type_or_unit> "<goal>")`.
action make_hole(ty, goal, l):
    return make_node("HOLE", ty, goal, 0, [], l)

# ── statements ──────────────────────────────────────────────────────────

action make_stmt(kind, name, children, l):
    return make_node(kind, name, "", 0, children, l)

action make_block(label, stmts, l):
    return make_node("BLOCK", label, "", 0, stmts, l)

action make_guard(cond, l):
    return make_node("GUARD", "", "", 0, [cond], l)

# A `require` written inside a body (a co-located test, or an assertion after
# some work) is the same runtime check as guard, but the formatter prints the
# keyword the writer used.
action make_require(cond, l):
    return make_node("GUARD", "require", "", 0, [cond], l)

# guard cond otherwise return/break/continue. The second child is the exit
# statement; the plain guard keeps its trap behavior.
action make_guard_exit(cond, exit_stmt, l):
    return make_node("GUARD", "", "", 0, [cond, exit_stmt], l)

action make_break(l):
    return make_node("BREAK", "", "", 0, [], l)

action make_continue(l):
    return make_node("CONTINUE", "", "", 0, [], l)

# repeat N times: body. The count is evaluated once; the body runs that many
# times unless a guard exits early.
action make_repeat(count, body, l):
    return make_node("REPEAT", "", "", 0, [count, body], l)

# The ceiling of a while ... bounded n: loop. An empty spelling means the loop
# declared no ceiling, which the checker refuses.
action make_bound(text, l):
    return make_node("BOUND", "", text, 0, [], l)

action make_while(cond, body, bound, l):
    return make_node("WHILE", "", "", 0, [cond, body, bound], l)

action make_if(cond, then_block, other_block, l):
    return make_node("IF", "", "", 0, [cond, then_block, other_block], l)

action make_for_each(var, list_expr, body, l):
    return make_node("FOR_EACH", var, "", 0, [list_expr, body], l)

action make_parallel_for(var, list_expr, body, l):
    return make_node("PARALLEL_FOR", var, "", 0, [list_expr, body], l)

action make_try(err_name, body, other_block, l):
    return make_node("TRY", err_name, "", 0, [body, other_block], l)

# ── phase 13: deterministic concurrency ─────────────────────────────────
#
# Four statement shapes and one expression shape, all lowering to the
# cooperative scheduler in the native runtime:
#
#   spawn worker(1) as w1     a child fiber task; the name holds its handle
#   yield                     an explicit cooperative suspension point
#   join w1                   drive the scheduler until w1 finishes, yield its value
#   cancel w1                 cancel w1 and its children; it never resumes
#   send v to q               ring-buffer send; false when the channel is full
#                             (children are [value, channel], in written order)
#   receive from q            ring-buffer receive; needs an otherwise fallback
#
# A fiber is a routine that may suspend, so it is neither an action nor a
# hook: it is entered by spawning it, never by calling it.
action make_spawn(routine_name, args, task_name, l):
    return make_node("SPAWN", routine_name, task_name, 0, args, l)

action make_yield(l):
    return make_node("YIELD", "", "", 0, [], l)

action make_join(task, l):
    return make_node("JOIN", "", "", 0, [task], l)

action make_cancel(task, l):
    return make_node("CANCEL", "", "", 0, [task], l)

action make_send(value, chan, l):
    return make_node("SEND", "", "", 0, [value, chan], l)

action make_receive(chan, l):
    return make_node("RECEIVE", "", "", 0, [chan], l)

# Fuel units a fiber may burn: each scheduling step and each suspended step
# costs one, so a program's concurrency budget is a number, not a hope.
action make_fuel(text, l):
    return make_node("FUEL", "", text, 0, [], l)

# The module-level task ceiling: tasks bounded <n>.
action make_tasks_bound(text, l):
    return make_node("TASKS_BOUND", "", text, 0, [], l)

# ── items ───────────────────────────────────────────────────────────────

action make_param(name, ty, defaults, l):
    return make_node("PARAM", name, ty, 0, defaults, l)

action make_field_def(name, ty, l):
    return make_node("FIELD_DEF", name, ty, 0, [], l)

# kind_word is the keyword that was written (action, routine, func, check,
# filter); the node kind is the semantic item kind.
action make_item(kind_word, name, params, contracts, result, body, l):
    let kind = "ACTION"
    if kind_word == "check":
        set kind to "CHECK"
    if kind_word == "filter":
        set kind to "FILTER"
    if kind_word == "fiber":
        set kind to "FIBER"
    return make_node(kind, name, result, 0, [params, contracts, body], l)

action make_record_item(name, fields, l):
    return make_node("RECORD", name, "", 0, fields, l)

# test "description": body. The generated name gives the block a stable C
# routine name; the description is what humans and `kaze test` display.
action make_test(desc, contracts, body, l):
    let name = "__kz_test_" + l
    let params = make_node("PARAMS", "", "", 0, [], l)
    let contracts_node = make_node("CONTRACTS", "", "", 0, contracts, l)
    return make_node("TEST", name, desc, 0, [params, contracts_node, body], l)

action make_contract(kind_word, expr, l):
    return make_node("CONTRACT", kind_word, "", 0, [expr], l)

action make_recursion_bound(text, l):
    return make_node("RECURSION_BOUND", "", text, 0, [], l)

action make_routine_need(name, l):
    return make_node("ROUTINE_NEED", name, "", 0, [], l)

action make_when(cond, body, l):
    return make_node("WHEN", "", "", 0, [cond, body], l)

action make_every(duration, body, l):
    return make_node("EVERY", "", "", 0, [duration, body], l)

# ── imports and visibility (module format) ──────────────────────────────
#
# A use node carries the module spec in name, the namespace alias in val_str,
# and the selected symbols (for `use { a, b } from "..."`) as SYMBOL children.
# val_num distinguishes the forms without adding another record field:
#   0  use "./path.kaze"                bare, legacy single-namespace import
#   1  use "./path.kaze" as alias       qualified namespace import
#   2  use { a, b } from "./path.kaze"  selective import
action make_use(spec, alias, symbols, form, l):
    return make_node("USE", spec, alias, form, symbols, l)

action make_symbol(name, l):
    return make_node("SYMBOL", name, "", 0, [], l)

action use_alias(u: AstNode) -> string:
    return u.val_str

action use_symbols(u: AstNode) -> list:
    return u.children

# An item is visible to importers only when it says `pub`. Modules written before
# the keyword existed are grandfathered as implicit exports by the loader, which
# keeps the standard library and the compiler's own modules working unchanged.
action item_is_pub(item: AstNode) -> num:
    return item.val_num

action with_pub(item: AstNode, flag: num) -> AstNode:
    return make_node(item.kind, item.name, item.val_str, flag, item.children, item.line)

# The name a record carries at run time. The C symbol is mangled per module, but
# the value keeps the spelling the source used, so diagnostics and field maps do
# not leak the mangling scheme.
action record_runtime_name(item: AstNode) -> string:
    if item.kind == "RECORD" and item.val_str != "":
        return item.val_str
    return item.name

action make_program(uses, needs, items, config):
    let uses_node = make_node("USES", "", "", 0, uses, 0)
    let needs_node = make_node("NEEDS", "", "", 0, needs, 0)
    let items_node = make_node("ITEMS", "", "", 0, items, 0)
    let config_node = make_node("CONFIG", "", "", 0, config, 0)
    return make_node("PROGRAM", "", "", 0, [uses_node, needs_node, items_node, config_node], 0)

action program_uses(prog: AstNode):
    return child_at(prog, 0)

action program_needs(prog: AstNode):
    return child_at(prog, 1)

action program_items(prog: AstNode):
    let items_node = child_at(prog, 2)
    return items_node.children

# Module-level configuration (phase 13): the task ceiling and nothing else so
# far. Absent means the runtime default from KAZE_MAX_TASKS.
action program_config(prog: AstNode):
    let config_node = child_at(prog, 3)
    return config_node.children

action config_tasks_bound(prog: AstNode) -> string:
    let out = ""
    for each c in program_config(prog):
        if c.kind == "TASKS_BOUND":
            set out to c.val_str
    return out

# `kaze test` compiles the same program with this marker so the emitter knows
# to include co-located test items and to generate the test driver. A normal
# build never sets it, so test blocks stay inert (and DCE keeps them).
action with_test_mode(prog: AstNode):
    let uses_node = child_at(prog, 0)
    let needs_node = child_at(prog, 1)
    let items_node = child_at(prog, 2)
    let config_node = child_at(prog, 3)
    let config = config_node.children + [make_node("TEST_MODE", "", "", 0, [], 0)]
    let new_config = make_node("CONFIG", "", "", 0, config, 0)
    return make_node("PROGRAM", "", "", 0, [uses_node, needs_node, items_node, new_config], 0)

action config_has_test_mode(config) -> num:
    for each c in config:
        if c.kind == "TEST_MODE":
            return 1
    return 0

action item_is_test(item: AstNode) -> num:
    if item.kind == "TEST":
        return 1
    return 0

action items_have_tests(items) -> num:
    for each item in items:
        if item.kind == "TEST":
            return 1
    return 0

# ── vocabulary shared by the parser and the checker ─────────────────────

# ASCII lowercasing without a Unicode dependency: unit spellings are ASCII.
action lower_word(w):
    let out = ""
    let i = 0
    while i < (length of w) bounded 1000:
        let c = w[i] otherwise ""
        if c >= "A" and c <= "Z":
            set out to out + character(code(c) + 32)
        otherwise:
            set out to out + c
        set i to i + 1
    return out

# Short SI spellings are case-sensitive and stay exactly as written. Everything
# else is a spelled-out word and normalizes to lowercase.
action unit_abbrev(w):
    if w == "m" or w == "km" or w == "cm" or w == "mm":
        return 1
    if w == "s" or w == "ms" or w == "h" or w == "min":
        return 1
    if w == "kg" or w == "g":
        return 1
    if w == "C" or w == "K" or w == "A":
        return 1
    if w == "Pa" or w == "hPa" or w == "mbar" or w == "A":
        return 1
    if w == "%" or w == "m/s" or w == "km/h" or w == "m/s2" or w == "kg/m3":
        return 1
    return 0

# The unit a formatter prints. Abbreviations are preserved; a recognized
# spelled-out word is lowercased so `METERS`, `Meters` and `meters` converge.
action canonical_unit_text(w):
    if w == "":
        return ""
    if unit_abbrev(w) == 1:
        return w
    if unit_word(w) != "":
        return lower_word(w)
    return w

# Type annotations carry units and record names. Only a recognized unit is
# normalized; `Point` and `HeapNode` keep their PascalCase spelling.
action normalize_type_text(w):
    # Primitive spellings converge on the canonical one. This is the same
    # synonym set the checker resolves, kept here so `kaze fmt` removes the
    # dialect rather than preserving it forever.
    if w == "number" or w == "float" or w == "double":
        return "num"
    if w == "str" or w == "string":
        return "text"
    return canonical_unit_text(w)

# The unit suffixes the language knows (the phase 3 lexicon). A unit word here
# is consumed as a suffix and recorded on the literal it follows. Spelled-out
# words are accepted case-insensitively; SI abbreviations stay exact.
action unit_word(w):
    let lw = lower_word(w)
    if w == "m":
        return "m"
    if lw == "meter" or lw == "meters" or lw == "metre" or lw == "metres":
        return "meters"
    if w == "km":
        return "km"
    if lw == "kilometer" or lw == "kilometers" or lw == "kilometre" or lw == "kilometres":
        return "kilometers"
    if w == "cm":
        return "cm"
    if lw == "centimeter" or lw == "centimeters" or lw == "centimetre" or lw == "centimetres":
        return "centimeters"
    if w == "mm":
        return "mm"
    if lw == "millimeter" or lw == "millimeters" or lw == "millimetre" or lw == "millimetres":
        return "millimeters"
    if w == "s":
        return "s"
    if lw == "sec" or lw == "second" or lw == "seconds":
        return "seconds"
    if w == "ms":
        return "ms"
    if lw == "millisecond" or lw == "milliseconds":
        return "milliseconds"
    if w == "h":
        return "h"
    if lw == "hour" or lw == "hours":
        return "hours"
    if w == "min":
        return "min"
    if lw == "minute" or lw == "minutes":
        return "minutes"
    if w == "kg":
        return "kg"
    if lw == "kilogram" or lw == "kilograms":
        return "kilograms"
    if w == "g":
        return "g"
    if lw == "gram" or lw == "grams":
        return "grams"
    if w == "C":
        return "C"
    if lw == "celsius":
        return "Celsius"
    if w == "K":
        return "K"
    if lw == "kelvin":
        return "Kelvin"
    if w == "Pa":
        return "Pa"
    if lw == "pascal":
        return "Pascal"
    if w == "mbar":
        return "mbar"
    if lw == "millibar" or lw == "millibars":
        return "mbar"
    if w == "hPa":
        return "hPa"
    if lw == "hectopascal" or lw == "hectopascals":
        return "hectopascals"
    if w == "A":
        return "A"
    if lw == "ampere" or lw == "amperes" or lw == "amp":
        return "ampere"
    if lw == "percent":
        return "%"
    if lw == "degrees" or lw == "degree" or lw == "deg":
        return "degrees"
    if lw == "radians" or lw == "radian" or lw == "rad":
        return "radians"
    return ""

action is_angle_unit(u):
    if u == "degrees" or u == "radians":
        return 1
    return 0

# Declared capability names resolve to a family: fan is a device instance,
# lidar a sensor, and a family name is itself.
action family_of_word(w):
    if w == "drone" or w == "rover" or w == "sensor" or w == "device" or w == "memory" or w == "policy" or w == "log" or w == "alert" or w == "ai" or w == "tool":
        return w
    if w == "tools":
        return "tool"
    if w == "agent" or w == "model" or w == "llm":
        return "ai"
    # 'regs' is its own family so the checker can see the declaration: a program that
    # names it gains the mmio_* builtins and nothing else.
    if w == "regs":
        return "regs"
    if w == "lidar" or w == "camera" or w == "thermostat" or w == "probe":
        return "sensor"
    if w == "fan" or w == "mister" or w == "pump" or w == "relay" or w == "valve" or w == "motor" or w == "light":
        return "device"
    return "device"

# Bare telemetry names, read through the script's hardware family.
action is_telemetry(w):
    if w == "battery" or w == "altitude" or w == "heading" or w == "speed" or w == "position" or w == "temperature" or w == "humidity" or w == "distance" or w == "armed":
        return 1
    if w == "latitude" or w == "longitude" or w == "satellites":
        return 1
    return 0

action digit_value(c):
    if c == "0":
        return 0
    if c == "1":
        return 1
    if c == "2":
        return 2
    if c == "3":
        return 3
    if c == "4":
        return 4
    if c == "5":
        return 5
    if c == "6":
        return 6
    if c == "7":
        return 7
    if c == "8":
        return 8
    if c == "9":
        return 9
    return 0

# Read a decimal literal's text as a number. Used where the front end has to
# reason about the value (a divisor, an index, a loop ceiling); it never fails.
action text_to_num(s):
    let len = length of s
    let i = 0
    let whole = 0
    let frac = 0
    let scale = 1
    let seen_dot = 0
    while i < len bounded 64:
        let c = s[i] otherwise "x"
        if c == ".":
            set seen_dot to 1
        otherwise:
            if c >= "0" and c <= "9":
                let d = digit_value(c)
                if seen_dot == 1:
                    set scale to scale * 10
                    set frac to frac + (d / scale otherwise 0)
                otherwise:
                    set whole to whole * 10 + d
        set i to i + 1
    return whole + frac

# Single source of truth for the Kaze language version across the compiler,
# LSP handshake, and `kaze version` CLI output.
action kaze_version() -> text:
    return "1.0"
