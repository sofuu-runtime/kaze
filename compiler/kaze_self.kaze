# token.kaze — Kaze Token representations

record Token:
    kind: str
    text: str
    line: num
    col: num

action make_token(k, t, l, c):
    return Token(kind: k, text: t, line: l, col: c)
# ast.kaze — Kaze AST node representations

record AstNode:
    kind: str
    name: str
    val_str: str
    val_num: num
    children: list
    line: num

action make_node(k, n, vs, vn, ch, l):
    return AstNode(kind: k, name: n, val_str: vs, val_num: vn, children: ch, line: l)

action make_ident(name, l):
    return AstNode(kind: "IDENT", name: name, val_str: "", val_num: 0, children: [], line: l)

action make_num(n, l):
    return AstNode(kind: "NUM", name: "", val_str: "", val_num: n, children: [], line: l)

action make_str(s, l):
    return AstNode(kind: "STR", name: "", val_str: s, val_num: 0, children: [], line: l)

action make_bool(b, l):
    let vs = "false"
    if b:
        set vs to "true"
    return AstNode(kind: "BOOL", name: "", val_str: vs, val_num: 0, children: [], line: l)

action make_bin(op, left, right, l):
    return AstNode(kind: "BIN", name: op, val_str: "", val_num: 0, children: [left, right], line: l)

action make_call(target, args, l):
    return AstNode(kind: "CALL", name: target, val_str: "", val_num: 0, children: args, line: l)

action make_field(base, field, l):
    return AstNode(kind: "FIELD", name: field, val_str: "", val_num: 0, children: [base], line: l)

action make_index(coll, idx, l):
    return AstNode(kind: "INDEX", name: "", val_str: "", val_num: 0, children: [coll, idx], line: l)

action make_len(inner, l):
    return AstNode(kind: "LEN", name: "", val_str: "", val_num: 0, children: [inner], line: l)

action make_list_expr(items, l):
    return AstNode(kind: "LIST", name: "", val_str: "", val_num: 0, children: items, line: l)

action make_stmt(kind, name, children, l):
    return AstNode(kind: kind, name: name, val_str: "", val_num: 0, children: children, line: l)

action make_item(kind, name, params, body, l):
    return AstNode(kind: kind, name: name, val_str: "", val_num: 0, children: [params, body], line: l)
# lexer.kaze — Pure Kaze Tokenizer

action is_alpha(c):
    if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_":
        return 1
    return 0

action is_digit(c):
    if c >= "0" and c <= "9":
        return 1
    return 0

action is_alphanumeric(c):
    if is_alpha(c) == 1 or is_digit(c) == 1:
        return 1
    return 0

action tokenize(src):
    let tokens = []
    let len = length of src
    let i = 0
    let line = 1
    let col = 1

    let indent_stack = [0]

    while i < len:
        let c = src[i]

        # 1. Skip spaces and tabs
        if c == " " or c == "\t":
            set i to i + 1
            set col to col + 1

        # 2. Comments
        otherwise:
            if c == "#":
                while i < len and src[i] != "\n":
                    set i to i + 1
                # The newline itself will be processed next

            # 3. Newlines and Indentation
            otherwise:
                if c == "\n":
                    let nl_tok = make_token("NEWLINE", "\n", line, col)
                    set tokens to tokens + [nl_tok]
                    set i to i + 1
                    set line to line + 1
                    set col to 1

                    # Count leading spaces on the next line
                    let spaces = 0
                    while i < len and src[i] == " ":
                        set spaces to spaces + 1
                        set i to i + 1
                        set col to col + 1

                    # Ignore blank or comment-only lines
                    if i < len and src[i] != "\n" and src[i] != "#":
                        let curr_ind = indent_stack[(length of indent_stack) - 1]
                        if spaces > curr_ind:
                            let ind_tok = make_token("INDENT", "", line, col)
                            set tokens to tokens + [ind_tok]
                            set indent_stack to indent_stack + [spaces]
                        otherwise:
                            if spaces < curr_ind:
                                while (length of indent_stack) > 1 and indent_stack[(length of indent_stack) - 1] > spaces:
                                    let ded_tok = make_token("DEDENT", "", line, col)
                                    set tokens to tokens + [ded_tok]
                                    # pop indent stack by slicing or list rebuild
                                    let new_stack = []
                                    let stk_len = (length of indent_stack) - 1
                                    let si = 0
                                    while si < stk_len:
                                        set new_stack to new_stack + [indent_stack[si]]
                                        set si to si + 1
                                    set indent_stack to new_stack

                # 4. String literal
                otherwise:
                    if c == "\"":
                        let start_col = col
                        set i to i + 1
                        set col to col + 1
                        let text = ""
                        while i < len and src[i] != "\"":
                            if src[i] == "\\":
                                set i to i + 1
                                set col to col + 1
                                if i < len:
                                    if src[i] == "n":
                                        set text to text + "\n"
                                    otherwise:
                                        if src[i] == "t":
                                            set text to text + "\t"
                                        otherwise:
                                            set text to text + src[i]
                            otherwise:
                                set text to text + src[i]
                            set i to i + 1
                            set col to col + 1
                        if i < len and src[i] == "\"":
                            set i to i + 1
                            set col to col + 1
                        let tok = make_token("STR", text, line, start_col)
                        set tokens to tokens + [tok]

                    # 5. Number literal
                    otherwise:
                        if is_digit(c) == 1:
                            let start_col = col
                            let text = ""
                            while i < len and (is_digit(src[i]) == 1 or src[i] == "."):
                                set text to text + src[i]
                                set i to i + 1
                                set col to col + 1
                            let tok = make_token("NUM", text, line, start_col)
                            set tokens to tokens + [tok]

                        # 6. Identifier or Keyword
                        otherwise:
                            if is_alpha(c) == 1:
                                let start_col = col
                                let text = ""
                                while i < len and is_alphanumeric(src[i]) == 1:
                                    set text to text + src[i]
                                    set i to i + 1
                                    set col to col + 1
                                let tok = make_token("IDENT", text, line, start_col)
                                set tokens to tokens + [tok]

                            # 7. Two-character operators
                            otherwise:
                                let is_two = 0
                                if i + 1 < len:
                                    let next_c = src[i + 1]
                                    let two_s = c + next_c
                                    if two_s == "==" or two_s == "!=" or two_s == "<=" or two_s == ">=":
                                        let tok = make_token("OP", two_s, line, col)
                                        set tokens to tokens + [tok]
                                        set i to i + 2
                                        set col to col + 2
                                        set is_two to 1

                                # 8. Single-character symbols
                                if is_two == 0:
                                    let tok = make_token("SYM", c, line, col)
                                    set tokens to tokens + [tok]
                                    set i to i + 1
                                    set col to col + 1

    # Emit remaining DEDENT tokens at EOF
    while (length of indent_stack) > 1:
        let ded_tok = make_token("DEDENT", "", line, col)
        set tokens to tokens + [ded_tok]
        let new_stack = []
        let stk_len = (length of indent_stack) - 1
        let si = 0
        while si < stk_len:
            set new_stack to new_stack + [indent_stack[si]]
            set si to si + 1
        set indent_stack to new_stack

    let eof_tok = make_token("EOF", "", line, col)
    set tokens to tokens + [eof_tok]
    return tokens
# parser.kaze — Pure Kaze Recursive Descent Parser

action get_token(tokens, pos):
    return tokens[pos]

action token_kind(tokens, pos):
    let t = tokens[pos]
    return t.kind

action token_text(tokens, pos):
    let t = tokens[pos]
    return t.text

action token_line(tokens, pos):
    let t = tokens[pos]
    return t.line

action is_token(tokens, pos, k, txt):
    let t = tokens[pos]
    if t.kind == k and t.text == txt:
        return 1
    return 0

action skip_nl(tokens, pos):
    let len = length of tokens
    while pos < len:
        let t = tokens[pos]
        if t.kind == "NEWLINE":
            set pos to pos + 1
        otherwise:
            return pos
    return pos

action parse_primary(tokens, pos):
    let set_pos = skip_nl(tokens, pos)
    set pos to set_pos
    let t = tokens[pos]

    # 1. Number
    if t.kind == "NUM":
        let n = make_num(t.text, t.line)
        return [n, pos + 1]

    # 2. String
    if t.kind == "STR":
        let s = make_str(t.text, t.line)
        return [s, pos + 1]

    # 3. List Literal [a, b, c]
    if t.kind == "SYM" and t.text == "[":
        set pos to pos + 1
        let items = []
        let done = 0
        while pos < (length of tokens) and done == 0:
            let sk = skip_nl(tokens, pos)
            set pos to sk
            if is_token(tokens, pos, "SYM", "]") == 1:
                set pos to pos + 1
                set done to 1
            otherwise:
                let elem_res = parse_expr(tokens, pos)
                set items to items + [elem_res[0]]
                set pos to elem_res[1]
                let sk2 = skip_nl(tokens, pos)
                set pos to sk2
                if is_token(tokens, pos, "SYM", ",") == 1:
                    set pos to pos + 1
        let l_node = make_list_expr(items, t.line)
        return [l_node, pos]

    # 4. Parenthesized expression (expr)
    if t.kind == "SYM" and t.text == "(":
        set pos to pos + 1
        let res = parse_expr(tokens, pos)
        let inner = res[0]
        set pos to res[1]
        let sk = skip_nl(tokens, pos)
        set pos to sk
        if is_token(tokens, pos, "SYM", ")") == 1:
            set pos to pos + 1
        return [inner, pos]

    # 5. Length of x
    if t.kind == "IDENT" and t.text == "length":
        if pos + 1 < (length of tokens):
            let t_next = tokens[pos + 1]
            if t_next.text == "of":
                set pos to pos + 2
                let res = parse_primary(tokens, pos)
                let len_node = make_len(res[0], t.line)
                return [len_node, res[1]]

    # 6. Identifiers, booleans, and calls
    if t.kind == "IDENT":
        if t.text == "true":
            return [make_bool(true, t.line), pos + 1]
        if t.text == "false":
            return [make_bool(false, t.line), pos + 1]

        let name = t.text
        set pos to pos + 1

        # Check for function call or record init: name(...)
        if pos < (length of tokens) and is_token(tokens, pos, "SYM", "(") == 1:
            set pos to pos + 1
            let args = []
            let call_done = 0
            while pos < (length of tokens) and call_done == 0:
                let sk = skip_nl(tokens, pos)
                set pos to sk
                if is_token(tokens, pos, "SYM", ")") == 1:
                    set pos to pos + 1
                    set call_done to 1
                otherwise:
                    # check for named argument: field_name: expr
                    let is_named = 0
                    if pos + 1 < (length of tokens):
                        let tk0 = tokens[pos]
                        let tk1 = tokens[pos + 1]
                        if tk0.kind == "IDENT" and tk1.kind == "SYM" and tk1.text == ":":
                            set is_named = 1
                    if is_named == 1:
                        let tk_name = tokens[pos]
                        let fname = tk_name.text
                        set pos to pos + 2
                        let val_res = parse_expr(tokens, pos)
                        let named_node = make_bin(":", make_ident(fname, t.line), val_res[0], t.line)
                        set args to args + [named_node]
                        set pos to val_res[1]
                    otherwise:
                        let arg_res = parse_expr(tokens, pos)
                        set args to args + [arg_res[0]]
                        set pos to arg_res[1]

                    let sk2 = skip_nl(tokens, pos)
                    set pos to sk2
                    if is_token(tokens, pos, "SYM", ",") == 1:
                        set pos to pos + 1

            let call_node = make_call(name, args, t.line)
            return [call_node, pos]

        return [make_ident(name, t.line), pos]

    return [make_ident("unknown", t.line), pos + 1]

action parse_postfix(tokens, pos):
    let res = parse_primary(tokens, pos)
    let node = res[0]
    set pos to res[1]

    let loop_done = 0
    while pos < (length of tokens) and loop_done == 0:
        # Field access: node.field
        if is_token(tokens, pos, "SYM", ".") == 1:
            set pos to pos + 1
            let tk_field = tokens[pos]
            let field_name = tk_field.text
            set pos to pos + 1
            set node to make_field(node, field_name, tk_field.line)

        # Index access: node[idx]
        otherwise:
            if is_token(tokens, pos, "SYM", "[") == 1:
                set pos to pos + 1
                let idx_res = parse_expr(tokens, pos)
                let idx_node = idx_res[0]
                set pos to idx_res[1]
                let sk = skip_nl(tokens, pos)
                set pos to sk
                if is_token(tokens, pos, "SYM", "]") == 1:
                    set pos to pos + 1
                set node to make_index(node, idx_node, token_line(tokens, pos - 1))
            otherwise:
                set loop_done to 1

    return [node, pos]

action parse_unary(tokens, pos):
    let sk = skip_nl(tokens, pos)
    set pos to sk
    let t = tokens[pos]
    if t.kind == "IDENT" and t.text == "not":
        set pos to pos + 1
        let res = parse_unary(tokens, pos)
        let un_node = make_bin("not", res[0], make_num(0, t.line), t.line)
        return [un_node, res[1]]
    if t.kind == "SYM" and t.text == "-":
        set pos to pos + 1
        let res = parse_unary(tokens, pos)
        let neg_node = make_bin("-", make_num(0, t.line), res[0], t.line)
        return [neg_node, res[1]]
    return parse_postfix(tokens, pos)

action parse_multiplicative(tokens, pos):
    let res = parse_unary(tokens, pos)
    let node = res[0]
    set pos to res[1]

    let done = 0
    while pos < (length of tokens) and done == 0:
        let t = tokens[pos]
        if t.kind == "SYM" and (t.text == "*" or t.text == "/" or t.text == "%"):
            let op = t.text
            set pos to pos + 1
            let right_res = parse_unary(tokens, pos)
            set node to make_bin(op, node, right_res[0], t.line)
            set pos to right_res[1]
        otherwise:
            set done to 1
    return [node, pos]

action parse_additive(tokens, pos):
    let res = parse_multiplicative(tokens, pos)
    let node = res[0]
    set pos to res[1]

    let done = 0
    while pos < (length of tokens) and done == 0:
        let t = tokens[pos]
        if t.kind == "SYM" and (t.text == "+" or t.text == "-"):
            let op = t.text
            set pos to pos + 1
            let right_res = parse_multiplicative(tokens, pos)
            set node to make_bin(op, node, right_res[0], t.line)
            set pos to right_res[1]
        otherwise:
            set done to 1
    return [node, pos]

action parse_relational(tokens, pos):
    let res = parse_additive(tokens, pos)
    let node = res[0]
    set pos to res[1]

    let done = 0
    while pos < (length of tokens) and done == 0:
        let t = tokens[pos]
        let is_rel = 0
        let op = t.text
        if t.kind == "OP":
            if op == "==" or op == "!=" or op == "<=" or op == ">=":
                set is_rel = 1
        if t.kind == "SYM":
            if op == "<" or op == ">":
                set is_rel = 1

        if is_rel == 1:
            set pos to pos + 1
            let right_res = parse_additive(tokens, pos)
            set node to make_bin(op, node, right_res[0], t.line)
            set pos to right_res[1]
        otherwise:
            set done to 1
    return [node, pos]

action parse_logical_and(tokens, pos):
    let res = parse_relational(tokens, pos)
    let node = res[0]
    set pos to res[1]

    let done = 0
    while pos < (length of tokens) and done == 0:
        let t = tokens[pos]
        if t.kind == "IDENT" and t.text == "and":
            set pos to pos + 1
            let right_res = parse_relational(tokens, pos)
            set node to make_bin("and", node, right_res[0], t.line)
            set pos to right_res[1]
        otherwise:
            set done to 1
    return [node, pos]

action parse_expr(tokens, pos):
    let res = parse_logical_and(tokens, pos)
    let node = res[0]
    set pos to res[1]

    let done = 0
    while pos < (length of tokens) and done == 0:
        let t = tokens[pos]
        if t.kind == "IDENT" and t.text == "or":
            set pos to pos + 1
            let right_res = parse_logical_and(tokens, pos)
            set node to make_bin("or", node, right_res[0], t.line)
            set pos to right_res[1]
        otherwise:
            set done to 1
    return [node, pos]

action parse_block(tokens, pos):
    let sk = skip_nl(tokens, pos)
    set pos to sk

    let t = tokens[pos]
    if t.kind != "INDENT":
        return [[], pos]

    set pos to pos + 1
    let stmts = []
    let done = 0

    while pos < (length of tokens) and done == 0:
        let sk2 = skip_nl(tokens, pos)
        set pos to sk2
        let cur = tokens[pos]
        if cur.kind == "DEDENT":
            set pos to pos + 1
            set done to 1
        otherwise:
            if cur.kind == "EOF":
                set done to 1
            otherwise:
                let s_res = parse_stmt(tokens, pos)
                set stmts to stmts + [s_res[0]]
                set pos to s_res[1]

    return [stmts, pos]

action parse_stmt(tokens, pos):
    let sk = skip_nl(tokens, pos)
    set pos to sk
    let t = tokens[pos]

    # 1. let var = expr
    if t.kind == "IDENT" and t.text == "let":
        set pos to pos + 1
        let tk_var = tokens[pos]
        let var_name = tk_var.text
        set pos to pos + 1
        if is_token(tokens, pos, "SYM", "=") == 1:
            set pos to pos + 1
        let e_res = parse_expr(tokens, pos)
        let s_node = make_stmt("LET", var_name, [e_res[0]], t.line)
        return [s_node, e_res[1]]

    # 2. set var to expr / set var = expr
    if t.kind == "IDENT" and t.text == "set":
        set pos to pos + 1
        let tk_var = tokens[pos]
        let var_name = tk_var.text
        set pos to pos + 1
        if (is_token(tokens, pos, "IDENT", "to") == 1) or (is_token(tokens, pos, "SYM", "=") == 1):
            set pos to pos + 1
        let e_res = parse_expr(tokens, pos)
        let s_node = make_stmt("SET", var_name, [e_res[0]], t.line)
        return [s_node, e_res[1]]

    # 3. return expr
    if t.kind == "IDENT" and t.text == "return":
        set pos to pos + 1
        let cur = tokens[pos]
        if cur.kind == "NEWLINE" or cur.kind == "DEDENT" or cur.kind == "EOF":
            let s_node = make_stmt("RETURN", "", [], t.line)
            return [s_node, pos]
        let e_res = parse_expr(tokens, pos)
        let s_node = make_stmt("RETURN", "", [e_res[0]], t.line)
        return [s_node, e_res[1]]

    # 3b. log [level] expr
    if t.kind == "IDENT" and t.text == "log":
        set pos to pos + 1
        let cur = tokens[pos]
        if cur.kind == "IDENT" and (cur.text == "info" or cur.text == "warn" or cur.text == "warning" or cur.text == "error" or cur.text == "debug"):
            set pos to pos + 1
        let e_res = parse_expr(tokens, pos)
        let call_node = make_call("log", [e_res[0]], t.line)
        let s_node = make_stmt("EXPR", "", [call_node], t.line)
        return [s_node, e_res[1]]

    # 4. if cond: block otherwise: block
    if t.kind == "IDENT" and t.text == "if":
        set pos to pos + 1
        let c_res = parse_expr(tokens, pos)
        let cond_node = c_res[0]
        set pos to c_res[1]
        if is_token(tokens, pos, "SYM", ":") == 1:
            set pos to pos + 1
        let b_res = parse_block(tokens, pos)
        let then_stmts = b_res[0]
        set pos to b_res[1]

        let other_stmts = []
        let sk2 = skip_nl(tokens, pos)
        if sk2 < (length of tokens):
            let tk_other = tokens[sk2]
            if tk_other.kind == "IDENT" and tk_other.text == "otherwise":
                set pos to sk2 + 1
                if is_token(tokens, pos, "SYM", ":") == 1:
                    set pos to pos + 1
                let ob_res = parse_block(tokens, pos)
                set other_stmts = ob_res[0]
                set pos to ob_res[1]

        let then_node = make_stmt("BLOCK", "then", then_stmts, t.line)
        let other_node = make_stmt("BLOCK", "otherwise", other_stmts, t.line)
        let if_node = make_stmt("IF", "", [cond_node, then_node, other_node], t.line)
        return [if_node, pos]

    # 5. while cond: block
    if t.kind == "IDENT" and t.text == "while":
        set pos to pos + 1
        let c_res = parse_expr(tokens, pos)
        let cond_node = c_res[0]
        set pos to c_res[1]
        if is_token(tokens, pos, "SYM", ":") == 1:
            set pos to pos + 1
        let b_res = parse_block(tokens, pos)
        let body_stmts = b_res[0]
        set pos to b_res[1]
        let body_node = make_stmt("BLOCK", "body", body_stmts, t.line)
        let while_node = make_stmt("WHILE", "", [cond_node, body_node], t.line)
        return [while_node, pos]

    # 6. for each var in list: block
    if t.kind == "IDENT" and t.text == "for":
        set pos to pos + 1
        let tk_each = tokens[pos]
        if tk_each.kind == "IDENT" and tk_each.text == "each":
            set pos to pos + 1
        let tk_var = tokens[pos]
        let var_name = tk_var.text
        set pos to pos + 1
        let tk_in = tokens[pos]
        if tk_in.kind == "IDENT" and tk_in.text == "in":
            set pos to pos + 1
        let l_res = parse_expr(tokens, pos)
        let list_node = l_res[0]
        set pos to l_res[1]
        if is_token(tokens, pos, "SYM", ":") == 1:
            set pos to pos + 1
        let b_res = parse_block(tokens, pos)
        let body_stmts = b_res[0]
        set pos to b_res[1]
        let body_node = make_stmt("BLOCK", "body", body_stmts, t.line)
        let for_node = make_stmt("FOR_EACH", var_name, [list_node, body_node], t.line)
        return [for_node, pos]

    # 7. Expression statement (function calls, etc.)
    let e_res = parse_expr(tokens, pos)
    let s_node = make_stmt("EXPR", "", [e_res[0]], t.line)
    return [s_node, e_res[1]]

action parse_program(tokens):
    let items = []
    let pos = 0
    let len = length of tokens

    while pos < len:
        let sk = skip_nl(tokens, pos)
        set pos to sk
        if pos >= len:
            return items

        let t = tokens[pos]
        if t.kind == "EOF":
            return items

        # Ignore needs: header
        if t.kind == "IDENT" and t.text == "needs":
            let done = 0
            while pos < len and done == 0:
                let cur = tokens[pos]
                if cur.kind == "NEWLINE":
                    set pos to pos + 1
                    set done = 1
                otherwise:
                    if cur.kind == "EOF":
                        set done = 1
                    otherwise:
                        set pos to pos + 1

        # Ignore use "..." import
        otherwise:
            if t.kind == "IDENT" and t.text == "use":
                let done = 0
                while pos < len and done == 0:
                    let cur = tokens[pos]
                    if cur.kind == "NEWLINE":
                        set pos to pos + 1
                        set done = 1
                    otherwise:
                        if cur.kind == "EOF":
                            set done = 1
                        otherwise:
                            set pos to pos + 1

