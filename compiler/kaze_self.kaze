# kaze_self.kaze -- the self-hosted Kaze compiler as one file.
#
# Generated by scripts/self-sync.sh from compiler/{token,ast,lexer,parser,checker,machine,codegen,main}.kaze.
# Edit the modules, never this file. The use lines are dropped because the
# loader is not available inside the compiler's own bootstrap.

# token.kaze — Kaze Token representations

record Token:
    kind: str
    text: str
    line: num
    col: num
    # Byte offset of the token's first character in the source. Line and column
    # are what a diagnostic prints; the offset is what a source-to-source tool
    # needs to splice text without re-scanning.
    at: num

action make_token(k, t, l, c, at):
    return Token(kind: k, text: t, line: l, col: c, at: at)

# ast.kaze — Kaze AST node representations.
#
# Every shape the front end produces is an AstNode:
#
#   kind       the shape ("NUM", "BIN", "LET", "ACTION", ...)
#   name       an identifier, operator, unit or sub-tag
#   val_str    a literal payload (number text, string text, type name, ...)
#   val_num    a numeric payload (a declared bound, or a default value)
#   children   sub-nodes
#   line       1-based source line; 0 for a synthesised node
#
# Items carry three children, always in this order:
#
#   children[0]  PARAMS    one PARAM per parameter
#   children[1]  CONTRACTS REQUIRES / ENSURES / RECURSION_BOUND / ROUTINE_NEED
#   children[2]  BODY      the statement block
#
# Contracts and a routine's own needs: line are declarations. They live on the
# item, never in the body, so no backend has to filter them out of a run.

record AstNode:
    kind: str
    name: str
    val_str: str
    val_num: num
    children: list
    line: num

action make_node(k, n, vs, vn, ch, l):
    return AstNode(kind: k, name: n, val_str: vs, val_num: vn, children: ch, line: l)

# The empty node. Lookups return it instead of trapping, which is what keeps
# this front end free of run-time panics on a malformed tree.
action none_node():
    return AstNode(kind: "NONE", name: "", val_str: "", val_num: 0, children: [], line: 0)

action kids_of(n: AstNode):
    return n.children

# A guarded read: the index is proved in range before the read, so the call
# allocates nothing on the hit path. The old form --
#   node_at(kids, i)
# -- evaluated the fallback eagerly in native code, which meant a fresh record
# and list for every child access: hundreds of thousands of allocations on a
# 4,000-line file.
action node_at(nodes, i):
    # The proof has to be the *positive* condition of the guard: the checker
    # learns facts from an if body, not from an early return.
    if i >= 0 and i < (length of nodes):
        return nodes[i]
    return none_node()

action child_at(n: AstNode, i):
    return node_at(n.children, i)

# ── expressions ─────────────────────────────────────────────────────────

action make_ident(name, l):
    return make_node("IDENT", name, "", 0, [], l)

# A numeric literal keeps its source text in val_str, so "1.5" and "500" print
# back exactly as written and the C emitter needs no float formatting.
action make_num(text, l):
    return make_node("NUM", "", text, 0, [], l)

action make_str(s, l):
    return make_node("STR", "", s, 0, [], l)

action make_bool(b, l):
    let vs = "false"
    if b:
        set vs to "true"
    return make_node("BOOL", "", vs, 0, [], l)

action make_bin(op, left, right, l):
    return make_node("BIN", op, "", 0, [left, right], l)

action make_call(target, args, l):
    return make_node("CALL", target, "", 0, args, l)

action make_field(base, field, l):
    return make_node("FIELD", field, "", 0, [base], l)

action make_index(coll, idx, l):
    return make_node("INDEX", "", "", 0, [coll, idx], l)

action make_len(inner, l):
    return make_node("LEN", "", "", 0, [inner], l)

# Only a literal's length is known to the front end; the checker uses this to
# prove a constant index without running anything.
action make_len_lit(n, l):
    return make_node("LEN_LIT", "", "", n, [], l)

action make_list_expr(items, l):
    return make_node("LIST", "", "", 0, items, l)

# The phase 2 inline fallback: <expr> otherwise <fallback>.
action make_fallback(inner, fb, l):
    return make_node("FALLBACK", "", "", 0, [inner, fb], l)

# <expr> in radians / <expr> in degrees.
action make_in_unit(unit, inner, l):
    return make_node("IN_UNIT", unit, "", 0, [inner], l)

# f(name: value) keeps the field name on the argument.
action make_named_arg(field, value, l):
    return make_node("NAMED_ARG", field, "", 0, [value], l)

# An expression the parser could not read. The checker reports it; it is never
# silently dropped.
action make_unknown(l):
    return make_node("UNKNOWN", "", "", 0, [], l)

# ── statements ──────────────────────────────────────────────────────────

action make_stmt(kind, name, children, l):
    return make_node(kind, name, "", 0, children, l)

action make_block(label, stmts, l):
    return make_node("BLOCK", label, "", 0, stmts, l)

action make_guard(cond, l):
    return make_node("GUARD", "", "", 0, [cond], l)

# The ceiling of a while ... bounded n: loop. An empty spelling means the loop
# declared no ceiling, which the checker refuses.
action make_bound(text, l):
    return make_node("BOUND", "", text, 0, [], l)

action make_while(cond, body, bound, l):
    return make_node("WHILE", "", "", 0, [cond, body, bound], l)

action make_if(cond, then_block, other_block, l):
    return make_node("IF", "", "", 0, [cond, then_block, other_block], l)

action make_for_each(var, list_expr, body, l):
    return make_node("FOR_EACH", var, "", 0, [list_expr, body], l)

action make_try(err_name, body, other_block, l):
    return make_node("TRY", err_name, "", 0, [body, other_block], l)

# ── items ───────────────────────────────────────────────────────────────

action make_param(name, ty, defaults, l):
    return make_node("PARAM", name, ty, 0, defaults, l)

action make_field_def(name, ty, l):
    return make_node("FIELD_DEF", name, ty, 0, [], l)

# kind_word is the keyword that was written (action, routine, func, check,
# filter); the node kind is the semantic item kind.
action make_item(kind_word, name, params, contracts, result, body, l):
    let kind = "ACTION"
    if kind_word == "check":
        set kind to "CHECK"
    if kind_word == "filter":
        set kind to "FILTER"
    return make_node(kind, name, result, 0, [params, contracts, body], l)

action make_record_item(name, fields, l):
    return make_node("RECORD", name, "", 0, fields, l)

action make_contract(kind_word, expr, l):
    return make_node("CONTRACT", kind_word, "", 0, [expr], l)

action make_recursion_bound(text, l):
    return make_node("RECURSION_BOUND", "", text, 0, [], l)

action make_routine_need(name, l):
    return make_node("ROUTINE_NEED", name, "", 0, [], l)

action make_when(cond, body, l):
    return make_node("WHEN", "", "", 0, [cond, body], l)

action make_every(duration, body, l):
    return make_node("EVERY", "", "", 0, [duration, body], l)

action make_program(uses, needs, items):
    let uses_node = make_node("USES", "", "", 0, uses, 0)
    let needs_node = make_node("NEEDS", "", "", 0, needs, 0)
    let items_node = make_node("ITEMS", "", "", 0, items, 0)
    return make_node("PROGRAM", "", "", 0, [uses_node, needs_node, items_node], 0)

action program_uses(prog: AstNode):
    return child_at(prog, 0)

action program_needs(prog: AstNode):
    return child_at(prog, 1)

action program_items(prog: AstNode):
    let items_node = child_at(prog, 2)
    return items_node.children

# ── vocabulary shared by the parser and the checker ─────────────────────

# The unit suffixes the language knows (the phase 3 lexicon). A unit word here
# is consumed as a suffix and recorded on the literal it follows.
action unit_word(w):
    if w == "m" or w == "meter" or w == "meters":
        return "m"
    if w == "km" or w == "kilometer" or w == "kilometers":
        return "km"
    if w == "cm" or w == "centimeter" or w == "centimeters":
        return "cm"
    if w == "mm" or w == "millimeter" or w == "millimeters":
        return "mm"
    if w == "s" or w == "sec" or w == "second" or w == "seconds":
        return "seconds"
    if w == "ms" or w == "millisecond" or w == "milliseconds":
        return "ms"
    if w == "h" or w == "hour" or w == "hours":
        return "hours"
    if w == "min" or w == "minute" or w == "minutes":
        return "minutes"
    if w == "kg" or w == "kilogram" or w == "kilograms":
        return "kg"
    if w == "g" or w == "gram" or w == "grams":
        return "gram"
    if w == "Celsius" or w == "celsius" or w == "C":
        return "Celsius"
    if w == "Kelvin" or w == "kelvin" or w == "K":
        return "Kelvin"
    if w == "Pascal" or w == "pascal" or w == "Pa":
        return "Pascal"
    if w == "mbar" or w == "millibar" or w == "millibars":
        return "mbar"
    if w == "hPa" or w == "hpa" or w == "hectopascal" or w == "hectopascals":
        return "hPa"
    if w == "ampere" or w == "amperes" or w == "amp" or w == "A":
        return "ampere"
    if w == "percent":
        return "%"
    if w == "degrees" or w == "degree" or w == "deg":
        return "degrees"
    if w == "radians" or w == "radian" or w == "rad":
        return "radians"
    return ""

action is_angle_unit(u):
    if u == "degrees" or u == "radians":
        return 1
    return 0

# Declared capability names resolve to a family: fan is a device instance,
# lidar a sensor, and a family name is itself.
action family_of_word(w):
    if w == "drone" or w == "rover" or w == "sensor" or w == "device" or w == "memory" or w == "policy" or w == "log" or w == "alert" or w == "ai" or w == "tool":
        return w
    if w == "tools":
        return "tool"
    if w == "agent" or w == "model" or w == "llm":
        return "ai"
    if w == "lidar" or w == "camera" or w == "thermostat" or w == "probe":
        return "sensor"
    if w == "fan" or w == "mister" or w == "pump" or w == "relay" or w == "valve" or w == "motor" or w == "light":
        return "device"
    return "device"

# Bare telemetry names, read through the script's hardware family.
action is_telemetry(w):
    if w == "battery" or w == "altitude" or w == "heading" or w == "speed" or w == "position" or w == "temperature" or w == "humidity" or w == "distance" or w == "armed":
        return 1
    if w == "latitude" or w == "longitude" or w == "satellites":
        return 1
    return 0

action digit_value(c):
    if c == "0":
        return 0
    if c == "1":
        return 1
    if c == "2":
        return 2
    if c == "3":
        return 3
    if c == "4":
        return 4
    if c == "5":
        return 5
    if c == "6":
        return 6
    if c == "7":
        return 7
    if c == "8":
        return 8
    if c == "9":
        return 9
    return 0

# Read a decimal literal's text as a number. Used where the front end has to
# reason about the value (a divisor, an index, a loop ceiling); it never fails.
action text_to_num(s):
    let len = length of s
    let i = 0
    let whole = 0
    let frac = 0
    let scale = 1
    let seen_dot = 0
    while i < len bounded 64:
        let c = s[i] otherwise "x"
        if c == ".":
            set seen_dot to 1
        otherwise:
            if c >= "0" and c <= "9":
                let d = digit_value(c)
                if seen_dot == 1:
                    set scale to scale * 10
                    set frac to frac + (d / scale otherwise 0)
                otherwise:
                    set whole to whole * 10 + d
        set i to i + 1
    return whole + frac

# lexer.kaze — Pure Kaze Tokenizer
#
# Emits NEWLINE, INDENT, DEDENT, STR, NUM, IDENT, OP (==, !=, <=, >=), SYM, EOF.
# Every token carries its 1-based line and column.
#
# Indentation is the off-side rule: a deeper line opens an INDENT, a shallower
# one closes as many DEDENTs as needed. Inside brackets (a list literal, a call
# whose arguments span lines) indentation is not significant, so no INDENT or
# DEDENT is emitted there. Units are lexed as ordinary words; the parser
# consumes them after a numeric literal.

action is_alpha(c):
    if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_":
        return 1
    return 0

action is_digit(c):
    if c >= "0" and c <= "9":
        return 1
    return 0

action is_alphanumeric(c):
    if is_alpha(c) == 1 or is_digit(c) == 1:
        return 1
    return 0

# Tokens accumulate in fixed-size chunks and are flattened once at the end, and the
# chunk size is the optimum of the copy model: appends cost N*C/2 and sealing the
# chunk list costs N^2/(2C), which balance at C ~= sqrt(N) -- about 190 for this
# compiler's own 35,000 tokens. Measured on the monolith: C=128 573 MB, C=192
# 557 MB, C=256 567 MB, C=384 611 MB.
# Appending to one growing list would copy the whole list per token, which is
# quadratic: on this compiler's own 3,900 lines that was gigabytes of churn.
action push_tok(chunks, chunk, chunk_len, tok):
    ensures length of result == 3
    let next_chunk = chunk + [tok]
    let next_len = chunk_len + 1
    if next_len >= 192:
        return [chunks + [next_chunk], [], 0]
    return [chunks, next_chunk, next_len]

action tokenize(src):
    let chunks = []
    let chunk = []
    let chunk_len = 0
    let len = length of src
    let i = 0
    let line = 1
    let col = 1
    let bracket_depth = 0

    let indent_stack = [0]

    while i < len bounded 1000000:
        let c = src[i] otherwise " "

        # 1. Skip spaces and tabs
        if c == " " or c == "\t":
            set i to i + 1
            set col to col + 1

        # 2. Comments
        otherwise:
            if c == "#":
                while i < len and (src[i] otherwise " ") != "\n" bounded 1000000:
                    set i to i + 1
                # The newline itself will be processed next

            # 3. Newlines and Indentation
            otherwise:
                if c == "\n":
                    let nl_tok = make_token("NEWLINE", "\n", line, col, i)
                    let acc1 = push_tok(chunks, chunk, chunk_len, nl_tok)
                    set chunks to acc1[0] otherwise []
                    set chunk to acc1[1] otherwise []
                    set chunk_len to acc1[2] otherwise 0
                    set i to i + 1
                    set line to line + 1
                    set col to 1

                    # Count leading spaces on the next line
                    let spaces = 0
                    while i < len and (src[i] otherwise "x") == " " bounded 1000000:
                        set spaces to spaces + 1
                        set i to i + 1
                        set col to col + 1

                    # Ignore blank or comment-only lines, and lines inside
                    # brackets: indentation there is layout, not structure.
                    if bracket_depth > 0:
                        set spaces to spaces
                    otherwise:
                        if i < len and (src[i] otherwise "x") != "\n" and (src[i] otherwise "x") != "#":
                            let curr_ind = indent_stack[(length of indent_stack) - 1] otherwise 0
                            if spaces > curr_ind:
                                let ind_tok = make_token("INDENT", "", line, col, i)
                                let acc2 = push_tok(chunks, chunk, chunk_len, ind_tok)
                                set chunks to acc2[0] otherwise []
                                set chunk to acc2[1] otherwise []
                                set chunk_len to acc2[2] otherwise 0
                                set indent_stack to indent_stack + [spaces]
                            otherwise:
                                if spaces < curr_ind:
                                    while (length of indent_stack) > 1 and (indent_stack[(length of indent_stack) - 1] otherwise 0) > spaces bounded 64:
                                        let ded_tok = make_token("DEDENT", "", line, col, i)
                                        let acc3 = push_tok(chunks, chunk, chunk_len, ded_tok)
                                        set chunks to acc3[0] otherwise []
                                        set chunk to acc3[1] otherwise []
                                        set chunk_len to acc3[2] otherwise 0
                                        # pop the stack: rebuild it one shorter
                                        let new_stack = []
                                        let stk_len = (length of indent_stack) - 1
                                        let si = 0
                                        while si < stk_len bounded 64:
                                            set new_stack to new_stack + [indent_stack[si] otherwise 0]
                                            set si to si + 1
                                        set indent_stack to new_stack

                # 4. String literal
                otherwise:
                    if c == "\"":
                        let start_col = col
                        let start = i
                        set i to i + 1
                        set col to col + 1
                        let text = ""
                        while i < len and (src[i] otherwise "\"") != "\"" bounded 1000000:
                            if src[i] == "\\":
                                set i to i + 1
                                set col to col + 1
                                if i < len:
                                    if src[i] == "n":
                                        set text to text + "\n"
                                    otherwise:
                                        if src[i] == "t":
                                            set text to text + "\t"
                                        otherwise:
                                            set text to text + (src[i] otherwise "")
                            otherwise:
                                set text to text + (src[i] otherwise "")
                            set i to i + 1
                            set col to col + 1
                        if i < len and (src[i] otherwise "x") == "\"":
                            set i to i + 1
                            set col to col + 1
                        let tok = make_token("STR", text, line, start_col, start)
                        let acc4 = push_tok(chunks, chunk, chunk_len, tok)
                        set chunks to acc4[0] otherwise []
                        set chunk to acc4[1] otherwise []
                        set chunk_len to acc4[2] otherwise 0

                    # 5. Number literal
                    otherwise:
                        if is_digit(c) == 1:
                            let start_col = col
                            let start = i
                            let text = ""
                            while i < len and (is_digit(src[i] otherwise "x") == 1 or (src[i] otherwise "x") == ".") bounded 1000000:
                                set text to text + (src[i] otherwise "")
                                set i to i + 1
                                set col to col + 1
                            let tok = make_token("NUM", text, line, start_col, start)
                            let acc5 = push_tok(chunks, chunk, chunk_len, tok)
                            set chunks to acc5[0] otherwise []
                            set chunk to acc5[1] otherwise []
                            set chunk_len to acc5[2] otherwise 0

                        # 6. Identifier or Keyword
                        otherwise:
                            if is_alpha(c) == 1:
                                let start_col = col
                                let start = i
                                let text = ""
                                while i < len and is_alphanumeric(src[i] otherwise "x") == 1 bounded 1000000:
                                    set text to text + (src[i] otherwise "")
                                    set i to i + 1
                                    set col to col + 1
                                let tok = make_token("IDENT", text, line, start_col, start)
                                let acc6 = push_tok(chunks, chunk, chunk_len, tok)
                                set chunks to acc6[0] otherwise []
                                set chunk to acc6[1] otherwise []
                                set chunk_len to acc6[2] otherwise 0

                            # 7. Two-character operators
                            otherwise:
                                let is_two = 0
                                if i + 1 < len:
                                    let next_c = src[i + 1] otherwise ""
                                    let two_s = c + next_c
                                    if two_s == "==" or two_s == "!=" or two_s == "<=" or two_s == ">=":
                                        let tok = make_token("OP", two_s, line, col, i)
                                        let acc7 = push_tok(chunks, chunk, chunk_len, tok)
                                        set chunks to acc7[0] otherwise []
                                        set chunk to acc7[1] otherwise []
                                        set chunk_len to acc7[2] otherwise 0
                                        set i to i + 2
                                        set col to col + 2
                                        set is_two to 1

                                # 8. Single-character symbols
                                if is_two == 0:
                                    if c == "[" or c == "(":
                                        set bracket_depth to bracket_depth + 1
                                    if c == "]" or c == ")":
                                        if bracket_depth > 0:
                                            set bracket_depth to bracket_depth - 1
                                    let tok = make_token("SYM", c, line, col, i)
                                    let acc8 = push_tok(chunks, chunk, chunk_len, tok)
                                    set chunks to acc8[0] otherwise []
                                    set chunk to acc8[1] otherwise []
                                    set chunk_len to acc8[2] otherwise 0
                                    set i to i + 1
                                    set col to col + 1

    # Emit remaining DEDENT tokens at EOF
    while (length of indent_stack) > 1 bounded 64:
        let ded_tok = make_token("DEDENT", "", line, col, i)
        let acc9 = push_tok(chunks, chunk, chunk_len, ded_tok)
        set chunks to acc9[0] otherwise []
        set chunk to acc9[1] otherwise []
        set chunk_len to acc9[2] otherwise 0
        let new_stack = []
        let stk_len = (length of indent_stack) - 1
        let si = 0
        while si < stk_len bounded 64:
            set new_stack to new_stack + [indent_stack[si] otherwise 0]
            set si to si + 1
        set indent_stack to new_stack

    let eof_tok = make_token("EOF", "", line, col, i)
    let acc10 = push_tok(chunks, chunk, chunk_len, eof_tok)
    set chunks to acc10[0] otherwise []
    set chunk to acc10[1] otherwise []
    set chunk_len to acc10[2] otherwise 0

    # Flatten once. Concatenating chunk by chunk is O(tokens * chunks), which is
    # 256x cheaper than concatenating token by token: the difference between a
    # compile that peaks in tens of megabytes and one that needs gigabytes.
    let flat = []
    for each part in chunks:
        set flat to flat + part
    if (length of chunk) > 0:
        set flat to flat + chunk
    return flat

# parser.kaze — Pure Kaze recursive-descent parser.
#
# Reads the whole human surface the engine accepts, in one pass, with recovery
# instead of panics:
#
#   * items: use, needs, record, action/routine/func, check, filter, when, every
#   * routine headers: typed parameters with defaults, "-> type", and the
#     synonym "routine" for "action"
#   * routine bodies: contract lines (requires / ensures / recursion bounded /
#     needs:) as declarations, then statements
#   * statements: let, set, if/otherwise, while ... bounded n, for each,
#     try/otherwise with err, guard, return, the sentence verbs (log, arm,
#     takeoff, fly to, stop, turn, drive, pulse, send alert, reject, allow,
#     remember, recall) and plain expressions
#   * expressions: precedence climbing with the phase 2 inline fallback
#     "<expr> otherwise <expr>", dynamic index, field access, calls with named
#     arguments, list literals (including multi-line), "length of", the phase 3
#     unit suffixes (m/km/cm/mm, seconds/ms/hours/minutes, kg/gram, degrees,
#     radians, Celsius/Kelvin, Pascal/mbar/hPa, ampere, percent), composite
#     units (m/s, km/h, m/s2), "<expr> in radians|degrees", and the geometry
#     sentences (distance between, slant distance, bearing from/to/of).
#
# Anything the parser cannot read becomes an UNKNOWN node, which the checker
# reports; nothing is silently dropped.

# ── token plumbing ──────────────────────────────────────────────────────

action tok(tokens, pos):
    let t = tokens[pos] otherwise make_token("EOF", "", 0, 0, 0)
    return t

action tok_kind(tokens, pos):
    let t = tok(tokens, pos)
    return t.kind

action tok_text(tokens, pos):
    let t = tok(tokens, pos)
    return t.text

action tok_line(tokens, pos):
    let t = tok(tokens, pos)
    return t.line

action is_sym(tokens, pos, text):
    let t = tok(tokens, pos)
    if t.kind == "SYM" and t.text == text:
        return 1
    return 0

action is_word(tokens, pos, word):
    let t = tok(tokens, pos)
    if t.kind == "IDENT" and t.text == word:
        return 1
    return 0

action is_kind(tokens, pos, kind):
    let t = tok(tokens, pos)
    if t.kind == kind:
        return 1
    return 0

action at_end(tokens, pos):
    if pos >= (length of tokens):
        return 1
    return 0

action skip_nl(tokens, pos):
    let p = pos
    let len = length of tokens
    while p < len and (tok_kind(tokens, p) == "NEWLINE") bounded 1000000:
        set p to p + 1
    return p

# Layout noise that is not structural: newlines and the indent marks a
# bracketed list or call can still produce.
action skip_noise(tokens, pos):
    let p = pos
    let len = length of tokens
    let moving = 1
    while moving == 1 and p < len bounded 1000000:
        let k = tok_kind(tokens, p)
        if k == "NEWLINE" or k == "INDENT" or k == "DEDENT":
            set p to p + 1
        otherwise:
            set moving to 0
    return p

# ── expression grammar (loosest to tightest) ────────────────────────────
#
#   expr      := or (otherwise expr)?
#   or        := and (or and)*
#   and       := relational (and relational)*
#   relational:= additive ((== != <= >= < >) additive)*
#   additive  := multiplicative ((+ -) multiplicative)*
#   multiplicative := unary ((* / %) unary)*
#   unary     := ("not" | "-") unary | postfix
#   postfix   := primary ("." name | "[" expr "]" | "in" angle-unit)*
#   primary   := literal | list | "(" expr ")" | "length of" unary | call | name

action parse_expr(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let r = parse_or(tokens, pos)
    let node = r[0]
    let p = r[1]
    # "otherwise" is the fallback keyword, unless it opens an else block.
    if is_word(tokens, p, "otherwise") and not is_sym(tokens, p + 1, ":"):
        let f = parse_expr(tokens, p + 1)
        return [make_fallback(node, f[0], tok_line(tokens, p)), f[1]]
    return [node, p]

action parse_or(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let r = parse_and(tokens, pos)
    let node = r[0]
    let p = r[1]
    let done = 0
    while done == 0 bounded 1000000:
        if is_word(tokens, p, "or"):
            let rr = parse_and(tokens, p + 1)
            set node to make_bin("or", node, rr[0], tok_line(tokens, p))
            set p to rr[1]
        otherwise:
            set done to 1
    return [node, p]

action parse_and(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let r = parse_relational(tokens, pos)
    let node = r[0]
    let p = r[1]
    let done = 0
    while done == 0 bounded 1000000:
        if is_word(tokens, p, "and"):
            let rr = parse_relational(tokens, p + 1)
            set node to make_bin("and", node, rr[0], tok_line(tokens, p))
            set p to rr[1]
        otherwise:
            set done to 1
    return [node, p]

action parse_relational(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let r = parse_additive(tokens, pos)
    let node = r[0]
    let p = r[1]
    let done = 0
    while done == 0 bounded 1000000:
        let t = tok(tokens, p)
        let is_rel = 0
        if t.kind == "OP" and (t.text == "==" or t.text == "!=" or t.text == "<=" or t.text == ">="):
            set is_rel to 1
        if t.kind == "SYM" and (t.text == "<" or t.text == ">"):
            set is_rel to 1
        if is_rel == 1:
            let rr = parse_additive(tokens, p + 1)
            set node to make_bin(t.text, node, rr[0], t.line)
            set p to rr[1]
        otherwise:
            set done to 1
    return [node, p]

action parse_additive(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let r = parse_multiplicative(tokens, pos)
    let node = r[0]
    let p = r[1]
    let done = 0
    while done == 0 bounded 1000000:
        let t = tok(tokens, p)
        if t.kind == "SYM" and (t.text == "+" or t.text == "-"):
            let rr = parse_multiplicative(tokens, p + 1)
            set node to make_bin(t.text, node, rr[0], t.line)
            set p to rr[1]
        otherwise:
            set done to 1
    return [node, p]

action parse_multiplicative(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let r = parse_unary(tokens, pos)
    let node = r[0]
    let p = r[1]
    let done = 0
    while done == 0 bounded 1000000:
        let t = tok(tokens, p)
        let is_op = 0
        if t.kind == "SYM" and (t.text == "*" or t.text == "/" or t.text == "%"):
            set is_op to 1
        if is_op == 1:
            let rr = parse_unary(tokens, p + 1)
            set node to make_bin(t.text, node, rr[0], t.line)
            set p to rr[1]
        otherwise:
            set done to 1
    return [node, p]

action parse_unary(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    if is_word(tokens, pos, "not"):
        let r = parse_unary(tokens, pos + 1)
        return [make_bin("not", r[0], make_num("0", tok_line(tokens, pos)), tok_line(tokens, pos)), r[1]]
    if is_sym(tokens, pos, "-"):
        let r = parse_unary(tokens, pos + 1)
        return [make_bin("-", make_num("0", tok_line(tokens, pos)), r[0], tok_line(tokens, pos)), r[1]]
    return parse_postfix(tokens, pos)

action parse_postfix(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let r = parse_primary(tokens, pos)
    let node = r[0]
    let p = r[1]
    let done = 0
    while done == 0 bounded 1000000:
        if is_sym(tokens, p, "."):
            let nt = tok(tokens, p + 1)
            set node to make_field(node, nt.text, nt.line)
            set p to p + 2
        otherwise:
            if is_sym(tokens, p, "["):
                let ir = parse_expr(tokens, p + 1)
                let q = skip_noise(tokens, ir[1])
                if is_sym(tokens, q, "]"):
                    set q to q + 1
                set node to make_index(node, ir[0], tok_line(tokens, p))
                set p to q
            otherwise:
                if is_word(tokens, p, "in") and (is_word(tokens, p + 1, "radians") or is_word(tokens, p + 1, "degrees")):
                    let u = tok_text(tokens, p + 1)
                    set node to make_in_unit(u, node, tok_line(tokens, p))
                    set p to p + 2
                otherwise:
                    set done to 1
    return [node, p]

# The optional unit suffix of a numeric literal. Composite units only join
# here, right after a number: 1.2 m/s, 9.8 m/s2, 40 km/h.
action take_unit(tokens, pos):
    ensures length of result == 2
    let t = tok(tokens, pos)
    if t.kind == "SYM" and t.text == "%":
        return ["%", pos + 1]
    if t.kind != "IDENT":
        return ["", pos]
    let u = unit_word(t.text)
    if u == "":
        return ["", pos]
    if is_sym(tokens, pos + 1, "/"):
        let per = tok_text(tokens, pos + 2)
        if per == "s2":
            return [u + "/s2", pos + 3]
        let pu = unit_word(per)
        if pu == "seconds":
            return [u + "/s", pos + 3]
        if pu == "hours":
            return [u + "/h", pos + 3]
    return [u, pos + 1]

action parse_primary(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let p = skip_nl(tokens, pos)
    let t = tok(tokens, p)
    let k = t.kind
    let w = t.text
    let l = t.line

    # 1. Number literal, with an optional unit suffix.
    if k == "NUM":
        let u = take_unit(tokens, p + 1)
        return [make_node("NUM", u[0], w, 0, [], l), u[1]]

    # 2. Text literal.
    if k == "STR":
        return [make_str(w, l), p + 1]

    # 3. List literal, possibly spanning lines.
    if k == "SYM" and w == "[":
        return parse_list_literal(tokens, p)

    # 4. Parenthesised expression.
    if k == "SYM" and w == "(":
        let r = parse_expr(tokens, p + 1)
        let q = skip_noise(tokens, r[1])
        if is_sym(tokens, q, ")"):
            set q to q + 1
        return [r[0], q]

    # 5. length of x
    if k == "IDENT" and w == "length":
        if is_word(tokens, p + 1, "of"):
            let r = parse_unary(tokens, p + 2)
            return [make_len(r[0], l), r[1]]

    # 6. distance between a and b / slant distance between a and b
    if k == "IDENT" and w == "distance":
        if is_word(tokens, p + 1, "between"):
            let a = parse_unary(tokens, p + 2)
            if is_word(tokens, a[1], "and"):
                let b = parse_unary(tokens, a[1] + 1)
                return [make_call("geo.distance", [a[0], b[0]], l), b[1]]
            return [make_call("geo.distance", [a[0]], l), a[1]]
    if k == "IDENT" and w == "slant":
        if is_word(tokens, p + 1, "distance") and is_word(tokens, p + 2, "between"):
            let a = parse_unary(tokens, p + 3)
            if is_word(tokens, a[1], "and"):
                let b = parse_unary(tokens, a[1] + 1)
                return [make_call("geo.slant_distance", [a[0], b[0]], l), b[1]]
            return [make_call("geo.slant_distance", [a[0]], l), a[1]]

    # 7. bearing from a to b / bearing of a
    if k == "IDENT" and w == "bearing":
        if is_word(tokens, p + 1, "from"):
            let a = parse_unary(tokens, p + 2)
            if is_word(tokens, a[1], "to"):
                let b = parse_unary(tokens, a[1] + 1)
                return [make_call("geo.bearing_from", [a[0], b[0]], l), b[1]]
        if is_word(tokens, p + 1, "of"):
            let a = parse_unary(tokens, p + 2)
            return [make_call("geo.bearing_of", [a[0]], l), a[1]]

    # 8. policy detects <noun> in <expr>
    if k == "IDENT" and w == "policy":
        if is_word(tokens, p + 1, "detects") or is_word(tokens, p + 1, "detect"):
            let noun = make_str(tok_text(tokens, p + 2), l)
            let q = p + 3
            if is_word(tokens, q, "in"):
                let a = parse_unary(tokens, q + 1)
                return [make_call("policy.detects", [noun, a[0]], l), a[1]]
            return [make_call("policy.detects", [noun], l), q]

    # 9. link lost [for <duration>]
    if k == "IDENT" and w == "link":
        if is_word(tokens, p + 1, "lost"):
            let q = p + 2
            let args = []
            if is_word(tokens, q, "for"):
                let a = parse_unary(tokens, q + 1)
                set args to [a[0]]
                set q to a[1]
            return [make_call("link_lost", args, l), q]

    # 10. Booleans, calls and names.
    if k == "IDENT":
        if w == "true":
            return [make_bool(1, l), p + 1]
        if w == "false":
            return [make_bool(0, l), p + 1]
        # A capability call: sensor.temperature(), policy.detects(..)
        if is_sym(tokens, p + 1, ".") and is_kind(tokens, p + 2, "IDENT") and is_sym(tokens, p + 3, "("):
            let full = w + "." + tok_text(tokens, p + 2)
            let args = parse_call_args(tokens, p + 4)
            return [make_call(full, args[0], l), args[1]]
        if is_sym(tokens, p + 1, "("):
            let args = parse_call_args(tokens, p + 2)
            return [make_call(w, args[0], l), args[1]]
        return [make_ident(w, l), p + 1]

    # 11. Nothing readable here. Reported by the checker, never dropped.
    return [make_unknown(l), p + 1]

action parse_list_literal(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let items = []
    let p = pos + 1
    let done = 0
    while done == 0 bounded 1000000:
        set p to skip_noise(tokens, p)
        if is_sym(tokens, p, "]"):
            set p to p + 1
            set done to 1
        otherwise:
            if at_end(tokens, p) == 1:
                set done to 1
            otherwise:
                let r = parse_expr(tokens, p)
                set items to items + [r[0]]
                set p to skip_noise(tokens, r[1])
                if is_sym(tokens, p, ","):
                    set p to p + 1
    return [make_list_expr(items, tok_line(tokens, pos)), p]

action parse_call_args(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let args = []
    let p = pos
    let done = 0
    while done == 0 bounded 1000000:
        set p to skip_noise(tokens, p)
        if is_sym(tokens, p, ")"):
            set p to p + 1
            set done to 1
        otherwise:
            if at_end(tokens, p) == 1 or is_kind(tokens, p, "EOF"):
                set done to 1
            otherwise:
                if is_kind(tokens, p, "IDENT") and is_sym(tokens, p + 1, ":"):
                    let fname = tok_text(tokens, p)
                    let r = parse_expr(tokens, p + 2)
                    set args to args + [make_named_arg(fname, r[0], tok_line(tokens, p))]
                    set p to r[1]
                otherwise:
                    let r = parse_expr(tokens, p)
                    set args to args + [r[0]]
                    set p to r[1]
                set p to skip_noise(tokens, p)
                if is_sym(tokens, p, ","):
                    set p to p + 1
    return [args, p]

# ── statements ──────────────────────────────────────────────────────────

action parse_block(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let p = skip_nl(tokens, pos)
    let stmts = []
    let l = tok_line(tokens, p)
    if is_kind(tokens, p, "INDENT"):
        set p to p + 1
        let done = 0
        while done == 0 bounded 1000000:
            set p to skip_nl(tokens, p)
            let k = tok_kind(tokens, p)
            if k == "DEDENT":
                set p to p + 1
                set done to 1
            otherwise:
                if k == "EOF":
                    set done to 1
                otherwise:
                    if k == "INDENT":
                        set p to p + 1
                    otherwise:
                        let r = parse_stmt(tokens, p)
                        set stmts to stmts + [r[0]]
                        if r[1] > p:
                            set p to r[1]
                        otherwise:
                            set p to p + 1
    return [make_block("body", stmts, l), p]

action parse_stmt(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let p = skip_nl(tokens, pos)
    let t = tok(tokens, p)
    let w = t.text
    let l = t.line

    if t.kind == "IDENT":
        # A capability call statement: log.info("x"), sensor.read(1), drone.arm()
        if is_sym(tokens, p + 1, ".") and is_kind(tokens, p + 2, "IDENT") and is_sym(tokens, p + 3, "("):
            let cr = parse_expr(tokens, p)
            return [make_stmt("EXPR", "", [cr[0]], l), cr[1]]

        # let name = expr
        if w == "let":
            let nm = tok_text(tokens, p + 1)
            let q = p + 2
            if is_sym(tokens, q, "="):
                set q to q + 1
            let r = parse_expr(tokens, q)
            return [make_stmt("LET", nm, [r[0]], l), r[1]]

        # set name to expr / set name = expr
        if w == "set":
            let nm = tok_text(tokens, p + 1)
            let q = p + 2
            if is_word(tokens, q, "to") or is_sym(tokens, q, "="):
                set q to q + 1
            let r = parse_expr(tokens, q)
            return [make_stmt("SET", nm, [r[0]], l), r[1]]

        # return expr / return to launch
        if w == "return":
            let nt = tok(tokens, p + 1)
            if nt.kind == "IDENT" and nt.text == "to":
                return [make_stmt("EXPR", "", [make_call("drone.rtl", [], l)], l), p + 3]
            if nt.kind == "NEWLINE" or nt.kind == "DEDENT" or nt.kind == "EOF" or nt.kind == "INDENT":
                return [make_stmt("RETURN", "", [], l), p + 1]
            let r = parse_expr(tokens, p + 1)
            return [make_stmt("RETURN", "", [r[0]], l), r[1]]

        # guard <expr>
        if w == "guard":
            let r = parse_expr(tokens, p + 1)
            return [make_guard(r[0], l), r[1]]

        # if cond: block otherwise: block
        if w == "if":
            let c = parse_expr(tokens, p + 1)
            let q = c[1]
            if is_sym(tokens, q, ":"):
                set q to q + 1
            let b = parse_block(tokens, q)
            let q2 = skip_nl(tokens, b[1])
            let other = make_block("otherwise", [], l)
            if is_word(tokens, q2, "otherwise"):
                let q3 = q2 + 1
                if is_sym(tokens, q3, ":"):
                    set q3 to q3 + 1
                let ob = parse_block(tokens, q3)
                set other to ob[0]
                set q2 to ob[1]
            return [make_if(c[0], b[0], other, l), q2]

        # while cond bounded n: block
        if w == "while":
            let c = parse_expr(tokens, p + 1)
            let q = c[1]
            let bound = make_bound("", l)
            if is_word(tokens, q, "bounded"):
                let bt = tok(tokens, q + 1)
                if bt.kind == "NUM":
                    set bound to make_bound(bt.text, bt.line)
                otherwise:
                    set bound to make_bound("?", bt.line)
                set q to q + 2
            if is_sym(tokens, q, ":"):
                set q to q + 1
            let b = parse_block(tokens, q)
            return [make_while(c[0], b[0], bound, l), b[1]]

        # for each name in list: block
        if w == "for":
            let q = p + 1
            if is_word(tokens, q, "each"):
                set q to q + 1
            let var = tok_text(tokens, q)
            set q to q + 1
            if is_word(tokens, q, "in"):
                set q to q + 1
            let le = parse_expr(tokens, q)
            let q2 = le[1]
            if is_sym(tokens, q2, ":"):
                set q2 to q2 + 1
            let b = parse_block(tokens, q2)
            return [make_for_each(var, le[0], b[0], l), b[1]]

        # try: block otherwise with err: block
        if w == "try":
            let q = p + 1
            if is_sym(tokens, q, ":"):
                set q to q + 1
            let b = parse_block(tokens, q)
            let q2 = skip_nl(tokens, b[1])
            let err = ""
            let other = make_block("otherwise", [], l)
            if is_word(tokens, q2, "otherwise"):
                let q3 = q2 + 1
                if is_word(tokens, q3, "with"):
                    set err to tok_text(tokens, q3 + 1)
                    set q3 to q3 + 2
                if is_sym(tokens, q3, ":"):
                    set q3 to q3 + 1
                let ob = parse_block(tokens, q3)
                set other to ob[0]
                set q2 to ob[1]
            return [make_try(err, b[0], other, l), q2]

        # log / arm / takeoff / fly / stop / turn / drive / pulse / send /
        # reject / allow / remember / recall
        let v = parse_verb(tokens, p)
        if v[2] == 1:
            return [make_stmt("EXPR", "", [v[0]], l), v[1]]

    # Plain expression statement (a routine call, usually).
    let r = parse_expr(tokens, p)
    return [make_stmt("EXPR", "", [r[0]], l), r[1]]

# A sentence verb, or [none, pos, 0] when the line is not one.
action parse_verb(tokens, pos):
    recursion bounded 200
    ensures length of result == 3
    let t = tok(tokens, pos)
    let w = t.text
    let l = t.line
    if t.kind != "IDENT":
        return [none_node(), pos, 0]

    if w == "log":
        let q = pos + 1
        let level = "info"
        if is_word(tokens, q, "info") or is_word(tokens, q, "warn") or is_word(tokens, q, "warning") or is_word(tokens, q, "error") or is_word(tokens, q, "debug"):
            set level to tok_text(tokens, q)
            if level == "warning":
                set level to "warn"
            set q to q + 1
        let r = parse_expr(tokens, q)
        return [make_call("log." + level, [r[0]], l), r[1], 1]

    if w == "arm":
        let noun = tok_text(tokens, pos + 1)
        return [make_call(family_of_word(noun) + ".arm", [], l), pos + 2, 1]

    if w == "takeoff":
        let q = pos + 1
        if is_word(tokens, q, "to"):
            set q to q + 1
        let r = parse_expr(tokens, q)
        return [make_call("drone.takeoff", [r[0]], l), r[1], 1]

    if w == "fly":
        let q = pos + 1
        if is_word(tokens, q, "to"):
            set q to q + 1
        let r = parse_expr(tokens, q)
        let args = [r[0]]
        let q2 = r[1]
        if is_word(tokens, q2, "at"):
            let a = parse_expr(tokens, q2 + 1)
            set args to args + [a[0]]
            set q2 to a[1]
        return [make_call("drone.goto", args, l), q2, 1]

    if w == "stop":
        let noun = tok_text(tokens, pos + 1)
        if noun == "drone" or noun == "rover":
            return [make_call(noun + ".stop", [], l), pos + 2, 1]
        return [make_call("rover.stop", [], l), pos + 1, 1]

    if w == "hold":
        # 'hold' or 'hold position' — both lower to the same effector call.
        if is_word(tokens, pos + 1, "position"):
            return [make_call("drone.hold", [], l), pos + 2, 1]
        return [make_call("drone.hold", [], l), pos + 1, 1]

    if w == "land":
        if is_word(tokens, pos + 1, "drone"):
            return [make_call("drone.land", [], l), pos + 2, 1]
        return [make_call("drone.land", [], l), pos + 1, 1]

    if w == "turn":
        if is_word(tokens, pos + 1, "on") or is_word(tokens, pos + 1, "off"):
            let on = 1
            if is_word(tokens, pos + 1, "off"):
                set on to 0
            let dev = tok_text(tokens, pos + 2)
            return [make_call("device.set_relay", [make_str(dev, l), make_bool(on, l)], l), pos + 3, 1]
        if is_word(tokens, pos + 1, "left") or is_word(tokens, pos + 1, "right"):
            let op = "rover.turn_right"
            if is_word(tokens, pos + 1, "left"):
                set op to "rover.turn_left"
            let q = pos + 2
            if is_word(tokens, q, "by"):
                set q to q + 1
            let r = parse_expr(tokens, q)
            return [make_call(op, [r[0]], l), r[1], 1]

    if w == "drive":
        let op = "rover.forward"
        let q = pos + 1
        if is_word(tokens, q, "forward"):
            set q to q + 1
        otherwise:
            if is_word(tokens, q, "backward"):
                set op to "rover.backward"
                set q to q + 1
        if is_word(tokens, q, "at"):
            let r = parse_expr(tokens, q + 1)
            return [make_call(op, [r[0]], l), r[1], 1]
        return [make_call(op, [], l), q, 1]

    if w == "pulse":
        let dev = make_str(tok_text(tokens, pos + 1), l)
        let q = pos + 2
        if is_word(tokens, q, "for"):
            let r = parse_expr(tokens, q + 1)
            return [make_call("device.pulse", [dev, r[0]], l), r[1], 1]
        return [make_call("device.pulse", [dev], l), q, 1]

    if w == "send":
        if is_word(tokens, pos + 1, "alert"):
            let r = parse_expr(tokens, pos + 2)
            return [make_call("alert.send", [r[0]], l), r[1], 1]

    if w == "reject":
        let q = pos + 1
        if is_word(tokens, q, "with"):
            set q to q + 1
        let r = parse_expr(tokens, q)
        return [make_call("policy.reject", [r[0]], l), r[1], 1]

    if w == "allow":
        let nt = tok(tokens, pos + 1)
        if nt.kind == "NEWLINE" or nt.kind == "DEDENT" or nt.kind == "EOF" or nt.kind == "INDENT":
            return [make_call("policy.allow", [], l), pos + 1, 1]
        let r = parse_expr(tokens, pos + 1)
        return [make_call("policy.allow", [r[0]], l), r[1], 1]

    if w == "remember":
        let r = parse_expr(tokens, pos + 1)
        let q = r[1]
        if is_word(tokens, q, "as"):
            let lab = parse_expr(tokens, q + 1)
            return [make_call("memory.save", [lab[0], r[0]], l), lab[1], 1]
        return [make_call("memory.save", [r[0]], l), q, 1]

    if w == "recall":
        let q = pos + 1
        if is_word(tokens, q, "memories"):
            set q to q + 1
        if is_word(tokens, q, "matching"):
            set q to q + 1
        let r = parse_expr(tokens, q)
        return [make_call("memory.recall", [r[0]], l), r[1], 1]

    return [none_node(), pos, 0]

# ── items ───────────────────────────────────────────────────────────────

# A routine body: contract declarations first (in any order), then statements.
# requires / ensures / recursion bounded / needs: never become statements.
action parse_routine_body(tokens, pos):
    recursion bounded 200
    ensures length of result == 3
    let p = skip_nl(tokens, pos)
    let contracts = []
    let stmts = []
    let l = tok_line(tokens, p)
    if is_kind(tokens, p, "INDENT"):
        set p to p + 1
        let seen = 0
        let done = 0
        while done == 0 bounded 1000000:
            set p to skip_nl(tokens, p)
            let k = tok_kind(tokens, p)
            let w = tok_text(tokens, p)
            if k == "DEDENT":
                set p to p + 1
                set done to 1
            otherwise:
                if k == "EOF":
                    set done to 1
                otherwise:
                    if seen == 0 and k == "IDENT" and (w == "requires" or w == "ensures"):
                        let r = parse_expr(tokens, p + 1)
                        set contracts to contracts + [make_contract(w, r[0], tok_line(tokens, p))]
                        set p to r[1]
                    otherwise:
                        if seen == 0 and k == "IDENT" and w == "recursion":
                            let q = p + 1
                            if is_word(tokens, q, "bounded"):
                                set q to q + 1
                            let bt = tok(tokens, q)
                            if bt.kind == "NUM":
                                set contracts to contracts + [make_recursion_bound(bt.text, bt.line)]
                            otherwise:
                                set contracts to contracts + [make_recursion_bound("?", bt.line)]
                            set p to q + 1
                        otherwise:
                            if seen == 0 and k == "IDENT" and w == "needs":
                                let nr = parse_cap_list(tokens, p + 1)
                                set contracts to contracts + nr[0]
                                set p to nr[1]
                            otherwise:
                                set seen to 1
                                let r = parse_stmt(tokens, p)
                                set stmts to stmts + [r[0]]
                                if r[1] > p:
                                    set p to r[1]
                                otherwise:
                                    set p to p + 1
    return [contracts, make_block("body", stmts, l), p]

# The capability list of a routine's own needs: line.
action parse_cap_list(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let p = pos
    if is_sym(tokens, p, ":"):
        set p to p + 1
    let out = []
    let done = 0
    while done == 0 bounded 100000:
        let t = tok(tokens, p)
        if t.kind == "IDENT":
            let nm = t.text
            set p to p + 1
            if is_sym(tokens, p, "."):
                let nxt = tok_text(tokens, p + 1)
                set nm to nm + "." + nxt
                set p to p + 2
                if is_sym(tokens, p, "("):
                    let depth = 1
                    set p to p + 1
                    while depth > 0 and at_end(tokens, p) == 0 bounded 1000:
                        if is_sym(tokens, p, "("):
                            set depth to depth + 1
                        if is_sym(tokens, p, ")"):
                            set depth to depth - 1
                        set p to p + 1
            set out to out + [make_routine_need(nm, t.line)]
            if is_sym(tokens, p, ","):
                set p to p + 1
        otherwise:
            set done to 1
    return [out, p]

action parse_params(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let out = []
    let p = pos
    let done = 0
    while done == 0 bounded 100000:
        set p to skip_noise(tokens, p)
        if is_sym(tokens, p, ")"):
            set p to p + 1
            set done to 1
        otherwise:
            if at_end(tokens, p) == 1:
                set done to 1
            otherwise:
                let t = tok(tokens, p)
                if t.kind == "IDENT":
                    let nm = t.text
                    let ty = ""
                    let q = p + 1
                    if is_sym(tokens, q, ":"):
                        set ty to tok_text(tokens, q + 1)
                        set q to q + 2
                        if ty == "untrusted" and is_sym(tokens, q, "<"):
                            let depth = 1
                            set q to q + 1
                            while depth > 0 and at_end(tokens, q) == 0 bounded 1000:
                                if is_sym(tokens, q, "<"):
                                    set depth to depth + 1
                                if is_sym(tokens, q, ">"):
                                    set depth to depth - 1
                                set q to q + 1
                    let defaults = []
                    if is_sym(tokens, q, "="):
                        let r = parse_expr(tokens, q + 1)
                        set defaults to [r[0]]
                        set q to r[1]
                    set out to out + [make_param(nm, ty, defaults, t.line)]
                    set p to q
                otherwise:
                    set p to p + 1
                if is_sym(tokens, p, ","):
                    set p to p + 1
    return [out, p]

action parse_routine(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let kw = tok_text(tokens, pos)
    let l = tok_line(tokens, pos)
    let name = tok_text(tokens, pos + 1)
    let p = pos + 2
    let params = []
    if is_sym(tokens, p, "("):
        let pr = parse_params(tokens, p + 1)
        set params to pr[0]
        set p to pr[1]
    let result = ""
    if is_sym(tokens, p, "-") and is_sym(tokens, p + 1, ">"):
        set result to tok_text(tokens, p + 2)
        set p to p + 3
    if is_sym(tokens, p, ":"):
        set p to p + 1
    let br = parse_routine_body(tokens, p)
    let params_node = make_node("PARAMS", "", "", 0, params, l)
    let contracts_node = make_node("CONTRACTS", "", "", 0, br[0], l)
    return [make_item(kw, name, params_node, contracts_node, result, br[1], l), br[2]]

action parse_record(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let l = tok_line(tokens, pos)
    let name = tok_text(tokens, pos + 1)
    let p = pos + 2
    if is_sym(tokens, p, ":"):
        set p to p + 1
    let fields = []
    set p to skip_nl(tokens, p)
    if is_kind(tokens, p, "INDENT"):
        set p to p + 1
        let done = 0
        while done == 0 bounded 100000:
            set p to skip_nl(tokens, p)
            let k = tok_kind(tokens, p)
            if k == "DEDENT":
                set p to p + 1
                set done to 1
            otherwise:
                if k == "EOF":
                    set done to 1
                otherwise:
                    if k == "IDENT":
                        let fname = tok_text(tokens, p)
                        let fty = "any"
                        let q = p + 1
                        if is_sym(tokens, q, ":"):
                            set fty to tok_text(tokens, q + 1)
                            set q to q + 2
                        set fields to fields + [make_field_def(fname, fty, tok_line(tokens, p))]
                        set p to q
                    otherwise:
                        set p to p + 1
    return [make_record_item(name, fields, l), p]

action parse_when(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let l = tok_line(tokens, pos)
    let c = parse_expr(tokens, pos + 1)
    let p = c[1]
    if is_sym(tokens, p, ":"):
        set p to p + 1
    let b = parse_block(tokens, p)
    return [make_when(c[0], b[0], l), b[1]]

action parse_every(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let l = tok_line(tokens, pos)
    let d = parse_expr(tokens, pos + 1)
    let p = d[1]
    if is_sym(tokens, p, ":"):
        set p to p + 1
    let b = parse_block(tokens, p)
    return [make_every(d[0], b[0], l), b[1]]

# use "<path>": the loader resolves it; the parser records it so the dual
# syntax engine and the checker can both see the imports.
action parse_use_line(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let l = tok_line(tokens, pos)
    let path = ""
    let p = pos + 1
    let moving = 1
    while moving == 1 bounded 1000000:
        let t = tok(tokens, p)
        if t.kind == "STR":
            set path to t.text
        if t.kind == "NEWLINE" or t.kind == "EOF" or t.kind == "DEDENT" or at_end(tokens, p) == 1:
            set moving to 0
        otherwise:
            set p to p + 1
    return [make_node("USE", path, "", 0, [], l), p]

action parse_needs(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let p = pos + 1
    if is_sym(tokens, p, ":"):
        set p to p + 1
    let out = []
    let done = 0
    while done == 0 bounded 100000:
        let t = tok(tokens, p)
        if t.kind == "IDENT":
            set out to out + [make_node("NEED", t.text, "", 0, [], t.line)]
            set p to p + 1
        otherwise:
            if is_sym(tokens, p, ","):
                set p to p + 1
            otherwise:
                set done to 1
    return [out, p]

action parse_program(tokens):
    recursion bounded 200
    let uses = []
    let needs = []
    let items = []
    let p = 0
    let len = length of tokens
    let done = 0
    while done == 0 and p < len bounded 1000000:
        set p to skip_noise(tokens, p)
        if p >= len:
            set done to 1
        otherwise:
            let t = tok(tokens, p)
            let k = t.kind
            let w = t.text
            if k == "EOF":
                set done to 1
            otherwise:
                if k == "IDENT" and w == "use":
                    let r = parse_use_line(tokens, p)
                    set uses to uses + [r[0]]
                    set p to r[1]
                otherwise:
                    if k == "IDENT" and w == "needs":
                        let r = parse_needs(tokens, p)
                        set needs to needs + r[0]
                        set p to r[1]
                    otherwise:
                        if k == "IDENT" and w == "record":
                            let r = parse_record(tokens, p)
                            set items to items + [r[0]]
                            set p to r[1]
                        otherwise:
                            if k == "IDENT" and (w == "action" or w == "routine" or w == "func" or w == "check" or w == "filter"):
                                let r = parse_routine(tokens, p)
                                set items to items + [r[0]]
                                set p to r[1]
                            otherwise:
                                if k == "IDENT" and w == "when":
                                    let r = parse_when(tokens, p)
                                    set items to items + [r[0]]
                                    set p to r[1]
                                otherwise:
                                    if k == "IDENT" and w == "every":
                                        let r = parse_every(tokens, p)
                                        set items to items + [r[0]]
                                        set p to r[1]
                                    otherwise:
                                        set p to p + 1
    return make_program(uses, needs, items)

# checker.kaze — the pure-Kaze semantic checker.
#
# It reads the AST the parser produced and returns a list of Diagnostic
# records. It never runs the program, never prints and never fabricates a pass:
# a rule it cannot decide produces no diagnostic, and SELF-HOSTING.md names
# every rule it implements.
#
# Rules implemented from the AST alone (phase 2 and phase 5, H-1):
#
#   1. a capability family used but not declared in needs:   E_CAP_UNDECLARED
#   2. a capability operation the registry does not know:     E_KAZE_CAP_OP
#   3. a name that is not bound and not a known builtin:      E_KAZE_UNKNOWN_NAME
#   4. a filter whose body can fall off the end:              E_KAZE_FILTER_FALLTHROUGH
#   5. division or modulo with no fallback and a divisor
#      that is not a non-zero literal:                         E_KAZE_MISSING_FALLBACK
#   6. a dynamic index with no fallback and no enclosing
#      length guard:                                          E_KAZE_MISSING_FALLBACK
#   7. a constant index outside a literal's length:           E_KAZE_BOUNDS
#   8. a while loop with no bounded ceiling:                  E_KAZE_LOOP_UNBOUNDED
#   9. a recursive routine with no recursion bounded:         E_KAZE_RECURSION_UNBOUNDED
#  10. a requires/ensures clause that is not boolean:         E_KAZE_CONTRACT_NOT_BOOL
#  11. a needs: entry that is not a family or an instance:    E_KAZE_CAP_UNKNOWN
#  12. an expression the parser could not read:               E_KAZE_PARSE
#
# The Rust front end (kaze/src/checker.rs, strict.rs) remains the reference for
# everything else: type inference, unit algebra, host-record field fallbacks,
# capability argument counts, contract satisfiability and interval propagation.

record Diagnostic:
    code: str
    line: num
    msg: str

action diag(code, line, msg):
    return Diagnostic(code: code, line: line, msg: msg)

action render_diag(d: Diagnostic):
    return d.code + " at line " + d.line + ": " + d.msg

# ── small text and list helpers ─────────────────────────────────────────

action list_has(items, want):
    let i = 0
    let len = length of items
    let found = 0
    while i < len and found == 0 bounded 1000000:
        let cur = items[i] otherwise ""
        if cur == want:
            set found to 1
        set i to i + 1
    return found

action drop_last(items):
    let out = []
    let len = length of items
    let i = 0
    while i < len - 1 bounded 1000000:
        set out to out + [items[i] otherwise ""]
        set i to i + 1
    return out

# The part of a name before the first dot, or the whole name.
action head_words(name):
    let len = length of name
    let i = 0
    let out = ""
    let done = 0
    while i < len and done == 0 bounded 1000:
        let c = name[i] otherwise "x"
        if c == ".":
            set done to 1
        otherwise:
            set out to out + c
        set i to i + 1
    return out

# The part of a name after the first dot.
action tail_words(name):
    let len = length of name
    let i = 0
    let out = ""
    let seen = 0
    while i < len bounded 1000:
        let c = name[i] otherwise "x"
        if seen == 1:
            set out to out + c
        if c == "." and seen == 0:
            set seen to 1
        set i to i + 1
    return out

action has_dot(name):
    let len = length of name
    let i = 0
    let found = 0
    while i < len bounded 1000:
        if (name[i] otherwise "x") == ".":
            set found to 1
        set i to i + 1
    return found

action is_upper(word):
    let len = length of word
    if len == 0:
        return 0
    let c = word[0] otherwise "?"
    if c >= "A" and c <= "Z":
        return 1
    return 0

# ── the capability registry the checker knows ──────────────────────────
#
# The same table as kaze/src/caps.rs. It lives here so the pure-Kaze front end
# can answer "is this operation real" without a host.

action cap_name_known(w):
    if w == "drone" or w == "rover" or w == "sensor" or w == "device" or w == "memory" or w == "policy" or w == "log" or w == "alert" or w == "ai" or w == "tool":
        return 1
    if w == "tools" or w == "agent" or w == "model" or w == "llm":
        return 1
    if w == "lidar" or w == "camera" or w == "thermostat" or w == "probe":
        return 1
    if w == "fan" or w == "mister" or w == "pump" or w == "relay" or w == "valve" or w == "motor" or w == "light":
        return 1
    return 0

action op_known(family, op):
    if family == "drone":
        if op == "arm" or op == "land" or op == "rtl" or op == "hold" or op == "stop" or op == "takeoff" or op == "goto" or op == "telemetry":
            return 1
    if family == "rover":
        if op == "forward" or op == "backward" or op == "turn_left" or op == "turn_right" or op == "stop" or op == "telemetry":
            return 1
    if family == "sensor":
        if op == "temperature" or op == "humidity" or op == "distance" or op == "front_distance" or op == "read" or op == "telemetry":
            return 1
    if family == "device":
        if op == "set_relay" or op == "pulse" or op == "read_gpio" or op == "set_duty":
            return 1
    if family == "memory":
        if op == "save" or op == "recall":
            return 1
    if family == "policy":
        if op == "detects" or op == "detect" or op == "allow" or op == "reject":
            return 1
    if family == "log":
        if op == "info" or op == "warn" or op == "error" or op == "debug":
            return 1
    if family == "alert":
        if op == "send":
            return 1
    if family == "ai":
        if op == "prompt" or op == "complete" or op == "classify":
            return 1
    if family == "tool":
        if op == "call" or op == "run":
            return 1
    return 0

action pure_builtin(name):
    if name == "sin" or name == "cos" or name == "tan" or name == "sqrt" or name == "atan2":
        return 1
    if name == "abs" or name == "min" or name == "max" or name == "floor" or name == "ceil" or name == "round":
        return 1
    if name == "vector" or name == "link_lost" or name == "length":
        return 1
    return 0

# ── facts: what an enclosing guard proves ──────────────────────────────
#
# Two fact shapes, both plain text:
#   "lt:<index-key>:<collection-key>"  the index is below the collection length
#   "len:<collection-key>:<n>"         the collection has a known length

action key_of(e: AstNode):
    recursion bounded 64
    if e.kind == "IDENT":
        return e.name
    if e.kind == "FIELD":
        let base = key_of(child_at(e, 0))
        if base == "":
            return ""
        return base + "." + e.name
    return ""

# The collection a bound compares against: "length of xs" directly, or a local
# that a let bound to "length of xs" ("let len = length of src", then "i < len").
action bound_coll_key(bound: AstNode, facts):
    if bound.kind == "LEN":
        return key_of(child_at(bound, 0))
    if bound.kind == "IDENT":
        return alias_target(facts, bound.name)
    return ""

action alias_target(facts, name):
    let prefix = "alias:" + name + ":"
    let i = 0
    let len = length of facts
    let out = ""
    while i < len bounded 100000:
        let f = facts[i] otherwise ""
        if starts_with(f, prefix) == 1:
            set out to tail_from(f, prefix)
        set i to i + 1
    return out

action fact_lt(idx: AstNode, bound: AstNode, facts):
    let out = []
    let ik = key_of(idx)
    let ck = bound_coll_key(bound, facts)
    if ik != "" and ck != "":
        set out to out + ["lt:" + ik + ":" + ck]
    return out

action facts_from_cond(cond: AstNode, facts):
    recursion bounded 200
    let out = []
    if cond.kind == "BIN":
        if cond.name == "and":
            set out to out + facts_from_cond(child_at(cond, 0), facts)
            set out to out + facts_from_cond(child_at(cond, 1), facts)
        if cond.name == "<":
            set out to out + fact_lt(child_at(cond, 0), child_at(cond, 1), facts)
        if cond.name == ">":
            set out to out + fact_lt(child_at(cond, 1), child_at(cond, 0), facts)
    return out

action is_constant(e: AstNode):
    if e.kind == "NUM":
        return 1
    return 0

action constant_value(e: AstNode):
    return text_to_num(e.val_str)

# A non-zero literal divisor is provably safe: 4, 4.0, but not 0.
action nonzero_literal(e: AstNode):
    if e.kind != "NUM":
        return 0
    let v = text_to_num(e.val_str)
    if v > 0:
        return 1
    if v < 0:
        return 1
    return 0

# ── boolean shaping for contract clauses ───────────────────────────────

action is_boolean_expr(e: AstNode):
    recursion bounded 200
    if e.kind == "BOOL":
        return 1
    if e.kind == "BIN":
        if e.name == "==" or e.name == "!=" or e.name == "<" or e.name == "<=" or e.name == ">" or e.name == ">=":
            return 1
        if e.name == "and" or e.name == "or" or e.name == "not":
            return 1
    if e.kind == "CALL":
        if has_dot(e.name) == 1 and head_words(e.name) == "policy":
            return 1
        if e.name == "link_lost":
            return 1
    return 0

# ── name resolution ────────────────────────────────────────────────────

action name_allowed(name, names):
    if list_has(names, name) == 1:
        return 1
    if is_telemetry(name) == 1:
        return 1
    if name == "result":
        return 1
    return 0

action routine_named(items, name):
    let i = 0
    let len = length of items
    let found = none_node()
    while i < len bounded 1000000:
        let it = node_at(items, i)
        if it.name == name:
            set found to it
        set i to i + 1
    return found

action record_named(items, name):
    let i = 0
    let len = length of items
    let found = 0
    while i < len bounded 1000000:
        let it = node_at(items, i)
        if it.name == name and it.kind == "RECORD":
            set found to 1
        set i to i + 1
    return found

# ── promised result length ─────────────────────────────────────────────
#
# "ensures length of result == 2" is how a routine tells the checker that its
# result is a fixed-size tuple, so r[0] and r[1] need no fallback.

action promised_length(item: AstNode):
    let contracts = child_at(item, 1)
    let i = 0
    let len = length of contracts.children
    let out = 0
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "CONTRACT" and c.name == "ensures":
            let e = child_at(c, 0)
            if e.kind == "BIN" and e.name == "==":
                let left = child_at(e, 0)
                let right = child_at(e, 1)
                if left.kind == "LEN" and right.kind == "NUM":
                    set out to text_to_num(right.val_str)
        set i to i + 1
    return out

# ── string prefix helpers for the length facts ─────────────────────────

action starts_with(s, prefix):
    let plen = length of prefix
    if (length of s) < plen:
        return 0
    let i = 0
    let ok = 1
    while i < plen bounded 1000:
        if (s[i] otherwise "x") != (prefix[i] otherwise "y"):
            set ok to 0
        set i to i + 1
    return ok

action tail_from(s, prefix):
    let plen = length of prefix
    let len = length of s
    let i = plen
    let out = ""
    while i < len bounded 1000:
        set out to out + (s[i] otherwise "")
        set i to i + 1
    return out

action find_len_fact(facts, ck):
    let i = 0
    let len = length of facts
    let out = 0
    let prefix = "len:" + ck + ":"
    while i < len bounded 100000:
        let f = facts[i] otherwise ""
        if starts_with(f, prefix) == 1:
            set out to text_to_num(tail_from(f, prefix))
        set i to i + 1
    return out

# ── the expression walk ────────────────────────────────────────────────

action check_expr(e: AstNode, names, facts, items, needs, open, diags):
    recursion bounded 200
    let k = e.kind
    if k == "NUM" or k == "STR" or k == "BOOL":
        return diags

    if k == "IDENT":
        if name_allowed(e.name, names) == 1:
            return diags
        set diags to diags + [diag("E_KAZE_UNKNOWN_NAME", e.line, "'" + e.name + "' is not a parameter, a let binding or a known value")]
        return diags

    if k == "UNKNOWN":
        set diags to diags + [diag("E_KAZE_PARSE", e.line, "the parser could not read this expression")]
        return diags

    if k == "LEN" or k == "FIELD" or k == "IN_UNIT":
        return check_expr(child_at(e, 0), names, facts, items, needs, open, diags)

    if k == "LIST":
        let out = diags
        for each item in e.children:
            set out to check_expr(item, names, facts, items, needs, open, out)
        return out

    if k == "INDEX":
        return check_index(e, names, facts, items, needs, open, diags)

    if k == "BIN":
        # A long left-deep chain (this compiler's own string building has chains
        # of hundreds of "+") must not cost one frame per operator. Walk the left
        # spine with a loop, then check each right operand and the head.
        let rights = []
        let ops = []
        let cur = e
        let guard = 0
        while cur.kind == "BIN" and guard < 100000 bounded 100000:
            set rights to rights + [child_at(cur, 1)]
            set ops to ops + [cur.name]
            set cur to child_at(cur, 0)
            set guard to guard + 1
        let out = check_expr(cur, names, facts, items, needs, open, diags)
        let i = (length of rights) - 1
        while i >= 0 bounded 100000:
            let right = node_at(rights, i)
            let op = ops[i] otherwise ""
            set out to check_expr(right, names, facts, items, needs, open, out)
            if op == "/" or op == "%":
                if nonzero_literal(right) == 0:
                    set out to out + [diag("E_KAZE_MISSING_FALLBACK", right.line, "this '" + op + "' can divide by zero and has no fallback; write '<value> " + op + " <divisor> otherwise <fallback>'")]
            set i to i - 1
        return out

    if k == "FALLBACK":
        let inner = child_at(e, 0)
        let fb = child_at(e, 1)
        # The fallback covers the fallible head; its operands are still checked.
        if inner.kind == "INDEX":
            let out = check_expr(child_at(inner, 0), names, facts, items, needs, open, diags)
            set out to check_expr(child_at(inner, 1), names, facts, items, needs, open, out)
            return check_expr(fb, names, facts, items, needs, open, out)
        if inner.kind == "BIN" and (inner.name == "/" or inner.name == "%"):
            let out = check_expr(child_at(inner, 0), names, facts, items, needs, open, diags)
            set out to check_expr(child_at(inner, 1), names, facts, items, needs, open, out)
            return check_expr(fb, names, facts, items, needs, open, out)
        let out = check_expr(inner, names, facts, items, needs, open, diags)
        return check_expr(fb, names, facts, items, needs, open, out)

    if k == "CALL":
        return check_call(e, names, facts, items, needs, open, diags)

    return diags

action check_index(e: AstNode, names, facts, items, needs, open, diags):
    recursion bounded 200
    let coll = child_at(e, 0)
    let idx = child_at(e, 1)
    let out = check_expr(coll, names, facts, items, needs, open, diags)
    set out to check_expr(idx, names, facts, items, needs, open, out)
    let ck = key_of(coll)
    if is_constant(idx) == 1:
        # A literal collection is checked against its own length.
        if coll.kind == "LIST":
            let n = length of coll.children
            let k = constant_value(idx)
            if k >= 0 and k < n:
                return out
            set out to out + [diag("E_KAZE_BOUNDS", e.line, "this index is outside the value it reads; a constant position past the end is refused")]
            return out
        if ck != "":
            if list_has(facts, "lt:" + idx.val_str + ":" + ck) == 1:
                return out
            let promised = find_len_fact(facts, ck)
            let k = constant_value(idx)
            if promised > 0:
                if k >= 0 and k < promised:
                    return out
                set out to out + [diag("E_KAZE_BOUNDS", e.line, "this index is outside the value it reads; a constant position past the end is refused")]
                return out
        set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this index is not proved to be inside the value; guard it (if i < length of xs:) or write '<value>[<i>] otherwise <fallback>'")]
        return out
    if ck == "":
        set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this index is not proved to be inside the value; guard it (if i < length of xs:) or write '<value>[<i>] otherwise <fallback>'")]
        return out
    let ik = key_of(idx)
    if ik != "" and list_has(facts, "lt:" + ik + ":" + ck) == 1:
        return out
    set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this index is not proved to be inside the value; guard it (if i < length of xs:) or write '<value>[<i>] otherwise <fallback>'")]
    return out

action check_call(e: AstNode, names, facts, items, needs, open, diags):
    recursion bounded 200
    let name = e.name
    let out = diags
    for each a in e.children:
        if a.kind == "NAMED_ARG":
            set out to check_expr(child_at(a, 0), names, facts, items, needs, open, out)
        otherwise:
            set out to check_expr(a, names, facts, items, needs, open, out)

    if has_dot(name) == 1:
        let head = head_words(name)
        # Geometry is a pure builtin family, not a capability.
        if head == "geo":
            return out
        let family = family_of_word(head)
        let op = tail_words(name)
        if list_has(needs, family) == 0:
            set out to out + [diag("E_CAP_UNDECLARED", e.line, "'" + family + "' is used but this file does not declare it; add it to the needs: line")]
        if op_known(family, op) == 0:
            set out to out + [diag("E_KAZE_CAP_OP", e.line, "'" + family + "." + op + "' is not an operation Kaze knows")]
        return out

    if is_upper(name) == 1:
        if open == 0 and record_named(items, name) == 0:
            set out to out + [diag("E_KAZE_UNKNOWN_NAME", e.line, "record '" + name + "' is not defined in this file")]
        return out

    if pure_builtin(name) == 1:
        return out

    let callee = routine_named(items, name)
    if callee.kind != "NONE":
        return out
    if open == 1:
        return out
    set out to out + [diag("E_KAZE_UNKNOWN_NAME", e.line, "'" + name + "' is not a routine in this file")]
    return out

# ── statements ─────────────────────────────────────────────────────────

action check_stmt(s: AstNode, names, facts, items, needs, open, diags):
    recursion bounded 200
    let k = s.kind
    if k == "LET":
        return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
    if k == "SET":
        let out = check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
        if list_has(names, s.name) == 0:
            set out to out + [diag("E_KAZE_UNKNOWN_NAME", s.line, "'" + s.name + "' is set but never bound; use 'let " + s.name + " = ...' first")]
        return out
    if k == "RETURN":
        if (length of s.children) > 0:
            return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
        return diags
    if k == "EXPR":
        return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
    if k == "GUARD":
        return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
    if k == "IF":
        let cond = child_at(s, 0)
        let inner_facts = facts + facts_from_cond(cond, facts)
        let out = check_expr(cond, names, facts, items, needs, open, diags)
        set out to check_stmts(kids_of(child_at(s, 1)), names, inner_facts, items, needs, open, out)
        set out to check_stmts(kids_of(child_at(s, 2)), names, facts, items, needs, open, out)
        return out
    if k == "WHILE":
        let cond = child_at(s, 0)
        let bound = child_at(s, 2)
        let out = check_expr(cond, names, facts, items, needs, open, diags)
        if bound.val_str == "" or bound.val_str == "?":
            set out to out + [diag("E_KAZE_LOOP_UNBOUNDED", s.line, "this while loop declares no fuel ceiling; write a bounded form")]
        otherwise:
            if text_to_num(bound.val_str) < 1:
                set out to out + [diag("E_KAZE_LOOP_UNBOUNDED", s.line, "this while loop needs a whole number of iterations from 1 up")]
        let inner_facts = facts + facts_from_cond(cond, facts)
        set out to check_stmts(kids_of(child_at(s, 1)), names, inner_facts, items, needs, open, out)
        return out
    if k == "FOR_EACH":
        let out = check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
        set out to check_stmts(kids_of(child_at(s, 1)), names + [s.name], facts, items, needs, open, out)
        return out
    if k == "TRY":
        let out = check_stmts(kids_of(child_at(s, 0)), names, facts, items, needs, open, diags)
        let inner = names
        if s.name != "":
            set inner to names + [s.name]
        set out to check_stmts(kids_of(child_at(s, 1)), inner, facts, items, needs, open, out)
        return out
    return diags

action check_stmts(stmts, names, facts, items, needs, open, diags):
    recursion bounded 200
    let i = 0
    let len = length of stmts
    let cur_names = names
    let cur_facts = facts
    let out = diags
    while i < len bounded 1000000:
        let s = node_at(stmts, i)
        set out to check_stmt(s, cur_names, cur_facts, items, needs, open, out)
        if s.kind == "LET":
            set cur_names to cur_names + [s.name]
            let v = child_at(s, 0)
            if v.kind == "LIST":
                set cur_facts to cur_facts + ["len:" + s.name + ":" + (length of v.children)]
            if v.kind == "CALL":
                let callee = routine_named(items, v.name)
                let n = promised_length(callee)
                if n > 0:
                    set cur_facts to cur_facts + ["len:" + s.name + ":" + n]
        if s.kind == "LET":
            let v2 = child_at(s, 0)
            if v2.kind == "LEN":
                let ck2 = key_of(child_at(v2, 0))
                if ck2 != "":
                    set cur_facts to cur_facts + ["alias:" + s.name + ":" + ck2]
        if s.kind == "GUARD":
            set cur_facts to cur_facts + facts_from_cond(child_at(s, 0), cur_facts)
        set i to i + 1
    return out

# ── recursion cycles ───────────────────────────────────────────────────

action calls_in_expr(e: AstNode, out):
    recursion bounded 200
    let acc = out
    if e.kind == "CALL":
        if has_dot(e.name) == 0:
            set acc to acc + [e.name]
    for each c in e.children:
        set acc to calls_in_expr(c, acc)
    return acc

action calls_in_stmt_blocks(s: AstNode, out):
    recursion bounded 200
    let acc = out
    if s.kind == "IF":
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
        set acc to calls_in_stmts(kids_of(child_at(s, 2)), acc)
    if s.kind == "WHILE":
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
    if s.kind == "FOR_EACH":
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
    if s.kind == "TRY":
        set acc to calls_in_stmts(kids_of(child_at(s, 0)), acc)
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
    return acc

action calls_in_stmts(stmts, out):
    recursion bounded 200
    let acc = out
    let i = 0
    let len = length of stmts
    while i < len bounded 1000000:
        let s = node_at(stmts, i)
        set acc to calls_in_expr(s, acc)
        set acc to calls_in_stmt_blocks(s, acc)
        set i to i + 1
    return acc

# The call graph, built once and kept as two parallel number lists (edge source
# index, edge target index). The first version keyed every edge by routine
# *name*, so each reachability query scanned every edge and allocated a string
# per match: on this compiler's own monolith that was gigabytes. Indices make
# the whole check integer work.
action routine_names(items):
    let out = []
    for each item in items:
        set out to out + [item.name]
    return out

action index_of(names, name):
    let i = 0
    let len = length of names
    while i < len bounded 1000000:
        if (names[i] otherwise "") == name:
            return i
        set i to i + 1
    return -1

action call_edges(items, names):
    let froms = []
    let tos = []
    for each item in items:
        let from = index_of(names, item.name)
        let callees = calls_in_stmts(kids_of(child_at(item, 2)), [])
        for each c in callees:
            let to = index_of(names, c)
            if to >= 0:
                set froms to froms + [from]
                set tos to tos + [to]
    return [froms, tos]

action neighbours(froms, tos, idx):
    let out = []
    let i = 0
    let len = length of froms
    while i < len bounded 1000000:
        if (froms[i] otherwise -1) == idx:
            set out to out + [tos[i] otherwise -1]
        set i to i + 1
    return out

# Does one routine reach another through the call graph? A cycle back to the
# starting routine is recursion, and recursion needs a declared ceiling.
action reaches(start_idx, target_idx, froms, tos):
    let stack = neighbours(froms, tos, start_idx)
    let visited = []
    let found = 0
    let fuel = 0
    while (length of stack) > 0 and found == 0 and fuel < 100000 bounded 100000:
        set fuel to fuel + 1
        let cur = stack[(length of stack) - 1] otherwise -1
        set stack to drop_last(stack)
        if cur == target_idx:
            set found to 1
        otherwise:
            if list_has(visited, cur) == 0:
                set visited to visited + [cur]
                for each c in neighbours(froms, tos, cur):
                    # Push only what is neither visited nor already waiting.
                    # Without this check a dense call graph pushes the same
                    # callee over and over, and the stack list (copied on every
                    # push) grows exponentially: that was gigabytes on this
                    # compiler's own monolith.
                    if list_has(visited, c) == 0 and list_has(stack, c) == 0:
                        set stack to stack + [c]
    return found

action recursion_bound_of(item: AstNode):
    let contracts = child_at(item, 1)
    let i = 0
    let len = length of contracts.children
    let out = 0
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "RECURSION_BOUND":
            set out to text_to_num(c.val_str)
        set i to i + 1
    return out

# ── filters must not fall off the end ──────────────────────────────────

action ends_with_verdict(stmts):
    recursion bounded 64
    let len = length of stmts
    if len == 0:
        return 0
    let last = node_at(stmts, len - 1)
    if last.kind == "RETURN":
        return 1
    if last.kind == "EXPR":
        let e = child_at(last, 0)
        if e.kind == "CALL":
            let head = head_words(e.name)
            let op = tail_words(e.name)
            if head == "policy" and (op == "allow" or op == "reject"):
                return 1
    if last.kind == "IF":
        let then_ok = ends_with_verdict(kids_of(child_at(last, 1)))
        let else_ok = ends_with_verdict(kids_of(child_at(last, 2)))
        if then_ok == 1 and else_ok == 1:
            return 1
    return 0

# ── items ──────────────────────────────────────────────────────────────

action param_names(item: AstNode):
    let params = child_at(item, 0)
    let out = []
    for each p in params.children:
        set out to out + [p.name]
    return out

action routine_needs(item: AstNode):
    let contracts = child_at(item, 1)
    let out = []
    let i = 0
    let len = length of contracts.children
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "ROUTINE_NEED":
            set out to out + [family_of_word(c.name)]
        set i to i + 1
    return out

action requires_facts(item: AstNode):
    let contracts = child_at(item, 1)
    let out = []
    let i = 0
    let len = length of contracts.children
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "CONTRACT" and c.name == "requires":
            set out to out + facts_from_cond(child_at(c, 0), out)
        set i to i + 1
    return out

action contract_diags(item: AstNode):
    let contracts = child_at(item, 1)
    let out = []
    let i = 0
    let len = length of contracts.children
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "CONTRACT":
            if is_boolean_expr(child_at(c, 0)) == 0:
                set out to out + [diag("E_KAZE_CONTRACT_NOT_BOOL", c.line, "this '" + c.name + "' clause is not true-or-false; a contract must compare or combine conditions")]
        if c.kind == "RECURSION_BOUND":
            let n = text_to_num(c.val_str)
            if n < 1 or n > 256:
                set out to out + [diag("E_KAZE_PARSE", c.line, "'recursion bounded' needs a whole number of frames from 1 to 256")]
        set i to i + 1
    return out

action check_item(item: AstNode, module_needs, items, names_all, froms, tos, open):
    let out = contract_diags(item)
    let needs = module_needs + routine_needs(item)
    let names = param_names(item)
    let facts = requires_facts(item)
    let body = child_at(item, 2)
    set out to check_stmts(body.children, names, facts, items, needs, open, out)
    if item.kind == "FILTER":
        if ends_with_verdict(body.children) == 0:
            set out to out + [diag("E_KAZE_FILTER_FALLTHROUGH", item.line, "this filter can fall off the end without an allow or a reject verdict")]
    if recursion_bound_of(item) == 0:
        if reaches(index_of(names_all, item.name), index_of(names_all, item.name), froms, tos) == 1:
            set out to out + [diag("E_KAZE_RECURSION_UNBOUNDED", item.line, "'" + item.name + "' reaches itself and declares no ceiling; add a bounded recursion declaration at the top of its body")]
    return out

action need_names(needs_node: AstNode):
    let out = []
    for each n in needs_node.children:
        set out to out + [n.name]
    return out

action declared_families(need_list):
    let out = []
    for each n in need_list:
        set out to out + [family_of_word(n)]
    return out

action check_program(prog: AstNode):
    recursion bounded 200
    let out = []
    let items = program_items(prog)
    let need_list = need_names(program_needs(prog))
    let open = 0
    let use_node = program_uses(prog)
    if (length of use_node.children) > 0:
        set open to 1
    # 1. needs: entries must name a family or a known instance.
    let i = 0
    while i < (length of need_list) bounded 100000:
        let n = need_list[i] otherwise ""
        if cap_name_known(n) == 0:
            set out to out + [diag("E_KAZE_CAP_UNKNOWN", 1, "'" + n + "' does not name a capability family or an instance")]
        set i to i + 1
    # 2. every routine and hook. The call graph is built once here: rebuilding it
    # per routine made the recursion check quadratic in the module.
    let declared = declared_families(need_list)
    let names_all = routine_names(items)
    let graph = call_edges(items, names_all)
    let froms = graph[0] otherwise []
    let tos = graph[1] otherwise []
    set i to 0
    while i < (length of items) bounded 1000000:
        let item = node_at(items, i)
        if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER":
            set out to out + check_item(item, declared, items, names_all, froms, tos, open)
        if item.kind == "UNKNOWN_ITEM":
            set out to out + [diag("E_KAZE_PARSE", item.line, "the machine reader does not know the form '" + item.name + "'")]
        if item.kind == "WHEN" or item.kind == "EVERY":
            let body = child_at(item, 1)
            set out to check_stmts(body.children, [], [], items, declared, open, out)
        set i to i + 1
    return out

# machine.kaze — the dual-syntax engine.
#
# Kaze has two spellings of the same program:
#
#   * the human, indentation-based form the compiler reads by default;
#   * the canonical machine S-expression form, one form per line,
#     (kaze (format 1) (needs ..) (action "f" (params ..) (body ..))).
#
# This module emits the machine form from the AST, reads it back into the same
# AST, and prints the human form from an AST. The round-trip the tests pin is
#
#   HUMAN -> AST -> MACHINE -> AST -> HUMAN -> AST
#
# where the two ASTs must check identically. A construct this module does not
# support is emitted as (unsupported ..) or lowered to an UNKNOWN node, which
# the checker reports as E_KAZE_PARSE; nothing is dropped in silence.
#
# Machine grammar (format 1), all whitespace between tokens insignificant:
#
#   program  := "(" "kaze" (format 1)? (use STR)* (needs STR*)? item* ")"
#   item     := record | action | check | filter | when | every
#   record   := "(" "record" STR "(" "fields" field* ")" ")"
#   field    := "(" NAME TYPE ")" | STR
#   action   := "(" ("action"|"check"|"filter") STR
#                 "(" "params" param* ")"
#                 "(" "contracts" contract* ")"
#                 "(" "body" stmt* ")" ")"
#   param    := "(" "param" STR STR expr? ")"
#   contract := "(" "requires" expr ")" | "(" "ensures" expr ")"
#             | "(" "recursion" NUM ")" | "(" "needs" STR ")"
#   expr     := "(" "number" STR STR? ")" | "(" "string" STR ")"
#             | "(" "bool" ("true"|"false") ")"
#             | "(" "name" STR ")" | "(" "bin" OP expr expr ")"
#             | "(" "call" STR expr* ")" | "(" "named" STR expr ")"
#             | "(" "field" expr NAME ")" | "(" "index" expr expr ")"
#             | "(" "fallback" expr expr ")" | "(" "len" expr ")"
#             | "(" "in_unit" STR expr ")" | "(" "list" expr* ")"
#   stmt     := "(" "let" STR expr ")" | "(" "set" STR expr ")"
#             | "(" "return" expr? ")" | "(" "eval" expr ")"
#             | "(" "guard" expr ")"
#             | "(" "if" expr "(" "then" stmt* ")" "(" "otherwise" stmt* ")" ")"
#             | "(" "while" expr "(" "bounded" NUM ")"? "(" "body" stmt* ")" ")"
#             | "(" "for_each" STR expr "(" "body" stmt* ")" ")"
#             | "(" "try" "(" "body" stmt* ")" "(" "otherwise"
#                 "(" "with" STR ")"? stmt* ")" ")"

# ── shared text helpers ────────────────────────────────────────────────

action m_pad(n):
    let out = ""
    let i = 0
    while i < n bounded 1000:
        set out to out + "  "
        set i to i + 1
    return out

action h_pad(n):
    let out = ""
    let i = 0
    while i < n bounded 1000:
        set out to out + "    "
        set i to i + 1
    return out

action quoted(s):
    let out = "\""
    let len = length of s
    let i = 0
    while i < len bounded 1000000:
        let c = s[i] otherwise "x"
        if c == "\\":
            set out to out + "\\\\"
        otherwise:
            if c == "\"":
                set out to out + "\\\""
            otherwise:
                if c == "\n":
                    set out to out + "\\n"
                otherwise:
                    if c == "\t":
                        set out to out + "\\t"
                    otherwise:
                        set out to out + c
        set i to i + 1
    set out to out + "\""
    return out

action drop_first(items):
    let out = []
    let len = length of items
    let i = 1
    while i < len bounded 1000000:
        set out to out + [node_at(items, i)]
        set i to i + 1
    return out

# The head atom of a form, or "" when it is not a tagged list.
action m_head(form: AstNode):
    let kids = form.children
    if form.kind != "L" or (length of kids) == 0:
        return ""
    let h = node_at(kids, 0)
    if h.kind == "A":
        return h.name
    return ""

# Argument i of a tagged form (the head is argument -1).
action m_arg(form: AstNode, i):
    return child_at(form, i + 1)

# The text of a string or atom position.
action m_text(node: AstNode):
    if node.kind == "S":
        return node.val_str
    if node.kind == "A":
        return node.name
    return ""

# ── human -> machine ───────────────────────────────────────────────────

action emit_expr_machine(e: AstNode):
    recursion bounded 200
    let k = e.kind
    if k == "NUM":
        if e.name == "":
            return "(number " + quoted(e.val_str) + ")"
        return "(number " + quoted(e.val_str) + " " + quoted(e.name) + ")"
    if k == "STR":
        return "(string " + quoted(e.val_str) + ")"
    if k == "BOOL":
        return "(bool " + e.val_str + ")"
    if k == "IDENT":
        return "(name " + quoted(e.name) + ")"
    if k == "BIN":
        return "(bin " + quoted(e.name) + " " + emit_expr_machine(child_at(e, 0)) + " " + emit_expr_machine(child_at(e, 1)) + ")"
    if k == "FALLBACK":
        return "(fallback " + emit_expr_machine(child_at(e, 0)) + " " + emit_expr_machine(child_at(e, 1)) + ")"
    if k == "FIELD":
        return "(field " + emit_expr_machine(child_at(e, 0)) + " " + quoted(e.name) + ")"
    if k == "INDEX":
        return "(index " + emit_expr_machine(child_at(e, 0)) + " " + emit_expr_machine(child_at(e, 1)) + ")"
    if k == "LEN":
        return "(len " + emit_expr_machine(child_at(e, 0)) + ")"
    if k == "IN_UNIT":
        return "(in_unit " + quoted(e.name) + " " + emit_expr_machine(child_at(e, 0)) + ")"
    if k == "LIST":
        let parts = ""
        for each it in e.children:
            set parts to parts + " " + emit_expr_machine(it)
        return "(list" + parts + ")"
    if k == "CALL":
        let parts = ""
        for each a in e.children:
            set parts to parts + " " + emit_expr_machine(a)
        return "(call " + quoted(e.name) + parts + ")"
    if k == "NAMED_ARG":
        return "(named " + quoted(e.name) + " " + emit_expr_machine(child_at(e, 0)) + ")"
    return "(unsupported " + quoted(k) + ")"

action emit_stmts_machine(stmts):
    recursion bounded 200
    let parts = ""
    for each s in stmts:
        set parts to parts + " " + emit_stmt_machine(s)
    return parts

action emit_stmt_machine(s: AstNode):
    recursion bounded 200
    let k = s.kind
    if k == "LET":
        return "(let " + quoted(s.name) + " " + emit_expr_machine(child_at(s, 0)) + ")"
    if k == "SET":
        return "(set " + quoted(s.name) + " " + emit_expr_machine(child_at(s, 0)) + ")"
    if k == "RETURN":
        if (length of s.children) == 0:
            return "(return)"
        return "(return " + emit_expr_machine(child_at(s, 0)) + ")"
    if k == "EXPR":
        return "(eval " + emit_expr_machine(child_at(s, 0)) + ")"
    if k == "GUARD":
        return "(guard " + emit_expr_machine(child_at(s, 0)) + ")"
    if k == "IF":
        return "(if " + emit_expr_machine(child_at(s, 0)) + " (then" + emit_stmts_machine(kids_of(child_at(s, 1))) + ") (otherwise" + emit_stmts_machine(kids_of(child_at(s, 2))) + "))"
    if k == "WHILE":
        let bound = child_at(s, 2)
        let bound_part = ""
        if bound.val_str != "" and bound.val_str != "?":
            set bound_part to " (bounded " + bound.val_str + ")"
        return "(while " + emit_expr_machine(child_at(s, 0)) + bound_part + " (body" + emit_stmts_machine(kids_of(child_at(s, 1))) + "))"
    if k == "FOR_EACH":
        return "(for_each " + quoted(s.name) + " " + emit_expr_machine(child_at(s, 0)) + " (body" + emit_stmts_machine(kids_of(child_at(s, 1))) + "))"
    if k == "TRY":
        let with_part = ""
        if s.name != "":
            set with_part to " (with " + quoted(s.name) + ")"
        return "(try (body" + emit_stmts_machine(kids_of(child_at(s, 0))) + ") (otherwise" + with_part + emit_stmts_machine(kids_of(child_at(s, 1))) + "))"
    return "(unsupported_stmt " + quoted(k) + ")"

action emit_params_machine(item: AstNode):
    let params = child_at(item, 0)
    let parts = ""
    for each p in params.children:
        set parts to parts + " (param " + quoted(p.name) + " " + quoted(p.val_str)
        if (length of p.children) > 0:
            set parts to parts + " " + emit_expr_machine(child_at(p, 0))
        set parts to parts + ")"
    return "(params" + parts + ")"

action emit_contracts_machine(item: AstNode):
    let contracts = child_at(item, 1)
    let parts = ""
    for each c in contracts.children:
        if c.kind == "CONTRACT":
            set parts to parts + " (" + c.name + " " + emit_expr_machine(child_at(c, 0)) + ")"
        otherwise:
            if c.kind == "RECURSION_BOUND":
                set parts to parts + " (recursion " + c.val_str + ")"
            otherwise:
                if c.kind == "ROUTINE_NEED":
                    set parts to parts + " (needs " + quoted(c.name) + ")"
                otherwise:
                    set parts to parts + " (unsupported_contract " + quoted(c.kind) + ")"
    return "(contracts" + parts + ")"

action item_keyword(item: AstNode):
    if item.kind == "CHECK":
        return "check"
    if item.kind == "FILTER":
        return "filter"
    return "action"

action emit_item_machine(item: AstNode, depth):
    recursion bounded 200
    let ind = m_pad(depth)
    let out = ""
    if item.kind == "RECORD":
        let fields = ""
        for each f in item.children:
            set fields to fields + " (" + f.name + " " + f.val_str + ")"
        return ind + "(record " + quoted(item.name) + "\n" + ind + "  (fields" + fields + "))\n"
    if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER":
        let body = child_at(item, 2)
        set out to ind + "(" + item_keyword(item) + " " + quoted(item.name) + "\n"
        set out to out + ind + "  " + emit_params_machine(item) + "\n"
        set out to out + ind + "  " + emit_contracts_machine(item) + "\n"
        set out to out + ind + "  (body" + emit_stmts_machine(body.children) + "))\n"
        return out
    if item.kind == "WHEN":
        let body = child_at(item, 1)
        return ind + "(when " + emit_expr_machine(child_at(item, 0)) + "\n" + ind + "  (body" + emit_stmts_machine(body.children) + "))\n"
    if item.kind == "EVERY":
        let body = child_at(item, 1)
        return ind + "(every " + emit_expr_machine(child_at(item, 0)) + "\n" + ind + "  (body" + emit_stmts_machine(body.children) + "))\n"
    return ind + "(unsupported_item " + quoted(item.kind) + ")\n"

action emit_machine(prog: AstNode):
    recursion bounded 200
    let out = "(kaze\n  (format 1)\n"
    for each u in kids_of(program_uses(prog)):
        set out to out + "  (use " + quoted(u.name) + ")\n"
    let needs_node = program_needs(prog)
    if (length of needs_node.children) > 0:
        let parts = ""
        for each n in needs_node.children:
            set parts to parts + " " + quoted(n.name)
        set out to out + "  (needs" + parts + ")\n"
    for each item in program_items(prog):
        set out to out + emit_item_machine(item, 1)
    set out to out + ")\n"
    return out

# ── machine -> AST ─────────────────────────────────────────────────────

# A generic S-expression: kind "L" is a list, "S" a string, "A" an atom.
action m_sexpr(tokens, pos):
    recursion bounded 200
    ensures length of result == 2
    let p = skip_nl(tokens, pos)
    let t = tok(tokens, p)
    if t.kind == "SYM" and t.text == "(":
        let kids = []
        let q = p + 1
        let done = 0
        while done == 0 bounded 1000000:
            set q to skip_nl(tokens, q)
            if is_sym(tokens, q, ")"):
                set q to q + 1
                set done to 1
            otherwise:
                if at_end(tokens, q) == 1 or tok_kind(tokens, q) == "EOF":
                    set done to 1
                otherwise:
                    if tok_kind(tokens, q) == "DEDENT" or tok_kind(tokens, q) == "INDENT":
                        set q to q + 1
                    otherwise:
                        let r = m_sexpr(tokens, q)
                        set kids to kids + [r[0]]
                        set q to r[1]
        return [make_node("L", "", "", 0, kids, t.line), q]
    if t.kind == "STR":
        return [make_node("S", "", t.text, 0, [], t.line), p + 1]
    return [make_node("A", t.text, "", 0, [], t.line), p + 1]

action lower_expr(form: AstNode):
    recursion bounded 200
    let h = m_head(form)
    if h == "number":
        let unit = ""
        if (length of form.children) > 2:
            set unit to m_text(m_arg(form, 1))
        return make_node("NUM", unit, m_text(m_arg(form, 0)), 0, [], form.line)
    if h == "string":
        return make_str(m_text(m_arg(form, 0)), form.line)
    if h == "bool":
        let b = 0
        if m_text(m_arg(form, 0)) == "true":
            set b to 1
        return make_bool(b, form.line)
    if h == "name":
        return make_ident(m_text(m_arg(form, 0)), form.line)
    if h == "bin":
        return make_bin(m_text(m_arg(form, 0)), lower_expr(m_arg(form, 1)), lower_expr(m_arg(form, 2)), form.line)
    if h == "fallback":
        return make_fallback(lower_expr(m_arg(form, 0)), lower_expr(m_arg(form, 1)), form.line)
    if h == "field":
        return make_field(lower_expr(m_arg(form, 0)), m_text(m_arg(form, 1)), form.line)
    if h == "index":
        return make_index(lower_expr(m_arg(form, 0)), lower_expr(m_arg(form, 1)), form.line)
    if h == "len":
        return make_len(lower_expr(m_arg(form, 0)), form.line)
    if h == "in_unit":
        return make_in_unit(m_text(m_arg(form, 0)), lower_expr(m_arg(form, 1)), form.line)
    if h == "list":
        let items = []
        for each c in drop_first(form.children):
            set items to items + [lower_expr(c)]
        return make_list_expr(items, form.line)
    if h == "call":
        let args = []
        for each c in drop_first(drop_first(form.children)):
            set args to args + [lower_expr(c)]
        return make_call(m_text(m_arg(form, 0)), args, form.line)
    if h == "named":
        return make_named_arg(m_text(m_arg(form, 0)), lower_expr(m_arg(form, 1)), form.line)
    return make_unknown(form.line)

action lower_stmts(forms):
    recursion bounded 200
    let out = []
    for each f in forms:
        set out to out + [lower_stmt(f)]
    return out

action lower_block(form: AstNode):
    recursion bounded 200
    return lower_stmts(drop_first(form.children))

action lower_stmt(form: AstNode):
    recursion bounded 200
    let h = m_head(form)
    if h == "let":
        return make_stmt("LET", m_text(m_arg(form, 0)), [lower_expr(m_arg(form, 1))], form.line)
    if h == "set":
        return make_stmt("SET", m_text(m_arg(form, 0)), [lower_expr(m_arg(form, 1))], form.line)
    if h == "return":
        if (length of form.children) < 2:
            return make_stmt("RETURN", "", [], form.line)
        return make_stmt("RETURN", "", [lower_expr(m_arg(form, 0))], form.line)
    if h == "eval":
        return make_stmt("EXPR", "", [lower_expr(m_arg(form, 0))], form.line)
    if h == "guard":
        return make_guard(lower_expr(m_arg(form, 0)), form.line)
    if h == "if":
        let cond = lower_expr(m_arg(form, 0))
        let then_block = make_block("then", lower_block(m_arg(form, 1)), form.line)
        let other_block = make_block("otherwise", lower_block(m_arg(form, 2)), form.line)
        return make_if(cond, then_block, other_block, form.line)
    if h == "while":
        let cond = lower_expr(m_arg(form, 0))
        let bound = make_bound("", form.line)
        let body_arg = 1
        let inner = m_arg(form, 1)
        if m_head(inner) == "bounded":
            set bound to make_bound(m_text(m_arg(inner, 0)), inner.line)
            set body_arg to 2
        return make_while(cond, make_block("body", lower_block(m_arg(form, body_arg)), form.line), bound, form.line)
    if h == "for_each":
        let list_expr = lower_expr(m_arg(form, 1))
        let body = make_block("body", lower_block(m_arg(form, 2)), form.line)
        return make_for_each(m_text(m_arg(form, 0)), list_expr, body, form.line)
    if h == "try":
        let body = make_block("body", lower_block(m_arg(form, 0)), form.line)
        let other_form = m_arg(form, 1)
        let inner = drop_first(other_form.children)
        let err = ""
        let body_forms = inner
        if (length of inner) > 0:
            let first = node_at(inner, 0)
            if m_head(first) == "with":
                set err to m_text(m_arg(first, 0))
                set body_forms to drop_first(inner)
        let other = make_block("otherwise", lower_stmts(body_forms), form.line)
        return make_try(err, body, other, form.line)
    return make_unknown(form.line)

action lower_params(form: AstNode):
    let out = []
    for each p in drop_first(form.children):
        if m_head(p) == "param":
            let defaults = []
            if (length of p.children) > 3:
                set defaults to [lower_expr(m_arg(p, 2))]
            set out to out + [make_param(m_text(m_arg(p, 0)), m_text(m_arg(p, 1)), defaults, p.line)]
    return out

action lower_contracts(form: AstNode):
    let out = []
    for each c in drop_first(form.children):
        let h = m_head(c)
        if h == "requires" or h == "ensures":
            set out to out + [make_contract(h, lower_expr(m_arg(c, 0)), c.line)]
        otherwise:
            if h == "recursion":
                set out to out + [make_recursion_bound(m_text(m_arg(c, 0)), c.line)]
            otherwise:
                if h == "needs":
                    set out to out + [make_routine_need(m_text(m_arg(c, 0)), c.line)]
    return out

action lower_item(form: AstNode):
    recursion bounded 200
    let h = m_head(form)
    if h == "record":
        let fields = []
        let fields_form = m_arg(form, 1)
        if m_head(fields_form) == "fields":
            for each f in drop_first(fields_form.children):
                if f.kind == "L":
                    set fields to fields + [make_field_def(m_text(m_arg(f, 0)), m_text(m_arg(f, 1)), f.line)]
                otherwise:
                    set fields to fields + [make_field_def(m_text(f), "any", f.line)]
        return make_record_item(m_text(m_arg(form, 0)), fields, form.line)
    if h == "action" or h == "check" or h == "filter":
        let params_form = none_node()
        let contracts_form = none_node()
        let body_form = none_node()
        let line = form.line
        for each part in drop_first(drop_first(form.children)):
            let ph = m_head(part)
            if ph == "params":
                set params_form to part
            if ph == "contracts":
                set contracts_form to part
            if ph == "body":
                set body_form to part
        let params = []
        if params_form.kind == "L":
            set params to lower_params(params_form)
        let contracts = []
        if contracts_form.kind == "L":
            set contracts to lower_contracts(contracts_form)
        let body = make_block("body", [], line)
        if body_form.kind == "L":
            set body to make_block("body", lower_block(body_form), line)
        let params_node = make_node("PARAMS", "", "", 0, params, line)
        let contracts_node = make_node("CONTRACTS", "", "", 0, contracts, line)
        return make_item(h, m_text(m_arg(form, 0)), params_node, contracts_node, "", body, line)
    if h == "when":
        return make_when(lower_expr(m_arg(form, 0)), make_block("body", lower_block(m_arg(form, 1)), form.line), form.line)
    if h == "every":
        return make_every(lower_expr(m_arg(form, 0)), make_block("body", lower_block(m_arg(form, 1)), form.line), form.line)
    return make_node("UNKNOWN_ITEM", h, "", 0, [], form.line)

action lower_program(root: AstNode):
    recursion bounded 200
    let uses = []
    let needs = []
    let items = []
    if root.kind != "L":
        return make_program(uses, needs, items)
    for each form in root.children:
        let h = m_head(form)
        if form.kind != "L":
            set h to "kaze"
        if h == "use":
            set uses to uses + [make_node("USE", m_text(m_arg(form, 0)), "", 0, [], form.line)]
        otherwise:
            if h == "needs":
                for each c in drop_first(form.children):
                    set needs to needs + [make_node("NEED", m_text(c), "", 0, [], form.line)]
            otherwise:
                if h != "kaze" and h != "format":
                    set items to items + [lower_item(form)]
    return make_program(uses, needs, items)

# Read the canonical machine form back into a PROGRAM node.
action parse_machine(src):
    recursion bounded 200
    let tokens = tokenize(src)
    let r = m_sexpr(tokens, 0)
    return lower_program(r[0])

# ── AST -> human ───────────────────────────────────────────────────────

# Binding power, so a chain prints flat instead of one group per operator. A
# chain of two hundred terms used to be two hundred nested groups, and the
# parser needs a frame per group.
action tier_of(op):
    if op == "or":
        return 1
    if op == "and":
        return 2
    if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=":
        return 4
    if op == "+" or op == "-":
        return 5
    return 6

action emit_bin_human(e: AstNode):
    recursion bounded 200
    let t = tier_of(e.name)
    # Flatten the same-tier chain first, then build the text once, left to
    # right. Recursing instead copies the whole left subtree at every step,
    # which is quadratic: on this compiler's own string building that meant
    # gigabytes of intermediate strings and a memory stop.
    let ops = []
    let rights = []
    let cur = e
    let guard = 0
    while cur.kind == "BIN" and cur.name != "not" and tier_of(cur.name) == t and guard < 100000 bounded 100000:
        set ops to ops + [cur.name]
        set rights to rights + [child_at(cur, 1)]
        set cur to child_at(cur, 0)
        set guard to guard + 1
    let out = emit_expr_human(cur)
    let i = (length of ops) - 1
    while i >= 0 bounded 100000:
        set out to out + " " + (ops[i] otherwise "") + " " + emit_expr_human(node_at(rights, i))
        set i to i - 1
    return out

action emit_expr_human(e: AstNode):
    recursion bounded 200
    let k = e.kind
    if k == "NUM":
        let text = e.val_str
        if text == "":
            set text to "0"
        if e.name == "":
            return text
        if e.name == "%":
            return text + "%"
        return text + " " + e.name
    if k == "STR":
        return quoted(e.val_str)
    if k == "BOOL":
        if e.val_str == "true":
            return "true"
        return "false"
    if k == "IDENT":
        return e.name
    if k == "BIN":
        if e.name == "not":
            return "(not " + emit_expr_human(child_at(e, 0)) + ")"
        return "(" + emit_bin_human(e) + ")"
    if k == "FALLBACK":
        return "(" + emit_expr_human(child_at(e, 0)) + " otherwise " + emit_expr_human(child_at(e, 1)) + ")"
    if k == "FIELD":
        return "(" + emit_expr_human(child_at(e, 0)) + ")." + e.name
    if k == "INDEX":
        return "(" + emit_expr_human(child_at(e, 0)) + ")[" + emit_expr_human(child_at(e, 1)) + "]"
    if k == "LEN":
        return "length of (" + emit_expr_human(child_at(e, 0)) + ")"
    if k == "IN_UNIT":
        return "(" + emit_expr_human(child_at(e, 0)) + " in " + e.name + ")"
    if k == "LIST":
        let parts = ""
        let first = 1
        for each it in e.children:
            if first == 0:
                set parts to parts + ", "
            set parts to parts + emit_expr_human(it)
            set first to 0
        return "[" + parts + "]"
    if k == "CALL":
        let parts = ""
        let first = 1
        for each a in e.children:
            if first == 0:
                set parts to parts + ", "
            set parts to parts + emit_expr_human(a)
            set first to 0
        return e.name + "(" + parts + ")"
    if k == "NAMED_ARG":
        return e.name + ": " + emit_expr_human(child_at(e, 0))
    if k == "UNKNOWN":
        return "# the machine reader could not lower an expression here\n    guard false"
    return "0"

action emit_stmts_human(stmts, depth):
    recursion bounded 200
    let out = ""
    for each s in stmts:
        set out to out + emit_stmt_human(s, depth)
    return out

# A block must have at least one indented line in the human syntax. An empty
# block is written as a comment plus an always-true assertion.
action emit_block_human(block: AstNode, depth):
    recursion bounded 200
    let stmts = block.children
    if (length of stmts) == 0:
        return h_pad(depth) + "# empty block\n" + h_pad(depth) + "guard true\n"
    return emit_stmts_human(stmts, depth)

action emit_stmt_human(s: AstNode, depth):
    recursion bounded 200
    let ind = h_pad(depth)
    let k = s.kind
    if k == "LET":
        return ind + "let " + s.name + " = " + emit_expr_human(child_at(s, 0)) + "\n"
    if k == "SET":
        return ind + "set " + s.name + " to " + emit_expr_human(child_at(s, 0)) + "\n"
    if k == "RETURN":
        if (length of s.children) == 0:
            return ind + "return\n"
        return ind + "return " + emit_expr_human(child_at(s, 0)) + "\n"
    if k == "EXPR":
        return ind + emit_expr_human(child_at(s, 0)) + "\n"
    if k == "GUARD":
        return ind + "guard " + emit_expr_human(child_at(s, 0)) + "\n"
    if k == "IF":
        let out = ind + "if " + emit_expr_human(child_at(s, 0)) + ":\n"
        set out to out + emit_block_human(child_at(s, 1), depth + 1)
        if (length of kids_of(child_at(s, 2))) > 0:
            set out to out + ind + "otherwise:\n"
            set out to out + emit_block_human(child_at(s, 2), depth + 1)
        return out
    if k == "WHILE":
        let bound = child_at(s, 2)
        let head = ind + "while " + emit_expr_human(child_at(s, 0))
        if bound.val_str != "" and bound.val_str != "?":
            set head to head + " bounded " + bound.val_str
        return head + ":\n" + emit_block_human(child_at(s, 1), depth + 1)
    if k == "FOR_EACH":
        return ind + "for each " + s.name + " in " + emit_expr_human(child_at(s, 0)) + ":\n" + emit_block_human(child_at(s, 1), depth + 1)
    if k == "TRY":
        let out = ind + "try:\n"
        set out to out + emit_block_human(child_at(s, 0), depth + 1)
        set out to out + ind + "otherwise"
        if s.name != "":
            set out to out + " with " + s.name
        set out to out + ":\n"
        set out to out + emit_block_human(child_at(s, 1), depth + 1)
        return out
    if k == "UNKNOWN":
        return ind + "# unreadable statement\n" + ind + "guard false\n"
    return ind + "guard false\n"

action emit_params_human(item: AstNode):
    let params = child_at(item, 0)
    let out = ""
    let first = 1
    for each p in params.children:
        if first == 0:
            set out to out + ", "
        set out to out + p.name
        if p.val_str != "":
            set out to out + ": " + p.val_str
        if (length of p.children) > 0:
            set out to out + " = " + emit_expr_human(child_at(p, 0))
        set first to 0
    return out

action emit_item_human(item: AstNode, depth):
    recursion bounded 200
    let ind = h_pad(depth)
    if item.kind == "RECORD":
        let out = ind + "record " + item.name + ":\n"
        for each f in item.children:
            set out to out + ind + "    " + f.name + ": " + f.val_str + "\n"
        return out
    if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER":
        let head = ind + item_keyword(item) + " " + item.name + "(" + emit_params_human(item) + ")"
        if item.val_str != "":
            set head to head + " -> " + item.val_str
        let out = head + ":\n"
        let contracts = child_at(item, 1)
        for each c in contracts.children:
            if c.kind == "CONTRACT":
                set out to out + ind + "    " + c.name + " " + emit_expr_human(child_at(c, 0)) + "\n"
            otherwise:
                if c.kind == "RECURSION_BOUND":
                    set out to out + ind + "    recursion bounded " + c.val_str + "\n"
                otherwise:
                    if c.kind == "ROUTINE_NEED":
                        set out to out + ind + "    needs: " + c.name + "\n"
        set out to out + emit_block_human(child_at(item, 2), depth + 1)
        return out
    if item.kind == "WHEN":
        return ind + "when " + emit_expr_human(child_at(item, 0)) + ":\n" + emit_block_human(child_at(item, 1), depth + 1)
    if item.kind == "EVERY":
        return ind + "every " + emit_expr_human(child_at(item, 0)) + ":\n" + emit_block_human(child_at(item, 1), depth + 1)
    return ind + "# E_KAZE_UNSUPPORTED: the machine reader does not know " + item.kind + " at machine line " + item.line + "\n"

action emit_human(prog: AstNode):
    recursion bounded 200
    let out = ""
    for each u in kids_of(program_uses(prog)):
        set out to out + "use " + quoted(u.name) + "\n"
    let needs_node = program_needs(prog)
    if (length of needs_node.children) > 0:
        let parts = ""
        let first = 1
        for each n in needs_node.children:
            if first == 0:
                set parts to parts + ", "
            set parts to parts + n.name
            set first to 0
        set out to out + "needs: " + parts + "\n"
    for each item in program_items(prog):
        set out to out + "\n" + emit_item_human(item, 0)
    return out

# Does the source look like machine syntax? Same rule as the reference engine:
# the first non-space, non-comment character opens a (kaze ...) root.
action is_machine_source(src):
    let len = length of src
    let i = 0
    let looking = 1
    let found = 0
    while i < len and looking == 1 bounded 1000000:
        let c = src[i] otherwise "x"
        if c == " " or c == "\n" or c == "\t":
            set i to i + 1
        otherwise:
            if c == "#":
                while i < len and (src[i] otherwise "x") != "\n" bounded 1000000:
                    set i to i + 1
            otherwise:
                set looking to 0
                if c == "(":
                    set found to 1
    return found

