# coremain.kaze — the compiler core as a command line: check and emit-c only.
#
# The full CLI also formats, reads and writes machine syntax, compiles bytecode and
# serves LSP. Those are tooling; this file is the compiler proper. It exists so the
# footprint question can be answered with two numbers instead of one: how much of the
# binary is the language (lexer, parser, checker, code generator) and how much is the
# tooling around it. Measured on darwin-arm64: full CLI 699 KB, this core 425 KB.
#
# It is NOT part of the bootstrap monolith (scripts/self-sync.sh does not include it)
# and nothing depends on it; it is a measurement artefact and a smaller distribution
# for embedders who only need to compile.
use "./token.kaze"
use "./ast.kaze"
use "./lexer.kaze"
use "./parser.kaze"
use "./checker.kaze"
use "./codegen.kaze"

action core_mode(word: text) -> text:
    if word == "--check" or word == "check":
        return "check"
    if word == "--emit-c" or word == "emit-c":
        return "emit-c"
    return ""

action core_render(diags) -> text:
    if (length of diags) == 0:
        return "check: ok"
    let out = "check: " + (length of diags) + " diagnostic(s)"
    for each d in diags:
        set out to out + "\n" + d.code + " at line " + d.line + ": " + d.msg
    return out

action core_main(mode, src):
    let selected = core_mode(mode)
    if selected == "check":
        let tokens = tokenize(src)
        let program = parse_program(tokens)
        return core_render(check_program(program))
    if selected == "emit-c":
        let tokens = tokenize(src)
        let program = parse_program(tokens)
        return emit_c_program(program)
    return "core: usage: <binary> check|emit-c <file>"

action main(mode, src):
    return core_main(mode, src)
