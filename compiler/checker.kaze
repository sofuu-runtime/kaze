# checker.kaze — the pure-Kaze semantic checker.
#
# It reads the AST the parser produced and returns a list of Diagnostic
# records. It never runs the program, never prints and never fabricates a pass:
# a rule it cannot decide produces no diagnostic, and SELF-HOSTING.md names
# every rule it implements.
#
# Rules implemented from the AST alone (phase 2 and phase 5, H-1):
#
#   1. a capability family used but not declared in needs:   E_CAP_UNDECLARED
#   2. a capability operation the registry does not know:     E_KAZE_CAP_OP
#   3. a name that is not bound and not a known builtin:      E_KAZE_UNKNOWN_NAME
#   4. a filter whose body can fall off the end:              E_KAZE_FILTER_FALLTHROUGH
#   5. division or modulo with no fallback and a divisor
#      that is not a non-zero literal:                         E_KAZE_MISSING_FALLBACK
#   6. a dynamic index with no fallback and no enclosing
#      length guard:                                          E_KAZE_MISSING_FALLBACK
#   7. a constant index outside a literal's length:           E_KAZE_BOUNDS
#   8. a while loop with no bounded ceiling:                  E_KAZE_LOOP_UNBOUNDED
#   9. a recursive routine with no recursion bounded:         E_KAZE_RECURSION_UNBOUNDED
#  10. a requires/ensures clause that is not boolean:         E_KAZE_CONTRACT_NOT_BOOL
#  11. a needs: entry that is not a family or an instance:    E_KAZE_CAP_UNKNOWN
#  12. an expression the parser could not read:               E_KAZE_PARSE
#
# The Rust front end (kaze/src/checker.rs, strict.rs) remains the reference for
# everything else: type inference, unit algebra, host-record field fallbacks,
# capability argument counts, contract satisfiability and interval propagation.
use "./ast.kaze"

record Diagnostic:
    code: str
    line: num
    msg: str
    file: str

action diag(code, line, msg):
    return Diagnostic(code: code, line: line, msg: msg, file: "")

# A diagnostic that knows which module it came from. Single-file checks leave
# `file` empty, so their rendered form is byte-for-byte what it always was.
action diag_in(code, line, msg, file):
    return Diagnostic(code: code, line: line, msg: msg, file: file)

action render_diag(d: Diagnostic):
    if d.file != "":
        return d.file + ":" + d.line + ": " + d.code + ": " + d.msg
    return d.code + " at line " + d.line + ": " + d.msg

# ── small text and list helpers ─────────────────────────────────────────

action list_has(items, want):
    let i = 0
    let len = length of items
    let found = 0
    while i < len and found == 0 bounded 1000000:
        let cur = items[i] otherwise ""
        if cur == want:
            set found to 1
        set i to i + 1
    return found

action drop_last(items):
    let out = []
    let len = length of items
    let i = 0
    while i < len - 1 bounded 1000000:
        set out to out + [items[i] otherwise ""]
        set i to i + 1
    return out

# The part of a name before the first dot, or the whole name.
action head_words(name):
    let len = length of name
    let i = 0
    let out = ""
    let done = 0
    while i < len and done == 0 bounded 1000:
        let c = name[i] otherwise "x"
        if c == ".":
            set done to 1
        otherwise:
            set out to out + c
        set i to i + 1
    return out

# The part of a name after the first dot.
action tail_words(name):
    let len = length of name
    let i = 0
    let out = ""
    let seen = 0
    while i < len bounded 1000:
        let c = name[i] otherwise "x"
        if seen == 1:
            set out to out + c
        if c == "." and seen == 0:
            set seen to 1
        set i to i + 1
    return out

action has_dot(name):
    let len = length of name
    let i = 0
    let found = 0
    while i < len bounded 1000:
        if (name[i] otherwise "x") == ".":
            set found to 1
        set i to i + 1
    return found

action is_upper(word):
    let len = length of word
    if len == 0:
        return 0
    let c = word[0] otherwise "?"
    if c >= "A" and c <= "Z":
        return 1
    return 0

# ── the capability registry the checker knows ──────────────────────────
#
# The same table as kaze/src/caps.rs. It lives here so the pure-Kaze front end
# can answer "is this operation real" without a host.

action cap_name_known(w):
    # 'regs' is a requirement without verbs: a program declares it and gains the
    # mmio_* builtins, which are the only way to reach a peripheral register. It has no
    # .verb entries because a register access is not an operation on the world that a
    # policy can meaningfully inspect one call at a time; the declaration is the gate.
    if w == "regs":
        return 1
    if w == "drone" or w == "rover" or w == "sensor" or w == "device" or w == "memory" or w == "policy" or w == "log" or w == "alert" or w == "ai" or w == "tool":
        return 1
    if w == "tools" or w == "agent" or w == "model" or w == "llm":
        return 1
    if w == "lidar" or w == "camera" or w == "thermostat" or w == "probe":
        return 1
    if w == "fan" or w == "mister" or w == "pump" or w == "relay" or w == "valve" or w == "motor" or w == "light":
        return 1
    return 0

# The capability surface the compiler knows: one entry per family.verb. This is the
# single source of truth - op_known reads it, and `kaze surface` prints it so
# scripts/kaze-drift-check.sh can compare the standalone compiler with the embedded
# product engine. Keeping it as data rather than an if-chain is what makes the drift
# claim checkable at all.
action cap_verbs() -> list:
    return [
        "drone.arm", "drone.land", "drone.rtl", "drone.hold", "drone.stop",
        "drone.takeoff", "drone.goto", "drone.telemetry",
        "rover.forward", "rover.backward", "rover.turn_left", "rover.turn_right",
        "rover.stop", "rover.telemetry",
        "sensor.temperature", "sensor.humidity", "sensor.distance",
        "sensor.front_distance", "sensor.read", "sensor.telemetry",
        "device.set_relay", "device.pulse", "device.read_gpio", "device.set_duty",
        "memory.save", "memory.recall",
        "policy.detects", "policy.detect", "policy.allow", "policy.reject",
        "log.info", "log.warn", "log.error", "log.debug",
        "alert.send",
        "ai.prompt", "ai.complete", "ai.classify",
        "tool.call", "tool.run"
    ]

action op_known(family, op):
    return list_has(cap_verbs(), family + "." + op)

# Register access: the builtins that touch hardware. They are pure names as far as
# resolution goes, but a program may not call one without declaring 'needs: regs'.
action mmio_builtin(name):
    if name == "mmio_read8" or name == "mmio_read16" or name == "mmio_read32":
        return 1
    if name == "mmio_write8" or name == "mmio_write16" or name == "mmio_write32":
        return 1
    if name == "mmio_fence":
        return 1
    return 0

action pure_builtin(name):
    if mmio_builtin(name) == 1:
        return 1
    if name == "code" or name == "character" or name == "byte_at":
        return 1
    if name == "clock_monotonic_ns" or name == "clock_utc_seconds":
        return 1
    if name == "sin" or name == "cos" or name == "tan" or name == "sqrt" or name == "atan2":
        return 1
    if name == "abs" or name == "min" or name == "max" or name == "floor" or name == "ceil" or name == "round":
        return 1
    if name == "vector" or name == "link_lost" or name == "length":
        return 1
    if name == "channel":
        return 1
    if name == "parallel_map" or name == "parallel_filter":
        return 1
    # Phase 3 of the libraries/tooling plan: an explicit, host-granted HTTP
    # fetch. The builtin is standalone-only; the embedded engine has its own
    # capability registry and does not claim it.
    if name == "http_fetch":
        return 1
    # Phase 12 tensor builtins. The names are namespaced (tensor_add, tensor_sum)
    # so a program routine may still be called add or sum.
    if name == "tensor" or name == "zeros":
        return 1
    if name == "matmul" or name == "matmul_t" or name == "add_bias":
        return 1
    if name == "tensor_add" or name == "tensor_sub" or name == "tensor_mul" or name == "tensor_div":
        return 1
    if name == "transpose" or name == "reshape":
        return 1
    if name == "softmax" or name == "rms_norm" or name == "layer_norm":
        return 1
    if name == "gelu" or name == "silu" or name == "relu":
        return 1
    if name == "tensor_sum" or name == "tensor_mean":
        return 1
    if name == "argmax" or name == "tensor_get" or name == "tensor_shape":
        return 1
    if name == "model_open" or name == "model_forward":
        return 1
    if name == "cli_text":
        return 1
    # Compiler host intrinsics: the filesystem is not a language capability, it
    # is how a source file names its dependencies. A program that never imports
    # anything never calls these.
    if name == "source_read" or name == "source_exists" or name == "source_path":
        return 1
    if name == "env_text":
        return 1
    if name == "exit_code":
        return 1
    return 0

# ── facts: what an enclosing guard proves ──────────────────────────────
#
# Two fact shapes, both plain text:
#   "lt:<index-key>:<collection-key>"  the index is below the collection length
#   "len:<collection-key>:<n>"         the collection has a known length

action key_of(e: AstNode):
    recursion bounded 64
    if e.kind == "IDENT":
        return e.name
    if e.kind == "FIELD":
        let base = key_of(child_at(e, 0))
        if base == "":
            return ""
        return base + "." + e.name
    return ""

# The collection a bound compares against: "length of xs" directly, or a local
# that a let bound to "length of xs" ("let len = length of src", then "i < len").
action bound_coll_key(bound: AstNode, facts):
    if bound.kind == "LEN":
        return key_of(child_at(bound, 0))
    if bound.kind == "IDENT":
        return alias_target(facts, bound.name)
    return ""

action alias_target(facts, name):
    let prefix = "alias:" + name + ":"
    let i = 0
    let len = length of facts
    let out = ""
    while i < len bounded 100000:
        let f = facts[i] otherwise ""
        if starts_with(f, prefix) == 1:
            set out to tail_from(f, prefix)
        set i to i + 1
    return out

action fact_lt(idx: AstNode, bound: AstNode, facts):
    let out = []
    let ik = key_of(idx)
    let ck = bound_coll_key(bound, facts)
    if ik != "" and ck != "":
        set out to out + ["lt:" + ik + ":" + ck]
    return out

action facts_from_cond(cond: AstNode, facts):
    recursion bounded 200
    let out = []
    if cond.kind == "BIN":
        if cond.name == "and":
            set out to out + facts_from_cond(child_at(cond, 0), facts)
            set out to out + facts_from_cond(child_at(cond, 1), facts)
        if cond.name == "<":
            set out to out + fact_lt(child_at(cond, 0), child_at(cond, 1), facts)
        if cond.name == ">":
            set out to out + fact_lt(child_at(cond, 1), child_at(cond, 0), facts)
    return out

action is_constant(e: AstNode):
    if e.kind == "NUM":
        return 1
    return 0

action constant_value(e: AstNode):
    return text_to_num(e.val_str)

# A non-zero literal divisor is provably safe: 4, 4.0, but not 0.
action nonzero_literal(e: AstNode):
    if e.kind != "NUM":
        return 0
    let v = text_to_num(e.val_str)
    if v > 0:
        return 1
    if v < 0:
        return 1
    return 0

# ── boolean shaping for contract clauses ───────────────────────────────

action is_boolean_expr(e: AstNode):
    recursion bounded 200
    if e.kind == "BOOL":
        return 1
    if e.kind == "BIN":
        if e.name == "==" or e.name == "!=" or e.name == "<" or e.name == "<=" or e.name == ">" or e.name == ">=":
            return 1
        if e.name == "and" or e.name == "or" or e.name == "not":
            return 1
    if e.kind == "CALL":
        if has_dot(e.name) == 1 and head_words(e.name) == "policy":
            return 1
        if e.name == "link_lost":
            return 1
    return 0

# ── name resolution ────────────────────────────────────────────────────

action name_allowed(name, names):
    if list_has(names, name) == 1:
        return 1
    if is_telemetry(name) == 1:
        return 1
    if name == "result":
        return 1
    return 0

action routine_named(items, name):
    let i = 0
    let len = length of items
    let found = none_node()
    while i < len bounded 1000000:
        let it = node_at(items, i)
        if it.name == name:
            set found to it
        set i to i + 1
    return found

action record_named(items, name):
    let i = 0
    let len = length of items
    let found = 0
    while i < len bounded 1000000:
        let it = node_at(items, i)
        if it.name == name and it.kind == "RECORD":
            set found to 1
        set i to i + 1
    return found

# ── promised result length ─────────────────────────────────────────────
#
# "ensures length of result == 2" is how a routine tells the checker that its
# result is a fixed-size tuple, so r[0] and r[1] need no fallback.

action promised_length(item: AstNode):
    let contracts = child_at(item, 1)
    let i = 0
    let len = length of contracts.children
    let out = 0
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "CONTRACT" and c.name == "ensures":
            let e = child_at(c, 0)
            if e.kind == "BIN" and e.name == "==":
                let left = child_at(e, 0)
                let right = child_at(e, 1)
                if left.kind == "LEN" and right.kind == "NUM":
                    set out to text_to_num(right.val_str)
        set i to i + 1
    return out

# ── string prefix helpers for the length facts ─────────────────────────

action starts_with(s, prefix):
    let plen = length of prefix
    if (length of s) < plen:
        return 0
    let i = 0
    let ok = 1
    while i < plen bounded 1000:
        if (s[i] otherwise "x") != (prefix[i] otherwise "y"):
            set ok to 0
        set i to i + 1
    return ok

action tail_from(s, prefix):
    let plen = length of prefix
    let len = length of s
    let i = plen
    let out = ""
    while i < len bounded 1000:
        set out to out + (s[i] otherwise "")
        set i to i + 1
    return out

action find_len_fact(facts, ck):
    let i = 0
    let len = length of facts
    let out = 0
    let prefix = "len:" + ck + ":"
    while i < len bounded 100000:
        let f = facts[i] otherwise ""
        if starts_with(f, prefix) == 1:
            set out to text_to_num(tail_from(f, prefix))
        set i to i + 1
    return out

# ── the expression walk ────────────────────────────────────────────────

# ── unit dimensions ────────────────────────────────────────────────────
# Enough algebra to refuse adding a length to a time, which the reference engine
# reports as E_KAZE_UNIT_MISMATCH. Literals and in-unit wrappers carry a dimension;
# anything else is 'unknown' and stays quiet, because a false positive here would
# reject a correct program.

action dimension_of_unit(u: string) -> string:
    if u == "m" or u == "km" or u == "cm" or u == "mm":
        return "length"
    if u == "seconds" or u == "ms" or u == "hours" or u == "minutes":
        return "time"
    if u == "kg" or u == "gram":
        return "mass"
    if u == "Celsius" or u == "Kelvin":
        return "temperature"
    if u == "Pascal" or u == "mbar" or u == "hPa":
        return "pressure"
    if u == "ampere":
        return "current"
    if u == "degrees" or u == "radians":
        return "angle"
    if u == "%":
        return "percent"
    return ""

action unit_dimension(e: AstNode) -> string:
    recursion bounded 256
    if e.kind == "NUM" or e.kind == "IN_UNIT":
        return dimension_of_unit(unit_word(e.name))
    if e.kind == "BIN" and (e.name == "+" or e.name == "-"):
        let l = unit_dimension(child_at(e, 0))
        let r = unit_dimension(child_at(e, 1))
        if l == r:
            return l
        # a mismatch is reported by unit_mismatch; the dimension itself is unknown
        return ""
    return ""

action unit_mismatch(e: AstNode) -> string:
    recursion bounded 256
    if e.kind == "BIN" and (e.name == "+" or e.name == "-"):
        let l = unit_dimension(child_at(e, 0))
        let r = unit_dimension(child_at(e, 1))
        if (length of l) > 0 and (length of r) > 0 and l != r:
            return "cannot add or subtract " + l + " and " + r
    if e.kind == "BIN":
        let l = unit_mismatch(child_at(e, 0))
        if (length of l) > 0:
            return l
        return unit_mismatch(child_at(e, 1))
    return ""

# The expression walker proper. `guard` is true only for the immediate node inside an
# inline `otherwise`, never for its children: the reference resets the flag on every
# child, and a field read nested one level deeper than the fallback still needs its own
# (this is what caught `(reading.value + 1) otherwise 0` being wrongly accepted).
action check_expr(e: AstNode, names, facts, items, needs, open, diags):
    recursion bounded 256   # the walker recurses through this wrapper
    return check_expr_g(e, names, facts, items, needs, open, diags, 0)

action check_expr_g(e: AstNode, names, facts, items, needs, open, diags, guard):
    recursion bounded 200
    let k = e.kind
    if k == "NUM" or k == "STR" or k == "BOOL":
        return diags

    if k == "IDENT":
        if name_allowed(e.name, names) == 1:
            return diags
        let r = routine_named(items, e.name)
        if r.kind != "NONE":
            return diags
        set diags to diags + [diag("E_KAZE_UNKNOWN_NAME", e.line, "'" + e.name + "' is not a parameter, a let binding or a known value")]
        return diags

    if k == "UNKNOWN":
        set diags to diags + [diag("E_KAZE_PARSE", e.line, "the parser could not read this expression")]
        return diags

    if k == "FIELD":
        let out = check_expr(child_at(e, 0), names, facts, items, needs, open, diags)
        let base = child_at(e, 0)
        # Closed-world only: in a file with imports a record type may be declared elsewhere,
        # and this checker cannot see it. The reference resolves imports, so it has no such
        # blind spot; refusing here would be a false positive.
        if guard == 0 and base.kind == "IDENT" and list_has(facts, "param:" + base.name) == 1 and list_has(facts, "recparam:" + base.name) == 0 and (open == 0 or list_has(facts, "untyped:" + base.name)):
            set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "'" + base.name + "." + e.name + "' reads a field of '" + base.name + "', which came from outside this routine and may not have it; write '<read> otherwise <fallback>' or declare '" + base.name + "' with a record type")]
        return out

    if k == "LEN" or k == "IN_UNIT":
        return check_expr(child_at(e, 0), names, facts, items, needs, open, diags)

    if k == "LIST":
        let out = diags
        for each item in e.children:
            set out to check_expr(item, names, facts, items, needs, open, out)
        return out

    if k == "INDEX":
        return check_index(e, names, facts, items, needs, open, diags)

    if k == "BIN":
        # A long left-deep chain (this compiler's own string building has chains
        # of hundreds of "+") must not cost one frame per operator. Walk the left
        # spine with a loop, then check each right operand and the head.
        let rights = []
        let ops = []
        let cur = e
        let guard = 0
        while cur.kind == "BIN" and guard < 100000 bounded 100000:
            set rights to rights + [child_at(cur, 1)]
            set ops to ops + [cur.name]
            set cur to child_at(cur, 0)
            set guard to guard + 1
        let out = check_expr(cur, names, facts, items, needs, open, diags)
        let umsg = unit_mismatch(e)
        if (length of umsg) > 0:
            set out to out + [diag("E_KAZE_UNIT_MISMATCH", e.line, umsg)]
        let i = (length of rights) - 1
        while i >= 0 bounded 100000:
            let right = node_at(rights, i)
            let op = ops[i] otherwise ""
            set out to check_expr(right, names, facts, items, needs, open, out)
            if op == "/" or op == "%":
                if nonzero_literal(right) == 0:
                    set out to out + [diag("E_KAZE_MISSING_FALLBACK", right.line, "this '" + op + "' can divide by zero and has no fallback; write '<value> " + op + " <divisor> otherwise <fallback>'")]
            set i to i - 1
        return out

    if k == "FALLBACK":
        let inner = child_at(e, 0)
        let fb = child_at(e, 1)
        # The fallback covers the fallible head; its operands are still checked.
        if inner.kind == "INDEX":
            let out = check_expr(child_at(inner, 0), names, facts, items, needs, open, diags)
            set out to check_expr(child_at(inner, 1), names, facts, items, needs, open, out)
            return check_expr(fb, names, facts, items, needs, open, out)
        if inner.kind == "BIN" and (inner.name == "/" or inner.name == "%"):
            let out = check_expr(child_at(inner, 0), names, facts, items, needs, open, diags)
            set out to check_expr(child_at(inner, 1), names, facts, items, needs, open, out)
            return check_expr(fb, names, facts, items, needs, open, out)
        let out = check_expr_g(inner, names, facts, items, needs, open, diags, 1)
        return check_expr(fb, names, facts, items, needs, open, out)

    if k == "CALL":
        return check_call(e, names, facts, items, needs, open, diags, guard)

    # receive from <channel> fails when the ring buffer is empty, so it is a
    # fallible read: the checker asks for the same otherwise fallback a dynamic
    # index or a device read needs.
    if k == "RECEIVE":
        let out = check_expr(child_at(e, 0), names, facts, items, needs, open, diags)
        if guard == 0:
            set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this 'receive from' fails when the channel is empty and has no fallback; write 'receive from <channel> otherwise <fallback>'")]
        return out

    return diags

action check_index(e: AstNode, names, facts, items, needs, open, diags):
    recursion bounded 200
    let coll = child_at(e, 0)
    let idx = child_at(e, 1)
    let out = check_expr(coll, names, facts, items, needs, open, diags)
    set out to check_expr(idx, names, facts, items, needs, open, out)
    let ck = key_of(coll)
    if is_constant(idx) == 1:
        # A literal collection is checked against its own length.
        if coll.kind == "LIST":
            let n = length of coll.children
            let k = constant_value(idx)
            if k >= 0 and k < n:
                return out
            set out to out + [diag("E_KAZE_BOUNDS", e.line, "this index is outside the value it reads; a constant position past the end is refused")]
            return out
        if coll.kind == "STR":
            # A constant index into a text literal is proved against its length, the same
            # way a list literal is. Without this, `"kaze"[2]` was refused for want of a
            # fallback even though the position is plainly inside (a false positive, and
            # the corpus comparison against the reference caught it).
            let n = length of coll.val_str
            let k = constant_value(idx)
            if k >= 0 and k < n:
                return out
            set out to out + [diag("E_KAZE_BOUNDS", e.line, "this index is outside the value it reads; a constant position past the end is refused")]
            return out
        if ck != "":
            if list_has(facts, "lt:" + idx.val_str + ":" + ck) == 1:
                return out
            let promised = find_len_fact(facts, ck)
            let k = constant_value(idx)
            if promised > 0:
                if k >= 0 and k < promised:
                    return out
                set out to out + [diag("E_KAZE_BOUNDS", e.line, "this index is outside the value it reads; a constant position past the end is refused")]
                return out
        set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this index is not proved to be inside the value; guard it (if i < length of xs:) or write '<value>[<i>] otherwise <fallback>'")]
        return out
    if ck == "":
        set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this index is not proved to be inside the value; guard it (if i < length of xs:) or write '<value>[<i>] otherwise <fallback>'")]
        return out
    let ik = key_of(idx)
    if ik != "" and list_has(facts, "lt:" + ik + ":" + ck) == 1:
        return out
    set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this index is not proved to be inside the value; guard it (if i < length of xs:) or write '<value>[<i>] otherwise <fallback>'")]
    return out

# Which capability reads must carry a fallback, ported from the reference engine
# (src/strict.rs::needs_fallback). Sensor reads always return a number the script acts on;
# device and memory only on their read verbs; everything else - log, alert, policy,
# drone effectors - is an effect or a decision and needs none.
action needs_fallback_cap(family: string, op: string) -> num:
    if family == "sensor":
        return 1
    if family == "device":
        if op == "read_gpio" or op == "read":
            return 1
        return 0
    if family == "memory":
        if op == "recall":
            return 1
        return 0
    return 0

action check_call(e: AstNode, names, facts, items, needs, open, diags, guarded):
    recursion bounded 200
    let name = e.name
    let out = diags
    for each a in e.children:
        if a.kind == "NAMED_ARG":
            set out to check_expr(child_at(a, 0), names, facts, items, needs, open, out)
        otherwise:
            set out to check_expr(a, names, facts, items, needs, open, out)

    if has_dot(name) == 1:
        let head = head_words(name)
        let op = tail_words(name)
        # Geometry is a pure builtin family, not a capability - but the reference still
        # resolves geo through the device family, so its reads need a fallback too.
        if head == "geo":
            # The reference resolves geo through the device family, so its reads need a
            # fallback too; returning here used to skip that check.
            if guarded == 0 and list_has(facts, "in_try") == 0 and needs_fallback_cap("device", op) == 1:
                set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this reads geo." + op + " and needs a fallback; write '<read> otherwise <fallback>'")]
            return out
        let family = family_of_word(head)
        if list_has(needs, family) == 0:
            set out to out + [diag("E_CAP_UNDECLARED", e.line, "'" + family + "' is used but this file does not declare it; add it to the needs: line")]
        if op_known(family, op) == 0:
            set out to out + [diag("E_KAZE_CAP_OP", e.line, "'" + family + "." + op + "' is not an operation Kaze knows")]
        if guarded == 0 and list_has(facts, "in_try") == 0 and list_has(needs, family) == 1 and needs_fallback_cap(family, op) == 1:
            set out to out + [diag("E_KAZE_MISSING_FALLBACK", e.line, "this reads " + family + "." + op + " and needs a fallback; write '<read> otherwise <fallback>'")]
        return out

    if is_upper(name) == 1:
        if open == 0 and record_named(items, name) == 0:
            set out to out + [diag("E_KAZE_UNKNOWN_NAME", e.line, "record '" + name + "' is not defined in this file")]
        return out

    if mmio_builtin(name) == 1:
        # Fail closed: a register access without the declaration is a compile error, not a
        # runtime surprise on a board nobody provisioned.
        if list_has(needs, "regs") == 0:
            set out to out + [diag("E_KAZE_MISSING_CAPABILITY", e.line, "'" + name + "' touches hardware registers; declare 'needs: regs' at the top of the program")]
        return out
    if name == "parallel_map" or name == "parallel_filter":
        let p_args = e.children
        if (length of p_args) < 2:
            set out to out + [diag("E_KAZE_CALL_ARGS", e.line, "'" + name + "' expects 2 arguments: collection and pure worker routine")]
            return out
        let fn_arg = child_at(e, 1)
        let fn_name = ""
        if fn_arg.kind == "STR":
            set fn_name = fn_arg.val_str
        if fn_arg.kind == "IDENT":
            set fn_name = fn_arg.name
        if fn_name != "":
            let r = routine_named(items, fn_name)
            if r.kind != "NONE":
                let rn = routine_needs(r)
                if (length of rn) > 0:
                    set out to out + [diag("E_KAZE_IMPURE_PARALLEL", e.line, "'" + name + "' worker routine '" + fn_name + "' is impure; parallel operations require pure actions (needs: [])")]
            otherwise:
                if open == 0:
                    set out to out + [diag("E_KAZE_UNKNOWN_NAME", e.line, "'" + fn_name + "' is not a routine in this file")]
        return out
    if pure_builtin(name) == 1:
        return out

    let callee = routine_named(items, name)
    if callee.kind != "NONE":
        return out
    if open == 1:
        return out
    set out to out + [diag("E_KAZE_UNKNOWN_NAME", e.line, "'" + name + "' is not a routine in this file")]
    return out

# ── statements ─────────────────────────────────────────────────────────

action check_stmt(s: AstNode, names, facts, items, needs, open, diags):
    recursion bounded 200
    let k = s.kind
    if k == "LET":
        return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
    if k == "SET":
        let out = check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
        if list_has(names, s.name) == 0:
            set out to out + [diag("E_KAZE_UNKNOWN_NAME", s.line, "'" + s.name + "' is set but never bound; use 'let " + s.name + " = ...' first")]
        return out
    if k == "RETURN":
        if (length of s.children) > 0:
            return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
        return diags
    if k == "EXPR":
        return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
    if k == "GUARD":
        return check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
    if k == "IF":
        let cond = child_at(s, 0)
        let inner_facts = facts + facts_from_cond(cond, facts)
        let out = check_expr(cond, names, facts, items, needs, open, diags)
        set out to check_stmts(kids_of(child_at(s, 1)), names, inner_facts, items, needs, open, out)
        set out to check_stmts(kids_of(child_at(s, 2)), names, facts, items, needs, open, out)
        return out
    if k == "WHILE":
        let cond = child_at(s, 0)
        let bound = child_at(s, 2)
        let out = check_expr(cond, names, facts, items, needs, open, diags)
        if bound.val_str == "" or bound.val_str == "?":
            set out to out + [diag("E_KAZE_LOOP_UNBOUNDED", s.line, "this while loop declares no fuel ceiling; write a bounded form")]
        otherwise:
            if text_to_num(bound.val_str) < 1:
                set out to out + [diag("E_KAZE_LOOP_UNBOUNDED", s.line, "this while loop needs a whole number of iterations from 1 up")]
        let inner_facts = facts + facts_from_cond(cond, facts)
        set out to check_stmts(kids_of(child_at(s, 1)), names, inner_facts, items, needs, open, out)
        return out
    if k == "FOR_EACH":
        let out = check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
        set out to check_stmts(kids_of(child_at(s, 1)), names + [s.name], facts, items, needs, open, out)
        return out
    if k == "PARALLEL_FOR":
        let out = check_expr(child_at(s, 0), names, facts, items, needs, open, diags)
        set out to check_stmts(kids_of(child_at(s, 1)), names + [s.name], facts, items, needs, open, out)
        let calls = calls_in_stmts(kids_of(child_at(s, 1)), [])
        for each call_name in calls:
            if mmio_builtin(call_name) == 1:
                set out to out + [diag("E_KAZE_IMPURE_PARALLEL", s.line, "parallel loop body calls '" + call_name + "' which touches hardware; parallel operations require pure actions (needs: [])")]
            otherwise:
                let r = routine_named(items, call_name)
                if r.kind != "NONE":
                    let rn = routine_needs(r)
                    if (length of rn) > 0:
                        set out to out + [diag("E_KAZE_IMPURE_PARALLEL", s.line, "parallel loop body calls impure routine '" + call_name + "'; parallel operations require pure actions (needs: [])")]
        return out
    if k == "TRY":
        # `in_try` exempts capability reads (recoverable) and nothing else: a missing field'
        # or a bad index is fatal in the reference, so those rules keep firing here.'
        let try_facts = facts + ["in_try"]
        let out = check_stmts(kids_of(child_at(s, 0)), names, try_facts, items, needs, open, diags)
        let inner = names
        if s.name != "":
            set inner to names + [s.name]
        set out to check_stmts(kids_of(child_at(s, 1)), inner, facts, items, needs, open, out)
        return out
    return diags

action check_stmts(stmts, names, facts, items, needs, open, diags):
    recursion bounded 200
    let i = 0
    let len = length of stmts
    let cur_names = names
    let cur_facts = facts
    let out = diags
    while i < len bounded 1000000:
        let s = node_at(stmts, i)
        set out to check_stmt(s, cur_names, cur_facts, items, needs, open, out)
        if s.kind == "LET":
            set cur_names to cur_names + [s.name]
            let v = child_at(s, 0)
            if v.kind == "LIST":
                set cur_facts to cur_facts + ["len:" + s.name + ":" + (length of v.children)]
            if v.kind == "CALL":
                let callee = routine_named(items, v.name)
                let n = promised_length(callee)
                if n > 0:
                    set cur_facts to cur_facts + ["len:" + s.name + ":" + n]
        if s.kind == "LET":
            let v2 = child_at(s, 0)
            if v2.kind == "LEN":
                let ck2 = key_of(child_at(v2, 0))
                if ck2 != "":
                    set cur_facts to cur_facts + ["alias:" + s.name + ":" + ck2]
        if s.kind == "GUARD":
            set cur_facts to cur_facts + facts_from_cond(child_at(s, 0), cur_facts)
        set i to i + 1
    return out

# ── recursion cycles ───────────────────────────────────────────────────

action calls_in_expr(e: AstNode, out):
    recursion bounded 200
    let acc = out
    if e.kind == "CALL":
        if has_dot(e.name) == 0:
            set acc to acc + [e.name]
    for each c in e.children:
        set acc to calls_in_expr(c, acc)
    return acc

action calls_in_stmt_blocks(s: AstNode, out):
    recursion bounded 200
    let acc = out
    if s.kind == "IF":
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
        set acc to calls_in_stmts(kids_of(child_at(s, 2)), acc)
    if s.kind == "WHILE":
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
    if s.kind == "FOR_EACH":
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
    if s.kind == "PARALLEL_FOR":
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
    if s.kind == "TRY":
        set acc to calls_in_stmts(kids_of(child_at(s, 0)), acc)
        set acc to calls_in_stmts(kids_of(child_at(s, 1)), acc)
    return acc

action calls_in_stmts(stmts, out):
    recursion bounded 200
    let acc = out
    let i = 0
    let len = length of stmts
    while i < len bounded 1000000:
        let s = node_at(stmts, i)
        set acc to calls_in_expr(s, acc)
        set acc to calls_in_stmt_blocks(s, acc)
        set i to i + 1
    return acc

# The call graph, built once and kept as two parallel number lists (edge source
# index, edge target index). The first version keyed every edge by routine
# *name*, so each reachability query scanned every edge and allocated a string
# per match: on this compiler's own monolith that was gigabytes. Indices make
# the whole check integer work.
action routine_names(items):
    let out = []
    for each item in items:
        set out to out + [item.name]
    return out

action index_of(names, name):
    let i = 0
    let len = length of names
    while i < len bounded 1000000:
        if (names[i] otherwise "") == name:
            return i
        set i to i + 1
    return -1

action call_edges(items, names):
    let froms = []
    let tos = []
    for each item in items:
        let from = index_of(names, item.name)
        let callees = calls_in_stmts(kids_of(child_at(item, 2)), [])
        for each c in callees:
            let to = index_of(names, c)
            if to >= 0:
                set froms to froms + [from]
                set tos to tos + [to]
    return [froms, tos]

action neighbours(froms, tos, idx):
    let out = []
    let i = 0
    let len = length of froms
    while i < len bounded 1000000:
        if (froms[i] otherwise -1) == idx:
            set out to out + [tos[i] otherwise -1]
        set i to i + 1
    return out

# Does one routine reach another through the call graph? A cycle back to the
# starting routine is recursion, and recursion needs a declared ceiling.
action reaches(start_idx, target_idx, froms, tos):
    let stack = neighbours(froms, tos, start_idx)
    let visited = []
    let found = 0
    let fuel = 0
    while (length of stack) > 0 and found == 0 and fuel < 100000 bounded 100000:
        set fuel to fuel + 1
        let cur = stack[(length of stack) - 1] otherwise -1
        set stack to drop_last(stack)
        if cur == target_idx:
            set found to 1
        otherwise:
            if list_has(visited, cur) == 0:
                set visited to visited + [cur]
                for each c in neighbours(froms, tos, cur):
                    # Push only what is neither visited nor already waiting.
                    # Without this check a dense call graph pushes the same
                    # callee over and over, and the stack list (copied on every
                    # push) grows exponentially: that was gigabytes on this
                    # compiler's own monolith.
                    if list_has(visited, c) == 0 and list_has(stack, c) == 0:
                        set stack to stack + [c]
    return found

action recursion_bound_of(item: AstNode):
    let contracts = child_at(item, 1)
    let i = 0
    let len = length of contracts.children
    let out = 0
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "RECURSION_BOUND":
            set out to text_to_num(c.val_str)
        set i to i + 1
    return out

# ── filters must not fall off the end ──────────────────────────────────

action ends_with_verdict(stmts):
    recursion bounded 64
    let len = length of stmts
    if len == 0:
        return 0
    let last = node_at(stmts, len - 1)
    if last.kind == "RETURN":
        return 1
    if last.kind == "EXPR":
        let e = child_at(last, 0)
        if e.kind == "CALL":
            let head = head_words(e.name)
            let op = tail_words(e.name)
            if head == "policy" and (op == "allow" or op == "reject"):
                return 1
    if last.kind == "IF":
        let then_ok = ends_with_verdict(kids_of(child_at(last, 1)))
        let else_ok = ends_with_verdict(kids_of(child_at(last, 2)))
        if then_ok == 1 and else_ok == 1:
            return 1
    return 0

# Names the emitter generates for its own bookkeeping (a resume label's guard,
# a frame slot, a return binding) all start with _kz_. A program that used that
# prefix could collide with one, so the prefix is reserved.
action reserved_name(w: string) -> num:
    if (length of w) < 4:
        return 0
    if w == "_kz_":
        return 1
    let i = 0
    let prefix = ""
    while i < 4 bounded 8:
        set prefix to prefix + (w[i] otherwise " ")
        set i to i + 1
    if prefix == "_kz_":
        return 1
    return 0

action reserved_diags(n: AstNode, out, depth) -> list:
    recursion bounded 64
    let acc = out
    if depth < 60:
        let nm = ""
        if n.kind == "LET" or n.kind == "SET" or n.kind == "FOR_EACH" or n.kind == "PARALLEL_FOR":
            set nm to n.name
        if n.kind == "SPAWN":
            set nm to n.val_str
        if n.kind == "PARAM":
            set nm to n.name
        if nm != "" and reserved_name(nm) == 1:
            set acc to acc + [diag("E_KAZE_RESERVED", n.line, "'" + nm + "' starts with _kz_, which the compiler reserves for its own bookkeeping")]
        for each c in n.children:
            set acc to reserved_diags(c, acc, depth + 1)
    return acc

# ── phase 13: deterministic concurrency ────────────────────────────────
#
# Three rules, all from the AST:
#
#   a. yield only inside a fiber body                 E_KAZE_YIELD
#   b. a fiber is spawned, never called               E_KAZE_FIBER_CALL
#   c. a fiber may not reach a capability             E_KAZE_FIBER_EFFECT
#
# Rule (c) is what makes the concurrency model race-free by construction: only
# the serialized root task can touch hardware, so two fibers can never race for
# an effector, and a fiber never holds a device while it is suspended.

action name_is_capability(name) -> num:
    if has_dot(name) == 0:
        return 0
    if head_words(name) == "geo":
        return 0
    return cap_name_known(head_words(name))

action call_names_of(nodes) -> list:
    let out = []
    for each n in nodes:
        set out to out + [n.name]
    return out

action calls_reach_capability(call_names, items, depth) -> num:
    recursion bounded 12
    if depth > 8:
        return 0
    for each nm in call_names:
        if name_is_capability(nm) == 1:
            return 1
        let callee = routine_named(items, nm)
        if callee.kind != "NONE" and callee.kind != "RECORD":
            let inner = call_names_of(collect_kind(child_at(callee, 2), "CALL", [], 0))
            if calls_reach_capability(inner, items, depth + 1) == 1:
                return 1
    return 0

# Every node of a given kind inside an item body, wherever it sits.
action collect_kind(n: AstNode, want, out, depth) -> list:
    recursion bounded 64
    let acc = out
    if depth < 60:
        if n.kind == want:
            set acc to acc + [n]
        for each c in n.children:
            set acc to collect_kind(c, want, acc, depth + 1)
    return acc

action fiber_declared(items, name) -> num:
    let it = routine_named(items, name)
    if it.kind == "FIBER":
        return 1
    return 0

action body_of(item: AstNode) -> AstNode:
    if item.kind == "WHEN" or item.kind == "EVERY":
        return child_at(item, 1)
    return child_at(item, 2)

action concurrency_diags_item(item: AstNode, items) -> list:
    recursion bounded 64
    let out = []
    let body = body_of(item)
    let yields = collect_kind(body, "YIELD", [], 0)
    let spawns = collect_kind(body, "SPAWN", [], 0)
    # every call in the body, dotted capability calls included
    let calls = call_names_of(collect_kind(body, "CALL", [], 0))

    # (a) a yield suspends the fiber that owns it; nothing else can suspend.
    if item.kind != "FIBER":
        for each y in yields:
            set out to out + [diag("E_KAZE_YIELD", y.line, "'yield' is only legal inside a fiber body; a routine an action calls cannot suspend")]
    otherwise:
        # a fiber may not declare capabilities, and may not reach one
        if (length of routine_needs(item)) > 0:
            set out to out + [diag("E_KAZE_FIBER_EFFECT", item.line, "fiber '" + item.name + "' declares 'needs:'; a fiber is pure by construction, so hardware calls stay in the root task")]
        if calls_reach_capability(calls, items, 0) == 1:
            set out to out + [diag("E_KAZE_FIBER_EFFECT", item.line, "fiber '" + item.name + "' reaches a capability call; spawn a pure routine instead so no two tasks can race for a device")]

    # (b) a fiber is a task, not a callable routine
    for each nm in calls:
        if fiber_declared(items, nm) == 1:
            set out to out + [diag("E_KAZE_FIBER_CALL", item.line, "'" + nm + "' is a fiber; write 'spawn " + nm + "(...) as <task>' instead of calling it")]

    # a spawn target must be a fiber declared in this file
    for each sp in spawns:
        if fiber_declared(items, sp.name) == 0:
            set out to out + [diag("E_KAZE_FIBER_TARGET", sp.line, "'" + sp.name + "' is not a fiber declared in this file; declare it with 'fiber " + sp.name + "(...)'")]
    return out

action concurrency_diags(items) -> list:
    recursion bounded 64
    let out = []
    for each item in items:
        if item.kind == "FIBER" or item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER" or item.kind == "WHEN" or item.kind == "EVERY":
            set out to out + concurrency_diags_item(item, items)
    return out

# ── items ──────────────────────────────────────────────────────────────

action param_names(item: AstNode):
    let params = child_at(item, 0)
    let out = []
    for each p in params.children:
        set out to out + [p.name]
    return out

action routine_needs(item: AstNode):
    let contracts = child_at(item, 1)
    let out = []
    let i = 0
    let len = length of contracts.children
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "ROUTINE_NEED":
            set out to out + [family_of_word(c.name)]
        set i to i + 1
    return out

action requires_facts(item: AstNode):
    let contracts = child_at(item, 1)
    let out = []
    let i = 0
    let len = length of contracts.children
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "CONTRACT" and c.name == "requires":
            set out to out + facts_from_cond(child_at(c, 0), out)
        set i to i + 1
    return out

action contract_diags(item: AstNode):
    let contracts = child_at(item, 1)
    let out = []
    let i = 0
    let len = length of contracts.children
    while i < len bounded 1000:
        let c = child_at(contracts, i)
        if c.kind == "CONTRACT":
            if is_boolean_expr(child_at(c, 0)) == 0:
                set out to out + [diag("E_KAZE_CONTRACT_NOT_BOOL", c.line, "this '" + c.name + "' clause is not true-or-false; a contract must compare or combine conditions")]
        if c.kind == "RECURSION_BOUND":
            let n = text_to_num(c.val_str)
            if n < 1 or n > 256:
                set out to out + [diag("E_KAZE_PARSE", c.line, "'recursion bounded' needs a whole number of frames from 1 to 256")]
        if c.kind == "FUEL":
            let f = text_to_num(c.val_str)
            if f < 1 or f > 10000000:
                set out to out + [diag("E_KAZE_PARSE", c.line, "'fuel' needs a whole number of scheduler steps from 1 to 10000000")]
        set i to i + 1
    return out

# A field read on a parameter that came from outside this routine may name a field the
# record does not have, and the language answers that with nothing - the reference engine
# asks for a fallback there (src/strict.rs, Expr::Field). Parameters and record-typed
# parameters travel as facts so the expression walker needs no extra parameter.
# Exactly the words the reference's TypeRef::parse resolves before it considers a name a
# record (src/ast.rs). A record declared with one of these names is never a record type,
# so a parameter annotated with it counts as coming from outside.
action is_builtin_type_word(w: string) -> num:
    if w == "int" or w == "num" or w == "number" or w == "float":
        return 1
    if w == "str" or w == "text" or w == "bool" or w == "percent":
        return 1
    if w == "length" or w == "meters":
        return 1
    if w == "time" or w == "seconds":
        return 1
    if w == "angle" or w == "degrees":
        return 1
    if w == "temperature" or w == "Celsius" or w == "celsius" or w == "Kelvin" or w == "kelvin":
        return 1
    return 0

action param_facts(item: AstNode, items) -> list:
    recursion bounded 64
    #   param:<name>    always: it is a parameter
    #   untyped:<name>  no annotation, so it can never be an imported record either
    #   recparam:<name> annotated with a record declared in this file, and the annotation
    #                   is not a builtin type word (the reference parses the annotation
    #                   and builtin type words win over a record of the same name)
    let out = []
    let params = child_at(item, 0)
    for each p in params.children:
        set out to out + ["param:" + p.name]
        if p.val_str == "":
            set out to out + ["untyped:" + p.name]
        otherwise:
            if record_named(items, p.val_str) == 1 and is_builtin_type_word(p.val_str) == 0:
                set out to out + ["recparam:" + p.name]
    return out

action check_item(item: AstNode, module_needs, items, names_all, froms, tos, open):
    let out = contract_diags(item)
    let needs = module_needs + routine_needs(item)
    let names = param_names(item)
    let facts = requires_facts(item) + param_facts(item, items)
    let body = child_at(item, 2)
    set out to check_stmts(body.children, names, facts, items, needs, open, out)
    if item.kind == "FILTER":
        if ends_with_verdict(body.children) == 0:
            set out to out + [diag("E_KAZE_FILTER_FALLTHROUGH", item.line, "this filter can fall off the end without an allow or a reject verdict")]
    if recursion_bound_of(item) == 0:
        if reaches(index_of(names_all, item.name), index_of(names_all, item.name), froms, tos) == 1:
            set out to out + [diag("E_KAZE_RECURSION_UNBOUNDED", item.line, "'" + item.name + "' reaches itself and declares no ceiling; add a bounded recursion declaration at the top of its body")]
    return out

action need_names(needs_node: AstNode):
    let out = []
    for each n in needs_node.children:
        set out to out + [n.name]
    return out

action declared_families(need_list):
    let out = []
    for each n in need_list:
        set out to out + [family_of_word(n)]
    return out

# ── Phase 12: tensor shape algebra ─────────────────────────────────────
#
# Tensor shape checking is a second, additive pass: it does not re-run the
# strictness rules above, it infers a shape for every expression that can have
# one and refuses a program whose shapes cannot be unified. The representation is
# plain lists so the pass needs no new record types:
#
#   spec   ["tensor", d0, d1, ...]   a tensor shape (dims are text)
#          ["num"] ["bool"] ["text"] ["list"] ["model"] ["?"]
#   env    [[name, spec], ...]
#   binds  [[symbol, dim], ...]      symbolic dimension unification bindings
#
# Shapes are canonical text in the type annotation (tensor<f32,[2,3]>). Parsing
# that text here keeps the AST, the machine syntax and the human syntax on one
# representation.

action ts_char(s: string, i: num) -> string:
    if i >= 0 and i < (length of s):
        return (s[i] otherwise "")
    return ""

action ts_find(s: string, want: string, from: num) -> num:
    let i = from
    let n = length of s
    let found = 0 - 1
    while i < n bounded 100000:
        if ts_char(s, i) == want:
            set found to i
            set i to n
        otherwise:
            set i to i + 1
    return found

action ts_starts(s: string, pre: string) -> num:
    if (length of pre) > (length of s):
        return 0
    let i = 0
    let ok = 1
    while i < (length of pre) bounded 10000:
        if ts_char(s, i) != ts_char(pre, i):
            set ok to 0
            set i to length of pre
        otherwise:
            set i to i + 1
    return ok

action is_num_text(s: string) -> num:
    if (length of s) == 0:
        return 0
    let i = 0
    let ok = 1
    while i < (length of s) bounded 10000:
        let c = ts_char(s, i)
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or c == "8" or c == "9":
            set i to i + 1
        otherwise:
            set ok to 0
            set i to length of s
    return ok

action num_text_of(i: num) -> string:
    # Small non-negative integers only (ranks, literal dims, error text). Kaze
    # numbers are floats, so //-style truncation is done by repeated subtraction.
    if i <= 0:
        return "0"
    let n = i
    let out = ""
    let guard = 0
    while n > 0 bounded 1000:
        let q = 0
        let rem = n
        while rem >= 10 bounded 1000:
            set rem to rem - 10
            set q to q + 1
        let ch = ts_char("0123456789", rem)
        set out to ch + out
        set n to q
        set guard to guard + 1
    return out

# Parses "tensor<f32,[2,3]>" / "tensor<f16,[B,D]>" into ["tensor","2","3"].
# Anything that is not a tensor annotation yields [].
action tensor_spec_of_type(ty: string) -> list:
    if ts_starts(ty, "tensor<") == 0:
        return []
    let n = length of ty
    let comma = ts_find(ty, ",", 7)
    if comma < 0:
        return []
    let p = comma + 1
    if ts_char(ty, p) != "[":
        return []
    set p to p + 1
    let dims = []
    let cur = ""
    let done = 0
    while done == 0 bounded 10000:
        let c = ts_char(ty, p)
        if c == "" or c == "]":
            if cur != "":
                set dims to dims + [cur]
            set done to 1
        otherwise:
            if c == ",":
                if cur != "":
                    set dims to dims + [cur]
                set cur to ""
            otherwise:
                set cur to cur + c
        set p to p + 1
    if (length of dims) == 0:
        return []
    return ["tensor"] + dims

action rank_of(spec: list) -> num:
    if (length of spec) == 0:
        return 0
    if (spec[0] otherwise "") != "tensor":
        return 0
    return (length of spec) - 1

action dim_of(spec: list, i: num) -> string:
    if i >= 0 and i < rank_of(spec):
        return (spec[i + 1] otherwise "")
    return ""

action spec_equal(a: list, b: list) -> num:
    if (length of a) != (length of b):
        return 0
    let i = 0
    let ok = 1
    while i < (length of a) bounded 10000:
        if (a[i] otherwise "") != (b[i] otherwise ""):
            set ok to 0
            set i to length of a
        otherwise:
            set i to i + 1
    return ok

action render_spec(spec: list) -> string:
    if (length of spec) == 0:
        return "nothing"
    if (spec[0] otherwise "") != "tensor":
        return (spec[0] otherwise "")
    let out = "["
    let i = 0
    while i < rank_of(spec) bounded 1000:
        if i > 0:
            set out to out + ","
        set out to out + dim_of(spec, i)
        set i to i + 1
    return out + "]"

action resolve_dim(dim: string, binds: list) -> string:
    let cur = dim
    let guard = 0
    while guard < 128 bounded 128:
        let next = ""
        for each b in binds:
            if (b[0] otherwise "") == cur:
                set next to (b[1] otherwise "")
        if next == "" or next == cur:
            return cur
        set cur to next
        set guard to guard + 1
    return cur

# Unify one dimension. Returns [ok, binds]; ok is "1" or "0".
action bind_dim(x: string, y: string, binds: list) -> list:
    let rx = resolve_dim(x, binds)
    let ry = resolve_dim(y, binds)
    if rx == ry:
        return ["1", binds]
    if is_num_text(rx) == 1 and is_num_text(ry) == 1:
        return ["0", binds]
    if is_num_text(rx) == 1:
        return ["1", binds + [[ry, rx]]]
    if is_num_text(ry) == 1:
        return ["1", binds + [[rx, ry]]]
    return ["1", binds + [[ry, rx]]]

# Unify two shapes dimension by dimension. Returns [ok, binds].
action unify_shape(a: list, b: list, binds: list) -> list:
    if rank_of(a) != rank_of(b):
        return ["0", binds]
    let cur = binds
    let i = 0
    let ok = 1
    while i < rank_of(a) bounded 1000:
        let r = bind_dim(dim_of(a, i), dim_of(b, i), cur)
        if (r[0] otherwise "") == "0":
            set ok to 0
            set i to rank_of(a)
        otherwise:
            set cur to (r[1] otherwise "")
            set i to i + 1
    return [num_text_of(ok), cur]

action env_get(env: list, name: string) -> list:
    let i = (length of env) - 1
    while i >= 0 bounded 10000:
        let e = (env[i] otherwise "")
        if (e[0] otherwise "") == name:
            return (e[1] otherwise "")
        set i to i - 1
    return ["?"]

action env_set(env: list, name: string, spec: list) -> list:
    return env + [[name, spec]]

action unify_specs(a: list, b: list, binds: list) -> list:
    # Only tensor shapes are this pass's contract. A number used where text sits
    # is not a shape error, and treating it as one made every string-building
    # fallback in the standard library a false positive.
    if (length of a) == 0 or (length of b) == 0:
        return ["1", binds]
    if (a[0] otherwise "") == "?" or (b[0] otherwise "") == "?":
        return ["1", binds]
    if (a[0] otherwise "") == "tensor" and (b[0] otherwise "") == "tensor":
        return unify_shape(a, b, binds)
    return ["1", binds]

action specs_compatible(a: list, b: list) -> num:
    if (length of a) == 0 or (length of b) == 0:
        return 1
    if (a[0] otherwise "") == "?" or (b[0] otherwise "") == "?":
        return 1
    if (a[0] otherwise "") != (b[0] otherwise ""):
        return 0
    if (a[0] otherwise "") != "tensor":
        return 1
    if rank_of(a) != rank_of(b):
        return 0
    let i = 0
    let ok = 1
    while i < rank_of(a) bounded 1000:
        let x = dim_of(a, i)
        let y = dim_of(b, i)
        if is_num_text(x) == 1 and is_num_text(y) == 1 and x != y:
            set ok to 0
            set i to rank_of(a)
        otherwise:
            set i to i + 1
    return ok

action shape_error(diags: list, line: num, msg: string) -> list:
    return diags + [diag("E_KAZE_SHAPE_MISMATCH", line, msg)]

action dims_product(spec: list) -> num:
    if rank_of(spec) == 0:
        return 0 - 1
    let p = 1
    let i = 0
    let known = 1
    while i < rank_of(spec) bounded 1000:
        let d = dim_of(spec, i)
        if is_num_text(d) == 1:
            set p to p * text_to_num(d)
            set i to i + 1
        otherwise:
            set known to 0
            set i to rank_of(spec)
    if known == 0:
        return 0 - 1
    return p

action spec_with_last_one(spec: list) -> list:
    if rank_of(spec) == 0:
        return spec
    let out = ["tensor"]
    let i = 0
    while i < rank_of(spec) bounded 1000:
        if i + 1 == rank_of(spec):
            set out to out + ["1"]
        otherwise:
            set out to out + [dim_of(spec, i)]
        set i to i + 1
    return out

action spec_swap_last2(spec: list) -> list:
    if rank_of(spec) != 2:
        return spec
    return ["tensor", dim_of(spec, 1), dim_of(spec, 0)]

action spec_matmul_result(a: list, b: list, transpose_right: num) -> list:
    # a's leading dims, then b's trailing dims (or leading dims when b is
    # contracted transposed). Both leading/trailing parts exclude the contracted
    # dimension itself.
    let out = ["tensor"]
    let i = 0
    while i < rank_of(a) - 1 bounded 1000:
        set out to out + [dim_of(a, i)]
        set i to i + 1
    if transpose_right == 1:
        set i to 0
        while i < rank_of(b) - 1 bounded 1000:
            set out to out + [dim_of(b, i)]
            set i to i + 1
    otherwise:
        set i to 1
        while i < rank_of(b) bounded 1000:
            set out to out + [dim_of(b, i)]
            set i to i + 1
    return out

action spec_of_list_dims(e: AstNode) -> list:
    # A shape literal such as [2, 3] gives a tensor shape; anything else is
    # unknown and is not guessed.
    if e.kind != "LIST":
        return []
    let dims = ["tensor"]
    for each c in e.children:
        if c.kind == "NUM":
            set dims to dims + [c.val_str]
        otherwise:
            return []
    if (length of dims) < 2:
        return []
    return dims

action infer_expr(e: AstNode, env: list, binds: list, items: list, diags: list) -> list:
    recursion bounded 200
    let k = e.kind
    if k == "IDENT":
        return [env_get(env, e.name), binds, diags]
    if k == "NUM":
        return [["num"], binds, diags]
    if k == "STR":
        return [["text"], binds, diags]
    if k == "BOOL":
        return [["bool"], binds, diags]
    if k == "LIST":
        return [["list"], binds, diags]
    if k == "LEN" or k == "LEN_LIT":
        return [["num"], binds, diags]
    if k == "BIN" or k == "INDEX" or k == "IN_UNIT":
        return [["num"], binds, diags]
    if k == "FIELD":
        return [["?"], binds, diags]
    if k == "FALLBACK":
        let ri = infer_expr(child_at(e, 0), env, binds, items, diags)
        let rf = infer_expr(child_at(e, 1), env, (ri[1] otherwise ""), items, (ri[2] otherwise ""))
        let u = unify_specs((ri[0] otherwise ""), (rf[0] otherwise ""), (rf[1] otherwise ""))
        let out = (rf[2] otherwise "")
        if (u[0] otherwise "") == "0":
            set out to shape_error(out, e.line, "the two sides of otherwise have different shapes: " + render_spec((ri[0] otherwise "")) + " and " + render_spec((rf[0] otherwise "")))
        return [(ri[0] otherwise ""), (u[1] otherwise ""), out]
    if k == "CALL":
        return infer_call(e, env, binds, items, diags)
    return [["?"], binds, diags]

action infer_call(e: AstNode, env: list, binds: list, items: list, diags: list) -> list:
    recursion bounded 200
    let name = e.name
    let cnt = length of e.children

    if name == "tensor":
        if cnt < 2:
            return [["?"], binds, diags]
        let vals = child_at(e, 0)
        let spec = spec_of_list_dims(child_at(e, 1))
        let out = diags
        if (length of spec) == 0:
            set out to shape_error(out, e.line, "tensor(...) needs a literal shape list such as [2, 3]")
            return [["?"], binds, out]
        if vals.kind == "LIST":
            let want = dims_product(spec)
            if want >= 0 and (length of vals.children) != want:
                set out to shape_error(out, e.line, "tensor(...) shape " + render_spec(spec) + " needs " + num_text_of(want) + " values, the list has " + num_text_of(length of vals.children))
                return [["?"], binds, out]
        return [spec, binds, out]

    if name == "zeros":
        let spec = spec_of_list_dims(child_at(e, 0))
        if (length of spec) == 0:
            return [["?"], binds, shape_error(diags, e.line, "zeros(...) needs a literal shape list such as [2, 3]")]
        return [spec, binds, diags]

    if name == "matmul" or name == "matmul_t":
        let ra = infer_expr(child_at(e, 0), env, binds, items, diags)
        let rb = infer_expr(child_at(e, 1), env, (ra[1] otherwise ""), items, (ra[2] otherwise ""))
        let a = (ra[0] otherwise "")
        let b = (rb[0] otherwise "")
        let out = (rb[2] otherwise "")
        if rank_of(a) < 2 or rank_of(b) < 2:
            set out to shape_error(out, e.line, name + " needs two matrices; got " + render_spec(a) + " and " + render_spec(b))
            return [["?"], (rb[1] otherwise ""), out]
        let xdim = dim_of(a, rank_of(a) - 1)
        let ydim = dim_of(b, 0)
        if name == "matmul_t":
            set ydim to dim_of(b, rank_of(b) - 1)
        let u = bind_dim(xdim, ydim, (rb[1] otherwise ""))
        if (u[0] otherwise "") == "0":
            set out to shape_error(out, e.line, name + " inner dimensions do not match: " + render_spec(a) + " and " + render_spec(b))
            return [["?"], (rb[1] otherwise ""), out]
        let tx = 0
        if name == "matmul_t":
            set tx to 1
        return [spec_matmul_result(a, b, tx), (u[1] otherwise ""), out]

    if name == "tensor_add" or name == "tensor_sub" or name == "tensor_mul" or name == "tensor_div":
        let ra = infer_expr(child_at(e, 0), env, binds, items, diags)
        let rb = infer_expr(child_at(e, 1), env, (ra[1] otherwise ""), items, (ra[2] otherwise ""))
        let a = (ra[0] otherwise "")
        let b = (rb[0] otherwise "")
        let out = (rb[2] otherwise "")
        if rank_of(a) > 0 and rank_of(b) > 0:
            let u = unify_shape(a, b, (rb[1] otherwise ""))
            if (u[0] otherwise "") == "0":
                set out to shape_error(out, e.line, name + " needs equal shapes; got " + render_spec(a) + " and " + render_spec(b))
                return [["?"], (rb[1] otherwise ""), out]
            return [a, (u[1] otherwise ""), out]
        if rank_of(a) > 0:
            return [a, (rb[1] otherwise ""), out]
        if rank_of(b) > 0:
            return [b, (rb[1] otherwise ""), out]
        if (a[0] otherwise "") == "num" and (b[0] otherwise "") == "num":
            return [["num"], (rb[1] otherwise ""), out]
        return [["?"], (rb[1] otherwise ""), out]

    if name == "add_bias":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        let rb = infer_expr(child_at(e, 1), env, (rx[1] otherwise ""), items, (rx[2] otherwise ""))
        let x = (rx[0] otherwise "")
        let b = (rb[0] otherwise "")
        let out = (rb[2] otherwise "")
        if rank_of(x) < 1 or rank_of(b) != 1:
            set out to shape_error(out, e.line, "add_bias needs a tensor and a rank-1 bias; got " + render_spec(x) + " and " + render_spec(b))
            return [["?"], (rb[1] otherwise ""), out]
        let u = bind_dim(dim_of(x, rank_of(x) - 1), dim_of(b, 0), (rb[1] otherwise ""))
        if (u[0] otherwise "") == "0":
            set out to shape_error(out, e.line, "add_bias bias width does not match the last dimension: " + render_spec(x) + " and " + render_spec(b))
            return [["?"], (rb[1] otherwise ""), out]
        return [x, (u[1] otherwise ""), out]

    if name == "transpose":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        if rank_of((rx[0] otherwise "")) != 2:
            return [["?"], (rx[1] otherwise ""), shape_error((rx[2] otherwise ""), e.line, "transpose here needs a rank-2 tensor; got " + render_spec((rx[0] otherwise "")))]
        return [spec_swap_last2((rx[0] otherwise "")), (rx[1] otherwise ""), (rx[2] otherwise "")]

    if name == "reshape":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        let spec = spec_of_list_dims(child_at(e, 1))
        let out = (rx[2] otherwise "")
        if (length of spec) == 0:
            return [["?"], (rx[1] otherwise ""), shape_error(out, e.line, "reshape needs a literal target shape such as [2, 3]")]
        let from_n = dims_product((rx[0] otherwise ""))
        let to_n = dims_product(spec)
        if from_n >= 0 and to_n >= 0 and from_n != to_n:
            set out to shape_error(out, e.line, "reshape changes the element count: " + render_spec((rx[0] otherwise "")) + " -> " + render_spec(spec))
            return [["?"], (rx[1] otherwise ""), out]
        return [spec, (rx[1] otherwise ""), out]

    if name == "softmax" or name == "gelu" or name == "silu" or name == "relu":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        return [(rx[0] otherwise ""), (rx[1] otherwise ""), (rx[2] otherwise "")]

    if name == "rms_norm":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        let rw = infer_expr(child_at(e, 1), env, (rx[1] otherwise ""), items, (rx[2] otherwise ""))
        let out = (rw[2] otherwise "")
        if rank_of((rx[0] otherwise "")) < 1 or rank_of((rw[0] otherwise "")) != 1:
            set out to shape_error(out, e.line, "rms_norm needs a tensor and a rank-1 weight")
            return [["?"], (rw[1] otherwise ""), out]
        let u = bind_dim(dim_of((rx[0] otherwise ""), rank_of((rx[0] otherwise "")) - 1), dim_of((rw[0] otherwise ""), 0), (rw[1] otherwise ""))
        if (u[0] otherwise "") == "0":
            set out to shape_error(out, e.line, "rms_norm weight width does not match the last dimension")
            return [["?"], (rw[1] otherwise ""), out]
        return [(rx[0] otherwise ""), (u[1] otherwise ""), out]

    if name == "layer_norm":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        let rw = infer_expr(child_at(e, 1), env, (rx[1] otherwise ""), items, (rx[2] otherwise ""))
        let out = (rw[2] otherwise "")
        if rank_of((rx[0] otherwise "")) < 1 or rank_of((rw[0] otherwise "")) != 1:
            set out to shape_error(out, e.line, "layer_norm needs a tensor and a rank-1 weight")
            return [["?"], (rw[1] otherwise ""), out]
        let u = bind_dim(dim_of((rx[0] otherwise ""), rank_of((rx[0] otherwise "")) - 1), dim_of((rw[0] otherwise ""), 0), (rw[1] otherwise ""))
        if (u[0] otherwise "") == "0":
            set out to shape_error(out, e.line, "layer_norm weight width does not match the last dimension")
            return [["?"], (rw[1] otherwise ""), out]
        let outb = out
        if cnt > 2:
            let rbb = infer_expr(child_at(e, 2), env, (u[1] otherwise ""), items, outb)
            set out to (rbb[2] otherwise "")
            if rank_of((rbb[0] otherwise "")) == 1:
                let u2 = bind_dim(dim_of((rx[0] otherwise ""), rank_of((rx[0] otherwise "")) - 1), dim_of((rbb[0] otherwise ""), 0), (rbb[1] otherwise ""))
                if (u2[0] otherwise "") == "0":
                    set out to shape_error(out, e.line, "layer_norm bias width does not match the last dimension")
        return [(rx[0] otherwise ""), (u[1] otherwise ""), out]

    if name == "tensor_sum" or name == "tensor_mean":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        return [spec_with_last_one((rx[0] otherwise "")), (rx[1] otherwise ""), (rx[2] otherwise "")]

    if name == "argmax" or name == "tensor_argmax":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        return [["num"], (rx[1] otherwise ""), (rx[2] otherwise "")]

    if name == "tensor_get":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        return [["num"], (rx[1] otherwise ""), (rx[2] otherwise "")]

    if name == "tensor_shape":
        let rx = infer_expr(child_at(e, 0), env, binds, items, diags)
        return [["list"], (rx[1] otherwise ""), (rx[2] otherwise "")]

    if name == "cli_text":
        return [["text"], binds, diags]

    if name == "model_open":
        return [["model"], binds, diags]

    if name == "model_forward":
        let rm = infer_expr(child_at(e, 0), env, binds, items, diags)
        let out = (rm[2] otherwise "")
        let rms = (rm[0] otherwise [])
        if (rms[0] otherwise "") != "model" and (rms[0] otherwise "") != "?":
            set out to shape_error(out, e.line, "model_forward needs the value model_open returned")
        if cnt < 2:
            return [["?"], (rm[1] otherwise ""), shape_error(out, e.line, "model_forward needs a token list")]
        let rt = infer_expr(child_at(e, 1), env, (rm[1] otherwise ""), items, out)
        return [["tensor", "1", "V"], (rt[1] otherwise ""), (rt[2] otherwise "")]

    let callee = routine_named(items, name)
    if callee.kind != "NONE" and cnt == (length of child_at(callee, 0).children):
        let params = child_at(callee, 0)
        let cur = binds
        let out = diags
        let i = 0
        while i < cnt bounded 1000:
            let ra = infer_expr(child_at(e, i), env, cur, items, out)
            let ps = tensor_spec_of_type(child_at(params, i).val_str)
            set out to (ra[2] otherwise "")
            if (length of ps) > 0 and rank_of((ra[0] otherwise "")) > 0:
                let u = unify_shape((ra[0] otherwise ""), ps, (ra[1] otherwise ""))
                if (u[0] otherwise "") == "0":
                    set out to shape_error(out, e.line, "argument " + num_text_of(i + 1) + " of " + name + " has shape " + render_spec((ra[0] otherwise "")) + ", the parameter declares " + render_spec(ps))
                otherwise:
                    set cur to (u[1] otherwise "")
            otherwise:
                set cur to (ra[1] otherwise "")
            set i to i + 1
        let rs = tensor_spec_of_type(callee.val_str)
        if (length of rs) > 0:
            return [rs, cur, out]
        return [["?"], cur, out]

    if pure_builtin(name) == 1:
        return [["num"], binds, diags]
    return [["?"], binds, diags]

action tensor_stmt(s: AstNode, env: list, result_spec: list, items: list, binds: list, diags: list) -> list:
    recursion bounded 200
    let k = s.kind
    if k == "LET":
        let r = infer_expr(child_at(s, 0), env, binds, items, diags)
        return [env_set(env, s.name, (r[0] otherwise "")), (r[1] otherwise ""), (r[2] otherwise "")]
    if k == "SET":
        let r = infer_expr(child_at(s, 0), env, binds, items, diags)
        let old = env_get(env, s.name)
        let u = unify_specs(old, (r[0] otherwise ""), (r[1] otherwise ""))
        let out = (r[2] otherwise "")
        if (u[0] otherwise "") == "0":
            set out to shape_error(out, s.line, "'" + s.name + "' has shape " + render_spec(old) + " but this assignment gives " + render_spec((r[0] otherwise "")))
        return [env, (u[1] otherwise ""), out]
    if k == "RETURN":
        if (length of s.children) == 0:
            return [env, binds, diags]
        let r = infer_expr(child_at(s, 0), env, binds, items, diags)
        let u = unify_specs(result_spec, (r[0] otherwise ""), (r[1] otherwise ""))
        let out = (r[2] otherwise "")
        if (u[0] otherwise "") == "0":
            set out to shape_error(out, s.line, "this routine declares shape " + render_spec(result_spec) + " but returns " + render_spec((r[0] otherwise "")))
        return [env, (u[1] otherwise ""), out]
    if k == "EXPR" or k == "GUARD":
        let r = infer_expr(child_at(s, 0), env, binds, items, diags)
        return [env, (r[1] otherwise ""), (r[2] otherwise "")]
    if k == "IF":
        let r = infer_expr(child_at(s, 0), env, binds, items, diags)
        let t = tensor_stmts(kids_of(child_at(s, 1)), (r[0] otherwise ""), result_spec, items, (r[1] otherwise ""), (r[2] otherwise ""))
        let e = tensor_stmts(kids_of(child_at(s, 2)), (t[0] otherwise ""), result_spec, items, (t[1] otherwise ""), (t[2] otherwise ""))
        return [(e[0] otherwise ""), (e[1] otherwise ""), (e[2] otherwise "")]
    if k == "WHILE":
        let r = infer_expr(child_at(s, 0), env, binds, items, diags)
        let b = tensor_stmts(kids_of(child_at(s, 1)), (r[0] otherwise ""), result_spec, items, (r[1] otherwise ""), (r[2] otherwise ""))
        return [(b[0] otherwise ""), (b[1] otherwise ""), (b[2] otherwise "")]
    if k == "FOR_EACH" or k == "PARALLEL_FOR":
        let r = infer_expr(child_at(s, 0), env, binds, items, diags)
        let inner = env_set((r[0] otherwise ""), s.name, ["num"])
        let b = tensor_stmts(kids_of(child_at(s, 1)), inner, result_spec, items, (r[1] otherwise ""), (r[2] otherwise ""))
        return [env, (b[1] otherwise ""), (b[2] otherwise "")]
    if k == "TRY":
        let inner = env
        if s.name != "":
            set inner to env_set(env, s.name, ["?"])
        let b = tensor_stmts(kids_of(child_at(s, 0)), inner, result_spec, items, binds, diags)
        let e = tensor_stmts(kids_of(child_at(s, 1)), (b[0] otherwise ""), result_spec, items, (b[1] otherwise ""), (b[2] otherwise ""))
        return [env, (e[1] otherwise ""), (e[2] otherwise "")]
    if k == "SPAWN" or k == "JOIN" or k == "SEND" or k == "RECEIVE" or k == "RETURN_VALUE":
        let cur = binds
        let out = diags
        for each c in s.children:
            let r = infer_expr(c, env, cur, items, out)
            set cur to (r[1] otherwise "")
            set out to (r[2] otherwise "")
        return [env, cur, out]
    return [env, binds, diags]

action tensor_stmts(stmts, env: list, result_spec: list, items: list, binds: list, diags: list) -> list:
    recursion bounded 200
    let cur_env = env
    let cur_binds = binds
    let out = diags
    for each s in stmts:
        let r = tensor_stmt(s, cur_env, result_spec, items, cur_binds, out)
        set cur_env to (r[0] otherwise "")
        set cur_binds to (r[1] otherwise "")
        set out to (r[2] otherwise "")
    return [cur_env, cur_binds, out]

action tensor_item_diags(item: AstNode, items: list) -> list:
    recursion bounded 200
    if item.kind != "ACTION" and item.kind != "CHECK" and item.kind != "FILTER" and item.kind != "FIBER":
        return []
    let params = child_at(item, 0)
    let env = []
    for each p in params.children:
        let spec = tensor_spec_of_type(p.val_str)
        if (length of spec) > 0:
            set env to env_set(env, p.name, spec)
    let result_spec = tensor_spec_of_type(item.val_str)
    let body = child_at(item, 2)
    let r = tensor_stmts(body.children, env, result_spec, items, [], [])
    return (r[2] otherwise "")

action tensor_diags(items: list, need_list: list) -> list:
    recursion bounded 64
    let out = []
    for each item in items:
        set out to out + tensor_item_diags(item, items)
    # Host-resource rule: opening a model file reads the host filesystem, so the
    # file must declare the memory family. A missing declaration is the same
    # class of refusal as a missing capability anywhere else.
    let calls = []
    for each item in items:
        set calls to calls + collect_kind(item, "CALL", [], 0)
    let names = call_names_of(calls)
    let needs_mem = 0
    for each nm in names:
        if nm == "model_open" or nm == "model_forward":
            set needs_mem to 1
    if needs_mem == 1:
        let declared = 0
        for each n in need_list:
            if family_of_word(n) == "memory":
                set declared to 1
        if declared == 0:
            set out to out + [diag("E_CAP_UNDECLARED", 1, "model_open reads the host filesystem but this file does not declare it; add 'memory' to the needs: line")]
    return out



action check_program(prog: AstNode):
    recursion bounded 200
    let out = []
    let items = program_items(prog)
    let need_list = need_names(program_needs(prog))
    let open = 0
    let use_node = program_uses(prog)
    if (length of use_node.children) > 0:
        set open to 1
    # 1. needs: entries must name a family or a known instance.
    let i = 0
    while i < (length of need_list) bounded 100000:
        let n = need_list[i] otherwise ""
        if cap_name_known(n) == 0:
            set out to out + [diag("E_KAZE_CAP_UNKNOWN", 1, "'" + n + "' does not name a capability family or an instance")]
        set i to i + 1
    # 2. every routine and hook. The call graph is built once here: rebuilding it
    # per routine made the recursion check quadratic in the module.
    let declared = declared_families(need_list)
    let names_all = routine_names(items)
    let graph = call_edges(items, names_all)
    let froms = graph[0] otherwise []
    let tos = graph[1] otherwise []
    set i to 0
    while i < (length of items) bounded 1000000:
        let item = node_at(items, i)
        if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER" or item.kind == "FIBER":
            set out to out + check_item(item, declared, items, names_all, froms, tos, open)
        if item.kind == "RECORD" and (length of item.children) == 0:
            # A record written on one line ('record P: a: number') parses as a record with
            # no fields, and every field read of it then yields nil without a word. Refuse
            # it here instead: the indented form is the only form the reader accepts.
            set out to out + [diag("E_KAZE_RECORD_NO_FIELDS", item.line, "record '" + item.name + "' declares no fields; indent each 'name: type' line under it")]
        if item.kind == "UNKNOWN_ITEM":
            set out to out + [diag("E_KAZE_PARSE", item.line, "the machine reader does not know the form '" + item.name + "'")]
        if item.kind == "WHEN" or item.kind == "EVERY":
            let body = child_at(item, 1)
            set out to check_stmts(body.children, [], [], items, declared, open, out)
        set i to i + 1
    # 2b. A callable may not reuse a builtin's name. The emitter resolves builder
    #     names before program routines, so a routine called 'code' would leave every
    #     code(...) call compiled to the builtin and silently return the wrong value.
    for each item in items:
        if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER" or item.kind == "FIBER":
            if pure_builtin(item.name) == 1:
                set out to out + [diag("E_KAZE_RESERVED_NAME", item.line, "'" + item.name + "' is a builtin; a routine may not reuse the name")]
    # 3. the phase 13 rules: yield placement, fiber calls, fiber effects.
    set out to out + concurrency_diags(items)
    # 3b. the phase 12 tensor shape algebra.
    set out to out + tensor_diags(items, need_list)
    # 4. the _kz_ prefix is the compiler's, in every body and every parameter list.
    for each item in items:
        set out to out + reserved_diags(item, [], 0)
    return out
