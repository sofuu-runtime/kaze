    set h to h + "}\n\n"
    set h to h + "/* Make room for `need` items. A list may start with no buffer at all, so every\n"
    set h to h + "   reader that indexes items must come through here (or check len first). */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_list_reserve(KzList* l, size_t need) {\n"
    set h to h + "    if (l->cap >= need && l->items != NULL) return;\n"
    set h to h + "    size_t cap = l->cap ? l->cap : 4;\n"
    set h to h + "    while (cap < need) cap *= 2;\n"
    set h to h + "    KzValue* items = (KzValue*)kz_alloc(cap * sizeof(KzValue));\n"
    set h to h + "    if (l->len) memcpy(items, l->items, l->len * sizeof(KzValue));\n"
    set h to h + "    l->items = items;\n"
    set h to h + "    l->cap = cap;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_list_new(size_t cap) {\n"
    set h to h + "    KzList* l = (KzList*)kz_alloc(sizeof(KzList));\n"
    set h to h + "    l->len = 0;\n"
    set h to h + "    /* Lazy buffer: an empty list costs a header, not a header and a buffer.\n"
    set h to h + "       Every site that indexes items either checks len first or goes through\n"
    set h to h + "       kz_list_reserve (audited: concat, from, append, index, for-each). */\n"
    set h to h + "    l->cap = cap > 4 ? cap : 0;\n"
    set h to h + "    l->items = (cap > 4) ? (KzValue*)kz_alloc(l->cap * sizeof(KzValue)) : NULL;\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_LIST; v.as.list = l; return v;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_list_concat(KzValue a, KzValue b) {\n"
    set h to h + "    size_t la = (a.kind == KZ_VAL_LIST && a.as.list) ? a.as.list->len : 0;\n"
    set h to h + "    size_t lb = (b.kind == KZ_VAL_LIST && b.as.list) ? b.as.list->len : 0;\n"
    set h to h + "    KzValue res = kz_list_new(la + lb);\n"
    set h to h + "    kz_list_reserve(res.as.list, la + lb);   /* the buffer is lazy: ask first */\n"
    set h to h + "    KzList* l = res.as.list;\n"
    set h to h + "    if (la) { memcpy(l->items, a.as.list->items, la * sizeof(KzValue)); l->len += la; }\n"
    set h to h + "    if (lb) { memcpy(l->items + l->len, b.as.list->items, lb * sizeof(KzValue)); l->len += lb; }\n"
    set h to h + "    return res;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_list_from(size_t n, const KzValue* items) {\n"
    set h to h + "    KzValue res = kz_list_new(n);\n"
    set h to h + "    if (n > 0 && items) { kz_list_reserve(res.as.list, n); memcpy(res.as.list->items, items, n * sizeof(KzValue)); res.as.list->len = n; }\n"
    set h to h + "    return res;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_record_create(const char* type_name, size_t n, const char** keys, const KzValue* vals) {\n"
    set h to h + "    KzRecord* r = (KzRecord*)kz_alloc(sizeof(KzRecord));\n"
    set h to h + "    r->type_name = type_name;\n"
    set h to h + "    r->field_count = n;\n"
    set h to h + "    r->keys = keys;\n"
    set h to h + "    r->values = (n > 0) ? (KzValue*)kz_alloc(n * sizeof(KzValue)) : NULL;\n"
    set h to h + "    if (n > 0 && vals && r->values) { memcpy(r->values, vals, n * sizeof(KzValue)); }\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_RECORD; v.as.record = r; return v;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_get_field(KzValue obj, const char* field) {\n"
    set h to h + "    if (obj.kind == KZ_VAL_POINT) {\n"
    set h to h + "        if (field && field[0] == 'x' && field[1] == 0) return kz_num(obj.as.point.x);\n"
    set h to h + "        if (field && field[0] == 'y' && field[1] == 0) return kz_num(obj.as.point.y);\n"
    set h to h + "        if (field && field[0] == 'z' && field[1] == 0) return kz_num(obj.as.point.z);\n"
    set h to h + "        return kz_nil();\n"
    set h to h + "    }\n"
    set h to h + "    if (obj.kind != KZ_VAL_RECORD || !obj.as.record) return kz_nil();\n"
    set h to h + "    KzRecord* r = obj.as.record;\n"
    set h to h + "    for (size_t i = 0; i < r->field_count; i++) {\n"
    set h to h + "        /* Pointer identity first: record keys and field names come from the same\n"
    set h to h + "           literals, so the common hit costs one compare instead of a strcmp. */\n"
    set h to h + "        if (r->keys[i] == field || (field && strcmp(r->keys[i], field) == 0)) return r->values[i];\n"
    set h to h + "    }\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_add(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_num(a.as.number + b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR || b.kind == KZ_VAL_STR) {\n"
    set h to h + "        KzValue sa = (a.kind == KZ_VAL_STR) ? a : kz_str(kz_to_string(a));\n"
    set h to h + "        KzValue sb = (b.kind == KZ_VAL_STR) ? b : kz_str(kz_to_string(b));\n"
    set h to h + "        return kz_str(kz_str_concat_n(sa.as.str.data, sa.as.str.len, sb.as.str.data, sb.as.str.len));\n"
    set h to h + "    }\n"
    set h to h + "    if (a.kind == KZ_VAL_LIST && b.kind == KZ_VAL_LIST) return kz_list_concat(a, b);\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_sub(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_POINT && b.kind == KZ_VAL_POINT) return kz_point(kz_num(a.as.point.x - b.as.point.x), kz_num(a.as.point.y - b.as.point.y), kz_num(a.as.point.z - b.as.point.z));\n"
    set h to h + "    return kz_num(((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) - ((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_mul(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_POINT && b.kind == KZ_VAL_NUM) return kz_point(kz_num(a.as.point.x * b.as.number), kz_num(a.as.point.y * b.as.number), kz_num(a.as.point.z * b.as.number));\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_POINT) return kz_mul(b, a);\n"
    set h to h + "    return kz_num(((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) * ((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_div(KzValue a, KzValue b) {\n"
    set h to h + "    kaze_float_t out = 0.0;   /* kaze_rt checks the divisor and the result */\n"
    set h to h + "    kaze_float_t x = (a.kind == KZ_VAL_NUM) ? a.as.number : 0.0;\n"
    set h to h + "    kaze_float_t y = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    if (!kaze_float_div_checked(x, y, &out)) { kaze_trap(KAZE_ERR_DIV0, \"division by zero\"); exit(70); }\n"
    set h to h + "    return kz_num(out);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_mod(KzValue a, KzValue b) {\n"
    set h to h + "    kaze_float_t y = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    kaze_float_t x = (a.kind == KZ_VAL_NUM) ? a.as.number : 0.0;\n"
    set h to h + "    if (y == 0.0) { kaze_trap(KAZE_ERR_DIV0, \"remainder by zero\"); exit(70); }\n"
    set h to h + "    return kz_num(fmod(x, y));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_not(KzValue a) { return kz_bool(!kz_is_truthy(a)); }\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline bool kz_val_eq(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind != b.kind) return false;\n"
    set h to h + "    switch (a.kind) {\n"
    set h to h + "        case KZ_VAL_NIL: return true;\n"
    set h to h + "        case KZ_VAL_BOOL: return a.as.boolean == b.as.boolean;\n"
    set h to h + "        case KZ_VAL_NUM: return a.as.number == b.as.number;\n"
    set h to h + "        case KZ_VAL_STR: return (a.as.str.data && b.as.str.data) ? (strcmp(a.as.str.data, b.as.str.data) == 0) : (a.as.str.data == b.as.str.data);\n"
    set h to h + "        default: return a.as.list == b.as.list;\n"
    set h to h + "    }\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_eq(KzValue a, KzValue b) { return kz_bool(kz_val_eq(a, b)); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_ne(KzValue a, KzValue b) { return kz_bool(!kz_val_eq(a, b)); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_lt(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number < b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) < 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_le(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number <= b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) <= 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_gt(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number > b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) > 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_ge(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number >= b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) >= 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_and(KzValue a, KzValue b) { return kz_bool(kz_is_truthy(a) && kz_is_truthy(b)); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_or(KzValue a, KzValue b) { return kz_bool(kz_is_truthy(a) || kz_is_truthy(b)); }\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_len(KzValue a) {\n"
    set h to h + "    if (a.kind == KZ_VAL_POINT) return kz_num(sqrt(a.as.point.x * a.as.point.x + a.as.point.y * a.as.point.y + a.as.point.z * a.as.point.z));\n"
    set h to h + "    if (a.kind == KZ_VAL_STR) return kz_num((double)a.as.str.len);\n"
    set h to h + "    if (a.kind == KZ_VAL_LIST && a.as.list) return kz_num((double)a.as.list->len);\n"
    set h to h + "    /* length of applies to text, lists and points. Returning 0 for anything\n"
    set h to h + "       else would make a guard clause fall through instead of refusing. */\n"
    set h to h + "    kaze_trap(KAZE_ERR_TYPE, \"length of does not apply to this value\");\n"
    set h to h + "    exit(70);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_index(KzValue coll, KzValue idx) {\n"
    set h to h + "    size_t i = (idx.kind == KZ_VAL_NUM && idx.as.number >= 0.0) ? (size_t)idx.as.number : 0;\n"
    set h to h + "    if (coll.kind == KZ_VAL_LIST && coll.as.list) {\n"
    set h to h + "        if (i < coll.as.list->len) return coll.as.list->items[i];\n"
    set h to h + "        return kz_nil();\n"
    set h to h + "    }\n"
    set h to h + "    if (coll.kind == KZ_VAL_STR && coll.as.str.data) {\n"
    set h to h + "        size_t l = coll.as.str.len;\n"
    set h to h + "        if (i < l) {\n"
    set h to h + "            char* one = (char*)kz_alloc(2);\n"
    set h to h + "            one[0] = coll.as.str.data[i];\n"
    set h to h + "            one[1] = '\\0';\n"
    set h to h + "            return kz_str(one);\n"
    set h to h + "        }\n"
    set h to h + "        return kz_str(\"\");\n"
    set h to h + "    }\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_builtin_log(KzValue msg) { printf(\"[info] %s\\n\", kz_to_string(msg)); }\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_read_stream(FILE* f) {\n"
    set h to h + "    size_t cap = 4096; size_t len = 0;\n"
    set h to h + "    char* buf = (char*)kz_alloc(cap);\n"
    set h to h + "    if (!buf) return kz_str(\"\");\n"
    set h to h + "    size_t n;\n"
    set h to h + "    while ((n = fread(buf + len, 1, cap - len - 1, f)) > 0) {\n"
    set h to h + "        len += n;\n"
    set h to h + "        if (len + 1024 >= cap) { cap *= 2; char* nb = (char*)realloc(buf, cap); if (!nb) break; buf = nb; }\n"
    set h to h + "    }\n"
    set h to h + "    buf[len] = '\\0';\n"
    set h to h + "    if (len == 0) return kz_nil();   /* nothing on stdin is no value, not empty text */\n"
    set h to h + "    return kz_str(buf);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_read_file_or_string(const char* path_or_str) {\n"
    set h to h + "    if (!path_or_str) return kz_str(\"\");\n"
    set h to h + "    FILE* f = fopen(path_or_str, \"rb\");\n"
    set h to h + "    if (!f) return kz_str(path_or_str);\n"
    set h to h + "    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\n"
    set h to h + "    if (sz < 0) { fclose(f); return kz_str(path_or_str); }\n"
    set h to h + "    char* buf = (char*)kz_alloc((size_t)sz + 1);\n"
    set h to h + "    if (!buf) { fclose(f); return kz_str(path_or_str); }\n"
    set h to h + "    size_t rd = fread(buf, 1, (size_t)sz, f);\n"
    set h to h + "    buf[rd] = '\\0'; fclose(f);\n"
    set h to h + "    return kz_str(buf);\n"
    set h to h + "}\n\n"
    set h to h + "/* 12-factor input: --arg > AGENT_* > config > signature default. A parameter\n"
    set h to h + "   declared with a type must arrive with a value of that type; silently using 0\n"
    set h to h + "   or raw text is how a script acts on a number nobody gave it. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_param(const char* ty, const char* name, const char* routine, KzValue v) {\n"
    set h to h + "    if (ty == NULL || ty[0] == 0) return v;\n"
    set h to h + "    int wants_text = (strcmp(ty, \"text\") == 0 || strcmp(ty, \"string\") == 0);\n"
    set h to h + "    int wants_bool = (strcmp(ty, \"bool\") == 0);\n"
    set h to h + "    if (v.kind == KZ_VAL_NIL) {\n"
    set h to h + "        fprintf(stderr, \"E_KAZE_PARAM: parameter '%s' of '%s' is declared as %s and has no value; provide --arg %s=<value>, the environment variable AGENT_%s, or \\\"%s\\\" in the config file\\n\", name, routine, ty, name, name, name);\n"
    set h to h + "        exit(2);\n"
    set h to h + "    }\n"
    set h to h + "    if (wants_text) return (v.kind == KZ_VAL_STR) ? v : kz_str(kz_to_string(v));\n"
    set h to h + "    if (wants_bool) {\n"
    set h to h + "        if (v.kind == KZ_VAL_BOOL) return v;\n"
    set h to h + "        if (v.kind == KZ_VAL_STR) {\n"
    set h to h + "            if (strcmp(v.as.str.data, \"true\") == 0) return kz_bool(true);\n"
    set h to h + "            if (strcmp(v.as.str.data, \"false\") == 0) return kz_bool(false);\n"
    set h to h + "        }\n"
    set h to h + "    } else {\n"
    set h to h + "        if (v.kind == KZ_VAL_NUM) return v;\n"
    set h to h + "        if (v.kind == KZ_VAL_STR) {\n"
    set h to h + "            char* end = NULL;\n"
    set h to h + "            double d = strtod(v.as.str.data, &end);\n"
    set h to h + "            if (end != NULL && end != v.as.str.data && *end == 0) return kz_num(d);\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    fprintf(stderr, \"E_KAZE_PARAM: parameter '%s' of '%s' is declared as %s but the value given is not one\\n\", name, routine, ty);\n"
    set h to h + "    exit(2);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_resolve_cli_arg(int argc, char** argv, const char* name, int index) {\n"
    set h to h + "    size_t nlen = strlen(name);\n"
    set h to h + "    for (int i = 1; i < argc; i++) {\n"
    set h to h + "        const char* a = argv[i];\n"
    set h to h + "        if (strncmp(a, \"--\", 2) == 0) {\n"
    set h to h + "            const char* opt = a + 2;\n"
    set h to h + "            if (strncmp(opt, name, nlen) == 0 && opt[nlen] == '=') return kz_read_file_or_string(opt + nlen + 1);\n"
    set h to h + "            if (strcmp(opt, \"arg\") == 0 && i + 1 < argc) {\n"
    set h to h + "                const char* next_arg = argv[i + 1];\n"
    set h to h + "                if (strncmp(next_arg, name, nlen) == 0 && next_arg[nlen] == '=') return kz_read_file_or_string(next_arg + nlen + 1);\n"
    set h to h + "            }\n"
    set h to h + "            if (strncmp(opt, \"arg=\", 4) == 0) {\n"
    set h to h + "                const char* next_arg = opt + 4;\n"
    set h to h + "                if (strncmp(next_arg, name, nlen) == 0 && next_arg[nlen] == '=') return kz_read_file_or_string(next_arg + nlen + 1);\n"
    set h to h + "            }\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    char env_name[128];\n"
    set h to h + "    snprintf(env_name, sizeof(env_name), \"AGENT_%s\", name);\n"
    set h to h + "    for (size_t j = 6; env_name[j]; j++) { if (env_name[j] >= 'a' && env_name[j] <= 'z') env_name[j] -= 32; }\n"
    set h to h + "    char* ev = getenv(env_name);\n"
    set h to h + "    if (ev) return kz_read_file_or_string(ev);\n"
    set h to h + "    snprintf(env_name, sizeof(env_name), \"SOFUU_%s\", name);\n"
    set h to h + "    for (size_t j = 6; env_name[j]; j++) { if (env_name[j] >= 'a' && env_name[j] <= 'z') env_name[j] -= 32; }\n"
    set h to h + "    ev = getenv(env_name);\n"
    set h to h + "    if (ev) return kz_read_file_or_string(ev);\n"
    set h to h + "    int pos_idx = 0;\n"
    set h to h + "    for (int i = 1; i < argc; i++) {\n"
    set h to h + "        /* An option value is not a positional argument: --ticks 2 used to\n"
    set h to h + "           hand the 2 to the first parameter. */\n"
    set h to h + "        if (strcmp(argv[i], \"--ticks\") == 0 || strcmp(argv[i], \"--cap\") == 0 ||\n"
    set h to h + "            strcmp(argv[i], \"--config\") == 0 || strcmp(argv[i], \"--arg\") == 0 ||\n"
    set h to h + "            strcmp(argv[i], \"--entry\") == 0 || strcmp(argv[i], \"-o\") == 0) { i++; continue; }\n"
    set h to h + "        if (argv[i][0] != '-') {\n"
    set h to h + "            if (pos_idx == index) return kz_read_file_or_string(argv[i]);\n"
    set h to h + "            pos_idx++;\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    if (index == 0 && !isatty(fileno(stdin))) return kz_read_stream(stdin);\n"
    set h to h + "    /* No layer supplied this argument: nothing, not empty text, so a\n"
    set h to h + "       guard clause on it refuses the way the interpreter does. */\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_fb_div(KzValue a, KzValue b, KzValue fb) {\n"
    set h to h + "    double d = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    if (d == 0.0) return fb;\n"
    set h to h + "    return kz_div(a, b);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_fb_mod(KzValue a, KzValue b, KzValue fb) {\n"
    set h to h + "    double d = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    if (d == 0.0) return fb;\n"
    set h to h + "    return kz_mod(a, b);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_fb_index(KzValue coll, KzValue idx, KzValue fb) {\n"
    set h to h + "    double d = (idx.kind == KZ_VAL_NUM) ? idx.as.number : -1.0;\n"
    set h to h + "    if (d < 0.0) return fb;\n"
    set h to h + "    if (coll.kind == KZ_VAL_LIST && coll.as.list) {\n"
    set h to h + "        if ((size_t)d >= coll.as.list->len) return fb;\n"
    set h to h + "    } else if (coll.kind == KZ_VAL_STR && coll.as.str.data) {\n"
    set h to h + "        if ((size_t)d >= coll.as.str.len) return fb;\n"
    set h to h + "    }\n"
    set h to h + "    return kz_index(coll, idx);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_record_set(KzValue* vals, const char** keys, size_t count, size_t pos, const char* key, KzValue value) {\n"
    set h to h + "    if (key != NULL) {\n"
    set h to h + "        for (size_t j = 0; j < count; j++) {\n"
    set h to h + "            if (strcmp(keys[j], key) == 0) { vals[j] = value; return; }\n"
    set h to h + "        }\n"
    set h to h + "        return;\n"
    set h to h + "    }\n"
    set h to h + "    if (pos < count) vals[pos] = value;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_to_num(KzValue v) { return (v.kind == KZ_VAL_NUM) ? v.as.number : 0.0; }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_sqrt(KzValue a) { return kz_num(sqrt(kz_to_num(a))); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_sin(KzValue a) { return kz_num(sin(kz_to_num(a))); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_cos(KzValue a) { return kz_num(cos(kz_to_num(a))); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_atan2(KzValue a, KzValue b) { return kz_num(atan2(kz_to_num(a), kz_to_num(b))); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_to_radians(KzValue a) { return kz_num(kz_to_num(a) * 0.017453292519943295); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_to_degrees(KzValue a) { return kz_num(kz_to_num(a) * 57.29577951308232); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_point(KzValue x, KzValue y, KzValue z) {\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_POINT;\n"
    set h to h + "    v.as.point.x = (x.kind == KZ_VAL_NUM) ? x.as.number : 0.0;\n"
    set h to h + "    v.as.point.y = (y.kind == KZ_VAL_NUM) ? y.as.number : 0.0;\n"
    set h to h + "    v.as.point.z = (z.kind == KZ_VAL_NUM) ? z.as.number : 0.0;\n"
    set h to h + "    return v;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_pt(KzValue v, int i) {\n"
    set h to h + "    if (v.kind != KZ_VAL_POINT) return 0.0;\n"
    set h to h + "    return i == 0 ? v.as.point.x : (i == 1 ? v.as.point.y : v.as.point.z);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_list_num(KzValue v, size_t i) {\n"
    set h to h + "    if (v.kind == KZ_VAL_LIST && v.as.list && i < v.as.list->len) return kz_to_num(v.as.list->items[i]);\n"
    set h to h + "    return 0.0;\n"
    set h to h + "}\n"
    set h to h + "#define KZ_EARTH_RADIUS_M 6371008.8\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_rad(double d) { return d * (3.14159265358979323846 / 180.0); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_deg(double r) { return r * (180.0 / 3.14159265358979323846); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_norm(double d) { double m = fmod(d, 360.0); if (m < 0.0) m += 360.0; return m; }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_haversine(double alat, double alon, double blat, double blon) {\n"
    set h to h + "    double lat1 = kz_geo_rad(alat), lon1 = kz_geo_rad(alon);\n"
    set h to h + "    double lat2 = kz_geo_rad(blat), lon2 = kz_geo_rad(blon);\n"
    set h to h + "    double dlat = lat2 - lat1, dlon = lon2 - lon1;\n"
    set h to h + "    double s1 = sin(dlat / 2.0), s2 = sin(dlon / 2.0);\n"
    set h to h + "    double hv = s1 * s1 + cos(lat1) * cos(lat2) * s2 * s2;\n"
    set h to h + "    if (hv > 1.0) hv = 1.0;\n"
    set h to h + "    return 2.0 * KZ_EARTH_RADIUS_M * asin(sqrt(hv));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_distance(KzValue a, KzValue b) {\n"
    set h to h + "    return kz_num(kz_geo_haversine(kz_pt(a, 0), kz_pt(a, 1), kz_pt(b, 0), kz_pt(b, 1)));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_slant_distance(KzValue a, KzValue b) {\n"
    set h to h + "    double ground = kz_geo_haversine(kz_pt(a, 0), kz_pt(a, 1), kz_pt(b, 0), kz_pt(b, 1));\n"
    set h to h + "    double dz = kz_pt(b, 2) - kz_pt(a, 2);\n"
    set h to h + "    return kz_num(sqrt(ground * ground + dz * dz));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_bearing_from(KzValue a, KzValue b) {\n"
    set h to h + "    double lat1 = kz_geo_rad(kz_pt(a, 0)), lat2 = kz_geo_rad(kz_pt(b, 0));\n"
    set h to h + "    double dlon = kz_geo_rad(kz_pt(b, 1) - kz_pt(a, 1));\n"
    set h to h + "    double y = sin(dlon) * cos(lat2);\n"
    set h to h + "    double x = cos(lat1) * sin(lat2) - sin(lat1) * cos(lat2) * cos(dlon);\n"
    set h to h + "    return kz_num(kz_geo_norm(kz_geo_deg(atan2(y, x))));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_bearing_of(KzValue p) {\n"
    set h to h + "    return kz_num(kz_geo_norm(kz_geo_deg(atan2(kz_pt(p, 0), kz_pt(p, 1)))));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_unavailable(const char* what) {\n"
    set h to h + "    fprintf(stderr, \"E_KAZE_UNSUPPORTED: %s is not lowered by the pure-Kaze C emitter\\n\", what);\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n"
    set h to h + "/* A bare telemetry field is a capability read. Returning nothing here would\n"
    set h to h + "   let `when battery < 20%` compare nothing against a percent. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_cap_get(const char* family, const char* field) {\n"
    set h to h + "    fprintf(stderr, \"E_CAP_MISSING: the native emitter has no host for %s.%s\\n\", family, field);\n"
    set h to h + "    exit(70);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_cap_call(const char* recv, const char* op, int n, KzValue* args) {\n"
    set h to h + "    (void)n; (void)args;\n"
    set h to h + "    fprintf(stderr, \"E_CAP_MISSING: the native emitter has no host for %s.%s\\n\", recv, op);\n"
    set h to h + "    exit(70);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_builtin_alert(KzValue msg) { fprintf(stderr, \"[alert] %s\\n\", kz_to_string(msg)); }\n"
    return h

action sanitize_c_id(name):
    if name == "auto" or name == "break" or name == "case" or name == "char" or name == "const" or name == "continue" or name == "default" or name == "do" or name == "double" or name == "else" or name == "enum" or name == "extern" or name == "float" or name == "for" or name == "goto" or name == "if" or name == "inline" or name == "int" or name == "long" or name == "register" or name == "restrict" or name == "return" or name == "short" or name == "signed" or name == "sizeof" or name == "static" or name == "struct" or name == "switch" or name == "typedef" or name == "union" or name == "unsigned" or name == "void" or name == "volatile" or name == "while" or name == "main":
        return "_kz_" + name
    return name

action escape_c_str(s):
    let res = "\""
    let len = length of s
    let i = 0
    while i < len bounded 1000000:
        let c = s[i] otherwise "x"
        if c == "\\":
            set res to res + "\\\\"
        otherwise:
            if c == "\"":
                set res to res + "\\\""
            otherwise:
                if c == "\n":
                    set res to res + "\\n"
                otherwise:
                    if c == "\t":
                        set res to res + "\\t"
                    otherwise:
                        set res to res + c
        set i to i + 1
    set res to res + "\""
    return res

# ── name helpers ────────────────────────────────────────────────────────

action c_has_dot(name):
    let len = length of name
    let i = 0
    let found = 0
    while i < len bounded 1000:
        if (name[i] otherwise "x") == ".":
            set found to 1
        set i to i + 1
    return found

# The part before the first dot: a capability family, or a plain name.
action name_head(name):
    let len = length of name
    let i = 0
    let out = ""
    let done = 0
    while i < len and done == 0 bounded 1000:
        let c = name[i] otherwise "x"
        if c == ".":
            set done to 1
        otherwise:
            set out to out + c
        set i to i + 1
    return out

# The part after the first dot: a capability operation.
action name_tail(name):
    let len = length of name
    let i = 0
    let out = ""
    let seen = 0
    while i < len bounded 1000:
        let c = name[i] otherwise "x"
        if seen == 1:
            set out to out + c
        if c == "." and seen == 0:
            set seen to 1
        set i to i + 1
    return out

# A capitalised call is a record constructor: Token(..), AstNode(..).
action is_record_name(name):
    let len = length of name
    if len == 0:
        return 0
    let c = name[0] otherwise "?"
    if c >= "A" and c <= "Z":
        return 1
    return 0

# ── expressions ─────────────────────────────────────────────────────────

action emit_bin_op(op, l, r):
    if op == "+":
        return "kz_add(" + l + ", " + r + ")"
    if op == "-":
        return "kz_sub(" + l + ", " + r + ")"
    if op == "*":
        return "kz_mul(" + l + ", " + r + ")"
    if op == "/":
        return "kz_div(" + l + ", " + r + ")"
    if op == "%":
        return "kz_mod(" + l + ", " + r + ")"
    if op == "==":
        return "kz_eq(" + l + ", " + r + ")"
    if op == "!=":
        return "kz_ne(" + l + ", " + r + ")"
    if op == "<":
        return "kz_lt(" + l + ", " + r + ")"
    if op == "<=":
        return "kz_le(" + l + ", " + r + ")"
    if op == ">":
        return "kz_gt(" + l + ", " + r + ")"
    if op == ">=":
        return "kz_ge(" + l + ", " + r + ")"
    if op == "and":
        return "kz_and(" + l + ", " + r + ")"
    if op == "or":
        return "kz_or(" + l + ", " + r + ")"
    return "kz_nil()"

# An inline fallback. Division, modulo and indexing lower to the phase 2
# runtime helpers, which take the fallback value eagerly so the operand is
# evaluated exactly once. Any other fallback (a capability read) has no native
# failure path, so the inner expression is emitted as it is.
action emit_c_fallback(node: AstNode):
    recursion bounded 200
    ensures length of result >= 0
    let inner = child_at(node, 0)
    let fb = child_at(node, 1)
    let fb_s = emit_c_expr(fb)
    if inner.kind == "BIN":
        if inner.name == "/":
            return "kz_fb_div(" + emit_c_expr(child_at(inner, 0)) + ", " + emit_c_expr(child_at(inner, 1)) + ", " + fb_s + ")"
        if inner.name == "%":
            return "kz_fb_mod(" + emit_c_expr(child_at(inner, 0)) + ", " + emit_c_expr(child_at(inner, 1)) + ", " + fb_s + ")"
    if inner.kind == "INDEX":
        return "kz_fb_index(" + emit_c_expr(child_at(inner, 0)) + ", " + emit_c_expr(child_at(inner, 1)) + ", " + fb_s + ")"
    return emit_c_expr(inner)

action emit_c_args(args):
    recursion bounded 200
    let out = ""
    let first = 1
    for each a in args:
        if first == 0:
            set out to out + ", "
        if a.kind == "NAMED_ARG":
            set out to out + emit_c_expr(child_at(a, 0))
        otherwise:
            set out to out + emit_c_expr(a)
        set first to 0
    return out

# The key table a record constructor reads: the field name for a named
# argument, NULL for a positional one.
action emit_c_keys(args):
    recursion bounded 200
    let out = ""
    let first = 1
    for each a in args:
        if first == 0:
            set out to out + ", "
        if a.kind == "NAMED_ARG":
            set out to out + escape_c_str(a.name)
        otherwise:
            set out to out + "NULL"
        set first to 0
    return out

action nth_arg(args, n):
    recursion bounded 200
    if (length of args) <= n:
        return "kz_nil()"
    let holder = make_node("ARGS", "", "", 0, args, 0)
    let a = child_at(holder, n)
    if a.kind == "NAMED_ARG":
        return emit_c_expr(child_at(a, 0))
    return emit_c_expr(a)

action two_args(args):
    recursion bounded 200
    return nth_arg(args, 0) + ", " + nth_arg(args, 1)

action emit_c_call(node: AstNode):
    recursion bounded 200
    let name = node.name
    let args = node.children
    let cnt = length of args
    let arg_str = emit_c_args(args)

    # 1. Record construction.
    if is_record_name(name) == 1:
        if cnt == 0:
            return "kz_record_new_" + sanitize_c_id(name) + "(0, NULL, NULL)"
        return "kz_record_new_" + sanitize_c_id(name) + "(" + cnt + ", (KzValue[]){ " + arg_str + " }, (const char*[]){ " + emit_c_keys(args) + " })"

    # 2. Effects and geometry expressed as family.operation.
    if c_has_dot(name) == 1:
        let head = name_head(name)
        let tail = name_tail(name)
        if head == "log":
            return "kz_builtin_log(" + nth_arg(args, 0) + ")"
        if head == "alert":
            return "kz_builtin_alert(" + nth_arg(args, 0) + ")"
        if head == "geo":
            if tail == "distance":
                return "kz_geo_distance(" + two_args(args) + ")"
            if tail == "slant_distance":
                return "kz_geo_slant_distance(" + two_args(args) + ")"
            if tail == "bearing_from":
                return "kz_geo_bearing_from(" + two_args(args) + ")"
            if tail == "bearing_of":
                return "kz_geo_bearing_of(" + nth_arg(args, 0) + ")"
        let arr = "NULL"
        if cnt != 0:
            set arr to "(KzValue[]){ " + arg_str + " }"
        return "kz_cap_call(" + escape_c_str(head) + ", " + escape_c_str(tail) + ", " + cnt + ", " + arr + ")"

    # 3. Pure builtins.
    if name == "link_lost":
        return "kz_bool(false)"
    if name == "sin":
        return "kz_math_sin(" + nth_arg(args, 0) + ")"
    if name == "cos":
        return "kz_math_cos(" + nth_arg(args, 0) + ")"
    if name == "sqrt":
        return "kz_math_sqrt(" + nth_arg(args, 0) + ")"
    if name == "atan2":
        return "kz_math_atan2(" + two_args(args) + ")"
    if name == "vector":
        return "kz_point(" + nth_arg(args, 0) + ", " + nth_arg(args, 1) + ", " + nth_arg(args, 2) + ")"
    if name == "min" or name == "max" or name == "abs" or name == "floor" or name == "ceil" or name == "round":
        return "kz_unavailable(" + escape_c_str(name) + ")"

    # 4. A routine written in this program.
    return "kaze_fn_" + sanitize_c_id(name) + "(" + arg_str + ")"

action is_plain_integer(t: string) -> num:
    # Digits only (an optional leading minus): no dot, no exponent.
    if t == "":
        return 0
    let i = 0
    let n = length of t
    while i < n bounded 64:
        let c = t[i] otherwise "?"
        if c == "-" and i == 0:
            set i to i + 1
        otherwise:
            if c < "0" or c > "9":
                return 0
            set i to i + 1
    return 1

action emit_c_expr(node: AstNode):
    recursion bounded 200
    let k = node.kind

    if k == "NUM":
        # An angle literal is folded to radians on the way out, the same
        # lowering the reference engine applies, so sin/cos agree.
        if node.name == "degrees":
            return "kz_math_to_radians(kz_num(" + node.val_str + "))"
        if is_plain_integer(node.val_str) == 1:
            # INT64_C-style portability without an integer literal: 3300000000 is
            # an int on a 64-bit host and does not fit one on a 32-bit target.
            return "kz_num((kaze_float_t)" + node.val_str + ")"
        return "kz_num(" + node.val_str + ")"
    if k == "STR":
        return "kz_str(" + escape_c_str(node.val_str) + ")"
    if k == "BOOL":
        return "kz_bool(" + node.val_str + ")"
    if k == "TELEMETRY":
        # A bare telemetry word that no declaration shadows: a capability read.
        return "kz_cap_get(" + escape_c_str(node.val_str) + ", " + escape_c_str(node.name) + ")"
    if k == "IDENT":
        # A declared name: parameter, local, or record field. Telemetry words that
        # no declaration shadows were already rewritten to TELEMETRY above.
        return sanitize_c_id(node.name)
    if k == "LEN":
        return "kz_len(" + emit_c_expr(child_at(node, 0)) + ")"
    if k == "FIELD":
        return "kz_get_field(" + emit_c_expr(child_at(node, 0)) + ", " + escape_c_str(node.name) + ")"
    if k == "INDEX":
        return "kz_index(" + emit_c_expr(child_at(node, 0)) + ", " + emit_c_expr(child_at(node, 1)) + ")"
    if k == "BIN":
        if node.name == "not":
            return "kz_not(" + emit_c_expr(child_at(node, 0)) + ")"
        return emit_bin_op(node.name, emit_c_expr(child_at(node, 0)), emit_c_expr(child_at(node, 1)))
    if k == "FALLBACK":
        return emit_c_fallback(node)
    if k == "IN_UNIT":
        if node.name == "radians":
            return "kz_math_to_radians(" + emit_c_expr(child_at(node, 0)) + ")"
        return "kz_math_to_degrees(" + emit_c_expr(child_at(node, 0)) + ")"
    if k == "LIST":
        let items = node.children
        let cnt = length of items
        if cnt == 0:
            return "kz_list_new(0)"
        return "kz_list_from(" + cnt + ", (KzValue[]){ " + emit_c_args(items) + " })"
    if k == "CALL":
        return emit_c_call(node)
    return "kz_nil()"

# ── statements ──────────────────────────────────────────────────────────

action emit_c_stmt(stmt: AstNode, ind):
    recursion bounded 200
    let k = stmt.kind

    if k == "LET":
        return ind + "KzValue " + sanitize_c_id(stmt.name) + " = " + emit_c_expr(child_at(stmt, 0)) + ";\n"

    if k == "SET":
        return ind + sanitize_c_id(stmt.name) + " = " + emit_c_expr(child_at(stmt, 0)) + ";\n"

    if k == "RETURN":
        if (length of stmt.children) > 0:
            return ind + "return " + emit_c_expr(child_at(stmt, 0)) + ";\n"
        return ind + "return kz_nil();\n"

    if k == "RETURN_CHECKED":
        # A return site in a routine with ensures clauses: bind, check, return.
        let out = ind + "KzValue _kz_ret = " + emit_c_expr(child_at(stmt, 0)) + ";\n"
        let i = 1
        while i < (length of stmt.children) bounded 32:
            set out to out + ind + "if (!kz_is_truthy(" + emit_c_expr(child_at(stmt, i)) + ")) {\n"
            set out to out + ind + "    fprintf(stderr, \"E_KAZE_CONTRACT: an ensures clause is false for this result\\n\");\n"
            set out to out + ind + "    exit(70);\n"
            set out to out + ind + "}\n"
            set i to i + 1
        set out to out + ind + "return _kz_ret;\n"
        return out

    if k == "APPEND_OWN":
        # Proved append-only: kz_add_own does exactly what `+` would, but grows the
        # buffer in place when it is still the newest arena allocation.
        let target = sanitize_c_id(stmt.name)
        return ind + target + " = kz_add_own(" + target + ", " + emit_c_expr(child_at(stmt, 0)) + ");\n"

    if k == "EXPR":
        return ind + "(void)(" + emit_c_expr(child_at(stmt, 0)) + ");\n"

    if k == "APPEND_LIST_OWN":
        let target = sanitize_c_id(stmt.name)
        return ind + target + " = kz_list_append_own(" + target + ", " + emit_c_expr(child_at(stmt, 0)) + ");\n"

    # guard <expr>: an executed assertion. A false invariant stops the run.
    if k == "GUARD":
        return ind + "if (!kz_is_truthy(" + emit_c_expr(child_at(stmt, 0)) + ")) { fprintf(stderr, \"E_KAZE_GUARD: the invariant at line " + stmt.line + " is false\\n\"); return kz_nil(); }\n"

    if k == "IF":
        let cond = child_at(stmt, 0)
        let then_block = child_at(stmt, 1)
        let other_block = child_at(stmt, 2)
        let out = ind + "if (kz_is_truthy(" + emit_c_expr(cond) + ")) {\n"
        for each s in then_block.children:
            set out to out + emit_c_stmt(s, ind + "    ")
        if (length of other_block.children) > 0:
            set out to out + ind + "} else {\n"
            for each s in other_block.children:
                set out to out + emit_c_stmt(s, ind + "    ")
        set out to out + ind + "}\n"
        return out

    # while cond bounded n: a counter guard, so a stuck loop stops the run.
    if k == "WHILE":
        let cond = child_at(stmt, 0)
        let body = child_at(stmt, 1)
        let bound = child_at(stmt, 2)
        let guard_id = "_kz_loop_l" + stmt.line
        let out = ind + "{ long " + guard_id + " = 0;\n"
        set out to out + ind + "    while (kz_is_truthy(" + emit_c_expr(cond) + ")) {\n"
        if bound.val_str == "" or bound.val_str == "?":
            set out to out + ind + "        /* no ceiling declared */\n"
        otherwise:
            set out to out + ind + "        if (" + guard_id + " >= " + bound.val_str + "L) { fprintf(stderr, \"E_KAZE_LOOP_BOUND: loop exceeded its declared bound\\n\"); return kz_nil(); }\n"
        set out to out + ind + "        " + guard_id + " = " + guard_id + " + 1;\n"
        for each s in body.children:
            set out to out + emit_c_stmt(s, ind + "        ")
        set out to out + ind + "    }\n"
        set out to out + ind + "}\n"
        return out

    if k == "FOR_EACH":
        let list_e = child_at(stmt, 0)
        let body = child_at(stmt, 1)
        let out = ind + "{\n"
        set out to out + ind + "    KzValue _iter_target = " + emit_c_expr(list_e) + ";\n"
        set out to out + ind + "    if (_iter_target.kind == KZ_VAL_LIST && _iter_target.as.list) {\n"
        set out to out + ind + "        size_t _len = _iter_target.as.list->len;\n"
        set out to out + ind + "        for (size_t _i = 0; _i < _len; _i++) {\n"
        set out to out + ind + "            KzValue " + sanitize_c_id(stmt.name) + " = _iter_target.as.list->items[_i];\n"
        for each s in body.children:
            set out to out + emit_c_stmt(s, ind + "            ")
        set out to out + ind + "        }\n"
        set out to out + ind + "    }\n"
        set out to out + ind + "}\n"
        return out

    # try: the recovery block runs only in the virtual machine today.
    if k == "TRY":
        let body = child_at(stmt, 0)
        let other = child_at(stmt, 1)
        let out = ind + "{\n"
        set out to out + ind + "    /* try block */\n"
        for each s in body.children:
            set out to out + emit_c_stmt(s, ind + "    ")
        if (length of other.children) > 0:
            set out to out + ind + "    if (0) {\n"
            if stmt.name != "":
                set out to out + ind + "        KzValue " + sanitize_c_id(stmt.name) + " = kz_nil(); (void)" + sanitize_c_id(stmt.name) + ";\n"
            for each s in other.children:
                set out to out + emit_c_stmt(s, ind + "        ")
            set out to out + ind + "    }\n"
        set out to out + ind + "}\n"
        return out

    return ""

# ── items and program ───────────────────────────────────────────────────

action param_list(params_node: AstNode):
    recursion bounded 200
    let out = ""
    let first = 1
    for each p in params_node.children:
        if first == 0:
            set out to out + ", "
        set out to out + "KzValue " + sanitize_c_id(p.name)
        set first to 0
    if first == 1:
        return "void"
    return out

action find_named(items, name):
    recursion bounded 200
    let i = 0
    let len = length of items
    let found = none_node()
    while i < len bounded 1000000:
        let it = node_at(items, i)
        if it.name == name:
            set found to it
        set i to i + 1
    return found

action is_routine(item: AstNode):
    if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER":
        return 1
    return 0

action emit_record_ctor(item: AstNode):
    recursion bounded 200
    let id = sanitize_c_id(item.name)
    let fields = item.children
    let cnt = length of fields
    let out = "static inline KzValue kz_record_new_" + id + "(size_t n, KzValue* v, const char** k) {\n"
    set out to out + "    (void)n; (void)v; (void)k;\n"
    if cnt == 0:
        set out to out + "    return kz_record_create(" + escape_c_str(item.name) + ", 0, NULL, NULL);\n"
    otherwise:
        let keys = ""
        let i = 0
        while i < cnt bounded 1000:
            let f = node_at(fields, i)
            if i > 0:
                set keys to keys + ", "
            set keys to keys + escape_c_str(f.name)
            set i to i + 1
        set out to out + "    static const char* _keys[" + cnt + "] = { " + keys + " };\n"
        set out to out + "    KzValue _vals[" + cnt + "];\n"
        let j = 0
        while j < cnt bounded 1000:
            set out to out + "    _vals[" + j + "] = kz_nil();\n"
            set j to j + 1
        set out to out + "    for (size_t _i = 0; _i < n; _i++) kz_record_set(_vals, _keys, " + cnt + ", _i, k ? k[_i] : NULL, v[_i]);\n"
        set out to out + "    return kz_record_create(" + escape_c_str(item.name) + ", " + cnt + ", _keys, _vals);\n"
    set out to out + "}\n\n"
    return out

# Contracts at routine entry: a `requires` clause that is false for the arguments
# given is a refusal, not an assertion in the C sense -- the interpreter's
# E_KAZE_CONTRACT. Elision when every call site is proved comes later; correctness
# first.
action emit_requires(item: AstNode) -> string:
    recursion bounded 200
    let contracts = child_at(item, 1)
    let out = ""
    for each c in contracts.children:
        if c.kind == "CONTRACT" and c.name == "requires":
            let cond = child_at(c, 0)
            set out to out + "    if (!kz_is_truthy(" + emit_c_expr(cond) + ")) {\n"
            set out to out + "        fprintf(stderr, \"E_KAZE_CONTRACT: the requires clause at line " + c.line + " is false for these arguments\\n\");\n"
            set out to out + "        exit(70);\n"
            set out to out + "    }\n"
    return out

action emit_routine(item: AstNode):
    recursion bounded 200
    let id = sanitize_c_id(item.name)
    let params_node = child_at(item, 0)
    let body = child_at(item, 2)
    let out = "KZ_MAYBE_UNUSED static KzValue kaze_fn_" + id + "(" + param_list(params_node) + ") {\n"
    for each prm in params_node.children:
        set out to out + "    (void)" + sanitize_c_id(prm.name) + ";   /* a routine need not use every parameter */\n"
    set out to out + emit_requires(item)
    for each s in body.children:
        set out to out + emit_c_stmt(s, "    ")
    set out to out + "    return kz_nil();\n"
    set out to out + "}\n\n"
    return out

action emit_hook(item: AstNode):
    recursion bounded 200
    let body = child_at(item, 1)
    let kind = "when"
    if item.kind == "EVERY":
        set kind to "every"
    let out = "static KzValue kz_hook_" + kind + "_" + item.line + "(void) {\n"
    for each s in body.children:
        set out to out + emit_c_stmt(s, "    ")
    set out to out + "    return kz_nil();\n"
    set out to out + "}\n\n"
    return out

# The hook driver: `when` and `every` items fire on host ticks, the same way the
# interpreter drives them. The tick count comes from --ticks or KAZE_TICKS, and a
# predicate that needs telemetry the binary cannot supply is false, not assumed
# true, so hooks stay fail-closed.
action emit_hook_driver(items):
    recursion bounded 200
    let preds = []
    let calls = []
    for each item in items:
        if item.kind == "WHEN":
            let cond = child_at(item, 0)
            set preds to preds + ["        if (kz_is_truthy(" + emit_c_expr(cond) + ")) { kz_hook_when_" + item.line + "(); }\n"]
        if item.kind == "EVERY":
            set calls to calls + ["        kz_hook_every_" + item.line + "();\n"]
    let out = "/* --- Hook driver --- */\n"
    set out to out + "static int kz_ticks(int argc, char** argv) {\n"
    set out to out + "    for (int i = 1; i + 1 < argc; i++) {\n"
    set out to out + "        if (strcmp(argv[i], \"--ticks\") == 0) { long n = strtol(argv[i + 1], NULL, 10); if (n > 0) return (int)n; }\n"
    set out to out + "    }\n"
    set out to out + "    const char* env = getenv(\"KAZE_TICKS\");\n"
    set out to out + "    if (env && env[0]) { long n = strtol(env, NULL, 10); if (n > 0) return (int)n; }\n"
    set out to out + "    return 0;\n"
    set out to out + "}\n"
    set out to out + "static void kz_run_hooks(int argc, char** argv) {\n"
    set out to out + "    int ticks = kz_ticks(argc, argv);\n"
    set out to out + "    for (int t = 0; t < ticks; t++) {\n"
    for each p in preds:
        set out to out + p
    for each c in calls:
        set out to out + c
    set out to out + "    }\n"
    set out to out + "}\n\n"
    return out

action single_routine(items):
    # The interpreter's default entry is `main`, else the only action/check/filter
    # in the root file. Without this the native binary printed "no main entry"
    # and exited 0 where the VM actually ran the routine.
    let found = none_node()
    let count = 0
    for each item in items:
        if is_routine(item) == 1:
            set found to item
            set count to count + 1
    if count == 1:
        return found
    return none_node()

action emit_c_entry(items):
    recursion bounded 200
    let out = "/* --- Main Entry Point --- */\n"
    set out to out + "int main(int argc, char** argv) {\n"
    set out to out + "    /* One arena for the whole run; KAZE_ARENA_BYTES overrides the default. */\n"
    set out to out + "    if (!kaze_arena_init_heap(&kz_arena, kz_arena_bytes())) { fprintf(stderr, \"E_KAZE_OOM: cannot reserve the arena\\n\"); return 70; }\n"
    set out to out + "    atexit(kz_print_alloc_sites);   /* KAZE_ARENA_STATS=1 reports by function */\n"
    let main_item = find_named(items, "main")
    if is_routine(main_item) == 0:
        set main_item to single_routine(items)
    if is_routine(main_item) == 0:
        set out to out + "    (void)argc; (void)argv;\n"
        set out to out + "    kz_run_hooks(argc, argv);\n"
        set out to out + "    printf(\"Kaze module loaded (no main entry)\\n\");\n"
    otherwise:
        let params_node = child_at(main_item, 0)
        let cnt = length of params_node.children
        if cnt == 0:
            set out to out + "    (void)argc; (void)argv;\n"
            set out to out + "    KzValue res = kaze_fn_" + sanitize_c_id(main_item.name) + "();\n"
        otherwise:
            let i = 0
            let call_args = ""
            while i < cnt bounded 1000:
                let prm = child_at(params_node, i)
                set out to out + "    KzValue arg_" + i + " = kz_param(" + escape_c_str(prm.val_str) + ", " + escape_c_str(prm.name) + ", " + escape_c_str(main_item.name) + ", kz_resolve_cli_arg(argc, argv, " + escape_c_str(prm.name) + ", " + i + "));\n"
                if i > 0:
                    set call_args to call_args + ", "
                set call_args to call_args + "arg_" + i
                set i to i + 1
            set out to out + "    KzValue res = kaze_fn_" + sanitize_c_id(main_item.name) + "(" + call_args + ");\n"
        set out to out + "    if (res.kind == KZ_VAL_NUM) {\n"
        set out to out + "        char numbuf[64];\n"
        set out to out + "        kz_format_number(numbuf, sizeof numbuf, res.as.number);\n"
        set out to out + "        printf(\"%s\\n\", numbuf);\n"
        set out to out + "    } else if (res.kind == KZ_VAL_STR) {\n"
        set out to out + "        printf(\"%s\\n\", res.as.str.data ? res.as.str.data : \"\");\n"
        set out to out + "    } else if (res.kind == KZ_VAL_BOOL) {\n"
        set out to out + "        printf(\"%s\\n\", res.as.boolean ? \"true\" : \"false\");\n"
        set out to out + "    }\n"
        set out to out + "    kz_run_hooks(argc, argv);\n"
    set out to out + "    return 0;\n"
    set out to out + "}\n"
    return out

# ── ambient telemetry ──────────────────────────────────────────────────
# A bare telemetry word (battery, altitude, ...) is a capability read, but an
# emitter cannot tell it from a variable without name resolution -- `distance` is
# an ordinary local in this compiler's own source, and lowering every telemetry
# word blindly broke the compiler's own build. This pass resolves it once, on the
# tree, where each routine's declarations are known.

# ── in-place append ────────────────────────────────────────────────────
# `set out to out + piece` copies the whole string every time, which is where the
# translators' memory and time go. When a variable is only ever built this way and
# read once at the end, its buffer can be extended in place instead -- the runtime
# checks that the buffer is still the newest arena allocation before writing.

action count_ident(n: AstNode, v: string) -> num:
    recursion bounded 256
    let total = 0
    if n.kind == "IDENT" and n.name == v:
        set total to 1
    for each c in n.children:
        set total to total + count_ident(c, v)
    return total

action count_appends(n: AstNode, v: string) -> num:
    recursion bounded 256
    let total = 0
    if n.kind == "SET" and n.name == v:
        let rhs = child_at(n, 0)
        if rhs.kind == "BIN" and rhs.name == "+":
            let left = child_at(rhs, 0)
            # kz_add_own dispatches on the runtime type, so any operand shape is safe
            # here: the result is exactly what `+` would have produced.
            if left.kind == "IDENT" and left.name == v:
                set total to 1
    for each c in n.children:
        set total to total + count_appends(c, v)
    return total

action count_return_reads(n: AstNode, v: string) -> num:
    recursion bounded 256
    let total = 0
    if n.kind == "RETURN":
        set total to total + count_ident(n, v)
    for each c in n.children:
        set total to total + count_return_reads(c, v)
    return total

action string_lets(n: AstNode, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "LET":
        let rhs = child_at(n, 0)
        if rhs.kind == "STR" or rhs.kind == "LIST" or rhs.kind == "CALL" or (rhs.kind == "BIN" and rhs.name == "+"):
            set out to out + [n.name]
    for each c in n.children:
        set out to string_lets(c, out)
    return out

action append_plan(body: AstNode) -> list:
    recursion bounded 200
    # A name qualifies when every occurrence of it is either the left operand of an
    # append or inside a return: nothing else can hold its buffer.
    let out = []
    for each v in string_lets(body, []):
        let app = count_appends(body, v)
        if app > 0:
            let occ = count_ident(body, v)
            let ret = count_return_reads(body, v)
            if occ == app + ret:
                set out to out + [v]
    return out

action rewrite_appends(n: AstNode, plan: list) -> AstNode:
    recursion bounded 256
    if n.kind == "SET" and has_name(plan, n.name):
        let rhs = child_at(n, 0)
        if rhs.kind == "BIN" and rhs.name == "+":
            let left = child_at(rhs, 0)
            if left.kind == "IDENT" and left.name == n.name:
                return make_node("APPEND_OWN", n.name, n.val_str, n.val_num, [child_at(rhs, 1)], n.line)
    let kids = []
    for each c in n.children:
        set kids to kids + [rewrite_appends(c, plan)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

action has_name(names: list, w: string) -> num:
    recursion bounded 256
    for each n in names:
        if n == w:
            return 1
    return 0

action collect_declared(n: AstNode, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "LET" or n.kind == "SET" or n.kind == "FOR_EACH" or n.kind == "PARAM":
        if n.name != "" and has_name(acc, n.name) == 0:
            set out to out + [n.name]
    for each c in n.children:
        set out to collect_declared(c, out)
    return out

action relabel_telemetry(n: AstNode, declared: list) -> AstNode:
    recursion bounded 256
    if n.kind == "IDENT":
        if is_telemetry(n.name) == 1 and has_name(declared, n.name) == 0:
            return make_node("TELEMETRY", n.name, family_of_word(n.name), 0, [], n.line)
        return n
    let kids = []
    for each c in n.children:
        set kids to kids + [relabel_telemetry(c, declared)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

# ── contract elision ───────────────────────────────────────────────────
# A `requires` clause costs a branch per call. When every call site passes
# constants that satisfy it, the branch can go -- the reference rule
# (src/compiler.rs::requires_proved_everywhere), on the tree.

action num_of_text(t: string) -> num:
    recursion bounded 64
    let i = 0
    let n = length of t
    let sign = 1
    if n > 0 and (t[0] otherwise "?") == "-":
        set sign to -1
        set i to 1
    let whole = 0
    let seen_dot = 0
    let scale = 1
    while i < n bounded 64:
        let c = t[i] otherwise "?"
        if c == ".":
            set seen_dot to 1
        otherwise:
            if c >= "0" and c <= "9":
                let d = digit_value(c)
                if seen_dot == 1:
                    set scale to scale * 10
                    set whole to whole + (d / scale otherwise 0)
                otherwise:
                    set whole to whole * 10 + d
        set i to i + 1
    return sign * whole

action eval_const(n: AstNode, params: list, values: list) -> list:
    recursion bounded 256
    # [1, v] when this node is a constant under the bindings, else [0, 0].
    if n.kind == "NUM":
        return [1, num_of_text(n.val_str)]
    if n.kind == "IDENT":
        let i = 0
        for each p in params:
            if p == n.name and i < (length of values):
                return [1, values[i] otherwise 0]
            set i to i + 1
        return [0, 0]
    if n.kind == "BIN":
        let l = eval_const(child_at(n, 0), params, values)
        let r = eval_const(child_at(n, 1), params, values)
        if (l[0] otherwise 0) == 0 or (r[0] otherwise 0) == 0:
            return [0, 0]
        let a = l[1] otherwise 0
        let b = r[1] otherwise 0
        if n.name == ">=":
            if a >= b:
                return [1, 1]
            return [1, 0]
        if n.name == "<=":
            if a <= b:
                return [1, 1]
            return [1, 0]
        if n.name == ">":
            if a > b:
                return [1, 1]
            return [1, 0]
        if n.name == "<":
            if a < b:
                return [1, 1]
            return [1, 0]
        if n.name == "==":
            if a == b:
                return [1, 1]
            return [1, 0]
        if n.name == "!=":
            if a != b:
                return [1, 1]
            return [1, 0]
        return [0, 0]
    return [0, 0]

action calls_to(n: AstNode, name: string, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "CALL" and n.name == name:
        set out to out + [n.children]
    for each c in n.children:
        set out to calls_to(c, name, out)
    return out

action routine_param_names(params: AstNode) -> list:
    recursion bounded 64
    let out = []
    for each p in params.children:
        set out to out + [p.name]
    return out

action all_calls_proved(name: string, items: list, params: list, clauses: list) -> num:
    recursion bounded 200
    let sites = []
    for each it in items:
        set sites to calls_to(it, name, sites)
    if (length of sites) == 0:
        # Nothing in this program calls it; the host still might.
        return 0
    for each args in sites:
        if (length of args) != (length of params):
            return 0
        let values = []
        for each a in args:
            let v = eval_const(a, [], [])
            if (v[0] otherwise 0) == 0:
                return 0
            set values to values + [v[1] otherwise 0]
        for each cl in clauses:
            let c = eval_const(child_at(cl, 0), params, values)
            if (c[0] otherwise 0) == 0 or (c[1] otherwise 0) == 0:
                return 0
    return 1

action elidable_names(items: list) -> list:
    recursion bounded 200
    let out = []
    for each it in items:
        if it.kind == "ACTION" or it.kind == "CHECK" or it.kind == "FILTER":
            let params = routine_param_names(child_at(it, 0))
            let ctr = child_at(it, 1)
            let clauses = []
            for each c in ctr.children:
                if c.kind == "CONTRACT" and c.name == "requires":
                    set clauses to clauses + [c]
            if (length of clauses) > 0:
                if all_calls_proved(it.name, items, params, clauses) == 1:
                    set out to out + [it.name]
    return out

# ── ensures ────────────────────────────────────────────────────────────
# `ensures` speaks about `result`, so each return site binds the value first and
# checks the clause against it. The rewrite happens on the tree, where the
# routine's contracts and its return statements are both visible.


action subst_result(n: AstNode) -> AstNode:
    recursion bounded 256
    if n.kind == "IDENT" and n.name == "result":
        return make_node("IDENT", "_kz_ret", n.val_str, n.val_num, [], n.line)
    let kids = []
    for each c in n.children:
        set kids to kids + [subst_result(c)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

action returns_of(n: AstNode, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "RETURN" and (length of n.children) > 0:
        set out to out + [child_at(n, 0)]
    for each c in n.children:
        set out to returns_of(c, out)
    return out

action ensures_proved(clauses: list, body: AstNode) -> num:
    recursion bounded 200
    # An ensures clause is elidable when every return value is a literal that
    # satisfies it: no branch is needed for a proof already in the tree.
    if (length of clauses) == 0:
        return 1
    let sites = returns_of(body, [])
    if (length of sites) == 0:
        return 1
    for each r in sites:
        let v = eval_const(r, [], [])
        if (v[0] otherwise 0) == 0:
            return 0
        let value = v[1] otherwise 0
        for each cl in clauses:
            let c = eval_const(cl, ["_kz_ret"], [value])
            if (c[0] otherwise 0) == 0 or (c[1] otherwise 0) == 0:
                return 0
    return 1

action drop_proved_ensures(contracts: AstNode, body: AstNode) -> AstNode:
    recursion bounded 64
    let clauses = []
    for each c in contracts.children:
        if c.kind == "CONTRACT" and c.name == "ensures":
            set clauses to clauses + [subst_result(child_at(c, 0))]
    if ensures_proved(clauses, body) == 0:
        return contracts
    let kept = []
    for each c in contracts.children:
        let proven = 0
        if c.kind == "CONTRACT" and c.name == "ensures":
            set proven to 1
        if proven == 0:
            set kept to kept + [c]
    return make_node("CONTRACTS", contracts.name, contracts.val_str, contracts.val_num, kept, contracts.line)

action ensures_clauses(contracts: AstNode) -> list:
    recursion bounded 64
    let out = []
    for each c in contracts.children:
        if c.kind == "CONTRACT" and c.name == "ensures":
            set out to out + [subst_result(child_at(c, 0))]
    return out

action rewrite_returns(n: AstNode, clauses: list) -> AstNode:
    recursion bounded 256
    if n.kind == "RETURN" and (length of clauses) > 0 and (length of n.children) > 0:
        let kids = [child_at(n, 0)]
        for each cl in clauses:
            set kids to kids + [cl]
        return make_node("RETURN_CHECKED", n.name, n.val_str, n.val_num, kids, n.line)
    let kids = []
    for each c in n.children:
        set kids to kids + [rewrite_returns(c, clauses)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

action drop_proved_requires(contracts: AstNode, name: string, elided: list) -> AstNode:
    recursion bounded 64
    # A routine whose every call site passes constants satisfying its requires
    # clauses needs no entry branch at all.
    if has_name(elided, name) == 0:
        return contracts
    let kept = []
    for each c in contracts.children:
        let proven = 0
        if c.kind == "CONTRACT" and c.name == "requires":
            set proven to 1
        if proven == 0:
            set kept to kept + [c]
    return make_node("CONTRACTS", contracts.name, contracts.val_str, contracts.val_num, kept, contracts.line)

action mark_item(item: AstNode, elided: list) -> AstNode:
    recursion bounded 200
    if item.kind == "WHEN" or item.kind == "EVERY":
        let declared = collect_declared(child_at(item, 1), [])
        let cond = relabel_telemetry(child_at(item, 0), declared)
        let body = relabel_telemetry(child_at(item, 1), declared)
        return make_node(item.kind, item.name, item.val_str, item.val_num, [cond, body], item.line)
    if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER":
        let params = child_at(item, 0)
        let declared = collect_declared(params, [])
        set declared to collect_declared(child_at(item, 2), declared)
        let raw_contracts = drop_proved_requires(child_at(item, 1), item.name, elided)
        let contracts = relabel_telemetry(raw_contracts, declared)
        let checked = rewrite_returns(child_at(item, 2), ensures_clauses(drop_proved_ensures(raw_contracts, child_at(item, 2))))
        let plan = append_plan(checked)
        set checked to rewrite_appends(checked, plan)
        let body = relabel_telemetry(checked, declared)
        return make_node(item.kind, item.name, item.val_str, item.val_num, [params, contracts, body], item.line)
    return item

action emit_c_program(prog: AstNode):
    recursion bounded 200
    # Resolve bare telemetry words once, with each routine's declarations in hand.
    let raw_items = program_items(prog)
    let elided = elidable_names(raw_items)
    let items = []
    for each it in raw_items:
        set items to items + [mark_item(it, elided)]
    let out = get_c_runtime_header()

    # 1. Forward declarations.
    set out to out + "/* --- Forward Declarations --- */\n"
    for each item in items:
        if item.kind == "RECORD":
            set out to out + "static inline KzValue kz_record_new_" + sanitize_c_id(item.name) + "(size_t n, KzValue* v, const char** k);\n"
        otherwise:
            if is_routine(item) == 1:
                let params_node = child_at(item, 0)
                set out to out + "KZ_MAYBE_UNUSED static KzValue kaze_fn_" + sanitize_c_id(item.name) + "(" + param_list(params_node) + ");\n"

    # 2. Record constructors.
    set out to out + "\n/* --- Record Constructors --- */\n"
    for each item in items:
        if item.kind == "RECORD":
            set out to out + emit_record_ctor(item)

    # 3. Routines. A when/every hook has no native scheduler, so it is named in
    # a comment rather than dropped in silence.
    set out to out + "/* --- Routines --- */\n"
    for each item in items:
        if is_routine(item) == 1:
            set out to out + emit_routine(item)
        otherwise:
            if item.kind == "WHEN" or item.kind == "EVERY":
                set out to out + emit_hook(item)

    # 4. Hook driver, then the entry point.
    set out to out + "\n" + emit_hook_driver(items)
    set out to out + emit_c_entry(items)
    return out
