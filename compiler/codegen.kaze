# codegen.kaze — Pure Kaze C99 Emitter
use "./ast.kaze"

action get_c_runtime_header():
    let h = "/* Generated by Kaze-in-Kaze Self-Hosted Compiler (Stage 1) */\n"
    set h to h + "#include <stdint.h>\n"
    set h to h + "#include <stdbool.h>\n"
    set h to h + "#include <stddef.h>\n"
    set h to h + "#include <stdlib.h>\n"
    set h to h + "#include <string.h>\n"
    set h to h + "#include <stdio.h>\n"
    set h to h + "#include <math.h>\n"
    set h to h + "#include \"kaze_rt.h\"   /* arena, checked arithmetic, portable types */\n"
    set h to h + "#pragma STDC FP_CONTRACT OFF\n\n"
    set h to h + "#if !defined(_WIN32)\n"
    set h to h + "#include <unistd.h>\n"
    set h to h + "#else\n"
    set h to h + "#include <io.h>\n"
    set h to h + "#define isatty _isatty\n"
    set h to h + "#define fileno _fileno\n"
    set h to h + "#endif\n\n"
    set h to h + "/* A program need not use every helper; keep strict builds clean. */\n"
    set h to h + "#if defined(__GNUC__) || defined(__clang__)\n"
    set h to h + "#define KZ_MAYBE_UNUSED __attribute__((unused))\n"
    set h to h + "#else\n"
    set h to h + "#define KZ_MAYBE_UNUSED\n"
    set h to h + "#endif\n\n"
    set h to h + "/* Bulk allocation: every dynamic structure comes from this arena and is\n"
    set h to h + "   released in one reset. KAZE_ARENA_BYTES sizes it. */\n"
    set h to h + "static kaze_arena_t kz_arena;\n"
    set h to h + "/* KAZE_ARENA_BYTES sizes the arena; 64 MiB default. */\n"
    set h to h + "static size_t kz_arena_bytes(void) {\n"
    set h to h + "    const char* env = getenv(\"KAZE_ARENA_BYTES\");\n"
    set h to h + "    if (env && env[0]) { long n = strtol(env, NULL, 10); if (n > 0) return (size_t)n; }\n"
    set h to h + "    return (size_t)1024 * 1024 * 1024;\n"
    set h to h + "}\n"
    set h to h + "/* Per-function allocation accounting: KAZE_ARENA_STATS=1 answers where the\n"
    set h to h + "   memory went, from data. __func__ names the emitting helper, so no call site\n"
    set h to h + "   has to be tagged. */\n"
    set h to h + "#define KZ_ALLOC_SITES 16\n"
    set h to h + "static const char* kz_site_name[KZ_ALLOC_SITES];\n"
    set h to h + "static size_t kz_site_bytes[KZ_ALLOC_SITES];\n"
    set h to h + "static size_t kz_site_calls[KZ_ALLOC_SITES];\n"
    set h to h + "static void kz_note_site(const char* site, size_t n) {\n"
    set h to h + "    for (int i = 0; i < KZ_ALLOC_SITES; i++) {\n"
    set h to h + "        if (kz_site_name[i] == site || kz_site_name[i] == NULL) {\n"
    set h to h + "            if (kz_site_name[i] == NULL) kz_site_name[i] = site;\n"
    set h to h + "            kz_site_bytes[i] += n;\n"
    set h to h + "            kz_site_calls[i] += 1;\n"
    set h to h + "            return;\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "}\n"
    set h to h + "static void* kz_alloc_site(const char* site, size_t n);\n"
    set h to h + "#define kz_alloc(n) kz_alloc_site(__func__, (n))\n"
    set h to h + "static void* kz_alloc_raw(size_t n) {\n"
    set h to h + "    void* p = kmalloc(&kz_arena, n);\n"
    set h to h + "    if (p == NULL) {\n"
    set h to h + "        kaze_trap(KAZE_ERR_OOM, \"the arena is full; raise KAZE_ARENA_BYTES\");\n"
    set h to h + "        exit(70);\n"
    set h to h + "    }\n"
    set h to h + "    return p;\n"
    set h to h + "}\n\n"
    set h to h + "static void* kz_alloc_site(const char* site, size_t n) {\n"
    set h to h + "    kz_note_site(site, n);\n"
    set h to h + "    return kz_alloc_raw(n);\n"
    set h to h + "}\n"
    set h to h + "static void kz_print_alloc_sites(void) {\n"
    set h to h + "    const char* env = getenv(\"KAZE_ARENA_STATS\");\n"
    set h to h + "    if (env == NULL || env[0] == 0 || env[0] == 48) return;\n"
    set h to h + "    fprintf(stderr, \"kaze-alloc: %zu bytes used in the arena\\n\", kaze_arena_used(&kz_arena));\n"
    set h to h + "    for (int i = 0; i < KZ_ALLOC_SITES; i++) {\n"
    set h to h + "        if (kz_site_name[i] != NULL)\n"
    set h to h + "            fprintf(stderr, \"kaze-alloc:   %-12s %12zu bytes %10zu calls\\n\", kz_site_name[i], kz_site_bytes[i], kz_site_calls[i]);\n"
    set h to h + "    }\n"
    set h to h + "}\n"
    set h to h + "typedef enum { KZ_VAL_NIL = 0, KZ_VAL_BOOL, KZ_VAL_NUM, KZ_VAL_STR, KZ_VAL_LIST, KZ_VAL_RECORD, KZ_VAL_POINT, KZ_VAL_CHAN, KZ_VAL_FIBER } KzValKind;\n"
    set h to h + "struct KzValue;\n"
    set h to h + "typedef struct { size_t len; size_t cap; struct KzValue* items; } KzList;\n"
    set h to h + "typedef struct { const char* type_name; size_t field_count; const char** keys; struct KzValue* values; } KzRecord;\n"
    set h to h + "typedef struct { const char* data; size_t len; } KzStr;\n"
    set h to h + "typedef struct { kaze_float_t x, y, z; } KzPoint;\n"
    set h to h + "typedef struct KzValue {\n"
    set h to h + "    KzValKind kind;\n"
    set h to h + "    union { bool boolean; kaze_float_t number; KzStr str; KzList* list; KzRecord* record; KzPoint point; void* ptr; } as;\n"
    set h to h + "} KzValue;\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_nil(void) { KzValue v; v.kind = KZ_VAL_NIL; v.as.number = 0.0; return v; }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_bool(bool b) { KzValue v; v.kind = KZ_VAL_BOOL; v.as.boolean = b; return v; }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_num(double n) { KzValue v; v.kind = KZ_VAL_NUM; v.as.number = n; return v; }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_str(const char* s) {\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_STR;\n"
    set h to h + "    v.as.str.data = s ? s : \"\";\n"
    set h to h + "    v.as.str.len = strlen(v.as.str.data);   /* measured once, never again */\n"
    set h to h + "    return v;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_point(KzValue x, KzValue y, KzValue z);\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_pt(KzValue v, int i);\n"
    set h to h + "KZ_MAYBE_UNUSED static inline bool kz_is_truthy(KzValue v) {\n"
    set h to h + "    switch (v.kind) {\n"
    set h to h + "        case KZ_VAL_BOOL: return v.as.boolean;\n"
    set h to h + "        case KZ_VAL_NUM: return v.as.number != 0.0;\n"
    set h to h + "        case KZ_VAL_STR: return v.as.str.data && v.as.str.data[0] != '\\0';\n"
    set h to h + "        case KZ_VAL_LIST: return v.as.list && v.as.list->len > 0;\n"
    set h to h + "        case KZ_VAL_RECORD: return true;\n"
    set h to h + "        case KZ_VAL_CHAN: return v.as.ptr != NULL;\n"
    set h to h + "        case KZ_VAL_FIBER: return v.as.ptr != NULL;\n"
    set h to h + "        default: return false;\n"
    set h to h + "    }\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline char* kz_str_alloc_copy(const char* s) {\n"
    set h to h + "    if (!s) return \"\";\n"
    set h to h + "    size_t l = strlen(s);\n"
    set h to h + "    char* out = (char*)kz_alloc(l + 1);\n"
    set h to h + "    if (!out) return \"\";\n"
    set h to h + "    memcpy(out, s, l + 1);\n"
    set h to h + "    return out;\n"
    set h to h + "}\n\n"
    set h to h + "/* Concatenate with known lengths: nothing is re-walked. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline char* kz_str_concat_n(const char* a, size_t la, const char* b, size_t lb) {\n"
    set h to h + "    char* out = (char*)kz_alloc(la + lb + 1);\n"
    set h to h + "    if (la) memcpy(out, a, la);\n"
    set h to h + "    if (lb) memcpy(out + la, b, lb);\n"
    set h to h + "    out[la + lb] = 0;\n"
    set h to h + "    return out;\n"
    set h to h + "}\n"

    set h to h + "KZ_MAYBE_UNUSED static inline char* kz_str_concat(const char* a, const char* b) {\n"
    set h to h + "    size_t la = a ? strlen(a) : 0;\n"
    set h to h + "    size_t lb = b ? strlen(b) : 0;\n"
    set h to h + "    char* out = (char*)kz_alloc(la + lb + 1);\n"
    set h to h + "    if (!out) return \"\";\n"
    set h to h + "    if (la) memcpy(out, a, la);\n"
    set h to h + "    if (lb) memcpy(out + la, b, lb);\n"
    set h to h + "    out[la + lb] = '\\0';\n"
    set h to h + "    return out;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_add(KzValue a, KzValue b);\n"
    set h to h + "/* `v = v + x` where v is proved append-only. Same result as kz_add, but a text\n"
    set h to h + "   or list buffer that is still the newest arena allocation grows in place\n"
    set h to h + "   instead of being copied. Dispatch is by runtime type, so any operand is safe. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_add_own(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) {\n"
    set h to h + "        const char* s = a.as.str.data;\n"
    set h to h + "        size_t la = a.as.str.len, lb = b.as.str.len;\n"
    set h to h + "        if (kz_arena.base != NULL && s != NULL &&\n"
    set h to h + "            s + la + 1 == (const char*)kz_arena.base + kz_arena.offset &&\n"
    set h to h + "            kz_arena.offset + lb <= kz_arena.cap) {\n"
    set h to h + "            memcpy((char*)s + la, b.as.str.data, lb);\n"
    set h to h + "            ((char*)s)[la + lb] = 0;\n"
    set h to h + "            kz_arena.offset += lb;\n"
    set h to h + "            a.as.str.len = la + lb;   /* the value carries its length: keep it true */\n"
    set h to h + "            return a;\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    if (a.kind == KZ_VAL_LIST && b.kind == KZ_VAL_LIST && a.as.list != NULL &&\n"
    set h to h + "        b.as.list != NULL && b.as.list->len == 1) {\n"
    set h to h + "        KzList* l = a.as.list;\n"
    set h to h + "        if (l->len >= l->cap) {\n"
    set h to h + "            size_t cap = l->cap ? l->cap * 2 : 4;\n"
    set h to h + "            KzValue* items;\n"
    set h to h + "            if (kz_arena.base != NULL &&\n"
    set h to h + "                (const char*)l->items + l->cap * sizeof(KzValue) ==\n"
    set h to h + "                    (const char*)kz_arena.base + kz_arena.offset &&\n"
    set h to h + "                kz_arena.offset + (cap - l->cap) * sizeof(KzValue) <= kz_arena.cap) {\n"
    set h to h + "                items = l->items;\n"
    set h to h + "                kz_arena.offset += (cap - l->cap) * sizeof(KzValue);\n"
    set h to h + "            } else {\n"
    set h to h + "                items = (KzValue*)kz_alloc(cap * sizeof(KzValue));\n"
    set h to h + "                memcpy(items, l->items, l->len * sizeof(KzValue));\n"
    set h to h + "            }\n"
    set h to h + "            l->items = items;\n"
    set h to h + "            l->cap = cap;\n"
    set h to h + "        }\n"
    set h to h + "        l->items[l->len] = b.as.list->items[0];\n"
    set h to h + "        l->len += 1;\n"
    set h to h + "        return a;\n"
    set h to h + "    }\n"
    set h to h + "    return kz_add(a, b);\n"
    set h to h + "}\n"




    set h to h + "KZ_MAYBE_UNUSED static inline void kz_format_number(char* buf, size_t cap, double v) {\n"
    set h to h + "    if (isnan(v)) { snprintf(buf, cap, \"NaN\"); return; }\n"
    set h to h + "    if (isinf(v)) { snprintf(buf, cap, v > 0 ? \"inf\" : \"-inf\"); return; }\n"
    set h to h + "    if (floor(v) == v && fabs(v) < 1e17) { snprintf(buf, cap, \"%.0f\", v); return; }\n"
    set h to h + "    for (int prec = 15; prec <= 17; prec++) {\n"
    set h to h + "        snprintf(buf, cap, \"%.*g\", prec, v);\n"
    set h to h + "        if (strtod(buf, NULL) == v) return;\n"
    set h to h + "    }\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline const char* kz_to_string(KzValue v) {\n"
    set h to h + "    if (v.kind == KZ_VAL_POINT) {\n"
    set h to h + "        char pbuf[192], b1[40], b2[40], b3[40];\n"
    set h to h + "        kz_format_number(b1, sizeof(b1), v.as.point.x);\n"
    set h to h + "        kz_format_number(b2, sizeof(b2), v.as.point.y);\n"
    set h to h + "        kz_format_number(b3, sizeof(b3), v.as.point.z);\n"
    set h to h + "        snprintf(pbuf, sizeof(pbuf), \"(%s, %s, %s)\", b1, b2, b3);\n"
    set h to h + "        return kz_str_alloc_copy(pbuf);\n"
    set h to h + "    }\n"
    set h to h + "    if (v.kind == KZ_VAL_STR) return v.as.str.data ? v.as.str.data : \"\";\n"
    set h to h + "    if (v.kind == KZ_VAL_BOOL) return v.as.boolean ? \"true\" : \"false\";\n"
    set h to h + "    if (v.kind == KZ_VAL_NUM) {\n"
    set h to h + "        char buf[64];\n"
    set h to h + "        kz_format_number(buf, sizeof(buf), v.as.number);\n"
    set h to h + "        return kz_str_alloc_copy(buf);\n"
    set h to h + "    }\n"
    set h to h + "    if (v.kind == KZ_VAL_NIL) return \"nil\";\n"
    set h to h + "    if (v.kind == KZ_VAL_RECORD) return v.as.record ? v.as.record->type_name : \"record\";\n"
    set h to h + "    if (v.kind == KZ_VAL_LIST) return \"list\";\n"
    set h to h + "    return \"\";\n"
    set h to h + "}\n\n"
    set h to h + "/* --- phase 13: deterministic cooperative concurrency ------------------- */\n"
    set h to h + "/* One OS thread, one linear arena, one run. Tasks switch only where the\n"
    set h to h + " * program says yield, in round-robin spawn order, so a run is a deterministic\n"
    set h to h + " * sequence of steps: no wall clock, no scheduler tick, and no two tasks\n"
    set h to h + " * executing at once. Channels are bounded ring buffers of KzValue: a send\n"
    set h to h + " * moves the value header and never the data it points at, and a full or empty\n"
    set h to h + " * channel is a value (false / a fallback), never a block, so a program cannot\n"
    set h to h + " * deadlock on one. */\n"
    set h to h + "#define KZ_CHAN_MAX 64\n"
    set h to h + "#define KZ_TASKS_DEFAULT 8\n"
    set h to h + "#define KZ_FUEL_DEFAULT 10000\n"
    set h to h + "#define KZ_FRAME_SLOTS 32\n"
    set h to h + "#define KZ_FRAME_GUARDS 16\n"
    set h to h + "\n"
    set h to h + "typedef struct kz_chan { KzValue* buf; size_t cap, head, tail, len; } kz_chan;\n"
    set h to h + "typedef struct kz_fiber kz_fiber;\n"
    set h to h + "struct kz_fiber {\n"
    set h to h + "    kz_fiber* parent;\n"
    set h to h + "    kz_fiber* next;\n"
    set h to h + "    int (*step)(kz_fiber*);\n"
    set h to h + "    KzValue* slots;\n"
    set h to h + "    size_t slot_count;\n"
    set h to h + "    long* guards;\n"
    set h to h + "    size_t guard_count;\n"
    set h to h + "    KzValue args;\n"
    set h to h + "    KzValue ret;\n"
    set h to h + "    long fuel;\n"
    set h to h + "    int pc;\n"
    set h to h + "    int done;\n"
    set h to h + "    int cancelled;\n"
    set h to h + "    const char* name;\n"
    set h to h + "};\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static kz_fiber* kz_tasks_head = NULL;\n"
    set h to h + "KZ_MAYBE_UNUSED static kz_fiber* kz_tasks_tail = NULL;\n"
    set h to h + "KZ_MAYBE_UNUSED static kz_fiber* kz_rr_cursor = NULL;\n"
    set h to h + "KZ_MAYBE_UNUSED static kz_fiber* kz_current = NULL;\n"
    set h to h + "KZ_MAYBE_UNUSED static long kz_switch_count = 0;\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static long kz_env_num(const char* name, long dflt) {\n"
    set h to h + "    const char* env = getenv(name);\n"
    set h to h + "    if (env == NULL || env[0] == '\\0') return dflt;\n"
    set h to h + "    long v = strtol(env, NULL, 10);\n"
    set h to h + "    if (v <= 0) return dflt;\n"
    set h to h + "    return v;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static void kz_conc_fail(const char* code, const char* detail) {\n"
    set h to h + "    fprintf(stderr, \"%s: %s\\n\", code, detail);\n"
    set h to h + "    exit(70);\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static long kz_tasks_declared = 0;   /* the module's tasks bounded */\n"
    set h to h + "KZ_MAYBE_UNUSED static long kz_task_ceiling(void) {\n"
    set h to h + "    long v = kz_tasks_declared;\n"
    set h to h + "    if (v <= 0) v = kz_env_num(\"KAZE_MAX_TASKS\", KZ_TASKS_DEFAULT);\n"
    set h to h + "    return v > 256 ? 256 : v;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static long kz_live_tasks(void) {\n"
    set h to h + "    long n = 0;\n"
    set h to h + "    kz_fiber* f;\n"
    set h to h + "    for (f = kz_tasks_head; f != NULL; f = f->next)\n"
    set h to h + "        if (!f->done && !f->cancelled) n += 1;\n"
    set h to h + "    return n;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_fiber_value(kz_fiber* f) {\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_FIBER; v.as.ptr = (void*)f; return v;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_fiber_spawn(int (*step)(kz_fiber*), KzValue args, size_t slot_count, size_t guard_count, const char* name, long declared_fuel) {\n"
    set h to h + "    kz_fiber* f;\n"
    set h to h + "    size_t i;\n"
    set h to h + "    if (kz_live_tasks() >= kz_task_ceiling())\n"
    set h to h + "        kz_conc_fail(\"E_KAZE_TASK_BOUND\", \"the task ceiling is reached; raise KAZE_MAX_TASKS or spawn fewer tasks\");\n"
    set h to h + "    f = (kz_fiber*)kz_alloc(sizeof(kz_fiber));\n"
    set h to h + "    f->parent = kz_current;\n"
    set h to h + "    f->next = NULL;\n"
    set h to h + "    f->step = step;\n"
    set h to h + "    f->slot_count = slot_count;\n"
    set h to h + "    f->slots = (KzValue*)kz_alloc(sizeof(KzValue) * (slot_count ? slot_count : 1));\n"
    set h to h + "    for (i = 0; i < slot_count; i++) f->slots[i] = kz_nil();\n"
    set h to h + "    f->guard_count = guard_count;\n"
    set h to h + "    f->guards = (long*)kz_alloc(sizeof(long) * (guard_count ? guard_count : 1));\n"
    set h to h + "    for (i = 0; i < guard_count; i++) f->guards[i] = 0;\n"
    set h to h + "    f->args = args;\n"
    set h to h + "    if (args.kind == KZ_VAL_LIST && args.as.list != NULL) {\n"
    set h to h + "        size_t n = args.as.list->len;\n"
    set h to h + "        if (n > slot_count) n = slot_count;\n"
    set h to h + "        for (i = 0; i < n; i++) f->slots[i] = args.as.list->items[i];\n"
    set h to h + "    }\n"
    set h to h + "    f->ret = kz_nil();\n"
    set h to h + "    f->fuel = declared_fuel > 0 ? declared_fuel : kz_env_num(\"KAZE_FUEL\", KZ_FUEL_DEFAULT);\n"
    set h to h + "    if (kz_current != NULL) {\n"
    set h to h + "        /* A child spends from the parent's budget, never more than half of\n"
    set h to h + "         * it, so a spawn cannot starve the spawner. */\n"
    set h to h + "        long share = kz_current->fuel / 2;\n"
    set h to h + "        if (share < 1) share = 1;\n"
    set h to h + "        if (f->fuel > share) f->fuel = share;\n"
    set h to h + "        kz_current->fuel -= f->fuel;\n"
    set h to h + "    }\n"
    set h to h + "    f->pc = 0; f->done = 0; f->cancelled = 0; f->name = name;\n"
    set h to h + "    if (kz_tasks_tail == NULL) { kz_tasks_head = f; kz_tasks_tail = f; }\n"
    set h to h + "    else { kz_tasks_tail->next = f; kz_tasks_tail = f; }\n"
    set h to h + "    return kz_fiber_value(f);\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static kz_fiber* kz_task_after(kz_fiber* from) {\n"
    set h to h + "    kz_fiber* f = (from != NULL) ? from->next : kz_tasks_head;\n"
    set h to h + "    while (f != NULL) { if (!f->done && !f->cancelled) return f; f = f->next; }\n"
    set h to h + "    f = kz_tasks_head;\n"
    set h to h + "    while (f != NULL && f != from) { if (!f->done && !f->cancelled) return f; f = f->next; }\n"
    set h to h + "    if (from != NULL && !from->done && !from->cancelled) return from;\n"
    set h to h + "    return NULL;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static void kz_task_step(kz_fiber* f) {\n"
    set h to h + "    kz_fiber* prev;\n"
    set h to h + "    kz_fiber* g;\n"
    set h to h + "    int st;\n"
    set h to h + "    if (f->done || f->cancelled) return;\n"
    set h to h + "    if (f->fuel <= 0) kz_conc_fail(\"E_KAZE_FUEL_EXHAUSTED\", \"a task spent its whole fuel budget\");\n"
    set h to h + "    f->fuel -= 1;\n"
    set h to h + "    prev = kz_current;\n"
    set h to h + "    kz_current = f;\n"
    set h to h + "    kz_switch_count += 1;\n"
    set h to h + "    st = f->step(f);\n"
    set h to h + "    kz_current = prev;\n"
    set h to h + "    if (st == 0) f->done = 1;\n"
    set h to h + "    if (f->done) {\n"
    set h to h + "        /* A parent's exit cancels the children it left running: nothing\n"
    set h to h + "         * outlives the task that owns it. */\n"
    set h to h + "        for (g = kz_tasks_head; g != NULL; g = g->next)\n"
    set h to h + "            if (g->parent == f && !g->done) g->cancelled = 1;\n"
    set h to h + "    }\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static void kz_sched_drive(kz_fiber* target) {\n"
    set h to h + "    for (;;) {\n"
    set h to h + "        kz_fiber* next;\n"
    set h to h + "        if (target != NULL && (target->done || target->cancelled)) return;\n"
    set h to h + "        next = kz_task_after(kz_rr_cursor);\n"
    set h to h + "        if (next == NULL) return;\n"
    set h to h + "        if (next == kz_current) return;\n"
    set h to h + "        kz_rr_cursor = next;\n"
    set h to h + "        kz_task_step(next);\n"
    set h to h + "    }\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_fiber_join(KzValue v) {\n"
    set h to h + "    kz_fiber* f;\n"
    set h to h + "    if (v.kind != KZ_VAL_FIBER || v.as.ptr == NULL) return kz_nil();\n"
    set h to h + "    f = (kz_fiber*)v.as.ptr;\n"
    set h to h + "    kz_sched_drive(f);\n"
    set h to h + "    return f->ret;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static void kz_fiber_cancel_value(KzValue v) {\n"
    set h to h + "    kz_fiber* f;\n"
    set h to h + "    kz_fiber* g;\n"
    set h to h + "    if (v.kind != KZ_VAL_FIBER || v.as.ptr == NULL) return;\n"
    set h to h + "    f = (kz_fiber*)v.as.ptr;\n"
    set h to h + "    for (g = kz_tasks_head; g != NULL; g = g->next)\n"
    set h to h + "        if (g->parent == f) g->cancelled = 1;\n"
    set h to h + "    f->cancelled = 1;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_fiber_run_root(int (*step)(kz_fiber*), size_t slot_count, size_t guard_count, long declared_fuel) {\n"
    set h to h + "    KzValue v = kz_fiber_spawn(step, kz_nil(), slot_count, guard_count, \"main\", declared_fuel);\n"
    set h to h + "    return kz_fiber_join(v);\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_chan_new(KzValue depth) {\n"
    set h to h + "    kz_chan* c;\n"
    set h to h + "    size_t cap;\n"
    set h to h + "    KzValue v;\n"
    set h to h + "    double d = (depth.kind == KZ_VAL_NUM) ? depth.as.number : 0.0;\n"
    set h to h + "    if (d < 1 || d > KZ_CHAN_MAX) kz_conc_fail(\"E_KAZE_CHANNEL_DEPTH\", \"a channel holds from 1 to 64 values\");\n"
    set h to h + "    cap = (size_t)d;\n"
    set h to h + "    c = (kz_chan*)kz_alloc(sizeof(kz_chan));\n"
    set h to h + "    c->buf = (KzValue*)kz_alloc(sizeof(KzValue) * cap);\n"
    set h to h + "    c->cap = cap; c->head = 0; c->tail = 0; c->len = 0;\n"
    set h to h + "    v.kind = KZ_VAL_CHAN; v.as.ptr = (void*)c;\n"
    set h to h + "    return v;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static bool kz_chan_send(KzValue ch, KzValue v) {\n"
    set h to h + "    kz_chan* c;\n"
    set h to h + "    if (ch.kind != KZ_VAL_CHAN || ch.as.ptr == NULL) return false;\n"
    set h to h + "    c = (kz_chan*)ch.as.ptr;\n"
    set h to h + "    if (c->len >= c->cap) return false;\n"
    set h to h + "    c->buf[c->tail] = v;\n"
    set h to h + "    c->tail = (c->tail + 1) % c->cap;\n"
    set h to h + "    c->len += 1;\n"
    set h to h + "    return true;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_chan_recv_or(KzValue ch, KzValue fallback) {\n"
    set h to h + "    kz_chan* c;\n"
    set h to h + "    KzValue v;\n"
    set h to h + "    if (ch.kind != KZ_VAL_CHAN || ch.as.ptr == NULL) return fallback;\n"
    set h to h + "    c = (kz_chan*)ch.as.ptr;\n"
    set h to h + "    if (c->len == 0) return fallback;\n"
    set h to h + "    v = c->buf[c->head];\n"
    set h to h + "    c->head = (c->head + 1) % c->cap;\n"
    set h to h + "    c->len -= 1;\n"
    set h to h + "    return v;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_chan_len(KzValue ch) {\n"
    set h to h + "    if (ch.kind != KZ_VAL_CHAN || ch.as.ptr == NULL) return kz_num(0);\n"
    set h to h + "    return kz_num((double)((kz_chan*)ch.as.ptr)->len);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static void kz_print_switch_stats(void) {\n"
    set h to h + "    const char* env = getenv(\"KAZE_SWITCH_STATS\");\n"
    set h to h + "    if (env == NULL || env[0] == 0 || env[0] == 48) return;\n"
    set h to h + "    fprintf(stderr, \"kaze-switch: %ld task switches\\n\", kz_switch_count);\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "/* Make room for `need` items. A list may start with no buffer at all, so every\n"
    set h to h + "   reader that indexes items must come through here (or check len first). */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_list_reserve(KzList* l, size_t need) {\n"
    set h to h + "    if (l->cap >= need && l->items != NULL) return;\n"
    set h to h + "    size_t cap = l->cap ? l->cap : 4;\n"
    set h to h + "    while (cap < need) cap *= 2;\n"
    set h to h + "    KzValue* items = (KzValue*)kz_alloc(cap * sizeof(KzValue));\n"
    set h to h + "    if (l->len) memcpy(items, l->items, l->len * sizeof(KzValue));\n"
    set h to h + "    l->items = items;\n"
    set h to h + "    l->cap = cap;\n"
    set h to h + "}\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_list_new(size_t cap) {\n"
    set h to h + "    KzList* l = (KzList*)kz_alloc(sizeof(KzList));\n"
    set h to h + "    l->len = 0;\n"
    set h to h + "    /* Lazy buffer: an empty list costs a header, not a header and a buffer.\n"
    set h to h + "       Every site that indexes items either checks len first or goes through\n"
    set h to h + "       kz_list_reserve (audited: concat, from, append, index, for-each). */\n"
    set h to h + "    l->cap = cap > 4 ? cap : 0;\n"
    set h to h + "    l->items = (cap > 4) ? (KzValue*)kz_alloc(l->cap * sizeof(KzValue)) : NULL;\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_LIST; v.as.list = l; return v;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_list_concat(KzValue a, KzValue b) {\n"
    set h to h + "    size_t la = (a.kind == KZ_VAL_LIST && a.as.list) ? a.as.list->len : 0;\n"
    set h to h + "    size_t lb = (b.kind == KZ_VAL_LIST && b.as.list) ? b.as.list->len : 0;\n"
    set h to h + "    KzValue res = kz_list_new(la + lb);\n"
    set h to h + "    kz_list_reserve(res.as.list, la + lb);   /* the buffer is lazy: ask first */\n"
    set h to h + "    KzList* l = res.as.list;\n"
    set h to h + "    if (la) { memcpy(l->items, a.as.list->items, la * sizeof(KzValue)); l->len += la; }\n"
    set h to h + "    if (lb) { memcpy(l->items + l->len, b.as.list->items, lb * sizeof(KzValue)); l->len += lb; }\n"
    set h to h + "    return res;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_list_from(size_t n, const KzValue* items) {\n"
    set h to h + "    KzValue res = kz_list_new(n);\n"
    set h to h + "    if (n > 0 && items) { kz_list_reserve(res.as.list, n); memcpy(res.as.list->items, items, n * sizeof(KzValue)); res.as.list->len = n; }\n"
    set h to h + "    return res;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_record_create(const char* type_name, size_t n, const char** keys, const KzValue* vals) {\n"
    set h to h + "    KzRecord* r = (KzRecord*)kz_alloc(sizeof(KzRecord));\n"
    set h to h + "    r->type_name = type_name;\n"
    set h to h + "    r->field_count = n;\n"
    set h to h + "    r->keys = keys;\n"
    set h to h + "    r->values = (n > 0) ? (KzValue*)kz_alloc(n * sizeof(KzValue)) : NULL;\n"
    set h to h + "    if (n > 0 && vals && r->values) { memcpy(r->values, vals, n * sizeof(KzValue)); }\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_RECORD; v.as.record = r; return v;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_get_field(KzValue obj, const char* field) {\n"
    set h to h + "    if (obj.kind == KZ_VAL_POINT) {\n"
    set h to h + "        if (field && field[0] == 'x' && field[1] == 0) return kz_num(obj.as.point.x);\n"
    set h to h + "        if (field && field[0] == 'y' && field[1] == 0) return kz_num(obj.as.point.y);\n"
    set h to h + "        if (field && field[0] == 'z' && field[1] == 0) return kz_num(obj.as.point.z);\n"
    set h to h + "        return kz_nil();\n"
    set h to h + "    }\n"
    set h to h + "    if (obj.kind != KZ_VAL_RECORD || !obj.as.record) return kz_nil();\n"
    set h to h + "    KzRecord* r = obj.as.record;\n"
    set h to h + "    for (size_t i = 0; i < r->field_count; i++) {\n"
    set h to h + "        /* Pointer identity first: record keys and field names come from the same\n"
    set h to h + "           literals, so the common hit costs one compare instead of a strcmp. */\n"
    set h to h + "        if (r->keys[i] == field || (field && strcmp(r->keys[i], field) == 0)) return r->values[i];\n"
    set h to h + "    }\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_add(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_num(a.as.number + b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR || b.kind == KZ_VAL_STR) {\n"
    set h to h + "        KzValue sa = (a.kind == KZ_VAL_STR) ? a : kz_str(kz_to_string(a));\n"
    set h to h + "        KzValue sb = (b.kind == KZ_VAL_STR) ? b : kz_str(kz_to_string(b));\n"
    set h to h + "        return kz_str(kz_str_concat_n(sa.as.str.data, sa.as.str.len, sb.as.str.data, sb.as.str.len));\n"
    set h to h + "    }\n"
    set h to h + "    if (a.kind == KZ_VAL_LIST && b.kind == KZ_VAL_LIST) return kz_list_concat(a, b);\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n"
    set h to h + "/* Bitwise operators: Kaze numbers are doubles, so each operand is truncated to\n"
    set h to h + " * the runtime integer type, and a shift count is masked to 0..63 so no shift is\n"
    set h to h + " * undefined behaviour. Right shift is logical, which is what hashing and CRCs\n"
    set h to h + " * want. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_band(KzValue a, KzValue b) {\n"
    set h to h + "    return kz_num((kaze_float_t)((kaze_int_t)((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) & (kaze_int_t)((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0)));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_bor(KzValue a, KzValue b) {\n"
    set h to h + "    return kz_num((kaze_float_t)((kaze_int_t)((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) | (kaze_int_t)((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0)));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_bxor(KzValue a, KzValue b) {\n"
    set h to h + "    return kz_num((kaze_float_t)((kaze_int_t)((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) ^ (kaze_int_t)((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0)));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_shl(KzValue a, KzValue b) {\n"
    set h to h + "    kaze_int_t n = (kaze_int_t)((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0) & 63;\n"
    set h to h + "    return kz_num((kaze_float_t)((kaze_int_t)((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) << n));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_shr(KzValue a, KzValue b) {\n"
    set h to h + "    kaze_int_t n = (kaze_int_t)((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0) & 63;\n"
    set h to h + "    return kz_num((kaze_float_t)((kaze_uint_t)((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) >> n));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_sub(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_POINT && b.kind == KZ_VAL_POINT) return kz_point(kz_num(a.as.point.x - b.as.point.x), kz_num(a.as.point.y - b.as.point.y), kz_num(a.as.point.z - b.as.point.z));\n"
    set h to h + "    return kz_num(((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) - ((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_mul(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_POINT && b.kind == KZ_VAL_NUM) return kz_point(kz_num(a.as.point.x * b.as.number), kz_num(a.as.point.y * b.as.number), kz_num(a.as.point.z * b.as.number));\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_POINT) return kz_mul(b, a);\n"
    set h to h + "    return kz_num(((a.kind == KZ_VAL_NUM) ? a.as.number : 0.0) * ((b.kind == KZ_VAL_NUM) ? b.as.number : 0.0));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_div(KzValue a, KzValue b) {\n"
    set h to h + "    kaze_float_t out = 0.0;   /* kaze_rt checks the divisor and the result */\n"
    set h to h + "    kaze_float_t x = (a.kind == KZ_VAL_NUM) ? a.as.number : 0.0;\n"
    set h to h + "    kaze_float_t y = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    if (!kaze_float_div_checked(x, y, &out)) { kaze_trap(KAZE_ERR_DIV0, \"division by zero\"); exit(70); }\n"
    set h to h + "    return kz_num(out);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_mod(KzValue a, KzValue b) {\n"
    set h to h + "    kaze_float_t y = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    kaze_float_t x = (a.kind == KZ_VAL_NUM) ? a.as.number : 0.0;\n"
    set h to h + "    if (y == 0.0) { kaze_trap(KAZE_ERR_DIV0, \"remainder by zero\"); exit(70); }\n"
    set h to h + "    return kz_num(fmod(x, y));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_not(KzValue a) { return kz_bool(!kz_is_truthy(a)); }\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline bool kz_val_eq(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind != b.kind) return false;\n"
    set h to h + "    switch (a.kind) {\n"
    set h to h + "        case KZ_VAL_NIL: return true;\n"
    set h to h + "        case KZ_VAL_BOOL: return a.as.boolean == b.as.boolean;\n"
    set h to h + "        case KZ_VAL_NUM: return a.as.number == b.as.number;\n"
    set h to h + "        case KZ_VAL_STR: return (a.as.str.data && b.as.str.data) ? (strcmp(a.as.str.data, b.as.str.data) == 0) : (a.as.str.data == b.as.str.data);\n"
    set h to h + "        default: return a.as.list == b.as.list;\n"
    set h to h + "    }\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_eq(KzValue a, KzValue b) { return kz_bool(kz_val_eq(a, b)); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_ne(KzValue a, KzValue b) { return kz_bool(!kz_val_eq(a, b)); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_lt(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number < b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) < 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_le(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number <= b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) <= 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_gt(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number > b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) > 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_ge(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_NUM && b.kind == KZ_VAL_NUM) return kz_bool(a.as.number >= b.as.number);\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) return kz_bool(strcmp(a.as.str.data, b.as.str.data) >= 0);\n"
    set h to h + "    return kz_bool(false);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_and(KzValue a, KzValue b) { return kz_bool(kz_is_truthy(a) && kz_is_truthy(b)); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_or(KzValue a, KzValue b) { return kz_bool(kz_is_truthy(a) || kz_is_truthy(b)); }\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_len(KzValue a) {\n"
    set h to h + "    if (a.kind == KZ_VAL_POINT) return kz_num(sqrt(a.as.point.x * a.as.point.x + a.as.point.y * a.as.point.y + a.as.point.z * a.as.point.z));\n"
    set h to h + "    if (a.kind == KZ_VAL_STR) return kz_num((double)a.as.str.len);\n"
    set h to h + "    if (a.kind == KZ_VAL_LIST && a.as.list) return kz_num((double)a.as.list->len);\n"
    set h to h + "    /* length of applies to text, lists and points. Returning 0 for anything\n"
    set h to h + "       else would make a guard clause fall through instead of refusing. */\n"
    set h to h + "    kaze_trap(KAZE_ERR_TYPE, \"length of does not apply to this value\");\n"
    set h to h + "    exit(70);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_index(KzValue coll, KzValue idx) {\n"
    set h to h + "    size_t i = (idx.kind == KZ_VAL_NUM && idx.as.number >= 0.0) ? (size_t)idx.as.number : 0;\n"
    set h to h + "    if (coll.kind == KZ_VAL_LIST && coll.as.list) {\n"
    set h to h + "        if (i < coll.as.list->len) return coll.as.list->items[i];\n"
    set h to h + "        return kz_nil();\n"
    set h to h + "    }\n"
    set h to h + "    if (coll.kind == KZ_VAL_STR && coll.as.str.data) {\n"
    set h to h + "        size_t l = coll.as.str.len;\n"
    set h to h + "        if (i < l) {\n"
    set h to h + "            char* one = (char*)kz_alloc(2);\n"
    set h to h + "            one[0] = coll.as.str.data[i];\n"
    set h to h + "            one[1] = '\\0';\n"
    set h to h + "            return kz_str(one);\n"
    set h to h + "        }\n"
    set h to h + "        return kz_str(\"\");\n"
    set h to h + "    }\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_builtin_log(KzValue msg) { printf(\"[info] %s\\n\", kz_to_string(msg)); }\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_read_stream(FILE* f) {\n"
    set h to h + "    size_t cap = 4096; size_t len = 0;\n"
    set h to h + "    char* buf = (char*)kz_alloc(cap);\n"
    set h to h + "    if (!buf) return kz_str(\"\");\n"
    set h to h + "    size_t n;\n"
    set h to h + "    while ((n = fread(buf + len, 1, cap - len - 1, f)) > 0) {\n"
    set h to h + "        len += n;\n"
    set h to h + "        if (len + 1024 >= cap) { cap *= 2; char* nb = (char*)realloc(buf, cap); if (!nb) break; buf = nb; }\n"
    set h to h + "    }\n"
    set h to h + "    buf[len] = '\\0';\n"
    set h to h + "    if (len == 0) return kz_nil();   /* nothing on stdin is no value, not empty text */\n"
    set h to h + "    return kz_str(buf);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_read_file_or_string(const char* path_or_str) {\n"
    set h to h + "    if (!path_or_str) return kz_str(\"\");\n"
    set h to h + "    FILE* f = fopen(path_or_str, \"rb\");\n"
    set h to h + "    if (!f) return kz_str(path_or_str);\n"
    set h to h + "    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);\n"
    set h to h + "    if (sz < 0) { fclose(f); return kz_str(path_or_str); }\n"
    set h to h + "    char* buf = (char*)kz_alloc((size_t)sz + 1);\n"
    set h to h + "    if (!buf) { fclose(f); return kz_str(path_or_str); }\n"
    set h to h + "    size_t rd = fread(buf, 1, (size_t)sz, f);\n"
    set h to h + "    buf[rd] = '\\0'; fclose(f);\n"
    set h to h + "    return kz_str(buf);\n"
    set h to h + "}\n\n"
    set h to h + "/* 12-factor input: --arg > AGENT_* > config > signature default. A parameter\n"
    set h to h + "   declared with a type must arrive with a value of that type; silently using 0\n"
    set h to h + "   or raw text is how a script acts on a number nobody gave it. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_param(const char* ty, const char* name, const char* routine, KzValue v) {\n"
    set h to h + "    if (ty == NULL || ty[0] == 0) return v;\n"
    set h to h + "    int wants_text = (strcmp(ty, \"text\") == 0 || strcmp(ty, \"string\") == 0);\n"
    set h to h + "    int wants_bool = (strcmp(ty, \"bool\") == 0);\n"
    set h to h + "    if (v.kind == KZ_VAL_NIL) {\n"
    set h to h + "        fprintf(stderr, \"E_KAZE_PARAM: parameter '%s' of '%s' is declared as %s and has no value; provide --arg %s=<value>, the environment variable AGENT_%s, or \\\"%s\\\" in the config file\\n\", name, routine, ty, name, name, name);\n"
    set h to h + "        exit(2);\n"
    set h to h + "    }\n"
    set h to h + "    if (wants_text) return (v.kind == KZ_VAL_STR) ? v : kz_str(kz_to_string(v));\n"
    set h to h + "    if (wants_bool) {\n"
    set h to h + "        if (v.kind == KZ_VAL_BOOL) return v;\n"
    set h to h + "        if (v.kind == KZ_VAL_STR) {\n"
    set h to h + "            if (strcmp(v.as.str.data, \"true\") == 0) return kz_bool(true);\n"
    set h to h + "            if (strcmp(v.as.str.data, \"false\") == 0) return kz_bool(false);\n"
    set h to h + "        }\n"
    set h to h + "    } else {\n"
    set h to h + "        if (v.kind == KZ_VAL_NUM) return v;\n"
    set h to h + "        if (v.kind == KZ_VAL_STR) {\n"
    set h to h + "            char* end = NULL;\n"
    set h to h + "            double d = strtod(v.as.str.data, &end);\n"
    set h to h + "            if (end != NULL && end != v.as.str.data && *end == 0) return kz_num(d);\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    fprintf(stderr, \"E_KAZE_PARAM: parameter '%s' of '%s' is declared as %s but the value given is not one\\n\", name, routine, ty);\n"
    set h to h + "    exit(2);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_resolve_cli_arg(int argc, char** argv, const char* name, int index) {\n"
    set h to h + "    size_t nlen = strlen(name);\n"
    set h to h + "    for (int i = 1; i < argc; i++) {\n"
    set h to h + "        const char* a = argv[i];\n"
    set h to h + "        if (strncmp(a, \"--\", 2) == 0) {\n"
    set h to h + "            const char* opt = a + 2;\n"
    set h to h + "            if (strncmp(opt, name, nlen) == 0 && opt[nlen] == '=') return kz_read_file_or_string(opt + nlen + 1);\n"
    set h to h + "            if (strcmp(opt, \"arg\") == 0 && i + 1 < argc) {\n"
    set h to h + "                const char* next_arg = argv[i + 1];\n"
    set h to h + "                if (strncmp(next_arg, name, nlen) == 0 && next_arg[nlen] == '=') return kz_read_file_or_string(next_arg + nlen + 1);\n"
    set h to h + "            }\n"
    set h to h + "            if (strncmp(opt, \"arg=\", 4) == 0) {\n"
    set h to h + "                const char* next_arg = opt + 4;\n"
    set h to h + "                if (strncmp(next_arg, name, nlen) == 0 && next_arg[nlen] == '=') return kz_read_file_or_string(next_arg + nlen + 1);\n"
    set h to h + "            }\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    char env_name[128];\n"
    set h to h + "    snprintf(env_name, sizeof(env_name), \"AGENT_%s\", name);\n"
    set h to h + "    for (size_t j = 6; env_name[j]; j++) { if (env_name[j] >= 'a' && env_name[j] <= 'z') env_name[j] -= 32; }\n"
    set h to h + "    char* ev = getenv(env_name);\n"
    set h to h + "    if (ev) return kz_read_file_or_string(ev);\n"
    set h to h + "    snprintf(env_name, sizeof(env_name), \"SOFUU_%s\", name);\n"
    set h to h + "    for (size_t j = 6; env_name[j]; j++) { if (env_name[j] >= 'a' && env_name[j] <= 'z') env_name[j] -= 32; }\n"
    set h to h + "    ev = getenv(env_name);\n"
    set h to h + "    if (ev) return kz_read_file_or_string(ev);\n"
    set h to h + "    int pos_idx = 0;\n"
    set h to h + "    for (int i = 1; i < argc; i++) {\n"
    set h to h + "        /* An option value is not a positional argument: --ticks 2 used to\n"
    set h to h + "           hand the 2 to the first parameter. */\n"
    set h to h + "        if (strcmp(argv[i], \"--ticks\") == 0 || strcmp(argv[i], \"--cap\") == 0 ||\n"
    set h to h + "            strcmp(argv[i], \"--config\") == 0 || strcmp(argv[i], \"--arg\") == 0 ||\n"
    set h to h + "            strcmp(argv[i], \"--entry\") == 0 || strcmp(argv[i], \"-o\") == 0) { i++; continue; }\n"
    set h to h + "        if (argv[i][0] != '-') {\n"
    set h to h + "            if (pos_idx == index) return kz_read_file_or_string(argv[i]);\n"
    set h to h + "            pos_idx++;\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    if (index == 0 && !isatty(fileno(stdin))) return kz_read_stream(stdin);\n"
    set h to h + "    /* No layer supplied this argument: nothing, not empty text, so a\n"
    set h to h + "       guard clause on it refuses the way the interpreter does. */\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n\n"
    set h to h + "\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_fb_div(KzValue a, KzValue b, KzValue fb) {\n"
    set h to h + "    double d = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    if (d == 0.0) return fb;\n"
    set h to h + "    return kz_div(a, b);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_fb_mod(KzValue a, KzValue b, KzValue fb) {\n"
    set h to h + "    double d = (b.kind == KZ_VAL_NUM) ? b.as.number : 0.0;\n"
    set h to h + "    if (d == 0.0) return fb;\n"
    set h to h + "    return kz_mod(a, b);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_fb_index(KzValue coll, KzValue idx, KzValue fb) {\n"
    set h to h + "    double d = (idx.kind == KZ_VAL_NUM) ? idx.as.number : -1.0;\n"
    set h to h + "    if (d < 0.0) return fb;\n"
    set h to h + "    if (coll.kind == KZ_VAL_LIST && coll.as.list) {\n"
    set h to h + "        if ((size_t)d >= coll.as.list->len) return fb;\n"
    set h to h + "    } else if (coll.kind == KZ_VAL_STR && coll.as.str.data) {\n"
    set h to h + "        if ((size_t)d >= coll.as.str.len) return fb;\n"
    set h to h + "    }\n"
    set h to h + "    return kz_index(coll, idx);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_record_set(KzValue* vals, const char** keys, size_t count, size_t pos, const char* key, KzValue value) {\n"
    set h to h + "    if (key != NULL) {\n"
    set h to h + "        for (size_t j = 0; j < count; j++) {\n"
    set h to h + "            if (strcmp(keys[j], key) == 0) { vals[j] = value; return; }\n"
    set h to h + "        }\n"
    set h to h + "        return;\n"
    set h to h + "    }\n"
    set h to h + "    if (pos < count) vals[pos] = value;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_to_num(KzValue v) { return (v.kind == KZ_VAL_NUM) ? v.as.number : 0.0; }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_sqrt(KzValue a) { return kz_num(sqrt(kz_to_num(a))); }\n"
    set h to h + "/* Character codes. Kaze text is bytes with a length and indexing yields a\n"
    set h to h + " * one-character text, so a program had no way to see a byte - which blocks every\n"
    set h to h + " * hash, every JSON escape and every binary codec. code(c) returns the byte and\n"
    set h to h + " * character(n) turns one back into text; n is clamped to a byte range so the pair\n"
    set h to h + " * is total and needs no fallback at the call site. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_code(KzValue v) {\n"
    set h to h + "    if (v.kind != KZ_VAL_STR || v.as.str.data == NULL || v.as.str.len == 0) return kz_num(0);\n"
    set h to h + "    return kz_num((kaze_float_t)(unsigned char)v.as.str.data[0]);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_character(KzValue n) {\n"
    set h to h + "    kaze_int_t c = (kaze_int_t)kz_to_num(n);\n"
    set h to h + "    if (c < 0 || c > 255) return kz_str(\"\");\n"
    set h to h + "    char one[2];\n"
    set h to h + "    one[0] = (char)c;\n"
    set h to h + "    one[1] = 0;\n"
    set h to h + "    /* kz_str wraps a pointer without copying and `one` is a stack buffer,\n"
    set h to h + "     * so the byte is copied into the arena before it escapes. */\n"
    set h to h + "    return kz_str(kz_str_concat_n(one, 1, \"\", 0));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_sin(KzValue a) { return kz_num(sin(kz_to_num(a))); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_cos(KzValue a) { return kz_num(cos(kz_to_num(a))); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_atan2(KzValue a, KzValue b) { return kz_num(atan2(kz_to_num(a), kz_to_num(b))); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_to_radians(KzValue a) { return kz_num(kz_to_num(a) * 0.017453292519943295); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_math_to_degrees(KzValue a) { return kz_num(kz_to_num(a) * 57.29577951308232); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_point(KzValue x, KzValue y, KzValue z) {\n"
    set h to h + "    KzValue v; v.kind = KZ_VAL_POINT;\n"
    set h to h + "    v.as.point.x = (x.kind == KZ_VAL_NUM) ? x.as.number : 0.0;\n"
    set h to h + "    v.as.point.y = (y.kind == KZ_VAL_NUM) ? y.as.number : 0.0;\n"
    set h to h + "    v.as.point.z = (z.kind == KZ_VAL_NUM) ? z.as.number : 0.0;\n"
    set h to h + "    return v;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_pt(KzValue v, int i) {\n"
    set h to h + "    if (v.kind != KZ_VAL_POINT) return 0.0;\n"
    set h to h + "    return i == 0 ? v.as.point.x : (i == 1 ? v.as.point.y : v.as.point.z);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_list_num(KzValue v, size_t i) {\n"
    set h to h + "    if (v.kind == KZ_VAL_LIST && v.as.list && i < v.as.list->len) return kz_to_num(v.as.list->items[i]);\n"
    set h to h + "    return 0.0;\n"
    set h to h + "}\n"
    set h to h + "#define KZ_EARTH_RADIUS_M 6371008.8\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_rad(double d) { return d * (3.14159265358979323846 / 180.0); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_deg(double r) { return r * (180.0 / 3.14159265358979323846); }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_norm(double d) { double m = fmod(d, 360.0); if (m < 0.0) m += 360.0; return m; }\n"
    set h to h + "KZ_MAYBE_UNUSED static inline double kz_geo_haversine(double alat, double alon, double blat, double blon) {\n"
    set h to h + "    double lat1 = kz_geo_rad(alat), lon1 = kz_geo_rad(alon);\n"
    set h to h + "    double lat2 = kz_geo_rad(blat), lon2 = kz_geo_rad(blon);\n"
    set h to h + "    double dlat = lat2 - lat1, dlon = lon2 - lon1;\n"
    set h to h + "    double s1 = sin(dlat / 2.0), s2 = sin(dlon / 2.0);\n"
    set h to h + "    double hv = s1 * s1 + cos(lat1) * cos(lat2) * s2 * s2;\n"
    set h to h + "    if (hv > 1.0) hv = 1.0;\n"
    set h to h + "    return 2.0 * KZ_EARTH_RADIUS_M * asin(sqrt(hv));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_distance(KzValue a, KzValue b) {\n"
    set h to h + "    return kz_num(kz_geo_haversine(kz_pt(a, 0), kz_pt(a, 1), kz_pt(b, 0), kz_pt(b, 1)));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_slant_distance(KzValue a, KzValue b) {\n"
    set h to h + "    double ground = kz_geo_haversine(kz_pt(a, 0), kz_pt(a, 1), kz_pt(b, 0), kz_pt(b, 1));\n"
    set h to h + "    double dz = kz_pt(b, 2) - kz_pt(a, 2);\n"
    set h to h + "    return kz_num(sqrt(ground * ground + dz * dz));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_bearing_from(KzValue a, KzValue b) {\n"
    set h to h + "    double lat1 = kz_geo_rad(kz_pt(a, 0)), lat2 = kz_geo_rad(kz_pt(b, 0));\n"
    set h to h + "    double dlon = kz_geo_rad(kz_pt(b, 1) - kz_pt(a, 1));\n"
    set h to h + "    double y = sin(dlon) * cos(lat2);\n"
    set h to h + "    double x = cos(lat1) * sin(lat2) - sin(lat1) * cos(lat2) * cos(dlon);\n"
    set h to h + "    return kz_num(kz_geo_norm(kz_geo_deg(atan2(y, x))));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_geo_bearing_of(KzValue p) {\n"
    set h to h + "    return kz_num(kz_geo_norm(kz_geo_deg(atan2(kz_pt(p, 0), kz_pt(p, 1)))));\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_unavailable(const char* what) {\n"
    set h to h + "    fprintf(stderr, \"E_KAZE_UNSUPPORTED: %s is not lowered by the pure-Kaze C emitter\\n\", what);\n"
    set h to h + "    return kz_nil();\n"
    set h to h + "}\n"
    set h to h + "/* A bare telemetry field is a capability read. Returning nothing here would\n"
    set h to h + "   let `when battery < 20%` compare nothing against a percent. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_cap_get(const char* family, const char* field) {\n"
    set h to h + "    fprintf(stderr, \"E_CAP_MISSING: the native emitter has no host for %s.%s\\n\", family, field);\n"
    set h to h + "    exit(70);\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_cap_call(const char* recv, const char* op, int n, KzValue* args) {\n"
    set h to h + "    (void)n; (void)args;\n"
    set h to h + "    fprintf(stderr, \"E_CAP_MISSING: the native emitter has no host for %s.%s\\n\", recv, op);\n"
    set h to h + "    exit(70);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline void kz_builtin_alert(KzValue msg) { fprintf(stderr, \"[alert] %s\\n\", kz_to_string(msg)); }\n"
    return h

action sanitize_c_id(name):
    if name == "auto" or name == "break" or name == "case" or name == "char" or name == "const" or name == "continue" or name == "default" or name == "do" or name == "double" or name == "else" or name == "enum" or name == "extern" or name == "float" or name == "for" or name == "goto" or name == "if" or name == "inline" or name == "int" or name == "long" or name == "register" or name == "restrict" or name == "return" or name == "short" or name == "signed" or name == "sizeof" or name == "static" or name == "struct" or name == "switch" or name == "typedef" or name == "union" or name == "unsigned" or name == "void" or name == "volatile" or name == "while" or name == "main":
        return "_kz_" + name
    return name

action escape_c_str(s):
    let res = "\""
    let len = length of s
    let i = 0
    while i < len bounded 1000000:
        let c = s[i] otherwise "x"
        if c == "\\":
            set res to res + "\\\\"
        otherwise:
            if c == "\"":
                set res to res + "\\\""
            otherwise:
                if c == "\n":
                    set res to res + "\\n"
                otherwise:
                    if c == "\t":
                        set res to res + "\\t"
                    otherwise:
                        set res to res + c
        set i to i + 1
    set res to res + "\""
    return res

# ── name helpers ────────────────────────────────────────────────────────

action c_has_dot(name):
    let len = length of name
    let i = 0
    let found = 0
    while i < len bounded 1000:
        if (name[i] otherwise "x") == ".":
            set found to 1
        set i to i + 1
    return found

# The part before the first dot: a capability family, or a plain name.
action name_head(name):
    let len = length of name
    let i = 0
    let out = ""
    let done = 0
    while i < len and done == 0 bounded 1000:
        let c = name[i] otherwise "x"
        if c == ".":
            set done to 1
        otherwise:
            set out to out + c
        set i to i + 1
    return out

# The part after the first dot: a capability operation.
action name_tail(name):
    let len = length of name
    let i = 0
    let out = ""
    let seen = 0
    while i < len bounded 1000:
        let c = name[i] otherwise "x"
        if seen == 1:
            set out to out + c
        if c == "." and seen == 0:
            set seen to 1
        set i to i + 1
    return out

# A capitalised call is a record constructor: Token(..), AstNode(..).
action is_record_name(name):
    let len = length of name
    if len == 0:
        return 0
    let c = name[0] otherwise "?"
    if c >= "A" and c <= "Z":
        return 1
    return 0

# ── expressions ─────────────────────────────────────────────────────────

action emit_bin_op(op, l, r):
    if op == "+":
        return "kz_add(" + l + ", " + r + ")"
    if op == "-":
        return "kz_sub(" + l + ", " + r + ")"
    if op == "*":
        return "kz_mul(" + l + ", " + r + ")"
    if op == "/":
        return "kz_div(" + l + ", " + r + ")"
    if op == "&":
        return "kz_band(" + l + ", " + r + ")"
    if op == "|":
        return "kz_bor(" + l + ", " + r + ")"
    if op == "^":
        return "kz_bxor(" + l + ", " + r + ")"
    if op == "<<":
        return "kz_shl(" + l + ", " + r + ")"
    if op == ">>":
        return "kz_shr(" + l + ", " + r + ")"
    if op == "%":
        return "kz_mod(" + l + ", " + r + ")"
    if op == "==":
        return "kz_eq(" + l + ", " + r + ")"
    if op == "!=":
        return "kz_ne(" + l + ", " + r + ")"
    if op == "<":
        return "kz_lt(" + l + ", " + r + ")"
    if op == "<=":
        return "kz_le(" + l + ", " + r + ")"
    if op == ">":
        return "kz_gt(" + l + ", " + r + ")"
    if op == ">=":
        return "kz_ge(" + l + ", " + r + ")"
    if op == "and":
        return "kz_and(" + l + ", " + r + ")"
    if op == "or":
        return "kz_or(" + l + ", " + r + ")"
    return "kz_nil()"

# An inline fallback. Division, modulo and indexing lower to the phase 2
# runtime helpers, which take the fallback value eagerly so the operand is
# evaluated exactly once. Any other fallback (a capability read) has no native
# failure path, so the inner expression is emitted as it is.
action emit_c_fallback(node: AstNode):
    recursion bounded 200
    ensures length of result >= 0
    let inner = child_at(node, 0)
    let fb = child_at(node, 1)
    let fb_s = emit_c_expr(fb)
    if inner.kind == "BIN":
        if inner.name == "/":
            return "kz_fb_div(" + emit_c_expr(child_at(inner, 0)) + ", " + emit_c_expr(child_at(inner, 1)) + ", " + fb_s + ")"
        if inner.name == "%":
            return "kz_fb_mod(" + emit_c_expr(child_at(inner, 0)) + ", " + emit_c_expr(child_at(inner, 1)) + ", " + fb_s + ")"
    if inner.kind == "INDEX":
        return "kz_fb_index(" + emit_c_expr(child_at(inner, 0)) + ", " + emit_c_expr(child_at(inner, 1)) + ", " + fb_s + ")"
    # An empty ring buffer is the receive's failure: the fallback is the value
    # the program named, and it is the only value read when the channel is empty.
    if inner.kind == "RECEIVE":
        return "kz_chan_recv_or(" + emit_c_expr(child_at(inner, 0)) + ", " + fb_s + ")"
    return emit_c_expr(inner)

action emit_c_args(args):
    recursion bounded 200
    let out = ""
    let first = 1
    for each a in args:
        if first == 0:
            set out to out + ", "
        if a.kind == "NAMED_ARG":
            set out to out + emit_c_expr(child_at(a, 0))
        otherwise:
            set out to out + emit_c_expr(a)
        set first to 0
    return out

# The key table a record constructor reads: the field name for a named
# argument, NULL for a positional one.
action emit_c_keys(args):
    recursion bounded 200
    let out = ""
    let first = 1
    for each a in args:
        if first == 0:
            set out to out + ", "
        if a.kind == "NAMED_ARG":
            set out to out + escape_c_str(a.name)
        otherwise:
            set out to out + "NULL"
        set first to 0
    return out

action nth_arg(args, n):
    recursion bounded 200
    if (length of args) <= n:
        return "kz_nil()"
    let holder = make_node("ARGS", "", "", 0, args, 0)
    let a = child_at(holder, n)
    if a.kind == "NAMED_ARG":
        return emit_c_expr(child_at(a, 0))
    return emit_c_expr(a)

action two_args(args):
    recursion bounded 200
    return nth_arg(args, 0) + ", " + nth_arg(args, 1)

action emit_c_call(node: AstNode):
    recursion bounded 200
    let name = node.name
    let args = node.children
    let cnt = length of args
    let arg_str = emit_c_args(args)

    # 1. Record construction.
    if is_record_name(name) == 1:
        if cnt == 0:
            return "kz_record_new_" + sanitize_c_id(name) + "(0, NULL, NULL)"
        return "kz_record_new_" + sanitize_c_id(name) + "(" + cnt + ", (KzValue[]){ " + arg_str + " }, (const char*[]){ " + emit_c_keys(args) + " })"

    # 2. Effects and geometry expressed as family.operation.
    if c_has_dot(name) == 1:
        let head = name_head(name)
        let tail = name_tail(name)
        if head == "log":
            return "kz_builtin_log(" + nth_arg(args, 0) + ")"
        if head == "alert":
            return "kz_builtin_alert(" + nth_arg(args, 0) + ")"
        if head == "geo":
            if tail == "distance":
                return "kz_geo_distance(" + two_args(args) + ")"
            if tail == "slant_distance":
                return "kz_geo_slant_distance(" + two_args(args) + ")"
            if tail == "bearing_from":
                return "kz_geo_bearing_from(" + two_args(args) + ")"
            if tail == "bearing_of":
                return "kz_geo_bearing_of(" + nth_arg(args, 0) + ")"
        let arr = "NULL"
        if cnt != 0:
            set arr to "(KzValue[]){ " + arg_str + " }"
        return "kz_cap_call(" + escape_c_str(head) + ", " + escape_c_str(tail) + ", " + cnt + ", " + arr + ")"

    # 3. Phase 13: a bounded channel, and a task handle join.
    if name == "channel":
        return "kz_chan_new(" + nth_arg(args, 0) + ")"
    if name == "http_fetch":
        return "kz_http_request(" + nth_arg(args, 0) + ", " + nth_arg(args, 1) + ", " + nth_arg(args, 2) + ", " + nth_arg(args, 3) + ", " + nth_arg(args, 4) + ")"

    # 4. Pure builtins.
    if name == "link_lost":
        return "kz_bool(false)"
    if name == "code":
        return "kz_code(" + nth_arg(args, 0) + ")"
    if name == "character":
        return "kz_character(" + nth_arg(args, 0) + ")"
    if name == "sin":
        return "kz_math_sin(" + nth_arg(args, 0) + ")"
    if name == "cos":
        return "kz_math_cos(" + nth_arg(args, 0) + ")"
    if name == "sqrt":
        return "kz_math_sqrt(" + nth_arg(args, 0) + ")"
    if name == "atan2":
        return "kz_math_atan2(" + two_args(args) + ")"
    if name == "vector":
        return "kz_point(" + nth_arg(args, 0) + ", " + nth_arg(args, 1) + ", " + nth_arg(args, 2) + ")"
    if name == "min" or name == "max" or name == "abs" or name == "floor" or name == "ceil" or name == "round":
        return "kz_unavailable(" + escape_c_str(name) + ")"

    # 4. Phase 12 tensor builtins. Each argument is evaluated exactly once by the
    #    call expression it is embedded in.
    if name == "tensor":
        return "kz_tensor_wrap(kz_tensor_make(" + nth_arg(args, 0) + ", " + nth_arg(args, 1) + "))"
    if name == "zeros":
        return "kz_tensor_wrap(kz_tensor_zeros_of(" + nth_arg(args, 0) + "))"
    if name == "matmul":
        return "kz_tensor_wrap(kaze_tensor_matmul(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + "))"
    if name == "matmul_t":
        return "kz_tensor_wrap(kaze_tensor_matmul_t(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + "))"
    if name == "add_bias":
        return "kz_tensor_wrap(kaze_tensor_add_bias(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + "))"
    if name == "tensor_add":
        return "kz_tensor_wrap(kaze_tensor_add(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + "))"
    if name == "tensor_sub":
        return "kz_tensor_wrap(kaze_tensor_sub(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + "))"
    if name == "tensor_mul":
        return "kz_tensor_wrap(kaze_tensor_mul(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + "))"
    if name == "tensor_div":
        return "kz_tensor_wrap(kaze_tensor_div(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + "))"
    if name == "transpose":
        return "kz_tensor_wrap(kaze_tensor_transpose(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", 0, 1))"
    if name == "reshape":
        return "kz_tensor_wrap(kz_tensor_reshape_of(" + tensor_unwrap(child_at(node, 0)) + ", " + nth_arg(args, 1) + "))"
    if name == "softmax":
        return "kz_tensor_wrap(kaze_tensor_softmax(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + "))"
    if name == "gelu":
        return "kz_tensor_wrap(kaze_tensor_gelu(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + "))"
    if name == "silu":
        return "kz_tensor_wrap(kaze_tensor_silu(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + "))"
    if name == "relu":
        return "kz_tensor_wrap(kaze_tensor_relu(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + "))"
    if name == "rms_norm":
        return "kz_tensor_wrap(kaze_tensor_rms_norm(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + ", " + tensor_float(child_at(node, 2)) + "))"
    if name == "layer_norm":
        return "kz_tensor_wrap(kaze_tensor_layer_norm(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + ", " + tensor_unwrap(child_at(node, 1)) + ", " + tensor_unwrap(child_at(node, 2)) + ", " + tensor_float(child_at(node, 3)) + "))"
    if name == "tensor_sum":
        return "kz_tensor_wrap(kaze_tensor_sum_last(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + "))"
    if name == "tensor_mean":
        return "kz_tensor_wrap(kaze_tensor_mean_last(&kz_arena, " + tensor_unwrap(child_at(node, 0)) + "))"
    if name == "argmax":
        return "kz_num((kaze_float_t)kaze_tensor_argmax_last(" + tensor_unwrap(child_at(node, 0)) + "))"
    if name == "tensor_get":
        return "kz_num(kaze_tensor_get(" + tensor_unwrap(child_at(node, 0)) + ", kz_i64(" + nth_arg(args, 1) + ")))"
    if name == "tensor_shape":
        return "kz_tensor_shape_value(" + tensor_unwrap(child_at(node, 0)) + ")"
    if name == "cli_text":
        return "kz_cli_text(" + nth_arg(args, 0) + ", " + nth_arg(args, 1) + ")"
    if name == "model_open":
        return "kz_model_wrap(kaze_llama_open(kz_text_cstr(" + nth_arg(args, 0) + ")))"
    if name == "model_forward":
        return "kz_model_forward_value(" + nth_arg(args, 0) + ", " + nth_arg(args, 1) + ")"

    # 5. A routine written in this program.
    return "kaze_fn_" + sanitize_c_id(name) + "(" + arg_str + ")"

action is_plain_integer(t: string) -> num:
    # Digits only (an optional leading minus): no dot, no exponent.
    if t == "":
        return 0
    let i = 0
    let n = length of t
    while i < n bounded 64:
        let c = t[i] otherwise "?"
        if c == "-" and i == 0:
            set i to i + 1
        otherwise:
            if c < "0" or c > "9":
                return 0
            set i to i + 1
    return 1

action emit_c_expr(node: AstNode):
    recursion bounded 200
    let k = node.kind

    if k == "NUM":
        # An angle literal is folded to radians on the way out, the same
        # lowering the reference engine applies, so sin/cos agree.
        if node.name == "degrees":
            return "kz_math_to_radians(kz_num(" + node.val_str + "))"
        if is_plain_integer(node.val_str) == 1:
            # INT64_C-style portability without an integer literal: 3300000000 is
            # an int on a 64-bit host and does not fit one on a 32-bit target.
            return "kz_num((kaze_float_t)" + node.val_str + ")"
        return "kz_num(" + node.val_str + ")"
    if k == "STR":
        return "kz_str(" + escape_c_str(node.val_str) + ")"
    if k == "BOOL":
        return "kz_bool(" + node.val_str + ")"
    if k == "TELEMETRY":
        # A bare telemetry word that no declaration shadows: a capability read.
        return "kz_cap_get(" + escape_c_str(node.val_str) + ", " + escape_c_str(node.name) + ")"
    if k == "IDENT":
        # A declared name: parameter, local, or record field. Telemetry words that
        # no declaration shadows were already rewritten to TELEMETRY above.
        return sanitize_c_id(node.name)
    if k == "LEN":
        return "kz_len(" + emit_c_expr(child_at(node, 0)) + ")"
    if k == "FIELD":
        return "kz_get_field(" + emit_c_expr(child_at(node, 0)) + ", " + escape_c_str(node.name) + ")"
    if k == "INDEX":
        return "kz_index(" + emit_c_expr(child_at(node, 0)) + ", " + emit_c_expr(child_at(node, 1)) + ")"
    if k == "BIN":
        if node.name == "not":
            return "kz_not(" + emit_c_expr(child_at(node, 0)) + ")"
        return emit_bin_op(node.name, emit_c_expr(child_at(node, 0)), emit_c_expr(child_at(node, 1)))
    if k == "FALLBACK":
        return emit_c_fallback(node)
    if k == "IN_UNIT":
        if node.name == "radians":
            return "kz_math_to_radians(" + emit_c_expr(child_at(node, 0)) + ")"
        return "kz_math_to_degrees(" + emit_c_expr(child_at(node, 0)) + ")"
    if k == "LIST":
        let items = node.children
        let cnt = length of items
        if cnt == 0:
            return "kz_list_new(0)"
        return "kz_list_from(" + cnt + ", (KzValue[]){ " + emit_c_args(items) + " })"
    # A receive with no fallback in reach: the checker has already refused the
    # unguarded spelling, so this is the value of an unreadable empty read.
    if k == "RECEIVE":
        return "kz_chan_recv_or(" + emit_c_expr(child_at(node, 0)) + ", kz_nil())"
    # join <task> as a value.
    if k == "JOIN":
        return "kz_fiber_join(" + emit_c_expr(child_at(node, 0)) + ")"
    if k == "CALL":
        return emit_c_call(node)
    return "kz_nil()"

# ── phase 13: the fiber body transform ─────────────────────────────────
#
# A fiber may suspend, and the runtime has no C stacks to suspend: a fiber is a
# stackless coroutine. The emitter therefore makes one step function per fiber
# whose locals live in the task's frame instead of on the C stack, and a yield
# spills every local, records the resume line and returns to the scheduler.
#
# The transform stays small because only statements can yield: a body is still
# one function, and one label per yield line is enough because Kaze puts one
# statement on a line. Loop counters are hoisted with the locals, because a
# resume jumps back into the middle of a loop.

record EmitFx:
    fiber: num
    slots: list
    guards: list

action fx_plain():
    return EmitFx(fiber: 0, slots: [], guards: [])

action slot_of(slots, name) -> num:
    let i = 0
    let len = length of slots
    while i < len bounded 512:
        if (slots[i] otherwise "") == name:
            return i
        set i to i + 1
    return -1

action guard_of(guards, name) -> num:
    let i = 0
    let len = length of guards
    while i < len bounded 512:
        if (guards[i] otherwise "") == name:
            return i
        set i to i + 1
    return -1

# Locals in slot order: parameters first (the spawn copies the call's arguments
# into these slots), then every binding the body introduces.
action collect_bindings(n: AstNode, out, depth) -> list:
    recursion bounded 64
    let acc = out
    if depth < 60:
        let nm = ""
        if n.kind == "LET" or n.kind == "SET" or n.kind == "FOR_EACH":
            set nm to n.name
        if n.kind == "SPAWN":
            set nm to n.val_str
        if nm != "" and slot_of(acc, nm) < 0:
            set acc to acc + [nm]
        for each c in n.children:
            set acc to collect_bindings(c, acc, depth + 1)
    return acc

action collect_guards(n: AstNode, out, depth) -> list:
    recursion bounded 64
    let acc = out
    if depth < 60:
        if n.kind == "WHILE":
            set acc to acc + ["_kz_loop_l" + n.line]
        for each c in n.children:
            set acc to collect_guards(c, acc, depth + 1)
    return acc

action collect_yield_lines(n: AstNode, out, depth) -> list:
    recursion bounded 64
    let acc = out
    if depth < 60:
        if n.kind == "YIELD" and slot_of(acc, n.line) < 0:
            set acc to acc + [n.line]
        for each c in n.children:
            set acc to collect_yield_lines(c, acc, depth + 1)
    return acc

# Fill the hoisted locals from the task's frame at step entry.
action fx_restore(fx: EmitFx, ind) -> string:
    let out = ""
    if fx.fiber == 0:
        return out
    for each nm in fx.slots:
        set out to out + ind + "KzValue " + sanitize_c_id(nm) + " = _kz_task->slots[" + slot_of(fx.slots, nm) + "];\n"
    for each g in fx.guards:
        set out to out + ind + "long " + g + " = _kz_task->guards[" + guard_of(fx.guards, g) + "];\n"
    return out

# Spill them back before handing the task to the scheduler.
action fx_spill(fx: EmitFx, ind) -> string:
    let out = ""
    if fx.fiber == 0:
        return out
    for each nm in fx.slots:
        set out to out + ind + "_kz_task->slots[" + slot_of(fx.slots, nm) + "] = " + sanitize_c_id(nm) + ";\n"
    for each g in fx.guards:
        set out to out + ind + "_kz_task->guards[" + guard_of(fx.guards, g) + "] = " + g + ";\n"
    return out

# ── statements ──────────────────────────────────────────────────────────

action emit_c_stmt(stmt: AstNode, ind, fx: EmitFx):
    let body = emit_c_stmt_inner(stmt, ind, fx)
    if stmt.line > 0:
        return "#line " + stmt.line + "\n" + body
    return body

action emit_c_stmt_inner(stmt: AstNode, ind, fx: EmitFx):
    recursion bounded 200
    let k = stmt.kind

    if k == "LET":
        if fx.fiber == 1:
            return ind + sanitize_c_id(stmt.name) + " = " + emit_c_expr(child_at(stmt, 0)) + ";\n"
        return ind + "KzValue " + sanitize_c_id(stmt.name) + " = " + emit_c_expr(child_at(stmt, 0)) + ";\n"

    if k == "SET":
        return ind + sanitize_c_id(stmt.name) + " = " + emit_c_expr(child_at(stmt, 0)) + ";\n"

    if k == "RETURN":
        if fx.fiber == 1:
            if (length of stmt.children) > 0:
                return ind + "_kz_task->ret = " + emit_c_expr(child_at(stmt, 0)) + "; return 0;\n"
            return ind + "_kz_task->ret = kz_nil(); return 0;\n"
        if (length of stmt.children) > 0:
            return ind + "return " + emit_c_expr(child_at(stmt, 0)) + ";\n"
        return ind + "return kz_nil();\n"

    if k == "RETURN_CHECKED":
        # A return site in a routine with ensures clauses: bind, check, return.
        let out = ind + "KzValue _kz_ret = " + emit_c_expr(child_at(stmt, 0)) + ";\n"
        let i = 1
        while i < (length of stmt.children) bounded 32:
            set out to out + ind + "if (!kz_is_truthy(" + emit_c_expr(child_at(stmt, i)) + ")) {\n"
            set out to out + ind + "    fprintf(stderr, \"E_KAZE_CONTRACT: an ensures clause is false for this result\\n\");\n"
            set out to out + ind + "    exit(70);\n"
            set out to out + ind + "}\n"
            set i to i + 1
        if fx.fiber == 1:
            set out to out + ind + "_kz_task->ret = _kz_ret; return 0;\n"
        otherwise:
            set out to out + ind + "return _kz_ret;\n"
        return out

    if k == "APPEND_OWN":
        # Proved append-only: kz_add_own does exactly what `+` would, but grows the
        # buffer in place when it is still the newest arena allocation.
        let target = sanitize_c_id(stmt.name)
        return ind + target + " = kz_add_own(" + target + ", " + emit_c_expr(child_at(stmt, 0)) + ");\n"

    if k == "EXPR":
        return ind + "(void)(" + emit_c_expr(child_at(stmt, 0)) + ");\n"

    if k == "APPEND_LIST_OWN":
        let target = sanitize_c_id(stmt.name)
        return ind + target + " = kz_list_append_own(" + target + ", " + emit_c_expr(child_at(stmt, 0)) + ");\n"

    # guard <expr>: an executed assertion. A false invariant stops the run.
    if k == "GUARD":
        if fx.fiber == 1:
            return ind + "if (!kz_is_truthy(" + emit_c_expr(child_at(stmt, 0)) + ")) { fprintf(stderr, \"E_KAZE_GUARD: the invariant at line " + stmt.line + " is false\\n\"); exit(70); }\n"
        return ind + "if (!kz_is_truthy(" + emit_c_expr(child_at(stmt, 0)) + ")) { fprintf(stderr, \"E_KAZE_GUARD: the invariant at line " + stmt.line + " is false\\n\"); return kz_nil(); }\n"

    if k == "IF":
        let cond = child_at(stmt, 0)
        let then_block = child_at(stmt, 1)
        let other_block = child_at(stmt, 2)
        let out = ind + "if (kz_is_truthy(" + emit_c_expr(cond) + ")) {\n"
        for each s in then_block.children:
            set out to out + emit_c_stmt(s, ind + "    ", fx)
        if (length of other_block.children) > 0:
            set out to out + ind + "} else {\n"
            for each s in other_block.children:
                set out to out + emit_c_stmt(s, ind + "    ", fx)
        set out to out + ind + "}\n"
        return out

    # while cond bounded n: a counter guard, so a stuck loop stops the run.
    if k == "WHILE":
        let cond = child_at(stmt, 0)
        let body = child_at(stmt, 1)
        let bound = child_at(stmt, 2)
        let guard_id = "_kz_loop_l" + stmt.line
        if fx.fiber == 1:
            let fout = ind + "while (kz_is_truthy(" + emit_c_expr(cond) + ")) {\n"
            if bound.val_str == "" or bound.val_str == "?":
                set fout to fout + ind + "    /* no ceiling declared */\n"
            otherwise:
                set fout to fout + ind + "    if (" + guard_id + " >= " + bound.val_str + "L) { fprintf(stderr, \"E_KAZE_LOOP_BOUND: loop exceeded its declared bound\\n\"); exit(70); }\n"
            set fout to fout + ind + "    " + guard_id + " = " + guard_id + " + 1;\n"
            for each s in body.children:
                set fout to fout + emit_c_stmt(s, ind + "    ", fx)
            set fout to fout + ind + "}\n"
            return fout
        let out = ind + "{ long " + guard_id + " = 0;\n"
        set out to out + ind + "    while (kz_is_truthy(" + emit_c_expr(cond) + ")) {\n"
        if bound.val_str == "" or bound.val_str == "?":
            set out to out + ind + "        /* no ceiling declared */\n"
        otherwise:
            set out to out + ind + "        if (" + guard_id + " >= " + bound.val_str + "L) { fprintf(stderr, \"E_KAZE_LOOP_BOUND: loop exceeded its declared bound\\n\"); return kz_nil(); }\n"
        set out to out + ind + "        " + guard_id + " = " + guard_id + " + 1;\n"
        for each s in body.children:
            set out to out + emit_c_stmt(s, ind + "        ", fx)
        set out to out + ind + "    }\n"
        set out to out + ind + "}\n"
        return out

    if k == "FOR_EACH":
        let list_e = child_at(stmt, 0)
        let body = child_at(stmt, 1)
        let out = ind + "{\n"
        set out to out + ind + "    KzValue _iter_target = " + emit_c_expr(list_e) + ";\n"
        set out to out + ind + "    if (_iter_target.kind == KZ_VAL_LIST && _iter_target.as.list) {\n"
        set out to out + ind + "        size_t _len = _iter_target.as.list->len;\n"
        set out to out + ind + "        for (size_t _i = 0; _i < _len; _i++) {\n"
        if fx.fiber == 1:
            set out to out + ind + "            " + sanitize_c_id(stmt.name) + " = _iter_target.as.list->items[_i];\n"
        otherwise:
            set out to out + ind + "            KzValue " + sanitize_c_id(stmt.name) + " = _iter_target.as.list->items[_i];\n"
        for each s in body.children:
            set out to out + emit_c_stmt(s, ind + "            ", fx)
        set out to out + ind + "        }\n"
        set out to out + ind + "    }\n"
        set out to out + ind + "}\n"
        return out

    # try: the recovery block runs only in the virtual machine today.
    if k == "TRY":
        let body = child_at(stmt, 0)
        let other = child_at(stmt, 1)
        let out = ind + "{\n"
        set out to out + ind + "    /* try block */\n"
        for each s in body.children:
            set out to out + emit_c_stmt(s, ind + "    ", fx)
        if (length of other.children) > 0:
            set out to out + ind + "    if (0) {\n"
            if stmt.name != "":
                if fx.fiber == 1:
                    set out to out + ind + "        " + sanitize_c_id(stmt.name) + " = kz_nil();\n"
                otherwise:
                    set out to out + ind + "        KzValue " + sanitize_c_id(stmt.name) + " = kz_nil(); (void)" + sanitize_c_id(stmt.name) + ";\n"
            for each s in other.children:
                set out to out + emit_c_stmt(s, ind + "        ", fx)
            set out to out + ind + "    }\n"
        set out to out + ind + "}\n"
        return out

    # ── phase 13: spawn / yield / join / cancel / send ─────────────────
    if k == "SPAWN":
        # The task handle is a value: a plain local in an action, a frame slot
        # in a fiber whose body spawns.
        let task = stmt.val_str
        let target = stmt.name
        let args_s = "kz_nil()"
        if (length of stmt.children) > 0:
            set args_s to "kz_list_from(" + (length of stmt.children) + ", (KzValue[]){ " + emit_c_args(stmt.children) + " })"
        let tmp = "_kz_args_" + stmt.line
        let call = "kz_fiber_spawn(&kz_step_" + sanitize_c_id(target) + ", " + tmp + ", kz_slots_" + sanitize_c_id(target) + "(), kz_guards_" + sanitize_c_id(target) + "(), " + escape_c_str(task) + ", kz_fuel_" + sanitize_c_id(target) + "())"
        let out = ind + "KzValue " + tmp + " = " + args_s + ";\n"
        if fx.fiber == 1:
            set out to out + ind + sanitize_c_id(task) + " = " + call + ";\n"
        otherwise:
            set out to out + ind + "KzValue " + sanitize_c_id(task) + " = " + call + ";\n"
            set out to out + ind + "(void)" + sanitize_c_id(task) + ";   /* a task may be fire-and-forget */\n"
        return out

    if k == "YIELD":
        # The one suspension point: spill the frame, remember the line, return
        # to the scheduler. The label below is where the next step resumes.
        if fx.fiber == 0:
            return ind + "/* yield outside a fiber: refused before this point */\n"
        let out = fx_spill(fx, ind)
        set out to out + ind + "_kz_task->pc = " + stmt.line + ";\n"
        set out to out + ind + "return 1;\n"
        set out to out + "kz_L" + stmt.line + ": ;\n"
        return out

    if k == "JOIN":
        return ind + "(void)kz_fiber_join(" + emit_c_expr(child_at(stmt, 0)) + ");\n"

    if k == "CANCEL":
        return ind + "kz_fiber_cancel_value(" + emit_c_expr(child_at(stmt, 0)) + ");\n"

    if k == "SEND":
        # Children are [value, channel], the order the source writes them in.
        return ind + "(void)kz_chan_send(" + emit_c_expr(child_at(stmt, 1)) + ", " + emit_c_expr(child_at(stmt, 0)) + ");\n"

    return ""

# ── items and program ───────────────────────────────────────────────────

action param_list(params_node: AstNode):
    recursion bounded 200
    let out = ""
    let first = 1
    for each p in params_node.children:
        if first == 0:
            set out to out + ", "
        set out to out + "KzValue " + sanitize_c_id(p.name)
        set first to 0
    if first == 1:
        return "void"
    return out

action find_named(items, name):
    recursion bounded 200
    let i = 0
    let len = length of items
    let found = none_node()
    while i < len bounded 1000000:
        let it = node_at(items, i)
        if it.name == name:
            set found to it
        set i to i + 1
    return found

action is_routine(item: AstNode):
    if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER":
        return 1
    return 0

action emit_record_ctor(item: AstNode):
    recursion bounded 200
    let id = sanitize_c_id(item.name)
    let fields = item.children
    let cnt = length of fields
    let out = "static inline KzValue kz_record_new_" + id + "(size_t n, KzValue* v, const char** k) {\n"
    set out to out + "    (void)n; (void)v; (void)k;\n"
    if cnt == 0:
        set out to out + "    return kz_record_create(" + escape_c_str(item.name) + ", 0, NULL, NULL);\n"
    otherwise:
        let keys = ""
        let i = 0
        while i < cnt bounded 1000:
            let f = node_at(fields, i)
            if i > 0:
                set keys to keys + ", "
            set keys to keys + escape_c_str(f.name)
            set i to i + 1
        set out to out + "    static const char* _keys[" + cnt + "] = { " + keys + " };\n"
        set out to out + "    KzValue _vals[" + cnt + "];\n"
        let j = 0
        while j < cnt bounded 1000:
            set out to out + "    _vals[" + j + "] = kz_nil();\n"
            set j to j + 1
        set out to out + "    for (size_t _i = 0; _i < n; _i++) kz_record_set(_vals, _keys, " + cnt + ", _i, k ? k[_i] : NULL, v[_i]);\n"
        set out to out + "    return kz_record_create(" + escape_c_str(item.name) + ", " + cnt + ", _keys, _vals);\n"
    set out to out + "}\n\n"
    return out

# Contracts at routine entry: a `requires` clause that is false for the arguments
# given is a refusal, not an assertion in the C sense -- the interpreter's
# E_KAZE_CONTRACT. Elision when every call site is proved comes later; correctness
# first.
action emit_requires(item: AstNode) -> string:
    recursion bounded 200
    let contracts = child_at(item, 1)
    let out = ""
    for each c in contracts.children:
        if c.kind == "CONTRACT" and c.name == "requires":
            let cond = child_at(c, 0)
            set out to out + "    if (!kz_is_truthy(" + emit_c_expr(cond) + ")) {\n"
            set out to out + "        fprintf(stderr, \"E_KAZE_CONTRACT: the requires clause at line " + c.line + " is false for these arguments\\n\");\n"
            set out to out + "        exit(70);\n"
            set out to out + "    }\n"
    return out

action emit_routine(item: AstNode):
    recursion bounded 200
    let id = sanitize_c_id(item.name)
    let params_node = child_at(item, 0)
    let body = child_at(item, 2)
    let l_tag = ""
    if item.line > 0:
        set l_tag = "#line " + item.line + "\n"
    let out = l_tag + "KZ_MAYBE_UNUSED static KzValue kaze_fn_" + id + "(" + param_list(params_node) + ") {\n"
    for each prm in params_node.children:
        set out to out + "    (void)" + sanitize_c_id(prm.name) + ";   /* a routine need not use every parameter */\n"
    set out to out + emit_requires(item)
    for each s in body.children:
        set out to out + emit_c_stmt(s, "    ", fx_plain())
    set out to out + "    return kz_nil();\n"
    set out to out + "}\n\n"
    return out

# A fiber lowers to two symbols: a step function the scheduler calls once per
# turn, and a tiny accessor carrying the fuel the routine declared.
action fiber_fuel(item: AstNode) -> string:
    let contracts = child_at(item, 1)
    let out = "0"
    for each c in contracts.children:
        if c.kind == "FUEL":
            set out to c.val_str
    return out

action fiber_ctx(item: AstNode) -> EmitFx:
    let params = child_at(item, 0)
    let body = child_at(item, 2)
    let slots = []
    for each p in params.children:
        set slots to slots + [p.name]
    set slots to collect_bindings(body, slots, 0)
    let guards = collect_guards(body, [], 0)
    return EmitFx(fiber: 1, slots: slots, guards: guards)

action emit_fiber(item: AstNode):
    recursion bounded 200
    let id = sanitize_c_id(item.name)
    let fx = fiber_ctx(item)
    let body = child_at(item, 2)
    let yields = collect_yield_lines(body, [], 0)
    let out = "/* fiber '" + item.name + "': one step per turn, resuming at a yield line */\n"
    set out to out + "static long kz_fuel_" + id + "(void) { return " + fiber_fuel(item) + "L; }\n"
    set out to out + "static size_t kz_slots_" + id + "(void) { return " + (length of fx.slots) + "; }\n"
    set out to out + "static size_t kz_guards_" + id + "(void) { return " + (length of fx.guards) + "; }\n"
    set out to out + "KZ_MAYBE_UNUSED static int kz_step_" + id + "(kz_fiber* _kz_task) {\n"
    set out to out + "    (void)_kz_task;\n"
    set out to out + fx_restore(fx, "    ")
    set out to out + emit_requires(item)
    set out to out + "    switch (_kz_task->pc) {\n"
    for each y in yields:
        set out to out + "        case " + y + ": goto kz_L" + y + ";\n"
    set out to out + "        default: break;\n"
    set out to out + "    }\n"
    for each s in body.children:
        set out to out + emit_c_stmt(s, "    ", fx)
    set out to out + "    _kz_task->ret = kz_nil();\n"
    set out to out + "    return 0;\n"
    set out to out + "}\n\n"
    return out

action emit_hook(item: AstNode):
    recursion bounded 200
    let body = child_at(item, 1)
    let kind = "when"
    if item.kind == "EVERY":
        set kind to "every"
    let out = "static KzValue kz_hook_" + kind + "_" + item.line + "(void) {\n"
    for each s in body.children:
        set out to out + emit_c_stmt(s, "    ", fx_plain())
    set out to out + "    return kz_nil();\n"
    set out to out + "}\n\n"
    return out

# The hook driver: `when` and `every` items fire on host ticks, the same way the
# interpreter drives them. The tick count comes from --ticks or KAZE_TICKS, and a
# predicate that needs telemetry the binary cannot supply is false, not assumed
# true, so hooks stay fail-closed.
action emit_hook_driver(items):
    recursion bounded 200
    let preds = []
    let calls = []
    for each item in items:
        if item.kind == "WHEN":
            let cond = child_at(item, 0)
            set preds to preds + ["        if (kz_is_truthy(" + emit_c_expr(cond) + ")) { kz_hook_when_" + item.line + "(); }\n"]
        if item.kind == "EVERY":
            set calls to calls + ["        kz_hook_every_" + item.line + "();\n"]
    let out = "/* --- Hook driver --- */\n"
    set out to out + "static int kz_ticks(int argc, char** argv) {\n"
    set out to out + "    for (int i = 1; i + 1 < argc; i++) {\n"
    set out to out + "        if (strcmp(argv[i], \"--ticks\") == 0) { long n = strtol(argv[i + 1], NULL, 10); if (n > 0) return (int)n; }\n"
    set out to out + "    }\n"
    set out to out + "    const char* env = getenv(\"KAZE_TICKS\");\n"
    set out to out + "    if (env && env[0]) { long n = strtol(env, NULL, 10); if (n > 0) return (int)n; }\n"
    set out to out + "    return 0;\n"
    set out to out + "}\n"
    set out to out + "static void kz_run_hooks(int argc, char** argv) {\n"
    set out to out + "    int ticks = kz_ticks(argc, argv);\n"
    set out to out + "    for (int t = 0; t < ticks; t++) {\n"
    for each p in preds:
        set out to out + p
    for each c in calls:
        set out to out + c
    set out to out + "    }\n"
    set out to out + "}\n\n"
    return out

action single_routine(items):
    # The interpreter's default entry is `main`, else the only action/check/filter
    # in the root file. Without this the native binary printed "no main entry"
    # and exited 0 where the VM actually ran the routine.
    let found = none_node()
    let count = 0
    for each item in items:
        if is_routine(item) == 1:
            set found to item
            set count to count + 1
    if count == 1:
        return found
    return none_node()

# The module's tasks bounded declaration, or 0 when it declares none.
action tasks_bound_of(config) -> string:
    let out = "0"
    for each c in config:
        if c.kind == "TASKS_BOUND":
            set out to c.val_str
    return out

action emit_c_entry(items, config, uses_tensors):
    recursion bounded 200
    let out = "/* --- Main Entry Point --- */\n"
    set out to out + "int main(int argc, char** argv) {\n"
    set out to out + "    /* One arena for the whole run; KAZE_ARENA_BYTES overrides the default. */\n"
    set out to out + "    if (!kaze_arena_init_heap(&kz_arena, kz_arena_bytes())) { fprintf(stderr, \"E_KAZE_OOM: cannot reserve the arena\\n\"); return 70; }\n"
    set out to out + "    atexit(kz_print_alloc_sites);   /* KAZE_ARENA_STATS=1 reports by function */\n"
    set out to out + "    atexit(kz_print_switch_stats);  /* KAZE_SWITCH_STATS=1 reports task switches */\n"
    if uses_tensors == 1:
        set out to out + "    kz_tensor_set_argv(argc, argv);\n"
    set out to out + "    kz_tasks_declared = " + tasks_bound_of(config) + "L;\n"
    let main_item = find_named(items, "main")
    if is_routine(main_item) == 0 and main_item.kind != "FIBER":
        set main_item to single_routine(items)
    if main_item.kind == "FIBER":
        # A fiber main is the root task: the scheduler runs it to completion,
        # and its return value is the program's result.
        set out to out + "    (void)argc; (void)argv;\n"
        set out to out + "    KzValue res = kz_fiber_run_root(&kz_step_" + sanitize_c_id(main_item.name) + ", kz_slots_" + sanitize_c_id(main_item.name) + "(), kz_guards_" + sanitize_c_id(main_item.name) + "(), kz_fuel_" + sanitize_c_id(main_item.name) + "());\n"
        set out to out + "    if (res.kind == KZ_VAL_NUM) {\n"
        set out to out + "        char numbuf[64];\n"
        set out to out + "        kz_format_number(numbuf, sizeof numbuf, res.as.number);\n"
        set out to out + "        printf(\"%s\\n\", numbuf);\n"
        set out to out + "    } else if (res.kind == KZ_VAL_STR) {\n"
        set out to out + "        printf(\"%s\\n\", res.as.str.data ? res.as.str.data : \"\");\n"
        set out to out + "    } else if (res.kind == KZ_VAL_BOOL) {\n"
        set out to out + "        printf(\"%s\\n\", res.as.boolean ? \"true\" : \"false\");\n"
        set out to out + "    }\n"
        set out to out + "    kz_run_hooks(argc, argv);\n"
    otherwise:
        if is_routine(main_item) == 0:
            set out to out + "    (void)argc; (void)argv;\n"
            set out to out + "    kz_run_hooks(argc, argv);\n"
            set out to out + "    printf(\"Kaze module loaded (no main entry)\\n\");\n"
        otherwise:
            let params_node = child_at(main_item, 0)
            let cnt = length of params_node.children
            if cnt == 0:
                set out to out + "    (void)argc; (void)argv;\n"
                set out to out + "    KzValue res = kaze_fn_" + sanitize_c_id(main_item.name) + "();\n"
            otherwise:
                let i = 0
                let call_args = ""
                while i < cnt bounded 1000:
                    let prm = child_at(params_node, i)
                    set out to out + "    KzValue arg_" + i + " = kz_param(" + escape_c_str(prm.val_str) + ", " + escape_c_str(prm.name) + ", " + escape_c_str(main_item.name) + ", kz_resolve_cli_arg(argc, argv, " + escape_c_str(prm.name) + ", " + i + "));\n"
                    if i > 0:
                        set call_args to call_args + ", "
                    set call_args to call_args + "arg_" + i
                    set i to i + 1
                set out to out + "    KzValue res = kaze_fn_" + sanitize_c_id(main_item.name) + "(" + call_args + ");\n"
            set out to out + "    if (res.kind == KZ_VAL_NUM) {\n"
            set out to out + "        char numbuf[64];\n"
            set out to out + "        kz_format_number(numbuf, sizeof numbuf, res.as.number);\n"
            set out to out + "        printf(\"%s\\n\", numbuf);\n"
            set out to out + "    } else if (res.kind == KZ_VAL_STR) {\n"
            set out to out + "        printf(\"%s\\n\", res.as.str.data ? res.as.str.data : \"\");\n"
            set out to out + "    } else if (res.kind == KZ_VAL_BOOL) {\n"
            set out to out + "        printf(\"%s\\n\", res.as.boolean ? \"true\" : \"false\");\n"
            set out to out + "    }\n"
            set out to out + "    kz_run_hooks(argc, argv);\n"
    set out to out + "    return 0;\n"
    set out to out + "}\n"
    return out

# ── ambient telemetry ──────────────────────────────────────────────────
# A bare telemetry word (battery, altitude, ...) is a capability read, but an
# emitter cannot tell it from a variable without name resolution -- `distance` is
# an ordinary local in this compiler's own source, and lowering every telemetry
# word blindly broke the compiler's own build. This pass resolves it once, on the
# tree, where each routine's declarations are known.

# ── in-place append ────────────────────────────────────────────────────
# `set out to out + piece` copies the whole string every time, which is where the
# translators' memory and time go. When a variable is only ever built this way and
# read once at the end, its buffer can be extended in place instead -- the runtime
# checks that the buffer is still the newest arena allocation before writing.

action count_ident(n: AstNode, v: string) -> num:
    recursion bounded 256
    let total = 0
    if n.kind == "IDENT" and n.name == v:
        set total to 1
    for each c in n.children:
        set total to total + count_ident(c, v)
    return total

action count_appends(n: AstNode, v: string) -> num:
    recursion bounded 256
    let total = 0
    if n.kind == "SET" and n.name == v:
        let rhs = child_at(n, 0)
        if rhs.kind == "BIN" and rhs.name == "+":
            let left = child_at(rhs, 0)
            # kz_add_own dispatches on the runtime type, so any operand shape is safe
            # here: the result is exactly what `+` would have produced.
            if left.kind == "IDENT" and left.name == v:
                set total to 1
    for each c in n.children:
        set total to total + count_appends(c, v)
    return total

action count_return_reads(n: AstNode, v: string) -> num:
    recursion bounded 256
    let total = 0
    if n.kind == "RETURN":
        set total to total + count_ident(n, v)
    for each c in n.children:
        set total to total + count_return_reads(c, v)
    return total

action string_lets(n: AstNode, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "LET":
        let rhs = child_at(n, 0)
        if rhs.kind == "STR" or rhs.kind == "LIST" or rhs.kind == "CALL" or (rhs.kind == "BIN" and rhs.name == "+"):
            set out to out + [n.name]
    for each c in n.children:
        set out to string_lets(c, out)
    return out

action append_plan(body: AstNode) -> list:
    recursion bounded 200
    # A name qualifies when every occurrence of it is either the left operand of an
    # append or inside a return: nothing else can hold its buffer.
    let out = []
    for each v in string_lets(body, []):
        let app = count_appends(body, v)
        if app > 0:
            let occ = count_ident(body, v)
            let ret = count_return_reads(body, v)
            if occ == app + ret:
                set out to out + [v]
    return out

action rewrite_appends(n: AstNode, plan: list) -> AstNode:
    recursion bounded 256
    if n.kind == "SET" and has_name(plan, n.name):
        let rhs = child_at(n, 0)
        if rhs.kind == "BIN" and rhs.name == "+":
            let left = child_at(rhs, 0)
            if left.kind == "IDENT" and left.name == n.name:
                return make_node("APPEND_OWN", n.name, n.val_str, n.val_num, [child_at(rhs, 1)], n.line)
    let kids = []
    for each c in n.children:
        set kids to kids + [rewrite_appends(c, plan)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

action has_name(names: list, w: string) -> num:
    recursion bounded 256
    for each n in names:
        if n == w:
            return 1
    return 0

action collect_declared(n: AstNode, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "LET" or n.kind == "SET" or n.kind == "FOR_EACH" or n.kind == "PARAM":
        if n.name != "" and has_name(acc, n.name) == 0:
            set out to out + [n.name]
    for each c in n.children:
        set out to collect_declared(c, out)
    return out

action relabel_telemetry(n: AstNode, declared: list) -> AstNode:
    recursion bounded 256
    if n.kind == "IDENT":
        if is_telemetry(n.name) == 1 and has_name(declared, n.name) == 0:
            return make_node("TELEMETRY", n.name, family_of_word(n.name), 0, [], n.line)
        return n
    let kids = []
    for each c in n.children:
        set kids to kids + [relabel_telemetry(c, declared)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

# ── contract elision ───────────────────────────────────────────────────
# A `requires` clause costs a branch per call. When every call site passes
# constants that satisfy it, the branch can go -- the reference rule
# (src/compiler.rs::requires_proved_everywhere), on the tree.

action num_of_text(t: string) -> num:
    recursion bounded 64
    let i = 0
    let n = length of t
    let sign = 1
    if n > 0 and (t[0] otherwise "?") == "-":
        set sign to -1
        set i to 1
    let whole = 0
    let seen_dot = 0
    let scale = 1
    while i < n bounded 64:
        let c = t[i] otherwise "?"
        if c == ".":
            set seen_dot to 1
        otherwise:
            if c >= "0" and c <= "9":
                let d = digit_value(c)
                if seen_dot == 1:
                    set scale to scale * 10
                    set whole to whole + (d / scale otherwise 0)
                otherwise:
                    set whole to whole * 10 + d
        set i to i + 1
    return sign * whole

action eval_const(n: AstNode, params: list, values: list) -> list:
    recursion bounded 256
    # [1, v] when this node is a constant under the bindings, else [0, 0].
    if n.kind == "NUM":
        return [1, num_of_text(n.val_str)]
    if n.kind == "IDENT":
        let i = 0
        for each p in params:
            if p == n.name and i < (length of values):
                return [1, values[i] otherwise 0]
            set i to i + 1
        return [0, 0]
    if n.kind == "BIN":
        let l = eval_const(child_at(n, 0), params, values)
        let r = eval_const(child_at(n, 1), params, values)
        if (l[0] otherwise 0) == 0 or (r[0] otherwise 0) == 0:
            return [0, 0]
        let a = l[1] otherwise 0
        let b = r[1] otherwise 0
        if n.name == ">=":
            if a >= b:
                return [1, 1]
            return [1, 0]
        if n.name == "<=":
            if a <= b:
                return [1, 1]
            return [1, 0]
        if n.name == ">":
            if a > b:
                return [1, 1]
            return [1, 0]
        if n.name == "<":
            if a < b:
                return [1, 1]
            return [1, 0]
        if n.name == "==":
            if a == b:
                return [1, 1]
            return [1, 0]
        if n.name == "!=":
            if a != b:
                return [1, 1]
            return [1, 0]
        return [0, 0]
    return [0, 0]

action calls_to(n: AstNode, name: string, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "CALL" and n.name == name:
        set out to out + [n.children]
    for each c in n.children:
        set out to calls_to(c, name, out)
    return out

action routine_param_names(params: AstNode) -> list:
    recursion bounded 64
    let out = []
    for each p in params.children:
        set out to out + [p.name]
    return out

action all_calls_proved(name: string, items: list, params: list, clauses: list) -> num:
    recursion bounded 200
    let sites = []
    for each it in items:
        set sites to calls_to(it, name, sites)
    if (length of sites) == 0:
        # Nothing in this program calls it; the host still might.
        return 0
    for each args in sites:
        if (length of args) != (length of params):
            return 0
        let values = []
        for each a in args:
            let v = eval_const(a, [], [])
            if (v[0] otherwise 0) == 0:
                return 0
            set values to values + [v[1] otherwise 0]
        for each cl in clauses:
            let c = eval_const(child_at(cl, 0), params, values)
            if (c[0] otherwise 0) == 0 or (c[1] otherwise 0) == 0:
                return 0
    return 1

action elidable_names(items: list) -> list:
    recursion bounded 200
    let out = []
    for each it in items:
        if it.kind == "ACTION" or it.kind == "CHECK" or it.kind == "FILTER":
            let params = routine_param_names(child_at(it, 0))
            let ctr = child_at(it, 1)
            let clauses = []
            for each c in ctr.children:
                if c.kind == "CONTRACT" and c.name == "requires":
                    set clauses to clauses + [c]
            if (length of clauses) > 0:
                if all_calls_proved(it.name, items, params, clauses) == 1:
                    set out to out + [it.name]
    return out

# ── ensures ────────────────────────────────────────────────────────────
# `ensures` speaks about `result`, so each return site binds the value first and
# checks the clause against it. The rewrite happens on the tree, where the
# routine's contracts and its return statements are both visible.


action subst_result(n: AstNode) -> AstNode:
    recursion bounded 256
    if n.kind == "IDENT" and n.name == "result":
        return make_node("IDENT", "_kz_ret", n.val_str, n.val_num, [], n.line)
    let kids = []
    for each c in n.children:
        set kids to kids + [subst_result(c)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

action returns_of(n: AstNode, acc: list) -> list:
    recursion bounded 256
    let out = acc
    if n.kind == "RETURN" and (length of n.children) > 0:
        set out to out + [child_at(n, 0)]
    for each c in n.children:
        set out to returns_of(c, out)
    return out

action ensures_proved(clauses: list, body: AstNode) -> num:
    recursion bounded 200
    # An ensures clause is elidable when every return value is a literal that
    # satisfies it: no branch is needed for a proof already in the tree.
    if (length of clauses) == 0:
        return 1
    let sites = returns_of(body, [])
    if (length of sites) == 0:
        return 1
    for each r in sites:
        let v = eval_const(r, [], [])
        if (v[0] otherwise 0) == 0:
            return 0
        let value = v[1] otherwise 0
        for each cl in clauses:
            let c = eval_const(cl, ["_kz_ret"], [value])
            if (c[0] otherwise 0) == 0 or (c[1] otherwise 0) == 0:
                return 0
    return 1

action drop_proved_ensures(contracts: AstNode, body: AstNode) -> AstNode:
    recursion bounded 64
    let clauses = []
    for each c in contracts.children:
        if c.kind == "CONTRACT" and c.name == "ensures":
            set clauses to clauses + [subst_result(child_at(c, 0))]
    if ensures_proved(clauses, body) == 0:
        return contracts
    let kept = []
    for each c in contracts.children:
        let proven = 0
        if c.kind == "CONTRACT" and c.name == "ensures":
            set proven to 1
        if proven == 0:
            set kept to kept + [c]
    return make_node("CONTRACTS", contracts.name, contracts.val_str, contracts.val_num, kept, contracts.line)

action ensures_clauses(contracts: AstNode) -> list:
    recursion bounded 64
    let out = []
    for each c in contracts.children:
        if c.kind == "CONTRACT" and c.name == "ensures":
            set out to out + [subst_result(child_at(c, 0))]
    return out

action rewrite_returns(n: AstNode, clauses: list) -> AstNode:
    recursion bounded 256
    if n.kind == "RETURN" and (length of clauses) > 0 and (length of n.children) > 0:
        let kids = [child_at(n, 0)]
        for each cl in clauses:
            set kids to kids + [cl]
        return make_node("RETURN_CHECKED", n.name, n.val_str, n.val_num, kids, n.line)
    let kids = []
    for each c in n.children:
        set kids to kids + [rewrite_returns(c, clauses)]
    return make_node(n.kind, n.name, n.val_str, n.val_num, kids, n.line)

action drop_proved_requires(contracts: AstNode, name: string, elided: list) -> AstNode:
    recursion bounded 64
    # A routine whose every call site passes constants satisfying its requires
    # clauses needs no entry branch at all.
    if has_name(elided, name) == 0:
        return contracts
    let kept = []
    for each c in contracts.children:
        let proven = 0
        if c.kind == "CONTRACT" and c.name == "requires":
            set proven to 1
        if proven == 0:
            set kept to kept + [c]
    return make_node("CONTRACTS", contracts.name, contracts.val_str, contracts.val_num, kept, contracts.line)

action mark_item(item: AstNode, elided: list) -> AstNode:
    recursion bounded 200
    if item.kind == "WHEN" or item.kind == "EVERY":
        let declared = collect_declared(child_at(item, 1), [])
        let cond = relabel_telemetry(child_at(item, 0), declared)
        let body = relabel_telemetry(child_at(item, 1), declared)
        return make_node(item.kind, item.name, item.val_str, item.val_num, [cond, body], item.line)
    if item.kind == "ACTION" or item.kind == "CHECK" or item.kind == "FILTER":
        let params = child_at(item, 0)
        let declared = collect_declared(params, [])
        set declared to collect_declared(child_at(item, 2), declared)
        let raw_contracts = drop_proved_requires(child_at(item, 1), item.name, elided)
        let contracts = relabel_telemetry(raw_contracts, declared)
        let checked = rewrite_returns(child_at(item, 2), ensures_clauses(drop_proved_ensures(raw_contracts, child_at(item, 2))))
        let plan = append_plan(checked)
        set checked to rewrite_appends(checked, plan)
        let body = relabel_telemetry(checked, declared)
        return make_node(item.kind, item.name, item.val_str, item.val_num, [params, contracts, body], item.line)
    return item

# ── Phase 12: tensor emission helpers ─────────────────────────────────
#
# Tensor values travel as KzValue numbers holding the tensor handle. A 64-bit
# host's user-space pointers fit exactly in a double's 53-bit integer range, and
# the 32-bit target is exact too, so no new KzValue variant is needed and the
# rest of the emitter is unchanged. Only the builtins below unwrap them.

# Returns [spec, binds, diags] for a call whose name is a tensor builtin.
action is_tensor_builtin(name: string) -> num:
    if name == "tensor" or name == "zeros":
        return 1
    if name == "matmul" or name == "matmul_t" or name == "add_bias":
        return 1
    if name == "tensor_add" or name == "tensor_sub" or name == "tensor_mul" or name == "tensor_div":
        return 1
    if name == "transpose" or name == "reshape":
        return 1
    if name == "softmax" or name == "rms_norm" or name == "layer_norm":
        return 1
    if name == "gelu" or name == "silu" or name == "relu":
        return 1
    if name == "tensor_sum" or name == "tensor_mean":
        return 1
    if name == "argmax" or name == "tensor_get" or name == "tensor_shape":
        return 1
    if name == "model_open" or name == "model_forward":
        return 1
    if name == "cli_text":
        return 1
    return 0

action tree_has_tensor_call(n: AstNode) -> num:
    recursion bounded 256
    if n.kind == "CALL":
        if is_tensor_builtin(n.name) == 1:
            return 1
    for each c in n.children:
        if tree_has_tensor_call(c) == 1:
            return 1
    return 0

action program_uses_tensors(items) -> num:
    recursion bounded 64
    for each item in items:
        if tree_has_tensor_call(item) == 1:
            return 1
    return 0

action tree_has_http_call(n: AstNode) -> num:
    recursion bounded 256
    if n.kind == "CALL" and n.name == "http_fetch":
        return 1
    for each c in n.children:
        if tree_has_http_call(c) == 1:
            return 1
    return 0

action program_uses_http(items) -> num:
    recursion bounded 64
    for each item in items:
        if tree_has_http_call(item) == 1:
            return 1
    return 0

action tensor_unwrap(e: AstNode) -> string:
    recursion bounded 64
    return "kz_tensor_unwrap(" + emit_c_expr(e) + ")"

action tensor_float(e: AstNode) -> string:
    recursion bounded 64
    return "kz_f32(" + emit_c_expr(e) + ")"

# Tensor values in the generated program. A tensor handle travels inside a
# KzValue number: 64-bit user pointers fit exactly in a double's 53-bit integer
# range (and 32-bit pointers are exact too). Only the tensor builtins unwrap one,
# so the rest of the emitter's value model is untouched.
action get_c_tensor_header():
    let h = ""
    set h to h + "#include \"kaze_tensor.h\"\n"
    set h to h + "\n/* --- Phase 12 tensor bridge --- */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline const char *kz_text_cstr(KzValue v) {\n"
    set h to h + "    return (v.kind == KZ_VAL_STR && v.as.str.data) ? v.as.str.data : \"\";\n"
    set h to h + "}\n"
    set h to h + "static int kz_argc_g = 0;\n"
    set h to h + "static char **kz_argv_g = NULL;\n"
    set h to h + "KZ_MAYBE_UNUSED static void kz_tensor_set_argv(int argc, char **argv) {\n"
    set h to h + "    kz_argc_g = argc; kz_argv_g = argv;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_cli_text(KzValue name, KzValue fallback) {\n"
    set h to h + "    const char *want = kz_text_cstr(name);\n"
    set h to h + "    size_t nlen = strlen(want);\n"
    set h to h + "    int i;\n"
    set h to h + "    for (i = 1; i + 1 < kz_argc_g; i++) {\n"
    set h to h + "        const char *a = kz_argv_g[i];\n"
    set h to h + "        if (strcmp(a, \"--arg\") == 0) {\n"
    set h to h + "            const char *v = kz_argv_g[i + 1];\n"
    set h to h + "            if (strncmp(v, want, nlen) == 0 && v[nlen] == '=')\n"
    set h to h + "                return kz_str(kz_str_alloc_copy(v + nlen + 1));\n"
    set h to h + "        }\n"
    set h to h + "        if (strncmp(a, \"--arg=\", 6) == 0) {\n"
    set h to h + "            const char *v = a + 6;\n"
    set h to h + "            if (strncmp(v, want, nlen) == 0 && v[nlen] == '=')\n"
    set h to h + "                return kz_str(kz_str_alloc_copy(v + nlen + 1));\n"
    set h to h + "        }\n"
    set h to h + "    }\n"
    set h to h + "    return fallback;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_tensor_wrap(kaze_tensor_t *t) {\n"
    set h to h + "    union { kaze_tensor_t *p; size_t u; } c;\n"
    set h to h + "    c.p = t; return kz_num((kaze_float_t)c.u);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline kaze_tensor_t *kz_tensor_unwrap(KzValue v) {\n"
    set h to h + "    union { kaze_tensor_t *p; size_t u; } c;\n"
    set h to h + "    c.u = (size_t)((v.kind == KZ_VAL_NUM) ? v.as.number : 0.0); return c.p;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline kaze_float_t kz_f32(KzValue v) {\n"
    set h to h + "    return (v.kind == KZ_VAL_NUM) ? v.as.number : 0.0;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline int64_t kz_i64(KzValue v) {\n"
    set h to h + "    return (int64_t)kz_f32(v);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static int kz_tensor_dims(KzValue shape, int64_t *dims) {\n"
    set h to h + "    int n, i;\n"
    set h to h + "    if (shape.kind != KZ_VAL_LIST || shape.as.list == NULL) return 0;\n"
    set h to h + "    n = (int)shape.as.list->len;\n"
    set h to h + "    if (n < 1 || n > KAZE_TENSOR_MAX_DIMS) return 0;\n"
    set h to h + "    for (i = 0; i < n; i++) {\n"
    set h to h + "        dims[i] = (int64_t)kz_f32(shape.as.list->items[i]);\n"
    set h to h + "        if (dims[i] < 1) return 0;\n"
    set h to h + "    }\n"
    set h to h + "    return n;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static kaze_tensor_t *kz_tensor_make(KzValue values, KzValue shape) {\n"
    set h to h + "    int64_t dims[KAZE_TENSOR_MAX_DIMS];\n"
    set h to h + "    int rank = kz_tensor_dims(shape, dims);\n"
    set h to h + "    kaze_tensor_t *t;\n"
    set h to h + "    int64_t i, n;\n"
    set h to h + "    if (rank == 0) return NULL;\n"
    set h to h + "    t = kaze_tensor_alloc(&kz_arena, KAZE_DTYPE_F32, rank, dims);\n"
    set h to h + "    if (t == NULL) return NULL;\n"
    set h to h + "    n = kaze_tensor_numel(t);\n"
    set h to h + "    for (i = 0; i < n; i++) {\n"
    set h to h + "        kaze_float_t v = 0.0f;\n"
    set h to h + "        if (values.kind == KZ_VAL_LIST && values.as.list != NULL && (size_t)i < values.as.list->len)\n"
    set h to h + "            v = kz_f32(values.as.list->items[i]);\n"
    set h to h + "        kaze_tensor_set(t, i, v);\n"
    set h to h + "    }\n"
    set h to h + "    return t;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static kaze_tensor_t *kz_tensor_zeros_of(KzValue shape) {\n"
    set h to h + "    int64_t dims[KAZE_TENSOR_MAX_DIMS];\n"
    set h to h + "    int rank = kz_tensor_dims(shape, dims);\n"
    set h to h + "    if (rank == 0) return NULL;\n"
    set h to h + "    return kaze_tensor_zeros(&kz_arena, KAZE_DTYPE_F32, rank, dims);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static kaze_tensor_t *kz_tensor_reshape_of(kaze_tensor_t *t, KzValue shape) {\n"
    set h to h + "    int64_t dims[KAZE_TENSOR_MAX_DIMS];\n"
    set h to h + "    int rank = kz_tensor_dims(shape, dims);\n"
    set h to h + "    if (t == NULL || rank == 0) return NULL;\n"
    set h to h + "    return kaze_tensor_reshape(&kz_arena, t, rank, dims);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_tensor_shape_value(kaze_tensor_t *t) {\n"
    set h to h + "    KzValue items[KAZE_TENSOR_MAX_DIMS];\n"
    set h to h + "    int32_t i, rank = (t == NULL) ? 0 : t->rank;\n"
    set h to h + "    for (i = 0; i < rank; i++) items[i] = kz_num((kaze_float_t)t->shape[i]);\n"
    set h to h + "    return kz_list_from((size_t)rank, items);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_model_wrap(kaze_llama_t *m) {\n"
    set h to h + "    union { kaze_llama_t *p; size_t u; } c;\n"
    set h to h + "    c.p = m; return kz_num((kaze_float_t)c.u);\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static inline kaze_llama_t *kz_model_unwrap(KzValue v) {\n"
    set h to h + "    union { kaze_llama_t *p; size_t u; } c;\n"
    set h to h + "    c.u = (size_t)kz_f32(v); return c.p;\n"
    set h to h + "}\n"
    set h to h + "KZ_MAYBE_UNUSED static KzValue kz_model_forward_value(KzValue model, KzValue tokens) {\n"
    set h to h + "    kaze_llama_t *m = kz_model_unwrap(model);\n"
    set h to h + "    int32_t ids[512];\n"
    set h to h + "    size_t n = 0, i, vocab;\n"
    set h to h + "    float *logits;\n"
    set h to h + "    kaze_tensor_t *t;\n"
    set h to h + "    int64_t dims[2];\n"
    set h to h + "    if (m == NULL || tokens.kind != KZ_VAL_LIST || tokens.as.list == NULL) return kz_nil();\n"
    set h to h + "    for (i = 0; i < tokens.as.list->len && i < 512; i++)\n"
    set h to h + "        ids[n++] = (int32_t)kz_f32(tokens.as.list->items[i]);\n"
    set h to h + "    vocab = kaze_llama_n_vocab(m);\n"
    set h to h + "    logits = (float *)kmalloc(&kz_arena, vocab * sizeof(float));\n"
    set h to h + "    if (logits == NULL) return kz_nil();\n"
    set h to h + "    if (!kaze_llama_forward(m, ids, n, 0, logits)) return kz_nil();\n"
    set h to h + "    dims[0] = 1; dims[1] = (int64_t)vocab;\n"
    set h to h + "    t = kaze_tensor_alloc(&kz_arena, KAZE_DTYPE_F32, 2, dims);\n"
    set h to h + "    if (t == NULL) return kz_nil();\n"
    set h to h + "    memcpy(t->data, logits, vocab * sizeof(float));\n"
    set h to h + "    return kz_tensor_wrap(t);\n"
    set h to h + "}\n"
    set h to h + "\n/* --- End Phase 12 tensor bridge --- */\n"
    return h

action emit_c_program(prog: AstNode):
    recursion bounded 200
    # Resolve bare telemetry words once, with each routine's declarations in hand.
    let raw_items = program_items(prog)
    let elided = elidable_names(raw_items)
    let items = []
    for each it in raw_items:
        set items to items + [mark_item(it, elided)]
    let out = get_c_runtime_header()
    let uses_tensors = program_uses_tensors(items)
    if uses_tensors == 1:
        set out to out + "\n" + get_c_tensor_header()
    # The HTTP backend is opt-in and lives in its own header so the compiler
    # and programs that never call it do not carry libcurl. It is appended
    # after the prelude because it uses KzValue and the arena string helpers.
    if program_uses_http(items) == 1:
        set out to out + "\n#include \"kaze_http.h\"\n"

    # 1. Forward declarations.
    set out to out + "/* --- Forward Declarations --- */\n"
    for each item in items:
        if item.kind == "RECORD":
            set out to out + "static inline KzValue kz_record_new_" + sanitize_c_id(item.name) + "(size_t n, KzValue* v, const char** k);\n"
        otherwise:
            if is_routine(item) == 1:
                let params_node = child_at(item, 0)
                set out to out + "KZ_MAYBE_UNUSED static KzValue kaze_fn_" + sanitize_c_id(item.name) + "(" + param_list(params_node) + ");\n"
            if item.kind == "FIBER":
                set out to out + "KZ_MAYBE_UNUSED static int kz_step_" + sanitize_c_id(item.name) + "(kz_fiber*);\n"
                set out to out + "static long kz_fuel_" + sanitize_c_id(item.name) + "(void);\n"
                set out to out + "static size_t kz_slots_" + sanitize_c_id(item.name) + "(void);\n"
                set out to out + "static size_t kz_guards_" + sanitize_c_id(item.name) + "(void);\n"

    # 2. Record constructors.
    set out to out + "\n/* --- Record Constructors --- */\n"
    for each item in items:
        if item.kind == "RECORD":
            set out to out + emit_record_ctor(item)

    # 3. Routines. A when/every hook has no native scheduler, so it is named in
    # a comment rather than dropped in silence.
    set out to out + "/* --- Routines --- */\n"
    for each item in items:
        if is_routine(item) == 1:
            set out to out + emit_routine(item)
        otherwise:
            if item.kind == "FIBER":
                set out to out + emit_fiber(item)
            if item.kind == "WHEN" or item.kind == "EVERY":
                set out to out + emit_hook(item)

    # 4. Hook driver, then the entry point.
    set out to out + "\n" + emit_hook_driver(items)
    set out to out + emit_c_entry(items, program_config(prog), uses_tensors)
    return out
