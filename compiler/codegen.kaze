    return h

action sanitize_c_id(name):
    if name == "auto" or name == "break" or name == "case" or name == "char" or name == "const" or name == "continue" or name == "default" or name == "do" or name == "double" or name == "else" or name == "enum" or name == "extern" or name == "float" or name == "for" or name == "goto" or name == "if" or name == "inline" or name == "int" or name == "long" or name == "register" or name == "restrict" or name == "return" or name == "short" or name == "signed" or name == "sizeof" or name == "static" or name == "struct" or name == "switch" or name == "typedef" or name == "union" or name == "unsigned" or name == "void" or name == "volatile" or name == "while" or name == "main":
        return "_kz_" + name
    return name

action escape_c_str(s):
    let res = "\""
    let len = length of s
    let i = 0
    while i < len:
        let c = s[i]
        if c == "\\":
            set res to res + "\\\\"
        otherwise:
            if c == "\"":
                set res to res + "\\\""
            otherwise:
                if c == "\n":
                    set res to res + "\\n"
                otherwise:
                    if c == "\t":
                        set res to res + "\\t"
                    otherwise:
                        set res to res + c
        set i to i + 1
    set res to res + "\""
    return res

action emit_c_expr(node):
    let k = node.kind

    if k == "NUM":
        return "kz_num(" + node.val_num + ")"

    if k == "STR":
        return "kz_str(" + escape_c_str(node.val_str) + ")"

    if k == "BOOL":
        return "kz_bool(" + node.val_str + ")"

    if k == "IDENT":
        return sanitize_c_id(node.name)

    if k == "LEN":
        let inner = node.children[0]
        return "kz_len(" + emit_c_expr(inner) + ")"

    if k == "FIELD":
        let base = node.children[0]
        return "kz_get_field(" + emit_c_expr(base) + ", \"" + node.name + "\")"

    if k == "INDEX":
        let coll = node.children[0]
        let idx = node.children[1]
        return "kz_index(" + emit_c_expr(coll) + ", " + emit_c_expr(idx) + ")"

    if k == "BIN":
        let left = node.children[0]
        let right = node.children[1]
        let op = node.name
        if op == "+":
            return "kz_add(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "-":
            return "kz_sub(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "*":
            return "kz_mul(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "/":
            return "kz_div(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "%":
            return "kz_mod(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "==":
            return "kz_eq(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "!=":
            return "kz_ne(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "<":
            return "kz_lt(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "<=":
            return "kz_le(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == ">":
            return "kz_gt(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == ">=":
            return "kz_ge(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "and":
            return "kz_and(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        if op == "or":
            return "kz_or(" + emit_c_expr(left) + ", " + emit_c_expr(right) + ")"
        return "kz_nil()"

    if k == "CALL":
        let fn_id = sanitize_c_id(node.name)
        let arg_strs = ""
        let is_first = 1
        for each a in node.children:
            if is_first == 0:
                set arg_strs to arg_strs + ", "
            # check if named field arg
            if a.kind == "BIN" and a.name == ":":
                let val_e = a.children[1]
                set arg_strs to arg_strs + emit_c_expr(val_e)
            otherwise:
                set arg_strs to arg_strs + emit_c_expr(a)
            set is_first to 0

        # Check if log call
        if node.name == "log":
            return "kz_builtin_log(" + arg_strs + ")"
        let n_name = node.name
        if length of n_name > 0:
            let first_char = n_name[0]
            if first_char >= "A" and first_char <= "Z":
                return "kz_record_new_" + fn_id + "(" + arg_strs + ")"
        return "kz_fn_" + fn_id + "(" + arg_strs + ")"

    if k == "LIST":
        let arg_strs = ""
        let is_first = 1
        for each item in node.children:
            if is_first == 0:
                set arg_strs to arg_strs + ", "
            set arg_strs to arg_strs + emit_c_expr(item)
            set is_first to 0
        let l_ch = node.children
        let cnt = length of l_ch
        if cnt == 0:
            return "kz_list_new(0)"
        return "kz_list_from(" + cnt + ", (KzValue[]){ " + arg_strs + " })"

    return "kz_nil()"

action emit_c_stmt(stmt, ind):
    let k = stmt.kind
    let out = ""

    if k == "LET":
        let v_id = sanitize_c_id(stmt.name)
        let val_e = stmt.children[0]
        set out to ind + "KzValue " + v_id + " = " + emit_c_expr(val_e) + ";\n"
        return out

    if k == "SET":
        let v_id = sanitize_c_id(stmt.name)
        let val_e = stmt.children[0]
        set out to ind + v_id + " = " + emit_c_expr(val_e) + ";\n"
        return out

    if k == "RETURN":
        let r_ch = stmt.children
        if (length of r_ch) > 0:
            let val_e = r_ch[0]
            set out to ind + "return " + emit_c_expr(val_e) + ";\n"
        otherwise:
            set out to ind + "return kz_nil();\n"
        return out

    if k == "EXPR":
        let val_e = stmt.children[0]
        set out to ind + "(void)(" + emit_c_expr(val_e) + ");\n"
        return out

    if k == "IF":
        let cond_e = stmt.children[0]
        let then_block = stmt.children[1]
        let other_block = stmt.children[2]
        set out to ind + "if (kz_is_truthy(" + emit_c_expr(cond_e) + ")) {\n"
        for each s in then_block.children:
            set out to out + emit_c_stmt(s, ind + "    ")
        let oth_ch = other_block.children
        if (length of oth_ch) > 0:
            set out to out + ind + "} else {\n"
            for each s in oth_ch:
                set out to out + emit_c_stmt(s, ind + "    ")
        set out to out + ind + "}\n"
        return out

    if k == "WHILE":
        let cond_e = stmt.children[0]
        let body_block = stmt.children[1]
        set out to ind + "while (kz_is_truthy(" + emit_c_expr(cond_e) + ")) {\n"
        for each s in body_block.children:
            set out to out + emit_c_stmt(s, ind + "    ")
        set out to out + ind + "}\n"
        return out

    if k == "FOR_EACH":
        let var_id = sanitize_c_id(stmt.name)
        let list_e = stmt.children[0]
        let body_block = stmt.children[1]
        set out to ind + "{\n"
        set out to out + ind + "    KzValue _iter_target = " + emit_c_expr(list_e) + ";\n"
        set out to out + ind + "    if (_iter_target.kind == KZ_VAL_LIST && _iter_target.as.list) {\n"
        set out to out + ind + "        size_t _len = _iter_target.as.list->len;\n"
        set out to out + ind + "        for (size_t _i = 0; _i < _len; _i++) {\n"
        set out to out + ind + "            KzValue " + var_id + " = _iter_target.as.list->items[_i];\n"
        for each s in body_block.children:
            set out to out + emit_c_stmt(s, ind + "            ")
        set out to out + ind + "        }\n"
        set out to out + ind + "    }\n"
        set out to out + ind + "}\n"
        return out

    return out

action emit_c_program(items):
    let out = get_c_runtime_header()

    # 1. Forward Declarations
    set out to out + "/* --- Forward Declarations --- */\n"
    for each item in items:
        if item.kind == "RECORD":
            let rec_id = sanitize_c_id(item.name)
            let params = ""
            let is_first = 1
            for each f in item.children:
                if is_first == 0:
                    set params to params + ", "
                set params to params + "KzValue " + sanitize_c_id(f.name)
                set is_first = 0
            if is_first == 1:
                set params = "void"
            set out to out + "static inline KzValue kz_record_new_" + rec_id + "(" + params + ");\n"
        otherwise:
            let fn_id = sanitize_c_id(item.name)
            let params_node = item.children[0]
            let params = ""
            let is_first = 1
            for each p in params_node.children:
                if is_first == 0:
                    set params to params + ", "
                set params to params + "KzValue " + sanitize_c_id(p.name)
                set is_first = 0
            if is_first == 1:
                set params = "void"
            set out to out + "static KzValue kz_fn_" + fn_id + "(" + params + ");\n"

    set out to out + "\n/* --- Record Constructors --- */\n"
    for each item in items:
        if item.kind == "RECORD":
            let rec_id = sanitize_c_id(item.name)
            let params = ""
            let keys = ""
            let vals = ""
            let is_first = 1
            for each f in item.children:
                if is_first == 0:
                    set params to params + ", "
                    set keys to keys + ", "
                    set vals to vals + ", "
                set params to params + "KzValue " + sanitize_c_id(f.name)
                set keys to keys + "\"" + f.name + "\""
                set vals to vals + sanitize_c_id(f.name)
                set is_first = 0
            if is_first == 1:
                set params = "void"
            set out to out + "static inline KzValue kz_record_new_" + rec_id + "(" + params + ") {\n"
            let r_fields = item.children
            let cnt = length of r_fields
            if cnt == 0:
                set out to out + "    return kz_record_create(\"" + item.name + "\", 0, NULL, NULL);\n"
            otherwise:
                set out to out + "    static const char* _keys[] = { " + keys + " };\n"
                set out to out + "    KzValue _vals[] = { " + vals + " };\n"
                set out to out + "    return kz_record_create(\"" + item.name + "\", " + cnt + ", _keys, _vals);\n"
            set out to out + "}\n\n"

    set out to out + "/* --- Routines --- */\n"
    for each item in items:
        if item.kind != "RECORD":
            let fn_id = sanitize_c_id(item.name)
            let params_node = item.children[0]
            let body_node = item.children[1]
            let params = ""
            let is_first = 1
            for each p in params_node.children:
                if is_first == 0:
                    set params to params + ", "
                set params to params + "KzValue " + sanitize_c_id(p.name)
                set is_first = 0
            if is_first == 1:
                set params = "void"
            set out to out + "static KzValue kz_fn_" + fn_id + "(" + params + ") {\n"
            for each s in body_node.children:
                set out to out + emit_c_stmt(s, "    ")
            set out to out + "    return kz_nil();\n"
            set out to out + "}\n\n"

    # Main Entry Point
    set out to out + "/* --- Main Entry Point --- */\n"
    set out to out + "int main(int argc, char** argv) {\n"
    let main_found = 0
    for each item in items:
        if item.name == "main":
            set main_found = 1
            let params_node = item.children[0]
            let p_ch = params_node.children
            let p_count = length of p_ch
            if p_count == 0:
                set out to out + "    (void)argc; (void)argv;\n"
                set out to out + "    KzValue res = kz_fn__kz_main();\n"
            otherwise:
                let idx = 0
                let call_args = ""
                for each p in params_node.children:
                    set out to out + "    KzValue arg_" + idx + " = kz_resolve_cli_arg(argc, argv, \"" + p.name + "\", " + idx + ");\n"
                    if idx > 0:
                        set call_args to call_args + ", "
                    set call_args to call_args + "arg_" + idx
                    set idx to idx + 1
                set out to out + "    KzValue res = kz_fn__kz_main(" + call_args + ");\n"
            set out to out + "    if (res.kind == KZ_VAL_NUM) {\n"
            set out to out + "        if (floor(res.as.number) == res.as.number) { printf(\"%.0f\\n\", res.as.number); }\n"
            set out to out + "        else { printf(\"%g\\n\", res.as.number); }\n"
            set out to out + "    } else if (res.kind == KZ_VAL_STR) {\n"
            set out to out + "        printf(\"%s\\n\", res.as.str ? res.as.str : \"\");\n"
            set out to out + "    } else if (res.kind == KZ_VAL_BOOL) {\n"
            set out to out + "        printf(\"%s\\n\", res.as.boolean ? \"true\" : \"false\");\n"
            set out to out + "    }\n"
    if main_found == 0:
        set out to out + "    (void)argc; (void)argv;\n"
        set out to out + "    printf(\"Kaze module loaded (no main entry)\\n\");\n"
    set out to out + "    return 0;\n"
    set out to out + "}\n"

    return out
