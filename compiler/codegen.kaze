    set h to h + "        return a;\n"
    set h to h + "    }\n"
    set h to h + "    return kz_add(a, b);\n"
    set h to h + "}\n"




    set h to h + "KZ_MAYBE_UNUSED static inline void kz_format_number(char* buf, size_t cap, double v) {\n"
    set h to h + "    if (isnan(v)) { snprintf(buf, cap, \"NaN\"); return; }\n"
    set h to h + "    if (isinf(v)) { snprintf(buf, cap, v > 0 ? \"inf\" : \"-inf\"); return; }\n"
    set h to h + "    if (floor(v) == v && fabs(v) < 1e17) { snprintf(buf, cap, \"%.0f\", v); return; }\n"
