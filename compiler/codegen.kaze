    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline const char* kz_to_string(KzValue v) {\n"
    set h to h + "    if (v.kind == KZ_VAL_POINT) {\n"
    set h to h + "        char pbuf[192], b1[40], b2[40], b3[40];\n"
