    set h to h + "    out[la + lb] = 0;\n"
    set h to h + "    return out;\n"
    set h to h + "}\n"

    set h to h + "KZ_MAYBE_UNUSED static inline char* kz_str_concat(const char* a, const char* b) {\n"
    set h to h + "    size_t la = a ? strlen(a) : 0;\n"
    set h to h + "    size_t lb = b ? strlen(b) : 0;\n"
    set h to h + "    char* out = (char*)kz_alloc(la + lb + 1);\n"
    set h to h + "    if (!out) return \"\";\n"
    set h to h + "    if (la) memcpy(out, a, la);\n"
    set h to h + "    if (lb) memcpy(out + la, b, lb);\n"
    set h to h + "    out[la + lb] = '\\0';\n"
    set h to h + "    return out;\n"
    set h to h + "}\n\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_add(KzValue a, KzValue b);\n"
    set h to h + "/* `v = v + x` where v is proved append-only. Same result as kz_add, but a text\n"
    set h to h + "   or list buffer that is still the newest arena allocation grows in place\n"
    set h to h + "   instead of being copied. Dispatch is by runtime type, so any operand is safe. */\n"
    set h to h + "KZ_MAYBE_UNUSED static inline KzValue kz_add_own(KzValue a, KzValue b) {\n"
    set h to h + "    if (a.kind == KZ_VAL_STR && b.kind == KZ_VAL_STR) {\n"
    set h to h + "        const char* s = a.as.str.data;\n"
    set h to h + "        size_t la = a.as.str.len, lb = b.as.str.len;\n"
