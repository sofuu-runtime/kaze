# tests/stdlib/sha512_test.kaze -- FIPS 180-4 SHA-512: the published vectors, the
# padding boundaries, a UTF-8 input, and a fixed-seed randomised run.
#
# Every expected digest below was computed independently with a standard SHA-512
# implementation and is quoted next to the reason the case earns a slot.

needs: log

use "./../../lib/sha512.kaze"

action expect(label, ok, failures) -> num:
    if ok:
        return failures
    log.info("FAIL " + label)
    return failures + 1

action a_repeated(n) -> text:
    let out = ""
    let i = 0
    while i < n bounded 100000:
        set out to out + "a"
        set i to i + 1
    return out

# The same text with position "at" replaced by "Z", so the length is unchanged and
# only the content differs.
action replace_at(t, at) -> text:
    let out = ""
    let i = 0
    let n = length of t
    while i < n bounded 100000:
        if i == at:
            set out to out + "Z"
        otherwise:
            set out to out + (t[i] otherwise "")
        set i to i + 1
    return out

# List equality in Kaze is identity, not content, so byte lists have to be compared
# element by element.
action same_bytes(a, b) -> bool:
    if (length of a) != (length of b):
        return false
    let i = 0
    let n = length of a
    while i < n bounded 100000:
        if (a[i] otherwise 0) != (b[i] otherwise 0):
            return false
        set i to i + 1
    return true

action all_bytes(digest) -> bool:
    for each b in digest:
        if b < 0 or b > 255:
            return false
    return true

action is_lower_hex(t) -> bool:
    if (length of t) != 128:
        return false
    for each c in t:
        let v = code(c) & 255
        let digit = v >= 48 and v <= 57
        let lower = v >= 97 and v <= 102
        if digit == false and lower == false:
            return false
    return true

action lcg_next(state) -> num:
    return (state * 1664525 + 1013904223) & 4294967295

# A pseudo-random lowercase text of length n, plus the advanced seed.
action random_text(seed, n) -> list:
    let out = ""
    let s = seed
    let i = 0
    while i < n bounded 100000:
        set s to lcg_next(s)
        set out to out + character(97 + ((s >> 8) % 26))
        set i to i + 1
    return [out, s]

action main() -> num:
    let failures = 0

    set failures to expect("empty message matches the FIPS 180-4 vector", sha512_hex("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", failures)
    set failures to expect("abc matches the FIPS 180-4 vector", sha512_hex("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", failures)

    let nist = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    set failures to expect("the 112-byte NIST message matches", sha512_hex(nist) == "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909", failures)

    let digest = sha512("abc")
    set failures to expect("sha512 returns 64 bytes", (length of digest) == 64, failures)
    set failures to expect("every digest byte is in 0..255", all_bytes(digest), failures)
    set failures to expect("sha512_hex returns 128 lowercase hex characters", is_lower_hex(sha512_hex("abc")), failures)
    # 0xdd first, 0x9f last: the byte list is the digest, not its hex form.
    set failures to expect("the digest is big-endian bytes, not hex text", (digest[0] otherwise 0) == 221 and (digest[63] otherwise 0) == 159, failures)

    # Padding boundaries. 111 bytes is the largest message whose length field still
    # fits in one block; 112 forces a second; 128 is an exact block.
    set failures to expect("111 bytes: the length field still fits one block", sha512_hex(a_repeated(111)) == "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2", failures)
    set failures to expect("112 bytes: the length field needs a second block", sha512_hex(a_repeated(112)) == "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca", failures)
    set failures to expect("127 bytes: length just before a block end", sha512_hex(a_repeated(127)) == "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502", failures)
    set failures to expect("128 bytes: an exact block plus the pad block", sha512_hex(a_repeated(128)) == "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321", failures)
    set failures to expect("129 bytes: one byte into a second block", sha512_hex(a_repeated(129)) == "4f681e0bd53cda4b5a2041cc8a06f2eabde44fb16c951fbd5b87702f07aeab611565b19c47fde30587177ebb852e3971bbd8d3fd30da18d71037dfbd98420429", failures)
    set failures to expect("1000 bytes: eight blocks through the schedule", sha512_hex(a_repeated(1000)) == "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97", failures)

    set failures to expect("one changed byte changes the digest", sha512_hex("abc") != sha512_hex("abd"), failures)
    # Kaze text is UTF-8 bytes, so a non-ASCII character occupies two of them.
    set failures to expect("a UTF-8 character is hashed as its two bytes", sha512_hex("é") == "9e2ad28633f24451bd4f3c1cb20586a21a44c3aeedbdc01b9cc8fa72917ea7bd689c82b8bf1fef89b911cf8cc46fa2c1ccc10087b2094fd4d3350ecd88526a2c", failures)
    # The byte-list entry point is what Ed25519 hashes with; it must agree with the
    # text one on the same bytes.
    set failures to expect("the byte and text entry points agree", same_bytes(sha512_of_bytes(sha512_text_bytes("é")), sha512("é")), failures)

    # Fixed-seed randomised run: lengths 1..41, printable text, one byte flipped.
    let seed = 20241124
    let bad_len = 0
    let unstable = 0
    let mutated_same = 0
    let i = 0
    while i < 24 bounded 100:
        let n = 1 + ((i * 7) % 41)
        let r = random_text(seed, n)
        let msg = r[0] otherwise ""
        set seed to r[1] otherwise 0
        let h = sha512_hex(msg)
        if (length of h) != 128:
            set bad_len to bad_len + 1
        if sha512_hex(msg) != h:
            set unstable to unstable + 1
        if sha512_hex(replace_at(msg, ((i * 13) % n) otherwise 0)) == h:
            set mutated_same to mutated_same + 1
        set i to i + 1
    set failures to expect("24 random texts all hash to 128 hex characters", bad_len == 0, failures)
    set failures to expect("hashing the same text twice gives the same digest", unstable == 0, failures)
    set failures to expect("a one-byte change changes every random digest", mutated_same == 0, failures)

    if failures == 0:
        log.info("OK sha512: 19 checks")
    return failures
