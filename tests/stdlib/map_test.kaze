# tests/stdlib/map_test.kaze -- the map library, including a 10,000-operation
# randomized run against a reference model built from plain lists.
needs: log

use "./../../lib/map.kaze"

action expect(label, ok, failures) -> num:
    if ok:
        return failures
    log.info("FAIL " + label)
    return failures + 1

# Reference model: a list of key/value pairs. Deliberately independent of the library.
action model_find(model, k) -> num:
    let i = 0 - 1
    for each pair in model:
        set i to i + 1
        if (pair[0] otherwise "") == k:
            return i
    return 0 - 1

action model_set(model, k, v) -> list:
    let at = model_find(model, k)
    let out = []
    let i = 0
    for each pair in model:
        if i == at:
            set out to out + [[k, v]]
        otherwise:
            set out to out + [pair]
        set i to i + 1
    if at < 0:
        set out to out + [[k, v]]
    return out

action model_delete(model, k) -> list:
    let out = []
    for each pair in model:
        if (pair[0] otherwise "") != k:
            set out to out + [pair]
    return out

action key_of(n) -> text:
    return "k" + n

action main() -> num:
    let failures = 0
    let m = map_new()
    set m to map_set(m, "alpha", 1)
    set m to map_set(m, "beta", 2)
    set m to map_set(m, "gamma", 3)
    set failures to expect("set and get", map_get(m, "beta") == 2, failures)
    set failures to expect("absent key reads 0", map_get(m, "delta") == 0, failures)
    set failures to expect("has distinguishes 0 from absent", map_has(m, "gamma") == 1 and map_has(m, "delta") == 0, failures)
    set failures to expect("size counts entries", map_size(m) == 3, failures)

    set m to map_set(m, "beta", 42)
    set failures to expect("set overwrites without growing", map_get(m, "beta") == 42 and map_size(m) == 3, failures)

    set m to map_delete(m, "beta")
    set failures to expect("delete removes the key", map_has(m, "beta") == 0 and map_size(m) == 2, failures)
    set failures to expect("delete keeps the others reachable", map_get(m, "alpha") == 1 and map_get(m, "gamma") == 3, failures)

    let big = map_new()
    let i = 0
    while i < 200 bounded 10000:
        set big to map_set(big, key_of(i), i * 2)
        set i to i + 1
    set failures to expect("200 inserts all land", map_size(big) == 200, failures)
    set failures to expect("the table grew", map_capacity(big) > 8, failures)
    let misses = 0
    let j = 0
    while j < 200 bounded 10000:
        if map_get(big, key_of(j)) != j * 2:
            set misses to misses + 1
        set j to j + 1
    set failures to expect("every key reads back after rehashing", misses == 0, failures)

    # ---- the gate: 10,000 randomized operations against the model ----------------
    let seed = 987654321
    let live = map_new()
    let model = []
    let k = 0
    let mismatches = 0
    while k < 10000 bounded 100000:
        set seed to ((seed * 1664525 + 1013904223) & 4294967295)
        let op = seed & 3
        let key = key_of((seed >> 7) % 64) otherwise 0
        let value = (seed >> 3) & 1023
        if op == 0 or op == 1:
            set live to map_set(live, key, value)
            set model to model_set(model, key, value)
        if op == 2:
            set live to map_delete(live, key)
            set model to model_delete(model, key)
        if map_size(live) != (length of model):
            set mismatches to mismatches + 1
        set k to k + 1
    set failures to expect("10,000 randomized operations keep the size in step", mismatches == 0, failures)
    let drift = 0
    for each pair in model:
        if map_get(live, pair[0] otherwise "") != (pair[1] otherwise 0):
            set drift to drift + 1
    set failures to expect("every modelled key still reads its value", drift == 0, failures)

    if failures == 0:
        log.info("OK map: 12 checks")
    return failures
