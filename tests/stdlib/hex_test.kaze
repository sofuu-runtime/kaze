# tests/stdlib/hex_test.kaze -- lib/hex.kaze against the published encoding rules
# and a fixed-seed round-trip property.
#
# The expected values are the canonical hexadecimal spellings (RFC 4648 section
# 10 for the alphabet, plus hand-computed byte values); nothing here is produced
# by the implementation under test. The 256-byte round trip and the seeded random
# round trips check the property that encode/decode are inverses over every byte
# value, including 0, which a text value cannot carry - that is why the decoder
# answers with a byte list.
needs: log

use "./../../lib/hex.kaze"

record Tally:
    failures: number
    checks: number

action expect(t: Tally, label: text, ok: bool) -> Tally:
    if ok:
        return Tally(failures: t.failures, checks: t.checks + 1)
    log.info("FAIL " + label)
    return Tally(failures: t.failures + 1, checks: t.checks + 1)

# Element-wise equality for byte lists. Kaze compares lists by identity, so the
# property checks need this rather than ==.
action same_bytes(a, b) -> bool:
    if (length of a) != (length of b):
        return false
    let i = 0
    let n = length of a
    while i < n bounded 1000000:
        if byte_at(a, i) != byte_at(b, i):
            return false
        set i to i + 1
    return true

action lcg_next(state) -> num:
    return (state * 1664525 + 1013904223) & 4294967295

action seed_bytes(seed, n) -> list:
    let out = []
    let cur = seed
    let i = 0
    while i < n bounded 1000000:
        set cur to lcg_next(cur)
        set out to out + [cur & 255]
        set i to i + 1
    return out

action main() -> num:
    # A nonzero failure count is a broken run, and the contract assertion turns
    # that into a nonzero exit status as well as the FAIL lines.
    ensures result == 0
    let t = Tally(failures: 0, checks: 0)

    # ---- encode: published spellings ---------------------------------------
    set t to expect(t, "empty text encodes empty", hex_encode("") == "")
    set t to expect(t, "f -> 66", hex_encode("f") == "66")
    set t to expect(t, "fo -> 666f", hex_encode("fo") == "666f")
    set t to expect(t, "foobar -> 666f6f626172", hex_encode("foobar") == "666f6f626172")
    set t to expect(t, "Hello, World! -> 48656c6c6f2c20576f726c6421", hex_encode("Hello, World!") == "48656c6c6f2c20576f726c6421")
    set t to expect(t, "UTF-8 bytes are encoded, not characters", hex_encode(character(195) + character(169)) == "c3a9")
    set t to expect(t, "output is lowercase", hex_encode("\n\t") == "0a09")

    # ---- encode: byte lists, including 0 ----------------------------------
    set t to expect(t, "byte list empty", hex_encode_bytes([]) == "")
    set t to expect(t, "zero byte encodes as 00", hex_encode_bytes([0]) == "00")
    set t to expect(t, "byte boundaries 0f/10/ff", hex_encode_bytes([15, 16, 255]) == "0f10ff")
    set t to expect(t, "byte list uses low eight bits", hex_encode_bytes([256, 0 - 1, 300]) == "00ff2c")
    let all = []
    let i = 0
    while i < 256 bounded 1000:
        set all to all + [i]
        set i to i + 1
    let all_hex = hex_encode_bytes(all)
    set t to expect(t, "all 256 bytes encode to 512 digits", (length of all_hex) == 512)
    set t to expect(t, "all 256 bytes start 00010203", hex_encoded_prefix(all_hex, 8) == "00010203")
    set t to expect(t, "all 256 bytes end fcfdfeff", hex_encoded_suffix(all_hex, 8) == "fcfdfeff")

    # ---- hex_encode_byte ---------------------------------------------------
    set t to expect(t, "hex_encode_byte 0", hex_encode_byte(0) == "00")
    set t to expect(t, "hex_encode_byte 15", hex_encode_byte(15) == "0f")
    set t to expect(t, "hex_encode_byte 16", hex_encode_byte(16) == "10")
    set t to expect(t, "hex_encode_byte 171", hex_encode_byte(171) == "ab")
    set t to expect(t, "hex_encode_byte 255", hex_encode_byte(255) == "ff")
    set t to expect(t, "hex_encode_byte negative is refused", hex_encode_byte(0 - 1) == "")
    set t to expect(t, "hex_encode_byte above 255 is refused", hex_encode_byte(256) == "")
    set t to expect(t, "hex_encode_byte fraction is refused", hex_encode_byte(3.5) == "")

    # ---- decode: canonical spellings --------------------------------------
    let e = hex_decode("")
    set t to expect(t, "empty decodes", e.ok and (length of e.bytes) == 0)
    set t to expect(t, "empty success has no error", e.err == "" and e.at == 0)
    let d1 = hex_decode("66")
    set t to expect(t, "66 decodes to [102]", d1.ok and same_bytes(d1.bytes, [102]))
    let d2 = hex_decode("666f6f626172")
    set t to expect(t, "foobar bytes", d2.ok and same_bytes(d2.bytes, [102, 111, 111, 98, 97, 114]))
    let d3 = hex_decode("00")
    set t to expect(t, "00 decodes to the zero byte", d3.ok and same_bytes(d3.bytes, [0]))
    let d4 = hex_decode("AABB")
    set t to expect(t, "uppercase is accepted", d4.ok and same_bytes(d4.bytes, [170, 187]))
    let d5 = hex_decode("aAbB")
    set t to expect(t, "mixed case is accepted", d5.ok and same_bytes(d5.bytes, [170, 187]))
    let d6 = hex_decode(all_hex)
    set t to expect(t, "all 256 bytes round-trip", d6.ok and same_bytes(d6.bytes, all))

    # ---- decode: malformed input ------------------------------------------
    let m1 = hex_decode("6")
    set t to expect(t, "odd length is E_HEX_LENGTH", (not m1.ok) and m1.err == "E_HEX_LENGTH" and m1.at == 1)
    let m2 = hex_decode("666")
    set t to expect(t, "odd length names the end", m2.err == "E_HEX_LENGTH" and m2.at == 3)
    let m3 = hex_decode("g")
    set t to expect(t, "length is checked before characters", m3.err == "E_HEX_LENGTH" and m3.at == 1)
    let m4 = hex_decode("gg")
    set t to expect(t, "gg is E_HEX_CHARACTER at 0", m4.err == "E_HEX_CHARACTER" and m4.at == 0)
    let m5 = hex_decode("6g")
    set t to expect(t, "6g is E_HEX_CHARACTER at 1", m5.err == "E_HEX_CHARACTER" and m5.at == 1)
    let m6 = hex_decode("66 6")
    set t to expect(t, "space is not skipped", m6.err == "E_HEX_CHARACTER" and m6.at == 2)
    let m7 = hex_decode("0x66")
    set t to expect(t, "0x prefix is not accepted", m7.err == "E_HEX_CHARACTER" and m7.at == 1)
    let m8 = hex_decode("66 0")
    set t to expect(t, "trailing space is refused", m8.err == "E_HEX_CHARACTER" and m8.at == 2)
    set t to expect(t, "a refused decode carries no bytes", (length of m4.bytes) == 0)

    # ---- round trips -------------------------------------------------------
    let cur = 424242
    let rounds = 0
    let bad = 0
    while rounds < 100 bounded 1000:
        set cur to lcg_next(cur)
        let n = cur & 63
        set cur to lcg_next(cur)
        let xs = seed_bytes(cur, n)
        let text = hex_encode_bytes(xs)
        let back = hex_decode(text)
        if (not back.ok) or (not same_bytes(back.bytes, xs)):
            set bad to bad + 1
        if (length of text) != n * 2:
            set bad to bad + 1
        set rounds to rounds + 1
    set t to expect(t, "100 seeded round trips are exact", bad == 0)
    set t to expect(t, "the round-trip loop ran 100 times", rounds == 100)

    # ---- hex_text_of_bytes -------------------------------------------------
    set t to expect(t, "printable bytes become text", hex_text_of_bytes([72, 105]) == "Hi")
    set t to expect(t, "the zero byte cannot become text", hex_text_of_bytes([0]) == "")
    set t to expect(t, "control bytes cannot become text", hex_text_of_bytes([10]) == "")
    set t to expect(t, "high bytes cannot become text", hex_text_of_bytes([255]) == "")

    if t.failures == 0:
        log.info("OK hex: " + t.checks + " checks")
    return t.failures

# Prefix/suffix helpers so the suite never indexes a string with an expression
# the checker cannot bound. Both are independent of the library under test.
action hex_encoded_prefix(t, n) -> text:
    let out = ""
    let i = 0
    while i < n and i < (length of t) bounded 1000:
        set out to out + (t[i] otherwise "")
        set i to i + 1
    return out

action hex_encoded_suffix(t, n) -> text:
    let out = ""
    let len = length of t
    let i = 0
    while i < n and i < len bounded 1000:
        set out to out + (t[len - n + i] otherwise "")
        set i to i + 1
    return out
