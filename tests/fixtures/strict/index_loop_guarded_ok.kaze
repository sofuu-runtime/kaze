# expect: ok — a dynamic index bound by the enclosing loop's length guard needs no fallback
# value: 18 with items=[5, 6, 7]
action main(items):
    let total = 0
    let i = 0
    while i < length of items bounded 100:
        let v = items[i]
        set total = total + v
        set i = i + 1
    return total
