pub action classify(n: num) -> text:
    require n between 0 and 100
    guard n >= 0 otherwise return "negative"
    if n < 10:
        return "small"
    elif n < 50:
        return "medium"
    else:
        return "large"

action main() -> num:
    let total = 0
    repeat 10 times:
        total += 1
        guard total < 8 otherwise break
        if total == 3:
            continue
        if total == 5:
            total += 1
    return total
