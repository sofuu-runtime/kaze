action heavy_calc(x):
    let acc = x
    let i = 0
    while i < 100000 bounded 200000:
        set acc to ((acc * 1103515245) + 12345) % 2147483648
        set i to i + 1
    return acc

action main() -> num:
    let nums = []
    let i = 0
    while i < 64 bounded 100:
        set nums to nums + [i]
        set i to i + 1
    let res = parallel_map(nums, heavy_calc)
    return length of res
