# A small script using local logging, with no device backend.
#
#   kaze run examples/hello.kaze --cap log
# A valid policy.json is required for the log capability.

needs: log

action main():
    log "Kaze is running"
    let total = 0
    let n = 1
    while n < 5:
        set total to total + n
        set n to n + 1
    log "sum 1..4 checked"
    return total
