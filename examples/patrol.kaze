# Kaze example — a drone perimeter patrol.
#
# Run it:
#   kaze run examples/patrol.kaze --cap drone=sim --cap log \
#       --arg 'points=[1,2,3,4]' --ticks 3 --sim battery=15
#
# This is an explicitly selected drone simulation for testing. A valid
# policy.json plus separate drone and log grants are required before calls.
# Simulation results are not physical hardware results.

needs: drone, log

action patrol(points):
    log "Starting automated perimeter patrol"
    arm drone
    takeoff to 15 meters
    for each point in points:
        fly to point at 15 meters
    return to launch

when battery < 20%:
    log warning "Battery critical!"
    return to launch
