# Kaze example — greenhouse climate control.
#
#   This syntax example needs real sensor and alert backends that are not yet
#   available in the standalone built-in host; it must not simulate them.
#
# `fan` and `mister` are instances of the `device` family, so one grant
# covers both relays.

needs: sensor, fan, mister, alert

check climate(target_temp, target_humidity):
    if sensor.temperature() > target_temp + 2:
        turn on fan
        send alert "Cooling fan activated"
    otherwise:
        turn off fan
    if sensor.humidity() < target_humidity:
        pulse mister for 5 seconds
