# kinematics.kaze — spatial maths with no hardware at all.
#
# Kaze v0.3: a point is a value, so a distance, a bearing and a scale factor
# are computed inside the script instead of on the ground station.
needs: log

action main():
    let home = vector(47.6000, 8.5000, 500)
    let waypoint = vector(47.6004, 8.5004, 500)
    log "metres to the waypoint:"
    log distance between home and waypoint
    log "bearing to the waypoint, in degrees:"
    log bearing from home to waypoint
    let offset = waypoint - home
    let doubled = offset * 2
    log "the offset, doubled:"
    log doubled
    log "its length in coordinate units:"
    log length of doubled
    log "sin of 30 degrees:"
    log sin(30 in radians)
