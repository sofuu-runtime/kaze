# A task's return value arrives at the join.
fiber counter(n: int) -> int:
    let total = 0
    while total < n bounded 100:
        set total to total + 1
        yield
    return total

action main():
    spawn counter(3) as a
    spawn counter(4) as b
    let ra = join a
    let rb = join b
    return ra * 100 + rb
