# fixture: every fallback in this file is discharged by the SMT proof, so the
# proof-carrying build may remove its runtime boundary branches.
requires_check: 0

action sum_prefix(n) -> num:
    requires n >= 0
    requires n <= 5
    let i = 0
    let total = 0
    while i < n bounded 1000:
        let v = [10, 20, 30, 40, 50][i] otherwise 0
        set total to total + v
        set i to i + 1
    return total

action ratio(a, b) -> num:
    requires b > 0
    let q = (a / b) otherwise 0
    return q

action main() -> num:
    let s = sum_prefix(5)
    let r = ratio(100, 4)
    return s + r
