    ]

# First 8 primes, fractional parts of their square roots. These are the SHA-512
# initial hash values, again as [hi, lo] pairs.
action sha512_iv() -> list:
    return [
        [1779033703, 4089235720],
        [3144134277, 2227873595],
        [1013904242, 4271175723],
        [2773480762, 1595750129],
        [1359893119, 2917565137],
        [2600822924, 725511199],
        [528734635, 4215389547],
        [1541459225, 327033209]
    ]

# ---- message schedule and compression ----------------------------------------

# One 128-byte block as 16 big-endian 64-bit words.
action sha512_block_words(block) -> list:
    let out = []
    let i = 0
    while i < 16 bounded 20:
        let o = i * 8
        let b0 = block[o] otherwise 0
        let b1 = block[o + 1] otherwise 0
        let b2 = block[o + 2] otherwise 0
        let b3 = block[o + 3] otherwise 0
        let b4 = block[o + 4] otherwise 0
        let b5 = block[o + 5] otherwise 0
        let b6 = block[o + 6] otherwise 0
        let b7 = block[o + 7] otherwise 0
        let hi = b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
        let lo = b4 * 16777216 + b5 * 65536 + b6 * 256 + b7
        set out to out + [[hi, lo]]
        set i to i + 1
    return out

# The 80-word schedule: W[t] = s1(W[t-2]) + W[t-7] + s0(W[t-15]) + W[t-16].
action sha512_schedule(words) -> list:
    let w = words
    let t = 16
    while t < 80 bounded 100:
        let w15 = w[t - 15] otherwise [0, 0]
        let w2 = w[t - 2] otherwise [0, 0]
        let s0 = small_sigma0(w15)
        let s1 = small_sigma1(w2)
        let sum = add64(add64(add64(w[t - 16] otherwise [0, 0], s0), w[t - 7] otherwise [0, 0]), s1)
        set w to w + [sum]
        set t to t + 1
    return w

# One block of compression. The eight working variables are rotated by rebinding,
# so the round body never indexes the state.
action sha512_compress(state, block) -> list:
    let w = sha512_schedule(sha512_block_words(block))
    let k = sha512_k()
    let a = state[0] otherwise [0, 0]
    let b = state[1] otherwise [0, 0]
    let c = state[2] otherwise [0, 0]
    let d = state[3] otherwise [0, 0]
    let e = state[4] otherwise [0, 0]
    let f = state[5] otherwise [0, 0]
    let g = state[6] otherwise [0, 0]
    let h = state[7] otherwise [0, 0]
    let t = 0
    while t < 80 bounded 100:
        let ki = k[t] otherwise [0, 0]
        let wi = w[t] otherwise [0, 0]
        let t1 = add64(add64(add64(h, big_sigma1(e)), ch64(e, f, g)), add64(ki, wi))
        let t2 = add64(big_sigma0(a), maj64(a, b, c))
        set h to g
        set g to f
        set f to e
        set e to add64(d, t1)
        set d to c
        set c to b
        set b to a
        set a to add64(t1, t2)
        set t to t + 1
    let work = [a, b, c, d, e, f, g, h]
    let out = []
    let i = 0
    while i < 8 bounded 10:
        let old = state[i] otherwise [0, 0]
        set out to out + [add64(old, work[i] otherwise [0, 0])]
        set i to i + 1
    return out

# The eight state words as 64 big-endian bytes.
action sha512_state_bytes(state) -> list:
    let out = []
    for each word in state:
        let hi = word[0] otherwise 0
        let lo = word[1] otherwise 0
        set out to out + [hi >> 24, (hi >> 16) & 255, (hi >> 8) & 255, hi & 255]
        set out to out + [lo >> 24, (lo >> 16) & 255, (lo >> 8) & 255, lo & 255]
    return out

# ---- padding and the public entry points -------------------------------------

# The message padded to a multiple of 128 bytes: 0x80, zeros, then the 128-bit
# bit length as 16 big-endian bytes.
action sha512_pad(msg, nbytes) -> list:
    let out = msg + [128]
    let m = length of out
    while (m % 128) != 112 bounded 10000000:
        set out to out + [0]
        set m to m + 1
    # bitlen < 2^53 always, so the high 64 bits of the length field are zero.
    let bitlen = nbytes * 8
    let bit_hi = bitlen >> 32
    let bit_lo = bitlen & 4294967295
    let z = 0
    while z < 8 bounded 16:
        set out to out + [0]
        set z to z + 1
    set out to out + [bit_hi >> 24, (bit_hi >> 16) & 255, (bit_hi >> 8) & 255, bit_hi & 255]
    set out to out + [bit_lo >> 24, (bit_lo >> 16) & 255, (bit_lo >> 8) & 255, bit_lo & 255]
    return out

# The digest of a message already in byte form. Ed25519 hashes the concatenation of
# two encoded points with a message, which is a byte list and not text, so it needs
# this entry point; sha512(text) is the same routine after the UTF-8 bytes are read
# out one by one.
action sha512_of_bytes(msg) -> list:
    let padded = sha512_pad(msg, length of msg)
    let state = sha512_iv()
    let off = 0
    let total = length of padded
    while off < total bounded 10000000:
        let block = []
        let j = 0
        while j < 128 bounded 200:
            set block to block + [padded[off + j] otherwise 0]
            set j to j + 1
        set state to sha512_compress(state, block)
        set off to off + 128
    return sha512_state_bytes(state)

# The UTF-8 bytes of a text, one entry per byte: length counts bytes and code gives
# the byte value at a byte position, which is why this is exact for any input.
action sha512_text_bytes(text) -> list:
    let msg = []
    let i = 0
    let n = length of text
    while i < n bounded 10000000:
        set msg to msg + [(code(text[i]) & 255)]
        set i to i + 1
    return msg

action sha512(text) -> list:
    return sha512_of_bytes(sha512_text_bytes(text))

action sha512_hex_digit(n) -> text:
    if n < 10:
        return character(48 + n)
    return character(87 + n)

action sha512_hex_byte(b) -> text:
    let hi = (b >> 4) & 15
    let lo = b & 15
    return sha512_hex_digit(hi) + sha512_hex_digit(lo)

action sha512_hex(text) -> text:
    let out = ""
    for each b in sha512(text):
        set out to out + sha512_hex_byte(b)
    return out
