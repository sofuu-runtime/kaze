# lib/sha512.kaze -- FIPS 180-4 SHA-512 over Kaze text.
#
# Kaze numbers are IEEE doubles and exact integers stop at 2^53, so a 64-bit word
# cannot live in one number. Every word in this module is a two-element list
# [hi, lo] of 32-bit halves, and add64, xor64, and64, rotr64 and shr64 are the only
# routines that touch the halves. Each of them keeps its intermediate below 2^33
# (a low-half sum tops out at 2^33-1, a rotated half is rebuilt from a masked piece
# that is smaller than 2^32), so every step is an exact double.
#
# Text is hashed byte for byte: Kaze text is UTF-8 at run time, `length of t` counts
# bytes and `code(t[i])` returns the byte at i, so non-ASCII input is hashed as its
# UTF-8 encoding, which is what FIPS 180-4 specifies.
#
# The length field is the 128-bit bit count. Its high 64 bits are always zero: a text
# whose bit length needs more than 53 bits cannot exist as a Kaze value.
#
#   sha512(text)         -> list of 64 bytes, each 0..255, in digest order
#   sha512_hex(text)     -> 128 lowercase hex characters
#   sha512_of_bytes(msg) -> the same digest for a message given as a byte list
#   sha512_text_bytes(t) -> the UTF-8 bytes of a text, one entry per byte

# ---- 64-bit words as [hi, lo] pairs ------------------------------------------

# Modulo-2^64 addition. The low halves sum to at most 2^33-1, so the carry is one
# comparison; the high halves then sum to at most 2^33-1 and lose their own carry,
# which is what modulo 2^64 means.
action add64(a, b) -> list:
    let lo = (a[1] otherwise 0) + (b[1] otherwise 0)
    let carry = 0
    if lo >= 4294967296:
        set lo to lo - 4294967296
        set carry to 1
    let hi = (a[0] otherwise 0) + (b[0] otherwise 0) + carry
    if hi >= 4294967296:
        set hi to hi - 4294967296
    return [hi, lo]

action xor64(a, b) -> list:
    let hi = (a[0] otherwise 0) ^ (b[0] otherwise 0)
    let lo = (a[1] otherwise 0) ^ (b[1] otherwise 0)
    return [hi, lo]

action and64(a, b) -> list:
    let hi = (a[0] otherwise 0) & (b[0] otherwise 0)
    let lo = (a[1] otherwise 0) & (b[1] otherwise 0)
    return [hi, lo]

action not64(a) -> list:
    return [(a[0] otherwise 0) ^ 4294967295, (a[1] otherwise 0) ^ 4294967295]

# Ch(e, f, g) = (e & f) ^ (~e & g)
action ch64(e, f, g) -> list:
    return xor64(and64(e, f), and64(not64(e), g))

# Maj(a, b, c) = (a & b) ^ (a & c) ^ (b & c)
action maj64(a, b, c) -> list:
    return xor64(xor64(and64(a, b), and64(a, c)), and64(b, c))

# Rotate the 64-bit word hi:lo right by n, where 1 <= n <= 31.
# The pieces shifted up by (32 - n) are first masked down to n bits, so they are
# below 2^32 before the shift and the result stays under 2^32 - never a 64-bit
# intermediate that a double would round.
action rotr_lt32(hi, lo, n) -> list:
    let m = (1 << n) - 1
    let up = 32 - n
    let nh = ((hi >> n) | ((lo & m) << up)) & 4294967295
    let nl = ((lo >> n) | ((hi & m) << up)) & 4294967295
    return [nh, nl]

action rotr64(x, n) -> list:
    let hi = x[0] otherwise 0
    let lo = x[1] otherwise 0
    if n <= 0:
        return [hi, lo]
    if n == 32:
        return [lo, hi]
    if n > 32:
        # A rotation by 32+n is a rotation of the swapped halves by n.
        return rotr_lt32(lo, hi, n - 32)
    return rotr_lt32(hi, lo, n)

action shr64(x, n) -> list:
    let hi = x[0] otherwise 0
    let lo = x[1] otherwise 0
    if n <= 0:
        return [hi, lo]
    if n == 32:
        return [0, hi]
    if n > 32:
        # Everything below the high half's (n-32) surviving bits is gone: the low
        # half contributes only bits below the dropped range.
        return [0, hi >> (n - 32)]
    let m = (1 << n) - 1
    let nh = hi >> n
    let nl = ((lo >> n) | ((hi & m) << (32 - n))) & 4294967295
    return [nh, nl]

# ---- the six mixed functions -------------------------------------------------

# ROTR 28, ROTR 34, ROTR 39
action big_sigma0(x) -> list:
    return xor64(xor64(rotr64(x, 28), rotr64(x, 34)), rotr64(x, 39))

# ROTR 14, ROTR 18, ROTR 41
action big_sigma1(x) -> list:
    return xor64(xor64(rotr64(x, 14), rotr64(x, 18)), rotr64(x, 41))

# ROTR 1, ROTR 8, SHR 7
action small_sigma0(x) -> list:
    return xor64(xor64(rotr64(x, 1), rotr64(x, 8)), shr64(x, 7))

# ROTR 19, ROTR 61, SHR 6
action small_sigma1(x) -> list:
    return xor64(xor64(rotr64(x, 19), rotr64(x, 61)), shr64(x, 6))

# ---- the round constants and the initial state -------------------------------

# First 80 primes, fractional parts of their cube roots, as [hi, lo]. The comment
# after each pair of entries is the 16 hex digits of the constant, so the table can
# be checked against FIPS 180-4 without running anything.
