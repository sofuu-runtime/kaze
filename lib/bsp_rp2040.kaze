# lib/bsp_rp2040.kaze -- board support for the RP2040-style virtual board.
#
# The RP2040 half of the virtual board models a different, smaller set of blocks.
# Every address below matches dist/kaze_board_sim.h exactly, and the suite next to
# this file writes and reads a scratch register in every window this BSP claims.
#
#   RESETS     0x4000C000   RESET 0x00 WDSEL 0x04 RESET_DONE 0x08
#   CLOCKS     0x40008000   CLK_REF_CTRL 0x30 CLK_SYS_CTRL 0x3C
#   IO_BANK0   0x40014000   GPIO0_CTRL 0x04 + n*0x08
#   PADS       0x4001C000   GPIO0 0x04 + n*0x04
#   SPI0       0x4003C000   SSPCR0 0x00 SSPCR1 0x04 SSPDR 0x08 SSPSR 0x0C
#   I2C0       0x40044000   IC_CON 0x00 IC_TAR 0x04 IC_DATA_CMD 0x10
#                           IC_RAW_INTR_STAT 0x34 IC_STATUS 0x70
#   PWM        0x40050000   CHn_CSR 0x00+n*0x14, DIV +4, CTR +8, CC +12, TOP +16
#                           EN 0xF0 INTR 0xF4
#   TIMER      0x40054000   TIMEHR 0x08 TIMELR 0x0C ALARM0 0x10 TIMERAWL 0x28
#   SIO        0xD0000000   GPIO_IN 0x004 GPIO_OUT 0x010 GPIO_OUT_SET 0x014
#                           GPIO_OUT_CLR 0x018 GPIO_OE 0x020
#
# Clock tree: 12 MHz XOSC -> PLL_SYS (REFDIV 1, FBDIV 125 -> 1500 MHz VCO,
# POSTDIV1 6, POSTDIV2 2) -> 125 MHz CLK_SYS, CLK_PERI following at 125 MHz. The
# virtual board models XOSC (CTRL/STATUS), PLL_SYS (CS/PWR/FBDIV_INT/PRIM) and
# the CLOCKS mux registers, so bsp_rp2040_clock_init() starts the crystal, waits
# for STABLE, powers the PLL, waits for LOCK, writes the muxes, decodes the
# dividers it reads back, publishes the resulting 125 MHz to SIM_CTL_SYSCLK_HZ
# and returns it as a number.
#
# There is no CAN controller on RP2040. bsp_rp2040_board() reports base_can = 0
# and bsp_rp2040_can_path() answers with the SPI-attached transport a CAN
# controller would use (SPI0 with a chip-select and an interrupt pin). No
# register in this module pretends an RP2040 CAN peripheral exists.
#
# UART0 (0x40034000) and DMA (0x50000000) are modelled, so the bring-up
# configures UART0 for 115200 8N1 and uses DMA channel 0 to move a three-byte
# greeting from the RAM window to the UART data register. That is the same
# telemetry path a driver uses; the suite checks the bytes the UART stored.
#
# Bring-up order (bsp_rp2040_init returns it as an ordered stage list):
#   resets -> clocks -> gpio_pins -> timer -> pwm -> spi -> i2c ->
#   can_spi_bridge -> uart -> dma

needs: regs


