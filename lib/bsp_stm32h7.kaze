# ---- DMA1 bit fields ---------------------------------------------------
# The virtual board reads the transfer width from S0CR bits 11:10, the direction
# from bit 4 (as board_test does) and always advances the memory pointer, which
# is why the bring-up uses EN|DIR (17). PINC and MINC are the silicon bits and
# are not needed on the model.

action stm32h7_dma_s0cr_en() -> num:
    return 1

action stm32h7_dma_s0cr_tcie() -> num:
    return 2

action stm32h7_dma_s0cr_htie() -> num:
    return 4

action stm32h7_dma_s0cr_teie() -> num:
    return 8

action stm32h7_dma_s0cr_dir() -> num:
    return 16

action stm32h7_dma_s0cr_circ() -> num:
    return 256

action stm32h7_dma_s0cr_pinc() -> num:
    return 512

action stm32h7_dma_s0cr_minc() -> num:
    return 1024


