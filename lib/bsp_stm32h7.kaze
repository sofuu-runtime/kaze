# lib/bsp_stm32h7.kaze -- board support for the STM32H7-style virtual board.
#
# This module is the contract between a driver and the board: the register map, the
# clock tree, the pin alternate functions, and one bring-up sequence. Every address
# below matches dist/kaze_board_sim.h exactly; the suite next to this file asserts
# that by reading and writing a scratch register in every window it claims, and by
# checking that the board counted no access outside the modelled map.
#
# What the virtual board models (and therefore what this BSP may touch):
#
#   TIM2   0x40000000   CR1/DIER/SR/EGR/CCMR1/CCMR2/CCER/CNT/PSC/ARR/CCR1..4/BDTR
#   I2C1   0x40005400   CR1/CR2/OAR1/TIMINGR/ISR/ICR/RXDR/TXDR
#   CAN1   0x4000A400   MCR/MSR/TSR/RF0R plus the TIR/TDTR/TDLR/TDHR and
#                       RIR/RDTR/RDLR/RDHR mailbox window
#   USART1 0x40011000   CR1/BRR/ISR/RDR/TDR
#   SPI1   0x40013000   CR1/CR2/SR/DR
#   DMA1   0x40020000   LISR, stream 0 and stream 1 registers
#   GPIOA  0x58020000   MODER/OTYPER/OSPEEDR/PUPDR/IDR/ODR/BSRR/AFRL/AFRH
#   RCC    0x58024400   CR/CFGR/D1CFGR/D2CFGR/D3CFGR/PLLCKSELR/PLLCFGR/
#                       PLL1DIVR/PLL1FRACR, with HSI and PLL1 ready bits
#   RAM    0x24000000   4 KiB the DMA model can move bytes through
#   SIM_CTL 0xE00F0000  the test-only control block
#
# The H7 also has an RCC block (0x58024400). The virtual board models its CR,
# CFGR, D1CFGR, D2CFGR, D3CFGR, PLLCKSELR, PLLCFGR, PLL1DIVR and PLL1FRACR
# registers, with HSION/HSIRDY always set and PLL1RDY following PLL1ON, so the
# clock bring-up below really writes the PLL and prescaler plan and reads it back.
# The plan is the real H743 plan: HSE 25 MHz, PLL1 DIVM 5, DIVN 192, DIVP 2 ->
# 960 MHz VCO and 480 MHz SYSCLK, AHB /2 -> 240 MHz HCLK, APB1..APB4 /2 -> 120 MHz,
# timer kernels 2 x PCLK -> 240 MHz. bsp_stm32h7_clock_init() writes those
# registers, polls PLL1RDY, decodes the values it actually read back, publishes
# the resulting SYSCLK to SIM_CTL_SYSCLK_HZ and returns it as a number.
#
# What this BSP does not claim:
#   * no silicon: no board is attached, and the virtual peripherals are behavioural;
#   * no interrupt controller, cache, MPU or power management;
#   * no GPIO port other than GPIOA is modelled. A real board passes its own port
#     base and pin numbers to the pin helpers; the default plan below uses the
#     pins that are expressible on the modelled port.
#
# Bring-up order (bsp_stm32h7_init returns it as an ordered stage list):
#   clocks -> gpio_pins -> timer -> spi -> i2c -> can -> uart -> dma

needs: regs


# ---- register bases ----------------------------------------------------
# Decimal because the language has no hex literals. Each value is a base from
# dist/kaze_board_sim.h.

action stm32h7_sim_ctl() -> num:
    return 3759079424

action stm32h7_tim2() -> num:
    return 1073741824

action stm32h7_i2c1() -> num:
    return 1073763328

action stm32h7_can1() -> num:
