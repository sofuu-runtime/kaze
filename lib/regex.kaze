# lib/regex.kaze -- a bounded regular-expression engine in Kaze.
#
# Scope is deliberately small and documented: literals, `.`, character classes
# (`[a-z]`, `[^...]`), the escapes `\d \w \s \D \W \S \n \t \r \xHH \uHHHH \u{H...}`,
# grouping and capture groups `(...)`, non-capturing groups `(?:...)`,
# alternation, the quantifiers `* + ?`, and the anchors `^` and `$`. There are
# no backreferences, lookaround, lazy quantifiers or counted repetition (`{m,n}`);
# an unsupported form is a syntax error, not a silently different match.
#
# Why this shape: a backtracking matcher can go exponential on patterns like
# `(a+)+$`. This engine keeps the set of reachable byte positions instead, so
# each input byte is visited a bounded number of times, and it still carries an
# explicit step budget so an adversarial pattern cannot tie up the process.
# The budget is returned to the caller (`steps`) and exceeding it is a typed
# failure (`E_REGEX_BUDGET`), never a wrong answer.
#
# Byte oriented: the runtime's text is bytes with a length, `code(c)` returns a
# byte and `character(n)` builds one back. UTF-8 is matched byte by byte with
# support for Unicode escapes (\uHHHH, \u{...}) and code-point boundary checking.

record Regex:
    ok: bool
    root: list
    error: text
    at: number
    num_groups: number

record RegexResult:
    ok: bool
    matched: bool
    start: number
    end: number
    steps: number
    error: text
    source: text
    groups: list

record RxParse:
    ok: bool
    node: list
    pos: number
    error: text
    at: number
    next_group: number

record RxAtom:
    ok: bool
    node: list
    pos: number
    error: text
    at: number

# The documented ceilings. A caller that needs a different work budget can call
# the `_limited` forms; the plain forms use these defaults.
action regex_max_pattern() -> num:
    return 1024

action regex_max_text() -> num:
    return 1048576

action regex_max_steps() -> num:
    return 1000000

# ── small helpers ──────────────────────────────────────────────────────

action rx_char(p: text, i: number) -> text:
    if i < 0 or i >= (length of p):
        return ""
    return p[i] otherwise ""

action rx_code(p: text, i: number) -> num:
    let c = rx_char(p, i)
    if length of c == 0:
        return 0 - 1
    return code(c)

action rx_valid(p: text, i: number) -> num:
    if i >= 0 and i < (length of p):
        return 1
    return 0

action rx_list_has(xs: list, v) -> bool:
    for each x in xs:
        if x == v:
            return true
    return false

action rx_error(msg: text, at: number) -> RxParse:
    return RxParse(ok: false, node: [], pos: at, error: msg, at: at, next_group: 0)

action rx_ok(node: list, pos: number, next_grp: number) -> RxParse:
    return RxParse(ok: true, node: node, pos: pos, error: "", at: 0, next_group: next_grp)

action rx_hex_digit(c: text) -> num:
    if length of c == 0:
        return 0 - 1
    let b = code(c)
    if b >= 48 and b <= 57:
        return b - 48
    if b >= 65 and b <= 70:
        return b - 55
    if b >= 97 and b <= 102:
        return b - 87
    return 0 - 1

action rx_floor_div(a: number, b: number) -> num:
    return ((a - ((a) % b otherwise 0)) / b) otherwise 0

action rx_codepoint_to_node(cp: number) -> list:
    if cp < 128:
        return ["char", cp]
    if cp < 2048:
        let b1 = 192 + rx_floor_div(cp, 64)
        let b2 = 128 + ((cp) % 64 otherwise 0)
        return ["seq", [["char", b1], ["char", b2]]]
    if cp < 65536:
        let b1 = 224 + rx_floor_div(cp, 4096)
        let b2 = 128 + (rx_floor_div(cp, 64) % 64 otherwise 0)
        let b3 = 128 + ((cp) % 64 otherwise 0)
        return ["seq", [["char", b1], ["char", b2], ["char", b3]]]
    let b1 = 240 + rx_floor_div(cp, 262144)
    let b2 = 128 + (rx_floor_div(cp, 4096) % 64 otherwise 0)
    let b3 = 128 + (rx_floor_div(cp, 64) % 64 otherwise 0)
    let b4 = 128 + ((cp) % 64 otherwise 0)
    return ["seq", [["char", b1], ["char", b2], ["char", b3], ["char", b4]]]

# ── parser ─────────────────────────────────────────────────────────────
#
# Recursive descent: alternation > sequence > repetition > atom. Every parser
# routine returns RxParse so a failure carries the byte offset that caused it.

action rx_parse(pattern: text) -> Regex:
    if length of pattern > regex_max_pattern():
        return Regex(ok: false, root: [], error: "E_REGEX_PATTERN_TOO_LARGE: pattern exceeds " + ("" + regex_max_pattern()) + " bytes", at: regex_max_pattern(), num_groups: 0)
    let r = rx_parse_alt(pattern, 0, 0, 1)
    if not r.ok:
        return Regex(ok: false, root: [], error: "E_REGEX_SYNTAX: " + r.error, at: r.at, num_groups: 0)
    if r.pos != (length of pattern):
        return Regex(ok: false, root: [], error: "E_REGEX_SYNTAX: unexpected '" + rx_char(pattern, r.pos) + "'", at: r.pos, num_groups: 0)
    let total_groups = r.next_group - 1
    if total_groups < 0:
        set total_groups to 0
    return Regex(ok: true, root: r.node, error: "", at: 0, num_groups: total_groups)

action rx_parse_alt(p: text, i: number, depth: number, grp: number) -> RxParse:
    recursion bounded 128
    if depth > 128:
        return rx_error("group nesting exceeds 128", i)
    let first = rx_parse_seq(p, i, depth, grp)
    if not first.ok:
        return first
    let branches = [first.node]
    let cur = first.pos
    let cur_grp = first.next_group
    while rx_char(p, cur) == "|" bounded 100000:
        let next = rx_parse_seq(p, cur + 1, depth, cur_grp)
        if not next.ok:
            return next
        set branches to branches + [next.node]
        set cur to next.pos
        set cur_grp to next.next_group
    if (length of branches) == 1:
        return rx_ok(first.node, cur, cur_grp)
    return rx_ok(["alt", branches], cur, cur_grp)

action rx_parse_seq(p: text, i: number, depth: number, grp: number) -> RxParse:
    recursion bounded 128
    let items = []
    let cur = i
    let cur_grp = grp
    let done = 0
    while done == 0 bounded 100000:
        let c = rx_char(p, cur)
        if length of c == 0:
            set done to 1
        otherwise:
            if c == "|" or c == ")":
                set done to 1
            otherwise:
                let r = rx_parse_repeat(p, cur, depth, cur_grp)
                if not r.ok:
                    return r
                set items to items + [r.node]
                set cur to r.pos
                set cur_grp to r.next_group
    # A one-item sequence is that item.
    if (length of items) == 1:
        return rx_ok(items[0] otherwise ["seq", items], cur, cur_grp)
    return rx_ok(["seq", items], cur, cur_grp)

# Wrapping a quantifier in another quantifier multiplies the matcher's work
# without changing the language. `(a+)+` is `a+`, `(a*)*` is `a*`, and so on;
# collapsing them at parse time is what keeps the advertised adversarial case
# inside a linear number of steps instead of a nested-closure quadratic.
action rx_quantify(node: list, q: text) -> list:
    let kind = node[0] otherwise ""
    let inner = node[1] otherwise []
    if kind == "group":
        let g_id = node[1] otherwise 0
        let g_child = node[2] otherwise []
        let child_kind = g_child[0] otherwise ""
        if child_kind == "star":
            return node
        if child_kind == "plus":
            if q == "*" or q == "+":
                return node
            return ["opt", node]
        if child_kind == "opt":
            if q == "*" or q == "+":
                return ["group", g_id, ["star", g_child[1] otherwise []]]
            return node
    if kind == "star":
        return node
    if kind == "plus":
        if q == "*":
            return node
        if q == "+":
            return node
        return ["opt", node]
    if kind == "opt":
        if q == "*" or q == "+":
            return ["star", inner]
        return node
    if q == "*":
        return ["star", node]
    if q == "+":
        return ["plus", node]
    return ["opt", node]

action rx_parse_repeat(p: text, i: number, depth: number, grp: number) -> RxParse:
    recursion bounded 128
    let atom = rx_parse_atom(p, i, depth, grp)
    if not atom.ok:
        return atom
    let node = atom.node
    let cur = atom.pos
    let cur_grp = atom.next_group
    let done = 0
    while done == 0 bounded 1000:
        let c = rx_char(p, cur)
        if c == "*":
            set node to rx_quantify(node, "*")
            set cur to cur + 1
        otherwise:
            if c == "+":
                set node to rx_quantify(node, "+")
                set cur to cur + 1
            otherwise:
                if c == "?":
                    set node to rx_quantify(node, "?")
                    set cur to cur + 1
                otherwise:
                    set done to 1
    return rx_ok(node, cur, cur_grp)

action rx_parse_atom(p: text, i: number, depth: number, grp: number) -> RxParse:
    recursion bounded 128
    if not rx_valid(p, i):
        return rx_error("expected an expression", i)
    let c = rx_char(p, i)
    if c == "(":
        if rx_char(p, i + 1) == "?" and rx_char(p, i + 2) == ":":
            let inner = rx_parse_alt(p, i + 3, depth + 1, grp)
            if not inner.ok:
                return inner
            if rx_char(p, inner.pos) != ")":
                return rx_error("missing ')'", inner.pos)
            return rx_ok(inner.node, inner.pos + 1, inner.next_group)
        let g_id = grp
        let inner = rx_parse_alt(p, i + 1, depth + 1, grp + 1)
        if not inner.ok:
            return inner
        if rx_char(p, inner.pos) != ")":
            return rx_error("missing ')'", inner.pos)
        return rx_ok(["group", g_id, inner.node], inner.pos + 1, inner.next_group)
    if c == "[":
        let cl = rx_parse_class(p, i + 1)
        if not cl.ok:
            return cl
        return rx_ok(cl.node, cl.pos, grp)
    if c == ".":
        return rx_ok(["any"], i + 1, grp)
    if c == "^":
        return rx_ok(["start"], i + 1, grp)
    if c == "$":
        return rx_ok(["end"], i + 1, grp)
    if c == "\\":
        return rx_parse_escape(p, i, grp)
    if c == "*" or c == "+" or c == "?":
        return rx_error("'" + c + "' has nothing to repeat", i)
    # Counted repetition is outside the documented subset. Refusing it is
    # better than treating '{' as a literal and quietly answering wrong.
    if c == "{" or c == "}":
        return rx_error("counted repetition '{m,n}' is not supported", i)
    return rx_ok(["char", rx_code(p, i)], i + 1, grp)

action rx_parse_escape(p: text, i: number, grp: number) -> RxParse:
    recursion bounded 128
    let e = rx_char(p, i + 1)
    if length of e == 0:
        return rx_error("trailing backslash", i)
    if e == "d":
        return rx_ok(["class", 0, [[48, 57]]], i + 2, grp)
    if e == "D":
        return rx_ok(["class", 1, [[48, 57]]], i + 2, grp)
    if e == "w":
        return rx_ok(["class", 0, [[48, 57], [65, 90], [97, 122], [95, 95]]], i + 2, grp)
    if e == "W":
        return rx_ok(["class", 1, [[48, 57], [65, 90], [97, 122], [95, 95]]], i + 2, grp)
    if e == "s":
        return rx_ok(["class", 0, [[9, 13], [32, 32]]], i + 2, grp)
    if e == "S":
        return rx_ok(["class", 1, [[9, 13], [32, 32]]], i + 2, grp)
    if e == "n":
        return rx_ok(["char", 10], i + 2, grp)
    if e == "t":
        return rx_ok(["char", 9], i + 2, grp)
    if e == "r":
        return rx_ok(["char", 13], i + 2, grp)
    if e == "x":
        let h1 = rx_hex_digit(rx_char(p, i + 2))
        let h2 = rx_hex_digit(rx_char(p, i + 3))
        if h1 >= 0 and h2 >= 0:
            let byte_val = h1 * 16 + h2
            return rx_ok(["char", byte_val], i + 4, grp)
        return rx_error("invalid \\xHH escape sequence", i)
    if e == "u":
        if rx_char(p, i + 2) == "{":
            let cur = i + 3
            let cp = 0
            let digits = 0
            while rx_valid(p, cur) and rx_char(p, cur) != "}" bounded 8:
                let d = rx_hex_digit(rx_char(p, cur))
                if d < 0:
                    return rx_error("invalid hex digit in \\u{...}", cur)
                set cp = cp * 16 + d
                set digits = digits + 1
                set cur = cur + 1
            if not rx_valid(p, cur) or rx_char(p, cur) != "}":
                return rx_error("unclosed \\u{...} escape", cur)
            if digits == 0 or cp > 1114111 or (cp >= 55296 and cp <= 57343):
                return rx_error("invalid Unicode code point in \\u{...}", i)
            let bytes_node = rx_codepoint_to_node(cp)
            return rx_ok(bytes_node, cur + 1, grp)
        otherwise:
            let u1 = rx_hex_digit(rx_char(p, i + 2))
            let u2 = rx_hex_digit(rx_char(p, i + 3))
            let u3 = rx_hex_digit(rx_char(p, i + 4))
            let u4 = rx_hex_digit(rx_char(p, i + 5))
            if u1 >= 0 and u2 >= 0 and u3 >= 0 and u4 >= 0:
                let cp = u1 * 4096 + u2 * 256 + u3 * 16 + u4
                if cp >= 55296 and cp <= 57343:
                    return rx_error("surrogate code point in \\uHHHH", i)
                let bytes_node = rx_codepoint_to_node(cp)
                return rx_ok(bytes_node, i + 6, grp)
            return rx_error("invalid \\uHHHH escape sequence", i)
    # An escaped punctuation character stands for itself.
    return rx_ok(["char", rx_code(p, i + 1)], i + 2, grp)

action rx_parse_class(p: text, i: number) -> RxParse:
    recursion bounded 128
    let cur = i
    let negated = 0
    if rx_char(p, cur) == "^":
        set negated to 1
        set cur to cur + 1
    let ranges = []
    let first = 1
    let closed = 0
    while closed == 0 bounded 10000:
        if not rx_valid(p, cur):
            return rx_error("missing ']'", cur)
        let c = rx_char(p, cur)
        if c == "]" and first == 0:
            set closed to 1
        otherwise:
            if c == "]" and first == 1:
                # A leading ']' is a literal, as in POSIX.
                set ranges to ranges + [[93, 93]]
                set cur to cur + 1
                set first to 0
            otherwise:
                let atom = rx_class_atom(p, cur)
                if not atom.ok:
                    return rx_error(atom.error, atom.at)
                if rx_char(p, atom.pos) == "-" and rx_valid(p, atom.pos + 1) and rx_char(p, atom.pos + 1) != "]":
                    let upper = rx_class_atom(p, atom.pos + 1)
                    if not upper.ok:
                        return rx_error(upper.error, upper.at)
                    if (length of upper.node) != 1:
                        return rx_error("a character class range needs a single upper bound", atom.pos + 1)
                    let pair = upper.node[0] otherwise [0, 0]
                    let lo_pair = atom.node[0] otherwise [0, 0]
                    let lo = lo_pair[0] otherwise 0
                    let hi = pair[0] otherwise 0
                    if lo > hi:
                        return rx_error("character class range is reversed", atom.pos)
                    set ranges to ranges + [[lo, hi]]
                    set cur to upper.pos
                otherwise:
                    for each r in atom.node:
                        set ranges to ranges + [r]
                    set cur to atom.pos
                set first to 0
    if (length of ranges) == 0:
        return rx_error("empty character class", i)
    return rx_ok(["class", negated, ranges], cur + 1, 0)

# One class member: a literal byte, an escape range, or a shorthand class.
action rx_class_atom(p: text, i: number) -> RxAtom:
    recursion bounded 128
    let c = rx_char(p, i)
    if c == "\\":
        let e = rx_char(p, i + 1)
        if length of e == 0:
            return RxAtom(ok: false, node: [], pos: i, error: "trailing backslash in a character class", at: i)
        if e == "d":
            return RxAtom(ok: true, node: [[48, 57]], pos: i + 2, error: "", at: 0)
        if e == "w":
            return RxAtom(ok: true, node: [[48, 57], [65, 90], [97, 122], [95, 95]], pos: i + 2, error: "", at: 0)
        if e == "s":
            return RxAtom(ok: true, node: [[9, 13], [32, 32]], pos: i + 2, error: "", at: 0)
        if e == "n":
            return RxAtom(ok: true, node: [[10, 10]], pos: i + 2, error: "", at: 0)
        if e == "t":
            return RxAtom(ok: true, node: [[9, 9]], pos: i + 2, error: "", at: 0)
        if e == "r":
            return RxAtom(ok: true, node: [[13, 13]], pos: i + 2, error: "", at: 0)
        let b = rx_code(p, i + 1)
        return RxAtom(ok: true, node: [[b, b]], pos: i + 2, error: "", at: 0)
    let b = rx_code(p, i)
    return RxAtom(ok: true, node: [[b, b]], pos: i + 1, error: "", at: 0)

# ── matcher ────────────────────────────────────────────────────────────
#
# The matcher keeps a set of reachable [pos, groups] states instead of backtracking.
# A star is the transitive closure of its child over those positions, so an
# input byte is never reconsidered by the same node more than a bounded number
# of times. `steps` counts node applications and the caller gets it back.

action rx_class_match(ranges: list, b: number) -> bool:
    for each r in ranges:
        let lo = r[0] otherwise 0
        let hi = r[1] otherwise 0
        if b >= lo and b <= hi:
            return true
    return false

action rx_state_has(states: list, pos: number) -> bool:
    for each s in states:
        let p = s[0] otherwise -1
        if p == pos:
            return true
    return false

action rx_merge_states(a: list, b: list) -> list:
    let out = a
    for each s in b:
        let p = s[0] otherwise -1
        if not rx_state_has(out, p):
            set out to out + [s]
    return out

action rx_set_group(groups: list, g_id: number, start: number, end: number) -> list:
    let out = []
    let i = 0
    let n = length of groups
    while i < n bounded 64:
        if i == g_id:
            set out to out + [[start, end]]
        otherwise:
            set out to out + [groups[i] otherwise [-1, -1]]
        set i to i + 1
    while (length of out) <= g_id bounded 64:
        if (length of out) == g_id:
            set out to out + [[start, end]]
        otherwise:
            set out to out + [[-1, -1]]
    return out

action rx_init_groups(num_groups: number) -> list:
    let out = []
    let i = 0
    let total = num_groups + 1
    while i < total bounded 64:
        set out to out + [[-1, -1]]
        set i to i + 1
    return out

action rx_match_node(node: list, text: text, state: list, steps: number, limit: number) -> list:
    recursion bounded 256
    if steps >= limit:
        return [[], steps, false]
    let pos = state[0] otherwise 0
    let grps = state[1] otherwise []
    let kind = node[0] otherwise ""
    let n = length of text
    if kind == "char":
        if pos < n and rx_code(text, pos) == (node[1] otherwise 0 - 1):
            return [[[pos + 1, grps]], steps + 1, true]
        return [[], steps + 1, true]
    if kind == "any":
        if pos < n and rx_code(text, pos) != 10:
            return [[[pos + 1, grps]], steps + 1, true]
        return [[], steps + 1, true]
    if kind == "class":
        if pos >= n:
            return [[], steps + 1, true]
        let negated = node[1] otherwise 0
        let inside = rx_class_match(node[2] otherwise [], rx_code(text, pos))
        if (negated == 1 and not inside) or (negated == 0 and inside):
            return [[[pos + 1, grps]], steps + 1, true]
        return [[], steps + 1, true]
    if kind == "start":
        if pos == 0:
            return [[[pos, grps]], steps + 1, true]
        return [[], steps + 1, true]
    if kind == "end":
        if pos == n:
            return [[[pos, grps]], steps + 1, true]
        return [[], steps + 1, true]
    if kind == "seq":
        return rx_match_items(node[1] otherwise [], text, [state], steps, limit)
    if kind == "group":
        let g_id = node[1] otherwise 0
        let child = node[2] otherwise []
        let r = rx_match_node(child, text, state, steps, limit)
        if not (r[2] otherwise false):
            return r
        let out_states = []
        for each s in (r[0] otherwise []):
            let end_p = s[0] otherwise 0
            let child_grps = s[1] otherwise []
            let updated = rx_set_group(child_grps, g_id, pos, end_p)
            set out_states to out_states + [[end_p, updated]]
        return [out_states, r[1] otherwise steps, true]
    if kind == "alt":
        let ends = []
        let total = steps
        for each branch in (node[1] otherwise []):
            let r = rx_match_node(branch, text, state, total, limit)
            if not (r[2] otherwise false):
                return [[], r[1] otherwise total, false]
            set total to r[1] otherwise total
            set ends to rx_merge_states(ends, r[0] otherwise [])
        return [ends, total, true]
    if kind == "opt":
        let r = rx_match_node(node[1] otherwise [], text, state, steps, limit)
        if not (r[2] otherwise false):
            return r
        return [rx_merge_states(r[0] otherwise [], [state]), r[1] otherwise steps, true]
    if kind == "star":
        return rx_star(node[1] otherwise [], text, state, steps, limit)
    if kind == "plus":
        let once = rx_match_node(node[1] otherwise [], text, state, steps, limit)
        if not (once[2] otherwise false):
            return once
        let ends = []
        let total = once[1] otherwise steps
        for each s in (once[0] otherwise []):
            let r = rx_star(node[1] otherwise [], text, s, total, limit)
            if not (r[2] otherwise false):
                return [[], r[1] otherwise total, false]
            set total to r[1] otherwise total
            set ends to rx_merge_states(ends, r[0] otherwise [])
        return [ends, total, true]
    return [[], steps + 1, true]

action rx_star(child: list, text: text, initial_state: list, steps: number, limit: number) -> list:
    recursion bounded 256
    let seen = [initial_state]
    let frontier = [initial_state]
    let total = steps
    let done = 0
    while done == 0 and length of frontier > 0 bounded 100000:
        let next = []
        for each s in frontier:
            let s_pos = s[0] otherwise 0
            let r = rx_match_node(child, text, s, total, limit)
            if not (r[2] otherwise false):
                return [[], r[1] otherwise total, false]
            set total to r[1] otherwise total
            for each cand in (r[0] otherwise []):
                let cand_pos = cand[0] otherwise 0
                if cand_pos > s_pos and not rx_state_has(seen, cand_pos):
                    set seen to seen + [cand]
                    set next to next + [cand]
        if length of next == 0:
            set done to 1
        otherwise:
            set frontier to next
    return [seen, total, true]

action rx_match_items(items: list, text: text, states: list, steps: number, limit: number) -> list:
    recursion bounded 256
    let cur = states
    let total = steps
    for each item in items:
        let next = []
        for each s in cur:
            let r = rx_match_node(item, text, s, total, limit)
            if not (r[2] otherwise false):
                return [[], r[1] otherwise total, false]
            set total to r[1] otherwise total
            set next to rx_merge_states(next, r[0] otherwise [])
        set cur to next
        if length of cur == 0:
            return [[], total, true]
    return [cur, total, true]

action rx_longest_state(states: list) -> list:
    if (length of states) == 0:
        return [-1, []]
    let best_pos = 0 - 1
    let best_state = [-1, []]
    for each s in states:
        let p = s[0] otherwise -1
        if p > best_pos:
            set best_pos to p
            set best_state to s
    return best_state

# ── public API ─────────────────────────────────────────────────────────

action regex_is_valid(pattern: text) -> bool:
    let re = rx_parse(pattern)
    return re.ok

# Match the whole text: `matched` is true only when the pattern consumes every
# byte. Anchors still work; this is the "validate" form.
action regex_full_match_limited(re: Regex, text: text, limit: number) -> RegexResult:
    if not re.ok:
        return RegexResult(ok: false, matched: false, start: 0, end: 0, steps: 0, error: re.error, source: text, groups: [])
    if length of text > regex_max_text():
        return RegexResult(ok: false, matched: false, start: 0, end: 0, steps: 0, error: "E_REGEX_TEXT_TOO_LARGE: text exceeds " + ("" + regex_max_text()) + " bytes", source: text, groups: [])
    let init_st = [0, rx_init_groups(re.num_groups)]
    let r = rx_match_node(re.root, text, init_st, 0, limit)
    if not (r[2] otherwise false):
        let used = r[1] otherwise limit
        return RegexResult(ok: false, matched: false, start: 0, end: 0, steps: used, error: "E_REGEX_BUDGET: match exceeded " + ("" + limit) + " steps", source: text, groups: [])
    let used = r[1] otherwise 0
    let best = rx_longest_state(r[0] otherwise [])
    let end = best[0] otherwise -1
    if end == (length of text):
        let grps = rx_set_group(best[1] otherwise [], 0, 0, end)
        return RegexResult(ok: true, matched: true, start: 0, end: end, steps: used, error: "", source: text, groups: grps)
    return RegexResult(ok: true, matched: false, start: 0, end: 0, steps: used, error: "", source: text, groups: [])

action regex_full_match(pattern: text, text: text) -> RegexResult:
    return regex_full_match_limited(rx_parse(pattern), text, regex_max_steps())

# Search for the leftmost match, longest at that start position.
action regex_search_limited(re: Regex, text: text, limit: number) -> RegexResult:
    if not re.ok:
        return RegexResult(ok: false, matched: false, start: 0, end: 0, steps: 0, error: re.error, source: text, groups: [])
    if length of text > regex_max_text():
        return RegexResult(ok: false, matched: false, start: 0, end: 0, steps: 0, error: "E_REGEX_TEXT_TOO_LARGE: text exceeds " + ("" + regex_max_text()) + " bytes", source: text, groups: [])
    let n = length of text
    let at = 0
    let total = 0
    while at <= n bounded 1048576:
        let init_st = [at, rx_init_groups(re.num_groups)]
        let r = rx_match_node(re.root, text, init_st, total, limit)
        if not (r[2] otherwise false):
            let used = r[1] otherwise limit
            return RegexResult(ok: false, matched: false, start: at, end: 0, steps: used, error: "E_REGEX_BUDGET: match exceeded " + ("" + limit) + " steps", source: text, groups: [])
        set total to r[1] otherwise total
        let best = rx_longest_state(r[0] otherwise [])
        let end = best[0] otherwise -1
        if end >= 0:
            let grps = rx_set_group(best[1] otherwise [], 0, at, end)
            return RegexResult(ok: true, matched: true, start: at, end: end, steps: total, error: "", source: text, groups: grps)
        set at to at + 1
    return RegexResult(ok: true, matched: false, start: 0, end: 0, steps: total, error: "", source: text, groups: [])

action regex_search(pattern: text, text: text) -> RegexResult:
    return regex_search_limited(rx_parse(pattern), text, regex_max_steps())

action regex_group_count(r: RegexResult) -> num:
    let n = length of r.groups
    if n <= 1:
        return 0
    return n - 1

action regex_group_span(r: RegexResult, index: number) -> list:
    if index < 0 or index >= (length of r.groups):
        return [-1, -1]
    return r.groups[index] otherwise [-1, -1]

action regex_group(r: RegexResult, index: number) -> text:
    let span = regex_group_span(r, index)
    let s = span[0] otherwise -1
    let e = span[1] otherwise -1
    if s < 0 or e < s:
        return ""
    return rx_slice_range(r.source, s, e)

action regex_group_text(r: RegexResult, t: text, index: number) -> text:
    let span = regex_group_span(r, index)
    let s = span[0] otherwise -1
    let e = span[1] otherwise -1
    if s < 0 or e < s:
        return ""
    return rx_slice_range(t, s, e)

action rx_expand_replacement(rep: text, r: RegexResult) -> text:
    let out = ""
    let i = 0
    let n = length of rep
    while i < n bounded 1048576:
        let c = rx_char(rep, i)
        if c == "$":
            let next_c = rx_char(rep, i + 1)
            if next_c == "$":
                set out to out + "$"
                set i to i + 2
            otherwise:
                let code_n = rx_code(rep, i + 1)
                if code_n >= 48 and code_n <= 57:
                    let grp_idx = code_n - 48
                    set out to out + regex_group(r, grp_idx)
                    set i to i + 2
                otherwise:
                    set out to out + "$"
                    set i to i + 1
        otherwise:
            if c == "\\":
                let code_n = rx_code(rep, i + 1)
                if code_n >= 48 and code_n <= 57:
                    let grp_idx = code_n - 48
                    set out to out + regex_group(r, grp_idx)
                    set i to i + 2
                otherwise:
                    set out to out + (rep[i] otherwise "")
                    set i to i + 1
            otherwise:
                set out to out + (rep[i] otherwise "")
                set i to i + 1
    return out

action regex_replace_limited(re: Regex, text: text, replacement: text, limit: number) -> text:
    let out = ""
    let at = 0
    let n = length of text
    let total = 0
    while at <= n bounded 1048576:
        let rest = rx_slice_from(text, at)
        let r = regex_search_limited(re, rest, limit - total)
        if not r.ok or not r.matched:
            set out to out + rest
            return out
        set total to total + r.steps
        let start = at + r.start
        let end = at + r.end
        set out to out + rx_slice_range(text, at, start)
        set out to out + rx_expand_replacement(replacement, r)
        if end > at:
            set at to end
        otherwise:
            if at < n:
                set out to out + (text[at] otherwise "")
            set at to at + 1
    return out

action regex_replace(pattern: text, text: text, replacement: text) -> text:
    return regex_replace_limited(rx_parse(pattern), text, replacement, regex_max_steps())

# All non-overlapping matches, leftmost first, as [start, end] byte pairs.
action regex_find_all_limited(re: Regex, text: text, limit: number) -> list:
    let out = []
    let at = 0
    let n = length of text
    let total = 0
    while at <= n bounded 1048576:
        let rest = rx_slice_from(text, at)
        let r = regex_search_limited(re, rest, limit - total)
        if not r.ok or not r.matched:
            return out
        set total to total + r.steps
        let start = at + r.start
        let end = at + r.end
        set out to out + [[start, end]]
        if end > at:
            set at to end
        otherwise:
            set at to at + 1
    return out

action regex_find_all(pattern: text, text: text) -> list:
    return regex_find_all_limited(rx_parse(pattern), text, regex_max_steps())

action regex_is_utf8_boundary(t: text, pos: number) -> bool:
    if pos <= 0 or pos >= (length of t):
        return true
    let b = rx_code(t, pos)
    if b < 128 or b >= 192:
        return true
    return false

action rx_slice_from(t: text, start: number) -> text:
    let out = ""
    let i = start
    let n = length of t
    while i < n bounded 1048576:
        set out to out + (t[i] otherwise "")
        set i to i + 1
    return out

action rx_slice_range(t: text, from: number, to: number) -> text:
    let out = ""
    let i = from
    let n = length of t
    if to < n:
        set n to to
    while i < n bounded 1048576:
        set out to out + (t[i] otherwise "")
        set i to i + 1
    return out
